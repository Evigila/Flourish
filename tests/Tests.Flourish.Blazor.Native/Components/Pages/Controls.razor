@page "/"
<PageTitle>Native controls</PageTitle>
<ApplicationShell OwnsDocument="true">
    <ChildContent>
        <PageBody>
            <PageHeading Title="Native controls" />
            <EditForm Model="form" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <Field Id="name" Label="Name" For="() => form.Name" Required><TextBox id="name" @bind-Value="form.Name" /></Field>
                <Field Id="enabled" Label="Enabled"><ToggleSwitch id="enabled" @bind-Value="form.Enabled" Label="Enabled" /></Field>
                <Button Type="submit">Submit</Button>
            </EditForm>
            <p role="status">@message</p>
            <ActionMenu Label="Actions" Actions="actions" />
            <Button OnClick="() => dialog = true">Open dialog</Button>
            <Button OnClick="() => sheet = true">Open sheet</Button>
            <label for="masked">Masked native input</label>
            <ArkheideSystem.Flourish.Blazor.Components.Primitives.StandaloneMaskedInput id="masked" Mask="000.000.000-00" @bind-Value="masked" />
            <ArkheideSystem.Flourish.Blazor.Components.Primitives.NoticeTrigger Severity="ArkheideSystem.Flourish.Abstract.NotificationSeverity.Information">Native notice content</ArkheideSystem.Flourish.Blazor.Components.Primitives.NoticeTrigger>
            <Disclosure Title="Native disclosure"><p>Disclosure content</p></Disclosure>
            <ProgressBar Value="35" Label="Progress" />
            <DataTable TItem="Entry" Items="entries" Columns="columns" Label="Entries" />
        </PageBody>
        <Dialog @bind-IsOpen="dialog" Title="Dialog"><p>Dialog content</p></Dialog>
        <Dialog @bind-IsOpen="sheet" Title="Sheet" Presentation="DialogPresentation.BottomSheet"><p>Sheet content</p></Dialog>
    </ChildContent>
</ApplicationShell>
@code {
    private sealed class Input { [System.ComponentModel.DataAnnotations.Required] public string Name { get; set; } = ""; public bool Enabled { get; set; } }
    private sealed record Entry(string Name, int Quantity);
    private readonly Input form = new();
    private bool dialog, sheet;
    private string? masked;
    private string message = "";
    private IReadOnlyList<MenuAction> actions => [new("Show status", () => { message = "Menu activated"; return Task.CompletedTask; })];
    private readonly IReadOnlyList<Entry> entries = [new("One", 1), new("Two", 2)];
    private readonly IReadOnlyList<TableColumn<Entry>> columns = [new("name", "Name", entry => entry.Name), new("quantity", "Quantity", entry => entry.Quantity)];
    private void Submit() => message = "Submitted " + form.Name;
}
