<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:ArkheideSystem.Flourish.Controls"
>
  <Style TargetType="{x:Type controls:FlourishGridSplitter}">
    <Setter Property="Width" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ShowsPreview" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:FlourishGridSplitter}">
          <Grid Background="{TemplateBinding Background}">
            <Border
              x:Name="SplitterIndicator"
              Width="2"
              HorizontalAlignment="Center"
              Background="{DynamicResource FlourishPrimaryForegroundBrush}"
              CornerRadius="1"
              IsHitTestVisible="False"
              Opacity="0"
              SnapsToDevicePixels="True"
            />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ResizeDirection" Value="Rows">
              <Setter TargetName="SplitterIndicator" Property="Width" Value="Auto" />
              <Setter TargetName="SplitterIndicator" Property="Height" Value="2" />
              <Setter
                TargetName="SplitterIndicator"
                Property="HorizontalAlignment"
                Value="Stretch"
              />
              <Setter
                TargetName="SplitterIndicator"
                Property="VerticalAlignment"
                Value="Center"
              />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="SplitterIndicator" Property="Opacity" Value="0.72" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="SplitterIndicator" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Background" Value="{DynamicResource FlourishNeutralBackgroundDisabledBrush}" />
              <Setter TargetName="SplitterIndicator" Property="Background" Value="{DynamicResource FlourishNeutralForegroundDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Variant" Value="NavigationPane">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="ResizeDirection" Value="Columns" />
        <Setter Property="Panel.ZIndex" Value="10" />
      </Trigger>
      <Trigger Property="ResizeDirection" Value="Rows">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="SizeNS" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
