<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <!-- Neutral aliases selected from the Fluent web dark palette. -->
  <SolidColorBrush x:Key="FlourishNeutralForeground1Brush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FlourishNeutralForeground2Brush" Color="#D6D6D6" />
  <SolidColorBrush x:Key="FlourishNeutralForegroundDisabledBrush" Color="#5C5C5C" />
  <SolidColorBrush x:Key="FlourishNeutralBackground1Brush" Color="#292929" />
  <SolidColorBrush x:Key="FlourishNeutralBackground1HoverBrush" Color="#3D3D3D" />
  <SolidColorBrush x:Key="FlourishNeutralBackground1PressedBrush" Color="#1F1F1F" />
  <SolidColorBrush x:Key="FlourishNeutralBackground2Brush" Color="#1F1F1F" />
  <SolidColorBrush x:Key="FlourishNeutralBackgroundDisabledBrush" Color="#141414" />
  <SolidColorBrush x:Key="FlourishShellBackgroundBrush" Color="#E6141414" />
  <SolidColorBrush x:Key="FlourishNeutralStroke1Brush" Color="#666666" />
  <SolidColorBrush x:Key="FlourishNeutralStroke1HoverBrush" Color="#757575" />
  <SolidColorBrush x:Key="FlourishNeutralStrokeAccessibleBrush" Color="#ADADAD" />
  <SolidColorBrush x:Key="FlourishNeutralStrokeDisabledBrush" Color="#424242" />
  <SolidColorBrush x:Key="FlourishFocusStrokeBrush" Color="#479EF5" />
  <SolidColorBrush x:Key="FlourishSurfaceStrokeBrush" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="FlourishDividerBrush" Color="#525252" />

  <!-- Shared interaction aliases. -->
  <SolidColorBrush x:Key="FlourishSelectionBackgroundBrush" Color="#0F548C" />
  <SolidColorBrush x:Key="FlourishSelectionForegroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FlourishHoverRevealBrush" Color="#66479EF5" />
  <SolidColorBrush x:Key="FlourishPressedRevealBrush" Color="#732886DE" />
  <SolidColorBrush x:Key="FlourishTonalButtonBackgroundBrush" Color="#082338" />
  <SolidColorBrush x:Key="FlourishTonalButtonForegroundBrush" Color="#62ABF5" />
  <SolidColorBrush x:Key="FlourishTonalButtonPressedBrush" Color="#061724" />
  <SolidColorBrush x:Key="FlourishTonalButtonPressedForegroundBrush" Color="#EBF3FC" />

  <!-- Primary, secondary and accent are independently overridable public roles. -->
  <Color x:Key="FlourishPrimaryColor">#0F6CBD</Color>
  <Color x:Key="FlourishSecondaryColor">#9C6DC7</Color>
  <Color x:Key="FlourishAccentColor">#DA3B01</Color>
  <SolidColorBrush x:Key="FlourishPrimaryForegroundBrush" Color="#479EF5" />
  <SolidColorBrush x:Key="FlourishPrimaryHoverBrush" Color="#62ABF5" />
  <SolidColorBrush x:Key="FlourishPrimaryPressedBrush" Color="#2886DE" />
  <SolidColorBrush x:Key="FlourishPrimarySurfaceBrush" Color="#300F6CBD" />
  <SolidColorBrush x:Key="FlourishPrimaryBackgroundBrush" Color="#115EA3" />
  <SolidColorBrush x:Key="FlourishPrimaryBackgroundHoverBrush" Color="#0F6CBD" />
  <SolidColorBrush x:Key="FlourishPrimaryBackgroundPressedBrush" Color="#0C3B5E" />
  <SolidColorBrush x:Key="FlourishForegroundOnPrimaryBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FlourishSecondaryForegroundBrush" Color="#C9A7EB" />
  <SolidColorBrush x:Key="FlourishSecondarySurfaceBrush" Color="#305C2E91" />
  <SolidColorBrush x:Key="FlourishAccentForegroundBrush" Color="#E9835E" />
  <SolidColorBrush x:Key="FlourishAccentSurfaceBrush" Color="#30DA3B01" />
  <LinearGradientBrush x:Key="FlourishHeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#420F6CBD" />
    <GradientStop Offset="0.68" Color="#385C2E91" />
    <GradientStop Offset="1" Color="#30DA3B01" />
  </LinearGradientBrush>

  <!-- Shared overlay and status aliases. -->
  <SolidColorBrush x:Key="FlourishOverlayScrimBrush" Color="#80000000" />
  <SolidColorBrush x:Key="FlourishForegroundOnOverlayBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FlourishDangerForegroundBrush" Color="#DC626D" />
  <SolidColorBrush x:Key="FlourishDangerBackgroundBrush" Color="#3B0509" />
  <SolidColorBrush x:Key="FlourishDangerStrongBackgroundBrush" Color="#C50F1F" />
  <SolidColorBrush x:Key="FlourishDangerStrokeBrush" Color="#DC626D" />
  <SolidColorBrush x:Key="FlourishDangerHoverRevealBrush" Color="#33DC626D" />
  <SolidColorBrush x:Key="FlourishForegroundOnDangerBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FlourishWarningBackgroundBrush" Color="#4A1E04" />
  <SolidColorBrush x:Key="FlourishWarningForegroundBrush" Color="#FAA06B" />

  <!-- Specialized surfaces that cannot be represented by another alias. -->
  <SolidColorBrush x:Key="FlourishScrollbarThumbBrush" Color="#999999" />
  <SolidColorBrush x:Key="FlourishScrollbarThumbPressedBrush" Color="#D6D6D6" />
  <SolidColorBrush x:Key="FlourishCardBackgroundBrush" Color="#333333" />
  <SolidColorBrush x:Key="FlourishOutputViewportBackgroundBrush" Color="#0A0A0A" />
  <SolidColorBrush x:Key="FlourishOutputViewportForegroundBrush" Color="#54B054" />
  <DropShadowEffect x:Key="FlourishElevation1Effect" BlurRadius="12" Direction="270" Opacity="0.24" ShadowDepth="2" Color="#000000" />
  <DropShadowEffect x:Key="FlourishElevation2Effect" BlurRadius="20" Direction="270" Opacity="0.40" ShadowDepth="4" Color="#000000" />
</ResourceDictionary>
