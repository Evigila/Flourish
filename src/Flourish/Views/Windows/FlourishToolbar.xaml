<UserControl
  x:Class="ArkheideSystem.Flourish.Views.Windows.FlourishToolbar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:ClassModifier="internal"
>
  <Border
    x:Name="ToolbarHostBorder"
    Margin="0,0,0,4"
    Padding="2"
    Background="{DynamicResource FlourishCardBackgroundBrush}"
    BorderBrush="{DynamicResource FlourishSurfaceStrokeBrush}"
    BorderThickness="{DynamicResource FlourishSurfaceBorderThickness}"
    CornerRadius="{DynamicResource FlourishSurfaceCornerRadius}"
  >
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel
        x:Name="StartRegionHost"
        Grid.Column="0"
        Orientation="Horizontal"
        Visibility="Collapsed"
      />
      <StackPanel x:Name="ItemHost" Grid.Column="1" Orientation="Horizontal" />
      <StackPanel
        x:Name="EndRegionHost"
        Grid.Column="2"
        Orientation="Horizontal"
        Visibility="Collapsed"
      />
    </Grid>
  </Border>
</UserControl>
