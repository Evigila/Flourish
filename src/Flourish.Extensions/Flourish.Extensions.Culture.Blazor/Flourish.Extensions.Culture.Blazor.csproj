<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Flourish.Extensions.Culture.Blazor</AssemblyName>
    <RootNamespace>ArkheideSystem.Flourish.Extensions.Culture.Blazor</RootNamespace>
    <PackageId>Arkheide.Flourish.Extensions.Culture.Blazor</PackageId>
    <StaticWebAssetBasePath>_content/Arkheide.Flourish.Extensions.Culture.Blazor</StaticWebAssetBasePath>
    <Description>Optional request localization and persistent browser culture selection for Flourish.Blazor.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EssentialCultureGeneratorEnabled>false</EssentialCultureGeneratorEnabled>
    <EssentialCultureAutoCreate>false</EssentialCultureAutoCreate>
    <EssentialCultureAutoInclude>false</EssentialCultureAutoInclude>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../Flourish.Blazor/Flourish.Blazor.Framework/Flourish.Blazor.Framework.csproj" />
    <PackageReference Include="Arkheide.Essential.Culture.Blazor" Version="$(EssentialCultureVersion)" />
    <EmbeddedResource Include="Localization/Culture.json" LogicalName="Culture.Texts.json" />
  </ItemGroup>
</Project>
