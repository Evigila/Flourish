<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>

    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ArkheideSystem.Flourish.Extensions.Culture.WPF</RootNamespace>
    <AssemblyName>Flourish.Extensions.Culture.WPF</AssemblyName>
    <PackageId>Arkheide.Flourish.Extensions.Culture.WPF</PackageId>
    <Title>Flourish Culture WPF integration</Title>
    <Description>Optional provider-neutral native Flourish WPF text integration with Essential.Culture.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EssentialCultureGeneratorEnabled>false</EssentialCultureGeneratorEnabled>
    <EssentialCultureAutoCreate>false</EssentialCultureAutoCreate>
    <EssentialCultureAutoInclude>false</EssentialCultureAutoInclude>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Flourish.WPF/Flourish.WPF.Framework/Flourish.WPF.Framework.csproj" />
    <PackageReference Include="Arkheide.Essential.Culture.Wpf" Version="$(EssentialCultureVersion)" />
  </ItemGroup>
</Project>
