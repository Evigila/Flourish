@namespace ArkheideSystem.Flourish.Blazor.Components

<button @attributes="AdditionalAttributes" type="@Type" class="f-button f-button-@Variant.ToString().ToLowerInvariant() @Class"
        disabled="@(Disabled || Busy)" aria-busy="@(Busy ? "true" : "false")" @onclick="ClickAsync">
    @if (Busy) { <span class="f-spinner" aria-hidden="true"></span> }
    @ChildContent
</button>

@code {
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private Task ClickAsync(MouseEventArgs args) => Disabled || Busy ? Task.CompletedTask : OnClick.InvokeAsync(args);
}
