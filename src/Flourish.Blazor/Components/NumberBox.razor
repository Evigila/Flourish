@namespace ArkheideSystem.Flourish.Blazor.Components
@using System.Globalization
@typeparam TValue
@inherits InputBase<TValue>
@implements IAsyncDisposable
@inject IJSRuntime JS

<input @ref="Element" @attributes="AdditionalAttributes" type="number" inputmode="decimal" id="@(Id ?? Field?.Id)" class="f-input @CssClass"
       value="@CurrentValueAsString" step="@Step" min="@Min" max="@Max" disabled="@Disabled" required="@InputSemantics.Required(Field, AdditionalAttributes)"
       aria-invalid="@InputSemantics.Invalid(EditContext, FieldIdentifier, Field, AdditionalAttributes)" aria-describedby="@Description" @oninput="Change" />

@code {
    private ElementReference Element;
    private IJSObjectReference? Module;
    private bool Disposed;
    [CascadingParameter] private FieldContext? Field { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Step { get; set; } = "any";
    [Parameter] public string? Min { get; set; }
    [Parameter] public string? Max { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string ParsingErrorMessage { get; set; } = "Enter a valid number.";
    private string? Description => InputSemantics.Description(Field, AdditionalAttributes);
    private void Change(ChangeEventArgs args) { if (!Disabled) CurrentValueAsString = args.Value?.ToString(); }
    protected override string? FormatValueAsString(TValue? value) => Convert.ToString(value, CultureInfo.InvariantCulture);
    protected override bool TryParseValueFromString(string? value, out TValue result, out string validationErrorMessage)
    {
        if (BindConverter.TryConvertTo<TValue>(value, CultureInfo.InvariantCulture, out var parsed))
        { result = parsed!; validationErrorMessage = ""; return true; }
        result = default!; validationErrorMessage = ParsingErrorMessage; return false;
    }
    protected override void OnParametersSet()
    {
        var type = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
        if (type != typeof(int) && type != typeof(long) && type != typeof(short) && type != typeof(decimal) && type != typeof(double) && type != typeof(float))
            throw new InvalidOperationException("NumberBox supports int, long, short, decimal, double and float, including their nullable forms.");
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Disposed) return;
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor/controls.js");
        if (Disposed) { await module.DisposeAsync(); return; }
        Module = module;
        await Module.InvokeVoidAsync("attachTextSelection", Element);
    }
    public async ValueTask DisposeAsync()
    {
        Disposed = true;
        ((IDisposable)this).Dispose();
        if (Module is null) return;
        try { await Module.InvokeVoidAsync("detachTextSelection", Element); await Module.DisposeAsync(); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }
}
