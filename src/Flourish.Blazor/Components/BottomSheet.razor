@namespace ArkheideSystem.Flourish.Blazor.Components

<Dialog Id="@Id" Title="@Title" IsOpen="@IsOpen" IsOpenChanged="@IsOpenChanged" Busy="@Busy" Class="@Class"
        Presentation="DialogPresentation.BottomSheet" CanClose="@CanClose" OnClose="@OnClose" CloseLabel="@CloseLabel" Actions="@Actions">
    @ChildContent
</Dialog>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string CloseLabel { get; set; } = "Close";
    [Parameter] public string? Class { get; set; }
    [Parameter] public Func<Task<bool>>? CanClose { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
