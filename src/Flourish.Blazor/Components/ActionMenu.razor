@namespace ArkheideSystem.Flourish.Blazor.Components
@implements IAsyncDisposable
@inject IJSRuntime JS

<span class="f-action-menu">
    <button @ref="Trigger" type="button" class="f-menu-trigger @(TriggerContent is not null ? "f-menu-trigger-label" : null)" aria-label="@Label" disabled="@(Disabled || Executing)"
            aria-haspopup="menu" aria-controls="@MenuId" aria-expanded="false" @onclick="ToggleAsync">
        @if (TriggerContent is not null) { @TriggerContent }
        else { <span aria-hidden="true">•••</span> }
    </button>
    <div @ref="Panel" id="@MenuId" class="f-menu-panel" role="menu" aria-label="@Label" popover="manual"
         aria-busy="@(Executing ? "true" : "false")">
        @for (var index = 0; index < Actions.Count; index++)
        {
            var actionIndex = index;
            var action = Actions[index];
            <button type="button" class="f-menu-item @(action.Destructive ? "f-menu-danger" : null)" role="menuitem"
                    disabled="@(Disabled || Executing || action.Disabled)" @onclick="() => ExecuteAsync(actionIndex)">@action.Text</button>
        }
    </div>
</span>

@code {
    private readonly string MenuId = "f-menu-" + Guid.NewGuid().ToString("N");
    private ElementReference Trigger;
    private ElementReference Panel;
    private IJSObjectReference? Module;
    private bool Executing;
    private bool Disposed;
    [Parameter] public string Label { get; set; } = "Record actions";
    [Parameter] public IReadOnlyList<MenuAction> Actions { get; set; } = Array.Empty<MenuAction>();
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? TriggerContent { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Disposed) return;
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor/controls.js");
        if (Disposed) { await module.DisposeAsync(); return; }
        Module = module;
        await Module.InvokeVoidAsync("attachMenu", Trigger, Panel);
    }
    private async Task ToggleAsync()
    {
        if (Disabled || Executing || Disposed || Module is null) return;
        await Module.InvokeVoidAsync("toggleMenu", Trigger, Panel);
    }
    private async Task ExecuteAsync(int index)
    {
        if (Disabled || Executing || Disposed || index < 0 || index >= Actions.Count) return;
        var action = Actions[index];
        if (action.Disabled) return;
        Executing = true;
        try
        {
            if (Module is not null) await Module.InvokeVoidAsync("closeMenu", Trigger, Panel, true);
            await action.OnClick();
        }
        finally { Executing = false; }
    }
    public async ValueTask DisposeAsync()
    {
        Disposed = true;
        if (Module is null) return;
        try { await Module.InvokeVoidAsync("detachMenu", Trigger, Panel); await Module.DisposeAsync(); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }
}
