@namespace ArkheideSystem.Flourish.Blazor.Components
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="Element" id="@Identifier" class="f-dialog @(Presentation == DialogPresentation.BottomSheet ? "f-bottom-sheet" : null) @Class"
        aria-labelledby="@(Identifier + "-title")" aria-modal="true" aria-busy="@(Busy || Closing ? "true" : "false")">
    <header class="f-dialog-header">
        <h2 id="@(Identifier + "-title")">@Title</h2>
        <button type="button" class="f-dialog-close" disabled="@(Busy || Closing)" aria-label="@CloseLabel" @onclick="RequestCloseAsync">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" /></svg>
        </button>
    </header>
    <div class="f-dialog-body" data-f-dialog-body>@ChildContent</div>
    @if (Actions is not null) { <footer class="f-dialog-actions">@Actions</footer> }
</dialog>

@code {
    private readonly string GeneratedId = "f-dialog-" + Guid.NewGuid().ToString("N");
    private string Identifier => Id ?? GeneratedId;
    private ElementReference Element;
    private IJSObjectReference? Module;
    private DotNetObjectReference<Dialog>? Reference;
    private bool Disposed;
    private bool Closing;
    [Parameter] public string? Id { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public DialogPresentation Presentation { get; set; }
    [Parameter] public string CloseLabel { get; set; } = "Close";
    [Parameter] public string? Class { get; set; }
    [Parameter] public Func<Task<bool>>? CanClose { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Disposed) return;
        if (Module is null)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor/controls.js");
            if (Disposed) { await module.DisposeAsync(); return; }
            Module = module;
        }
        Reference ??= DotNetObjectReference.Create(this);
        await Module.InvokeVoidAsync("synchronizeDialog", Element, IsOpen, Reference);
    }
    [JSInvokable]
    public async Task RequestCloseAsync()
    {
        if (Disposed || Busy || Closing || !IsOpen) return;
        Closing = true;
        try
        {
            if (CanClose is not null && !await CanClose()) return;
            if (Disposed || Busy) return;
            await IsOpenChanged.InvokeAsync(false);
            await OnClose.InvokeAsync();
        }
        finally { Closing = false; }
    }
    public async ValueTask DisposeAsync()
    {
        Disposed = true;
        try
        {
            if (Module is not null) { await Module.InvokeVoidAsync("detachDialog", Element); await Module.DisposeAsync(); }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
        finally { Reference?.Dispose(); }
    }
}
