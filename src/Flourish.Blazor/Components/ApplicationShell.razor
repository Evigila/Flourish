@using ArkheideSystem.Flourish.Blazor.Hosting
@implements IAsyncDisposable
@inject ApplicationOptions Options
@inject IAppearanceService Appearance
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div @ref="root" class="f-root f-shell f-theme-@Appearance.Current.Theme.ToString().ToLowerInvariant() @(!Options.TitleBar.Enabled ? "f-no-titlebar" : "") @(!Groups.Any() ? "f-no-navigation" : "")"
     style="@RootStyle" data-navigation-open="@navigationOpen.ToString().ToLowerInvariant()">
    <a class="f-skip-link" href="#@contentId">@SkipLabel</a>
    @if (Options.TitleBar.Enabled) {
        <header class="f-titlebar">
            @if (Options.TitleBar.NavigationToggle && Groups.Any()) {
                <button type="button" class="f-icon-button" aria-label="@MenuLabel" aria-expanded="@navigationOpen.ToString().ToLowerInvariant()" aria-controls="@navigationId" @onclick="ToggleNavigation"><Icon Name="menu" /></button>
            }
            <a class="f-application-title" href="@HomeHref">@(ApplicationTitle ?? Options.TitleBar.Title)</a>
            @if (Options.TitleBar.Search) {
                <form class="f-title-search" role="search" @onsubmit="SubmitSearch" @onsubmit:preventDefault>
                    <label class="f-sr-only" for="@searchId">@Options.TitleBar.SearchLabel</label>
                    <input id="@searchId" type="search" @bind="search" />
                    <button type="submit" class="f-icon-button" aria-label="@Options.TitleBar.SearchLabel"><Icon Name="search" /></button>
                </form>
            }
            <div class="f-titlebar-end">@TitleBarEnd</div>
        </header>
    }
    @if (Groups.Any()) {
        <aside id="@navigationId" class="f-navigation">
            <nav class="f-primary-navigation" aria-label="@MainNavigationLabel">
                @foreach (var group in Groups) {
                    var selected = group.Key == ActiveGroup?.Key;
                    var first = group.Items.FirstOrDefault(item => !item.Disabled);
                    <a class="f-primary-item @(selected ? "is-selected" : "")" href="@(first?.Href)" aria-current="@(selected ? "true" : null)" aria-disabled="@(first is null ? "true" : null)" aria-label="@group.Label"
                       aria-describedby="@(navigationId + "-" + group.Key)" tabindex="@(first is null ? -1 : 0)" @onclick="CloseNavigation">
                        <Icon Name="@group.Icon" /><span id="@(navigationId + "-" + group.Key)" class="f-nav-tooltip" role="tooltip">@group.Label</span>
                    </a>
                }
            </nav>
            @if (ActiveGroup is { } active) {
                <nav class="f-secondary-navigation" aria-label="@SecondaryNavigationLabel">
                    <div class="f-navigation-heading">@active.Label</div>
                    @foreach (var item in active.Items) {
                        <a href="@(item.Disabled ? null : item.Href)" class="f-secondary-item @(Matches(item) ? "is-selected" : "")" aria-current="@(Matches(item) ? "page" : null)"
                           aria-disabled="@(item.Disabled ? "true" : null)" tabindex="@(item.Disabled ? -1 : 0)" @onclick="CloseNavigation"><Icon Name="@item.Icon" /><span>@item.Label</span></a>
                    }
                </nav>
            }
        </aside>
        <button class="f-navigation-backdrop" type="button" aria-label="@CloseMenuLabel" tabindex="@(navigationOpen ? 0 : -1)" @onclick="CloseNavigation"></button>
    }
    <main id="@contentId" class="f-content-scroll" tabindex="-1" @ref="content">
        @ChildContent
    </main>
</div>
@code {
    [Parameter] public IReadOnlyList<NavigationGroup>? NavigationGroups { get; set; }
    [Parameter] public string? ApplicationTitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? TitleBarEnd { get; set; }
    [Parameter] public EventCallback<string> OnSearch { get; set; }
    [Parameter] public string HomeHref { get; set; } = "/";
    [Parameter] public string SkipLabel { get; set; } = "Skip to content";
    [Parameter] public string MenuLabel { get; set; } = "Open navigation";
    [Parameter] public string CloseMenuLabel { get; set; } = "Close navigation";
    [Parameter] public string MainNavigationLabel { get; set; } = "Main navigation";
    [Parameter] public string SecondaryNavigationLabel { get; set; } = "Secondary navigation";
    private readonly string contentId = "content-" + Guid.NewGuid().ToString("N");
    private readonly string navigationId = "nav-" + Guid.NewGuid().ToString("N");
    private readonly string searchId = "search-" + Guid.NewGuid().ToString("N");
    private ElementReference root, content;
    private IJSObjectReference? module;
    private bool disposed, navigationOpen, resetScroll, navigationChanged;
    private string search = string.Empty;
    private IReadOnlyList<NavigationGroup>? previousGroups;
    private IReadOnlyList<NavigationGroup> Groups => NavigationGroups ?? Options.Navigation;
    protected override void OnParametersSet() { if (!ReferenceEquals(previousGroups, Groups)) { previousGroups = Groups; navigationChanged = true; } }
    private string Path => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
    private bool Matches(NavigationItem item) => !item.Disabled && (string.Equals(Path, item.Href.TrimEnd('/') is "" ? "/" : item.Href.TrimEnd('/'), StringComparison.OrdinalIgnoreCase)
        || (!item.Exact && item.Href != "/" && Path.StartsWith(item.Href.TrimEnd('/') + "/", StringComparison.OrdinalIgnoreCase)));
    private NavigationGroup? ActiveGroup => Groups.SelectMany(group => group.Items.Where(Matches).Select(item => (group, item)))
        .OrderByDescending(match => match.item.Href.Length).Select(match => match.group).FirstOrDefault() ?? Groups.FirstOrDefault();
    private string RootStyle => AppearancePalette.Create(Appearance.Current.Primary, Appearance.Current.Accent).CssVariables
        + $";--f-font:{Appearance.Current.FontFamily};--f-content-width:{Options.Layout.ContentWidth}px";
    protected override void OnInitialized() { Appearance.Changed += AppearanceChanged; Navigation.LocationChanged += LocationChanged; }
    private void AppearanceChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);
    private void LocationChanged(object? sender, LocationChangedEventArgs e) { navigationOpen = false; resetScroll = true; _ = InvokeAsync(StateHasChanged); }
    private void ToggleNavigation() => navigationOpen = !navigationOpen;
    private void CloseNavigation() => navigationOpen = false;
    private Task SubmitSearch() => OnSearch.InvokeAsync(search);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        if (module is null) {
            var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor/shell.js");
            if (disposed) { await imported.DisposeAsync(); return; }
            module = imported;
            navigationChanged = true;
        }
        if (navigationChanged) { await module.InvokeVoidAsync("attach", root, content); navigationChanged = false; }
        await module.InvokeVoidAsync("synchronize", root, navigationOpen, resetScroll);
        resetScroll = false;
    }
    public async ValueTask DisposeAsync()
    {
        disposed = true; Appearance.Changed -= AppearanceChanged; Navigation.LocationChanged -= LocationChanged;
        try { if (module is not null) { await module.InvokeVoidAsync("detach", root); await module.DisposeAsync(); } }
        catch (JSDisconnectedException) { }
    }
}