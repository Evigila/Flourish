@namespace ArkheideSystem.Flourish.Blazor.Components

<div @attributes="AdditionalAttributes" class="f-uniform-cell f-uniform-grid-item @(Information ? "f-uniform-information" : null) @(SupportsIcon ? "f-uniform-icon-support" : null) @VariantClass @Class">@Contents</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public bool? IconSupport { get; set; }
    [CascadingParameter(Name = "UniformGridIconSupport")] private bool? InheritedIconSupport { get; set; }
    [Parameter] public string Text { get; set; } = string.Empty;
    /// <summary>Displays one read-only field: Title is its body-sized label; Text or ChildContent is its H1-sized value. ChildContent takes precedence. Information cells grow naturally without icon tracks or fixed-height clipping.</summary>
    [Parameter] public bool Information { get; set; }
    [Parameter] public UniformGridVariant? Variant { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private bool SupportsIcon => !Information && (IconSupport ?? InheritedIconSupport ?? !string.IsNullOrWhiteSpace(Icon));
    private RenderFragment Contents => Information ? Internal.UniformGridContent.Information(Title, Text, ChildContent)
        : Internal.UniformGridContent.Create(Title, Icon, Text, ChildContent, SupportsIcon);
    private string? VariantClass => Variant switch
    {
        null => null,
        UniformGridVariant.Elevated => "f-uniform-variant-elevated",
        UniformGridVariant.FilledElevated => "f-uniform-variant-filled-elevated",
        UniformGridVariant.Danger => "f-uniform-variant-danger",
        _ => throw new ArgumentOutOfRangeException(nameof(Variant))
    };
}
