@namespace ArkheideSystem.Flourish.Blazor.Components
<section class="@($"f-presentation-band f-presentation-{Tone.ToString().ToLowerInvariant()} {Class}".Trim())" aria-labelledby="@(string.IsNullOrWhiteSpace(Title) ? null : TitleId)" @attributes="AdditionalAttributes">
    <ContentContainer>
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <header class="f-presentation-band-heading">@Heading@if (Actions is not null) { <div class="f-inline-actions">@Actions</div> }</header>
        }
        else if (Actions is not null) { <div class="f-inline-actions">@Actions</div> }
        @ChildContent
    </ContentContainer>
</section>
@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string TitleId { get; set; } = $"presentation-band-{Guid.NewGuid():N}";
    [Parameter] public PresentationTone Tone { get; set; }
    [Parameter] public int HeadingLevel { get; set; } = 2;
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    protected override void OnParametersSet() {
        if (!Enum.IsDefined(Tone)) throw new ArgumentOutOfRangeException(nameof(Tone));
        if (HeadingLevel is < 1 or > 6) throw new ArgumentOutOfRangeException(nameof(HeadingLevel));
    }
    private RenderFragment Heading => builder => {
        builder.OpenElement(0, $"h{HeadingLevel}");
        builder.AddAttribute(1, "id", TitleId);
        builder.AddContent(2, Title);
        builder.CloseElement();
    };
}
