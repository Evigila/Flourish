@namespace ArkheideSystem.Flourish.Blazor.Components.Patterns
@inherits TextComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ArkheideSystem.Flourish.Blazor.Hosting.ApplicationOptions Options

<div @ref="root" class="navigation-surface @Class" style="@RootStyle">
    <a class="skip-link" href="#@ContentId">@EffectiveSkipLabel</a>
    @TitleBar
    <div class="app-body @(ShowSecondary && SecondaryNavigation is not null ? "has-secondary-navigation" : null)">
        @if (PrimaryNavigation is not null) {
            <aside class="primary-rail"><nav aria-label="@EffectivePrimaryLabel">@PrimaryNavigation</nav></aside>
        }
        @if (ShowSecondary && SecondaryNavigation is not null) {
            <aside class="secondary-rail"><nav aria-label="@EffectiveSecondaryLabel">@SecondaryNavigation</nav></aside>
        }
        <main @ref="stage" @key="DocumentKey" class="application-stage @ContentClass" id="@ContentId" tabindex="-1">@ChildContent</main>
        <SectionNavigator @key="(DocumentKey, nameof(SectionNavigator))" ContentId="@ContentId" />
        <BackToTop @key="(DocumentKey, nameof(BackToTop))" ContentId="@ContentId" Label="@EffectiveTopLabel" />
    </div>
</div>
@code {
    private string EffectiveSkipLabel => DefaultText(nameof(SkipLabel), SkipLabel, "Shell_Skip", "Skip to content");
    [Parameter] public RenderFragment? TitleBar { get; set; }
    [Parameter] public RenderFragment? PrimaryNavigation { get; set; }
    [Parameter] public bool ShowSecondary { get; set; } = true;
    [Parameter] public RenderFragment? SecondaryNavigation { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? ContentClass { get; set; }
    [Parameter] public string? Style { get; set; }
    /// <summary>Scales each centered PageBody side gutter within this shell. Zero through one; one preserves the standard layout.</summary>
    [Parameter] public double CenteredContentGutterScale { get; set; } = 1;
    [Parameter] public object? DocumentKey { get; set; }
    [Parameter] public string ContentId { get; set; } = "application-content";
    [Parameter] public string SkipLabel { get; set; } = "Skip to content";
    [Parameter] public string PrimaryLabel { get; set; } = "Modules";
    [Parameter] public string SecondaryLabel { get; set; } = "Pages";
    [Parameter] public string TopLabel { get; set; } = "Back to top";
    private string EffectivePrimaryLabel => DefaultText(nameof(PrimaryLabel), PrimaryLabel, "Shell_Modules", "Modules");
    private string EffectiveSecondaryLabel => DefaultText(nameof(SecondaryLabel), SecondaryLabel, "Shell_Pages", "Pages");
    private string EffectiveTopLabel => DefaultText(nameof(TopLabel), TopLabel, "Shell_Top", "Back to top");
    private ElementReference root, stage;
    private IJSObjectReference? module;
    private Task<IJSObjectReference?>? moduleLoading;
    private bool disposed;
    private string RootStyle => $"{Style};--f-content-width:{Options.Layout.ContentWidth}px;--f-centered-gutter-scale:{CenteredContentGutterScale.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!double.IsFinite(CenteredContentGutterScale) || CenteredContentGutterScale is < 0 or > 1)
            throw new ArgumentOutOfRangeException(nameof(CenteredContentGutterScale));
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (disposed) return;
        try {
            var activeModule = await GetModuleAsync();
            if (disposed || activeModule is null) return;
            await activeModule.InvokeVoidAsync("synchronize", root, stage);
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }
    private async Task<IJSObjectReference?> GetModuleAsync() {
        if (module is not null) return module;
        var loading = moduleLoading ??= ImportModuleAsync();
        try { return await loading; }
        finally { if (ReferenceEquals(moduleLoading, loading)) moduleLoading = null; }
    }
    private async Task<IJSObjectReference?> ImportModuleAsync() {
        var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor.Framework/patterns/surfaces.js");
        if (disposed) { await ReleaseModuleAsync(imported); return null; }
        module = imported;
        return imported;
    }
    private static async ValueTask ReleaseModuleAsync(IJSObjectReference activeModule) {
        try { await activeModule.DisposeAsync(); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }
    public async ValueTask DisposeAsync() {
        if (disposed) return;
        disposed = true;
        base.Dispose();
        var activeModule = module;
        module = null;
        if (activeModule is null) return;
        try { await activeModule.InvokeVoidAsync("dispose", root); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
        finally { await ReleaseModuleAsync(activeModule); }
    }
}
