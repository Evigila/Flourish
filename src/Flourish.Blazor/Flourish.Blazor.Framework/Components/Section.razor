<section @attributes="AdditionalAttributes" id="@Id" class="f-section @Class" aria-labelledby="@LabelledBy">
    @if (!string.IsNullOrEmpty(Title)) {
        <header class="f-section-heading"><h2 id="@HeadingId">@Title</h2>@if (Actions is not null) { <div class="f-heading-actions">@Actions</div> }</header>
    }
    @ChildContent
</section>
@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? TitleId { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private string? HeadingId => TitleId ?? (string.IsNullOrEmpty(Id) ? null : Id + "-title");
    private string? LabelledBy => AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("aria-labelledby", out var value) ? value?.ToString()
        : string.IsNullOrEmpty(Title) ? null : HeadingId;
}
