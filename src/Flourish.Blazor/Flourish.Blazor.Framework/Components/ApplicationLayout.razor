@inherits LayoutComponentBase
@using ArkheideSystem.Flourish.Blazor.Hosting
@inject ApplicationOptions Options
@inject IServiceProvider Services

<HeadContent>
    <link rel="icon" href="@Options.Project.BrowserIconPath" />
    <link rel="stylesheet" href="_content/Arkheide.Flourish.Blazor.Framework/framework.css" />
    @if (Theme is not null)
    {
        <link rel="stylesheet" href="@Theme.StylesheetHref" />
    }
</HeadContent>
<ApplicationShell OwnsDocument="OwnsDocument">@Body</ApplicationShell>

@code {
    /// <summary>Owns the viewport and leaves scrolling to the shell's content track. Disable for embedded demonstrations.</summary>
    [Parameter] public bool OwnsDocument { get; set; } = true;
    private IThemeProvider? Theme => Services.GetService(typeof(IThemeProvider)) as IThemeProvider;
}
