@namespace ArkheideSystem.Flourish.Blazor.Components

<div @attributes="AdditionalAttributes" class="f-uniform-grid @(Filled ? "f-uniform-filled" : null) @Class"
     style="--f-grid-columns:@Columns;--f-grid-narrow-columns:@(NarrowColumns ?? Columns)">@ChildContent</div>

@code {
    [Parameter] public int Columns { get; set; } = 3;
    [Parameter] public int? NarrowColumns { get; set; }
    [Parameter] public bool Filled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    protected override void OnParametersSet()
    {
        if (Columns is < 1 or > 5 || NarrowColumns is < 1 or > 5) throw new ArgumentOutOfRangeException(nameof(Columns));
    }
}
