@namespace ArkheideSystem.Flourish.Blazor.Components

<div @attributes="AdditionalAttributes" id="@Id" class="f-navigation-choices @(Compact ? "f-navigation-choices-compact" : null) @Class">
    <nav class="f-navigation-choices-nav" aria-label="@Label">
        @if (Compact)
        {
            <div class="f-navigation-choices-links" style="@($"--f-choice-columns:{Items.Count}")">
                @foreach (var choice in Items)
                {
                    <Button @key="choice.Key" id="@ChoiceId(choice)" Href="@choice.Href" Disabled="@choice.Disabled"
                            Variant="@(IsActive(choice) ? ActiveVariant : Variant)"
                            aria-current="@(IsActive(choice) ? "page" : null)" data-enhance-nav="false">@choice.Label</Button>
                }
            </div>
        }
        else
        {
        <UniformGrid Columns="@Items.Count" NarrowColumns="1" IconSupport="false">
            @foreach (var choice in Items)
            {
                <UniformGridButton @key="choice.Key" id="@ChoiceId(choice)" Href="@choice.Href" Disabled="@choice.Disabled"
                    Variant="@(IsActive(choice) ? UniformGridVariant.Filled : UniformGridVariant.Outlined)"
                    aria-current="@(IsActive(choice) ? "page" : null)" data-enhance-nav="false">@choice.Label</UniformGridButton>
            }
        </UniformGrid>
        }
    </nav>
    @foreach (var choice in Items)
    {
        <section @key="choice.Key" id="@PanelId(choice)" class="f-navigation-choice-panel"
            aria-label="@choice.Label" hidden="@(!IsActive(choice))">
            @ChildContent(choice)
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<NavigationChoiceItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public string ActiveKey { get; set; } = string.Empty;
    [Parameter, EditorRequired] public RenderFragment<NavigationChoiceItem> ChildContent { get; set; } = default!;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Quiet;
    [Parameter] public ButtonVariant ActiveVariant { get; set; } = ButtonVariant.Secondary;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsActive(NavigationChoiceItem choice) => string.Equals(choice.Key, ActiveKey, StringComparison.Ordinal);
    private string ChoiceId(NavigationChoiceItem choice) => $"{Id}-{choice.Key}-choice";
    private string PanelId(NavigationChoiceItem choice) => $"{Id}-{choice.Key}-panel";
    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(Variant)) throw new ArgumentOutOfRangeException(nameof(Variant));
        if (!Enum.IsDefined(ActiveVariant)) throw new ArgumentOutOfRangeException(nameof(ActiveVariant));
        if (!IsIdentifier(Id)) throw new ArgumentException("Provide a stable navigation choice identifier using letters, digits, underscores or hyphens.", nameof(Id));
        ArgumentException.ThrowIfNullOrWhiteSpace(Label);
        ArgumentNullException.ThrowIfNull(Items);
        ArgumentNullException.ThrowIfNull(ChildContent);
        if (Items.Count == 0) throw new ArgumentException("Provide at least one navigation choice.", nameof(Items));
        var keys = new HashSet<string>(StringComparer.Ordinal);
        foreach (var choice in Items)
        {
            if (choice is null || !IsIdentifier(choice.Key) || !keys.Add(choice.Key)
                || string.IsNullOrWhiteSpace(choice.Label) || !IsLocalDestination(choice.Href))
                throw new ArgumentException("Choices need distinct stable keys, visible labels and root-relative same-site destinations.", nameof(Items));
        }
        if (!Items.Any(choice => IsActive(choice) && !choice.Disabled))
            throw new ArgumentException("The active key must identify one available navigation choice.", nameof(ActiveKey));
    }
    private static bool IsIdentifier(string? value) => !string.IsNullOrWhiteSpace(value)
        && value.All(character => char.IsAsciiLetterOrDigit(character) || character is '_' or '-');
    private static bool IsLocalDestination(string? value) => !string.IsNullOrWhiteSpace(value)
        && value.StartsWith('/') && !value.StartsWith("//", StringComparison.Ordinal)
        && !value.Any(character => char.IsControl(character) || character is '\\' || char.IsWhiteSpace(character));
}
