@namespace ArkheideSystem.Flourish.Blazor.Components
@using System.Globalization
@typeparam TValue
@inherits TextInputBase<TValue>

<select @attributes="AdditionalAttributes" name="@NameAttributeValue" id="@(Id ?? Field?.Id)" class="f-input f-select@(CustomizedTrigger ? " f-select-customized" : null) @CssClass" value="@CurrentValueAsString"
        disabled="@Disabled" required="@InputSemantics.Required(Field, AdditionalAttributes)" aria-invalid="@InputSemantics.Invalid(EditContext, FieldIdentifier, Field, AdditionalAttributes)" aria-describedby="@Description" @onchange="Change">
    @if (CustomizedTrigger)
    {
        <button type="button" class="@TriggerClass" disabled="@Disabled">
            @if (!string.IsNullOrWhiteSpace(Icon)) { <Icon Name="@Icon" /> }
            else { <selectedcontent></selectedcontent> }
        </button>
    }
    @if (ChildContent is not null) { @ChildContent }
    else
    {
        @foreach (var option in Options)
        {
            <option value="@Internal.SelectValueConversion.Format(option.Value, Texts.FormatCulture)" disabled="@option.Disabled">@option.Text</option>
        }
    }
</select>

@code {
    [CascadingParameter] private FieldContext? Field { get; set; }
    private string? Description => InputSemantics.Description(Field, AdditionalAttributes);
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Displays a decorative icon in the native select trigger where customizable selects are supported.</summary>
    [Parameter] public string? Icon { get; set; }
    /// <summary>Uses a standard button appearance for the native select trigger; unsupported browsers retain the text selector.</summary>
    [Parameter] public ButtonVariant? TriggerVariant { get; set; }
    private bool CustomizedTrigger => !string.IsNullOrWhiteSpace(Icon) || TriggerVariant is not null;
    private string TriggerClass => $"f-select-trigger {(TriggerVariant is { } variant ? $"f-button f-button-{variant.ToString().ToLowerInvariant()}" : null)} {(!string.IsNullOrWhiteSpace(Icon) ? "f-button-icon" : null)}";

    [Parameter] public IReadOnlyList<SelectOption<TValue>> Options { get; set; } = Array.Empty<SelectOption<TValue>>();
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string ParsingErrorMessage { get; set; } = "Select a valid option.";
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (TriggerVariant is { } variant && !Enum.IsDefined(variant)) throw new ArgumentOutOfRangeException(nameof(TriggerVariant));
    }
    private void Change(ChangeEventArgs args) { if (!Disabled) CurrentValueAsString = args.Value?.ToString(); }
    protected override string? FormatValueAsString(TValue? value) => Internal.SelectValueConversion.Format(value, Texts.FormatCulture);
    protected override bool TryParseValueFromString(string? value, out TValue result, out string validationErrorMessage)
    {
        if (Internal.SelectValueConversion.TryParse<TValue>(value, Texts.FormatCulture, out var parsed))
        { result = parsed!; validationErrorMessage = ""; return true; }
        result = default!; validationErrorMessage = DefaultText(nameof(ParsingErrorMessage), ParsingErrorMessage, "Input_SelectError", "Select a valid option."); return false;
    }
}
