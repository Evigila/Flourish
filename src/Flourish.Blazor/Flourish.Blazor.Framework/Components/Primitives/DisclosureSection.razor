@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives

<details class="disclosure-section @Class" open="@InitiallyOpen">
    <summary><ToggleIndicator /><span>@Label</span></summary>
    <div class="disclosure-section-content">@ChildContent</div>
</details>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool InitiallyOpen { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
}
