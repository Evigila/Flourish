@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
<header class="page-heading">
    <div><h1>@Title</h1></div>
    @Actions
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
