@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
@inherits TextComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

<span class="row-action-menu">
    <button @ref="Trigger"
            id="@TriggerId"
            class="row-action-menu-trigger"
            type="button"
            aria-label="@EffectiveLabel"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="@MenuId"
            @onclick="ToggleAsync">•••</button>
    <div @ref="Menu"
         id="@MenuId"
         class="row-action-menu-panel"
         role="menu"
         aria-labelledby="@TriggerId"
         popover="manual">
        @ChildContent
    </div>
</span>

@code {
    private string EffectiveLabel => DefaultText(nameof(Label), Label, "Menu_RecordActions", "Record actions");
    private readonly string Id = $"row-actions-{Guid.NewGuid():N}";
    private ElementReference Trigger;
    private ElementReference Menu;
    private IJSObjectReference? Module;
    private Task<IJSObjectReference?>? ModuleLoading;
    private bool Disposed;
    private string TriggerId => $"{Id}-trigger";
    private string MenuId => $"{Id}-menu";

    [Parameter]
    public string Label { get; set; } = "Record actions";

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    private async Task ToggleAsync()
    {
        if (Disposed) return;
        try
        {
            var activeModule = await GetModuleAsync();
            if (Disposed || activeModule is null) return;
            await activeModule.InvokeVoidAsync("toggle", Trigger, Menu);
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }

    private async Task<IJSObjectReference?> GetModuleAsync()
    {
        if (Module is not null) return Module;
        var loading = ModuleLoading ??= ImportModuleAsync();
        try { return await loading; }
        finally { if (ReferenceEquals(ModuleLoading, loading)) ModuleLoading = null; }
    }

    private async Task<IJSObjectReference?> ImportModuleAsync()
    {
        var imported = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Arkheide.Flourish.Blazor.Framework/primitives/row-action-menu.js");
        if (Disposed) { await ReleaseModuleAsync(imported); return null; }
        Module = imported;
        return imported;
    }

    private static async ValueTask ReleaseModuleAsync(IJSObjectReference activeModule)
    {
        try { await activeModule.DisposeAsync(); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (Disposed) return;
        Disposed = true;
        base.Dispose();
        var activeModule = Module;
        Module = null;
        if (activeModule is null) return;
        try
        {
            await activeModule.InvokeVoidAsync("dispose", Trigger, Menu);
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException)
        {
            // The document already closed its top-layer popovers.
        }
        finally { await ReleaseModuleAsync(activeModule); }
    }
}
