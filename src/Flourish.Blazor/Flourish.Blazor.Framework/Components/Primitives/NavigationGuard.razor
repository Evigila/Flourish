@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
@inherits TextComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation


<Dialog @ref="Decision" Title="@Ui("Confirmation_Title", "Confirm action")">
    <ChildContent><p>@EffectiveMessage</p></ChildContent>
    <Actions>
        <InlineActions>
            <Button Variant="ButtonVariant.Quiet" OnClick="() => Decision!.CloseAsync()">@Ui("Confirmation_Cancel", "Cancel")</Button>
            <Button OnClick="() => Decision!.CloseAsync(true)">@Ui("Confirmation_Accept", "Confirm")</Button>
        </InlineActions>
    </Actions>
</Dialog>
@code {
    private Dialog? Decision;
    private string EffectiveMessage => DefaultText(nameof(Message), Message, "Navigation_Unsaved", "There are unsaved changes. Leave and discard them?");
    [Parameter]
    public bool HasUnsavedChanges { get; set; }

    [Parameter]
    public string Message { get; set; } = "There are unsaved changes. Leave and discard them?";

    private IDisposable? LocationChangingRegistration;
    private IJSObjectReference? Module;
    private string? ApprovedDestination;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                LocationChangingRegistration = Navigation.RegisterLocationChangingHandler(ConfirmInternalNavigationAsync);
            }
            catch (NotSupportedException)
            {
                // Static HTML rendering has no interactive navigation lifecycle to protect.
            }
        }

        try
        {
            await (await GetModuleAsync()).InvokeVoidAsync("setUnsavedChanges", HasUnsavedChanges);
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException)
        {
            // The page is already leaving, so the browser owns the remaining lifecycle.
        }
    }

    public async Task NavigateToAsync(string destination, bool forceLoad = false, bool replace = false)
    {
        ApprovedDestination = Normalize(destination);
        if (forceLoad)
            await (await GetModuleAsync()).InvokeVoidAsync("allowNextExternalNavigation");

        Navigation.NavigateTo(destination, forceLoad, replace);
    }

    private async ValueTask<IJSObjectReference> GetModuleAsync() =>
        Module ??= await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Arkheide.Flourish.Blazor.Framework/primitives/navigation-guard.js");

    private async ValueTask ConfirmInternalNavigationAsync(LocationChangingContext context)
    {
        var target = Normalize(context.TargetLocation);
        if (string.Equals(ApprovedDestination, target, StringComparison.OrdinalIgnoreCase))
        {
            ApprovedDestination = null;
            return;
        }

        if (!HasUnsavedChanges || IsCurrentLocation(target))
            return;

        if (Decision is null || Decision.HasPendingResult)
        {
            context.PreventNavigation();
            return;
        }
        var result = await Decision.ShowAsync(context.CancellationToken);
        if (result is not true || context.CancellationToken.IsCancellationRequested)
            context.PreventNavigation();
    }

    private bool IsCurrentLocation(string target) =>
        string.Equals(WithoutFragment(Normalize(Navigation.Uri)), WithoutFragment(target),
            StringComparison.OrdinalIgnoreCase);

    private static string WithoutFragment(string location)
    {
        var fragmentStart = location.IndexOf('#', StringComparison.Ordinal);
        return fragmentStart < 0 ? location : location[..fragmentStart];
    }

    private string Normalize(string destination)
    {
        var absolute = Navigation.ToAbsoluteUri(destination);
        return absolute.GetLeftPart(UriPartial.Path) + absolute.Query + absolute.Fragment;
    }

    public async ValueTask DisposeAsync()
    {
        base.Dispose();
        LocationChangingRegistration?.Dispose();
        if (Module is null) return;

        try
        {
            await Module.InvokeVoidAsync("dispose");
            await Module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser already released the external-navigation listener.
        }
    }
}
