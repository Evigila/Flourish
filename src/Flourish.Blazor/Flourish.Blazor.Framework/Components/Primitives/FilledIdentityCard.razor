@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives

<div class="filled-card filled-identity-card @Class" @attributes="AdditionalAttributes">
    <div class="identity-card-layout @(SideFacts.Count > 0 ? "identity-card-with-sidebar" : null)">
        <dl class="identity-card-facts @(Columns ? "identity-card-facts-columns" : null)">
            @foreach (var fact in Facts)
            {
                <div>
                    <dt>@fact.Label</dt>
                    <dd id="@fact.ValueId" class="@(fact.IsPrimary ? "identity-card-primary-value" : null) @(fact.IsIdentifier ? "identifier" : null)">@fact.Value</dd>
                </div>
            }
        </dl>
        @if (SideFacts.Count > 0)
        {
            <dl class="identity-card-facts">
                @foreach (var fact in SideFacts)
                {
                    <div>
                        <dt>@fact.Label</dt>
                        <dd id="@fact.ValueId" class="@(fact.IsPrimary ? "identity-card-primary-value" : null) @(fact.IsIdentifier ? "identifier" : null)">@fact.Value</dd>
                    </div>
                }
            </dl>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<IdentityFact> Facts { get; set; } = [];
    [Parameter] public IReadOnlyList<IdentityFact> SideFacts { get; set; } = [];
    [Parameter] public bool Columns { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
