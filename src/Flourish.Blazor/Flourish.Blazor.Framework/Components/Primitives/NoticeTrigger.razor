@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
<span class="notice-trigger @NoticePresentation.CssClass(Severity)">
    <button class="notice-trigger-button" type="button" aria-describedby="@DescriptionId">@Label</button>
    <span id="@DescriptionId" class="notice-trigger-content" role="note">@ChildContent</span>
</span>

@code {
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter, EditorRequired]
    public NoticeSeverity Severity { get; set; } = NoticeSeverity.Warning;

    private readonly string DescriptionId = $"notice-trigger-{Guid.NewGuid():N}";
    private string Label => Severity switch
    {
        NoticeSeverity.Error => "ERRO",
        NoticeSeverity.Warning => "AVISO",
        NoticeSeverity.Success => "SUCESSO",
        NoticeSeverity.Information or NoticeSeverity.Subtle => "INFO",
        _ => "INFO"
    };
}
