@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
@using ArkheideSystem.Flourish.Abstract
@inherits TextComponentBase
<span class="notice-trigger @NoticePresentation.CssClass(Severity, Subtle)">
    <button class="notice-trigger-button" type="button" aria-label="@Label" aria-describedby="@DescriptionId">
        <svg class="notice-trigger-glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            @if (Severity == NotificationSeverity.Error)
            {
                <path d="M6 6 18 18 M18 6 6 18" />
            }
            else if (Severity == NotificationSeverity.Success)
            {
                <path d="m4 12 5 5 11-11" />
            }
            else
            {
                <path d="M12 4v10" />
                <circle cx="12" cy="19" r="1.5" fill="currentColor" stroke="none" />
            }
        </svg>
    </button>
    <span id="@DescriptionId" class="notice-trigger-content" role="note">@ChildContent</span>
</span>

@code {
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter, EditorRequired]
    public NotificationSeverity Severity { get; set; } = NotificationSeverity.Warning;

    [Parameter] public bool Subtle { get; set; }

    private readonly string DescriptionId = $"notice-trigger-{Guid.NewGuid():N}";
    private string Label => Severity switch
    {
        NotificationSeverity.Error => Ui("Notice_Error", "Error"),
        NotificationSeverity.Warning => Ui("Notice_Warning", "Warning"),
        NotificationSeverity.Success => Ui("Notice_Success", "Success"),
        NotificationSeverity.Information => Ui("Notice_Information", "Information"),
        _ => Ui("Notice_Information", "Information")
    };
}
