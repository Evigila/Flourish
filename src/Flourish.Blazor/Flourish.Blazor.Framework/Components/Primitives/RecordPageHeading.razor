@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
<header class="page-heading record-page-heading" data-heading-mode="@(Compact ? "compact" : null)">
    <div class="record-heading-copy">
        <a class="record-parent-link" href="@ParentHref" aria-label="@($"Voltar para {ParentLabel}")">
            <span aria-hidden="true">←</span>
            <span>@ParentLabel</span>
        </a>
        <h1>@Title</h1>
    </div>
    @if (Actions is not null)
    {
        <div class="record-page-actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ParentLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ParentHref { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public bool Compact { get; set; }
}
