@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
@if (Banner)
{
    <main class="f-access-document">
        <ArkheideSystem.Flourish.Blazor.Components.PresentationBand FullHeight="true" Dotted="Dotted" Tone="@(Emphasized ? ArkheideSystem.Flourish.Blazor.Components.PresentationTone.Surface : ArkheideSystem.Flourish.Blazor.Components.PresentationTone.Canvas)">
            @ChildContent
        </ArkheideSystem.Flourish.Blazor.Components.PresentationBand>
    </main>
}
else
{
    <main class="access-surface @(Emphasized ? "themed-access-surface" : null)">@ChildContent</main>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Emphasized { get; set; }
    [Parameter] public bool Banner { get; set; }
    [Parameter] public bool Dotted { get; set; }
}
