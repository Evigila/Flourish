@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
<svg class="shell-glyph"
     viewBox="0 0 24 24"
     role="presentation"
     aria-hidden="true"
     focusable="false">
    @switch (Name)
    {
        case "user":
            <circle cx="12" cy="7" r="4" />
            <path d="M4 21v-2a8 8 0 0 1 16 0v2H4Z" />
            break;
        case "logout":
            <path d="M10 4H5v16h5" />
            <path d="m14 8 4 4-4 4M8 12h10" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;
}
