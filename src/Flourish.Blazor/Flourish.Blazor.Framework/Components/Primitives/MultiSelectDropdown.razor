@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
@typeparam TItem
@typeparam TValue where TValue : notnull

<SelectionDropdownSurface>
<div class="multi-select-dropdown" @onkeydown="HandleKeyDownAsync">
    <button @ref="Trigger" id="@(Id + "-trigger")" class="multi-select-trigger selection-trigger" type="button"
            aria-expanded="@(IsOpen ? "true" : "false")" aria-controls="@(Id + "-options")" aria-labelledby="@TriggerLabelledBy"
            disabled="@Disabled" @onclick="Toggle">
        <span title="@SelectionText">@SelectionText</span>
        <ExpansionIndicator Expanded="IsOpen" Class="multi-select-chevron selection-chevron" />
    </button>
    @if (IsOpen)
    {
        <div id="@(Id + "-options")" class="multi-select-options selection-panel" role="group" aria-labelledby="@LabelledBy">
            <div class="selection-panel-width" aria-hidden="true">
                @foreach (var item in Items) { <span class="selection-option">@TextSelector(item)</span> }
            </div>
            @if (CreateRequested is not null)
            {
                <input class="multi-select-search selection-search" type="search" form="@(Id + "-popup-search")"
                       value="@Search" maxlength="@NewItemMaximumLength" autocomplete="off"
                       aria-label="Buscar ou adicionar etiqueta" disabled="@Creating"
                       @oninput="SearchChanged" @oninput:stopPropagation @onkeydown="HandleSearchKeyDownAsync" />
            }
            @if (MatchingItems.Count == 0)
            {
                <p>@(string.IsNullOrWhiteSpace(Search) ? EmptyText : "Nenhuma etiqueta encontrada.")</p>
            }
            @foreach (var item in MatchingItems)
            {
                var value = ValueSelector(item);
                var selected = SelectedValues.Contains(value);
                <label class="form-check selection-option">
                    <input type="checkbox" checked="@selected"
                           disabled="@(!selected && SelectedValues.Count >= MaximumSelections)"
                           @onchange="args => ChangeAsync(value, args)" />
                    <span>@TextSelector(item)</span>
                </label>
            }
            @if (CanCreate)
            {
                <button type="button" class="multi-select-create selection-create" disabled="@(Creating || SelectedValues.Count >= MaximumSelections)"
                        @onclick="CreateAsync">@(Creating ? "Adicionando..." : $"Adicionar \"{Search.Trim()}\"")</button>
            }
        </div>
    }
</div>

</SelectionDropdownSurface>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlySet<TValue> SelectedValues { get; set; } = new HashSet<TValue>();

    [Parameter, EditorRequired]
    public Func<TItem, TValue> ValueSelector { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<TItem, string> TextSelector { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<TValue> SelectionChanged { get; set; }

    [Parameter]
    public string? LabelledBy { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = "Nenhuma opção cadastrada.";

    [Parameter]
    public string EmptySelectionText { get; set; } = "Sem etiquetas";

    [Parameter]
    public string MultipleSelectionText { get; set; } = "etiquetas selecionadas";

    [Parameter]
    public int MaximumSelections { get; set; } = int.MaxValue;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public Func<string, Task<bool>>? CreateRequested { get; set; }

    [Parameter]
    public int NewItemMaximumLength { get; set; } = 100;

    private bool IsOpen;
    private bool Creating;
    private string Search = string.Empty;
    private ElementReference Trigger;
    private IReadOnlyList<TItem> MatchingItems => string.IsNullOrWhiteSpace(Search)
        ? Items : Items.Where(item => TextSelector(item).Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();
    private bool CanCreate => CreateRequested is not null && !string.IsNullOrWhiteSpace(Search)
        && !Items.Any(item => string.Equals(TextSelector(item).Trim(), Search.Trim(), StringComparison.OrdinalIgnoreCase));
    private string TriggerLabelledBy => string.IsNullOrWhiteSpace(LabelledBy)
        ? Id + "-trigger"
        : $"{LabelledBy} {Id}-trigger";

    private string SelectionText
    {
        get
        {
            if (SelectedValues.Count == 0) return EmptySelectionText;
            if (SelectedValues.Count == 1)
            {
                var selected = Items.Where(item => SelectedValues.Contains(ValueSelector(item)))
                    .Select(TextSelector).FirstOrDefault();
                if (selected is not null) return selected;
            }
            return $"{SelectedValues.Count} {MultipleSelectionText}";
        }
    }

    protected override void OnParametersSet()
    {
        if (Disabled) { IsOpen = false; Search = string.Empty; }
    }

    private void Toggle()
    {
        if (!Disabled) { IsOpen = !IsOpen; Search = string.Empty; }
    }

    private void SearchChanged(ChangeEventArgs args) => Search = args.Value?.ToString() ?? string.Empty;

    private async Task HandleSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && CanCreate) await CreateAsync();
    }

    private async Task CreateAsync()
    {
        if (Disabled || Creating || !CanCreate || CreateRequested is null || SelectedValues.Count >= MaximumSelections) return;
        Creating = true;
        try
        {
            if (await CreateRequested(Search.Trim())) Search = string.Empty;
        }
        finally { Creating = false; }
    }

    private async Task ChangeAsync(TValue value, ChangeEventArgs args)
    {
        if (Disabled || args.Value is not bool) return;
        await SelectionChanged.InvokeAsync(value);
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key != "Escape" || !IsOpen) return;
        IsOpen = false;
        await Trigger.FocusAsync();
    }
}
