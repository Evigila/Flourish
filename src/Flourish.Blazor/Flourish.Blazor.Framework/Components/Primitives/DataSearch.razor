@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
@inherits TextComponentBase
@typeparam TItem

<ArkheideSystem.Flourish.Blazor.Components.DataSearch TItem="TItem" Columns="CanonicalColumns" ColumnKey="@ColumnKey" Value="@Value"
    Changed="ForwardChangedAsync" Disabled="@Disabled" Id="@Id" MaximumLength="@MaximumLength" ChildContent="@ChildContent" />

@code {
    private IReadOnlyList<ArkheideSystem.Flourish.Blazor.Components.TableColumn<TItem>> CanonicalColumns => Columns.Select(column =>
        new ArkheideSystem.Flourish.Blazor.Components.TableColumn<TItem>(column.Key, column.Label, item => column.Value(item), Searchable: column.CanSearch)).ToArray();

    [Parameter, EditorRequired] public IReadOnlyList<DataColumn<TItem>> Columns { get; set; } = [];
    [Parameter] public string? ColumnKey { get; set; }
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<DataSearchRequest> Changed { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public int MaximumLength { get; set; } = 200;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task ForwardChangedAsync(ArkheideSystem.Flourish.Blazor.Components.TableSearchRequest request) =>
        Changed.InvokeAsync(new DataSearchRequest(request.ColumnKey ?? string.Empty, request.Value));
}
