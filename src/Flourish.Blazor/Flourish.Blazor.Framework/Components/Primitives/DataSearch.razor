@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
@typeparam TItem

<div class="data-search quick-filter-row form-controls">
    @if (SearchColumns.Count > 0)
    {
        <label class="quick-filter-field search-column-field" for="@(FieldId + "-column")">Buscar por
            <select class="f-input f-select" id="@(FieldId + "-column")" @bind:get="SelectedColumn.Key" @bind:set="ChangeColumnAsync"
                    disabled="@Disabled" @onchange:stopPropagation @oninput:stopPropagation>
                @foreach (var column in SearchColumns)
                {
                    <option value="@column.Key">@column.Label</option>
                }
            </select>
        </label>
        <label class="quick-filter-field search-value-field" for="@FieldId">@SelectedColumn.Label
            <input id="@FieldId" type="search" @bind:get="Value" @bind:set="ChangeValueAsync" @bind:event="oninput" disabled="@Disabled"
                   maxlength="@MaximumLength" autocomplete="off" @oninput:stopPropagation @onchange:stopPropagation />
        </label>
    }
    @ChildContent
</div>

@code {
    private readonly string Identifier = $"list-search-{Guid.NewGuid():N}";
    private IReadOnlyList<DataColumn<TItem>> SearchColumns = [];
    private DataColumn<TItem> SelectedColumn => SearchColumns.FirstOrDefault(column => column.Key == ColumnKey) ?? SearchColumns[0];
    private string FieldId => Id ?? Identifier;

    [Parameter, EditorRequired] public IReadOnlyList<DataColumn<TItem>> Columns { get; set; } = [];
    [Parameter] public string? ColumnKey { get; set; }
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<DataSearchRequest> Changed { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public int MaximumLength { get; set; } = 200;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet() => SearchColumns = Columns.Where(column => column.CanSearch).ToArray();

    private Task ChangeColumnAsync(string key)
    {
        return Disabled || !SearchColumns.Any(column => column.Key == key) ? Task.CompletedTask
            : Changed.InvokeAsync(new(key, Value));
    }

    private Task ChangeValueAsync(string value) => Disabled || SearchColumns.Count == 0 ? Task.CompletedTask
        : Changed.InvokeAsync(new(SelectedColumn.Key, value));
}
