@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
<NavLink class="@(IsCurrent ? "f-secondary-item is-selected" : "f-secondary-item")" href="@Href" Match="Match" ActiveClass="is-selected" title="@Label" aria-current="@(IsCurrent ? "page" : null)"><span class="f-navigation-label">@Label</span></NavLink>
@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
    [Parameter] public bool IsCurrent { get; set; }
}
