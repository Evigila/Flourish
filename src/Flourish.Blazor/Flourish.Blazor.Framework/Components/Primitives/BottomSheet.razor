@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="Dialog" id="@Id" class="bottom-sheet" aria-labelledby="@(Id + "-title")"
        aria-modal="true" aria-busy="@(IsBusy ? "true" : "false")">
    <header class="bottom-sheet-header">
        <div class="bottom-sheet-heading">
            <div class="section-title-row">
                <h2 id="@(Id + "-title")">@Title</h2>
            </div>
            <button class="bottom-sheet-close" type="button" title="Fechar" aria-label="Fechar"
                    disabled="@IsBusy" @onclick="RequestCloseAsync">
                <AppIcon Name="close" Size="tool" />
            </button>
        </div>
    </header>
    <div class="bottom-sheet-body" data-sheet-scroll>
        <div class="bottom-sheet-content">
            @if (HasOpened) { @ChildContent }
        </div>
    </div>
    @if (HasOpened && Actions is not null)
    {
        <footer class="bottom-sheet-actions f-dialog-actions">@Actions</footer>
    }
</dialog>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional actions arranged at the end of the sheet below its scrollable content.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    private ElementReference Dialog;
    private IJSObjectReference? Module;
    private DotNetObjectReference<BottomSheet>? Reference;
    private bool IsDisposed;
    private bool HasOpened;
    private bool? SynchronizedOpen;

    protected override void OnParametersSet()
    {
        // Keep a used form mounted so closing a sheet does not discard its draft state.
        HasOpened |= IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsDisposed || Module is null && !IsOpen)
        {
            return;
        }

        if (Module is null)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor.Framework/primitives/bottom-sheet.js");
            if (IsDisposed || Module is null && !IsOpen)
            {
                await module.DisposeAsync();
                return;
            }

            Module = module;
        }

        if (SynchronizedOpen == IsOpen) return;
        Reference ??= DotNetObjectReference.Create(this);
        var isOpen = IsOpen;
        await Module.InvokeVoidAsync("synchronize", Dialog, isOpen, Reference);
        SynchronizedOpen = isOpen;
    }

    [JSInvokable]
    public Task RequestCloseAsync() => IsBusy || IsDisposed ? Task.CompletedTask : OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (IsDisposed) return;
        IsDisposed = true;
        try
        {
            if (Module is not null)
            {
                await Module.InvokeVoidAsync("dispose", Dialog);
                await Module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Module disposal cannot call into a disconnected Blazor circuit.
        }
        finally
        {
            Reference?.Dispose();
        }
    }
}
