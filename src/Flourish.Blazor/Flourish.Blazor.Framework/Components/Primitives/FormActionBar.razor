@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
<div class="form-action-bar @Class">
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.UniformGrid Columns="Columns" NarrowColumns="@(Columns > 2 ? 2 : Columns)" Filled="true">
        @ChildContent
    </ArkheideSystem.Flourish.Blazor.Components.Primitives.UniformGrid>
</div>

@code {
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter]
    public int Columns { get; set; } = 2;

    [Parameter]
    public string? Class { get; set; }
}
