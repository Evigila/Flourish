@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
@inherits TextComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="Container" class="primary-navigation-entry">
    @if (Disabled)
    {
        <span class="primary-nav-item is-disabled" role="link" tabindex="0" aria-disabled="true"
              aria-label="@Label" aria-describedby="@TooltipId" data-navigation-trigger>
            <span class="primary-nav-symbol"><ArkheideSystem.Flourish.Blazor.Components.Icon Name="@Icon" Filled="@Filled" Class="primary-navigation-icon" /></span>
        </span>
    }
    else
    {
        <NavLink class="@NavigationClass" ActiveClass="is-active" href="@Href" Match="@Match"
                 aria-label="@Label" aria-describedby="@TooltipId" data-navigation-trigger>
            <span class="primary-nav-symbol"><ArkheideSystem.Flourish.Blazor.Components.Icon Name="@Icon" Filled="@Filled" Class="primary-navigation-icon" /></span>
        </NavLink>
    }
    <span id="@TooltipId" class="primary-navigation-tooltip" role="tooltip" popover="manual"
          data-navigation-tooltip>@(Disabled ? DisabledMessage ?? Ui("Navigation_Unavailable", "{0} — unavailable", Label) : Label)</span>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter] public bool Filled { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? DisabledMessage { get; set; }
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
    [Parameter] public bool IsCurrent { get; set; }

    private string TooltipId => Id + "-tooltip";
    private string NavigationClass => IsCurrent ? "primary-nav-item is-active" : "primary-nav-item";
    private ElementReference Container;
    private IJSObjectReference? Module;
    private bool IsDisposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || IsDisposed) return;
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor.Framework/primitives/primary-navigation-item.js");
        if (IsDisposed)
        {
            await module.DisposeAsync();
            return;
        }

        Module = module;
        await Module.InvokeVoidAsync("attach", Container);
    }

    public async ValueTask DisposeAsync()
    {
        base.Dispose();
        IsDisposed = true;
        if (Module is null) return;
        try
        {
            await Module.InvokeVoidAsync("detach", Container);
            await Module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The DOM observer also releases listeners when a disconnected circuit removes the entry.
        }
    }
}
