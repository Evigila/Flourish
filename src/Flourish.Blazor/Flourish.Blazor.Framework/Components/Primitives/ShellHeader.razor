@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
<header class="shell-header @Class" data-shell-header-follow-content="@(FollowContentWidth ? "true" : null)"
        data-shell-header-accent-brand="@(AccentBrand ? "true" : null)" data-shell-header-accent-context="@(AccentContext ? "true" : null)">
    <div class="shell-header-start">
        @if (ServiceLauncher is not null)
        {
            <div class="shell-header-launcher">@ServiceLauncher</div>
        }
        <ArkheideSystem.Flourish.Blazor.Components.Button Class="shell-header-brand" Href="@HomeHref" Variant="ButtonVariant.Quiet" aria-label="@HomeAriaLabel">
            <span class="shell-header-logo" aria-hidden="true">
                <img src="@LogoPath" alt="" width="24" height="24" />
            </span>
            <span class="shell-header-title">
                <strong>@BrandName</strong>
                @if (!string.IsNullOrWhiteSpace(ContextName))
                {
                    <span class="shell-header-context">@ContextName</span>
                }
            </span>
        </ArkheideSystem.Flourish.Blazor.Components.Button>
    </div>
    <div class="shell-header-heading" data-f-shell-heading hidden aria-hidden="true">
        <div class="shell-header-heading-main">
            <span data-f-heading-parent-space hidden></span>
            <span class="shell-header-heading-title"></span>
        </div>
        <span class="shell-header-heading-actions" data-f-heading-actions-space hidden></span>
    </div>
    @if (Services is not null)
    {
        <div class="shell-header-center"><div class="f-topbar-slot">@Services</div></div>
    }
    @if (LeadingActions is not null || !string.IsNullOrWhiteSpace(IdentityName) || EndActions is not null)
    {
        <div class="shell-header-actions">
            @if (LeadingActions is not null)
            {
                <div class="f-topbar-slot">@LeadingActions</div>
            }
            @if (!string.IsNullOrWhiteSpace(IdentityName))
            {
                @if (!string.IsNullOrWhiteSpace(IdentityHref))
                {
                    <a class="@IdentityClass" href="@IdentityHref" aria-label="@EffectiveIdentityLabel" title="@IdentityTooltip">
                        <ArkheideSystem.Flourish.Blazor.Components.Icon Name="person" />
                        @if (!IdentityIconOnly) { <strong>@IdentityName</strong> }
                    </a>
                }
                else
                {
                    <span class="@IdentityClass" role="@(IdentityIconOnly ? "img" : null)" aria-label="@EffectiveIdentityLabel" title="@IdentityTooltip">
                        <ArkheideSystem.Flourish.Blazor.Components.Icon Name="person" />
                        @if (!IdentityIconOnly) { <strong>@IdentityName</strong> }
                    </span>
                }
            }
            @if (EndActions is not null)
            {
                <div class="f-topbar-slot">@EndActions</div>
            }
        </div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string HomeHref { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string HomeAriaLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string LogoPath { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string BrandName { get; set; } = string.Empty;
    /// <summary>Uses the theme accent for the brand name.</summary>
    [Parameter] public bool AccentBrand { get; set; }
    [Parameter] public string? ContextName { get; set; }
    /// <summary>Uses the theme accent for the context name.</summary>
    [Parameter] public bool AccentContext { get; set; }
    [Parameter] public string? IdentityName { get; set; }
    [Parameter] public string? IdentityHref { get; set; }
    [Parameter] public string? IdentityAriaLabel { get; set; }
    /// <summary>Shows the user glyph without visible text, retaining the accessible label and identity tooltip.</summary>
    [Parameter] public bool IdentityIconOnly { get; set; }
    [Parameter] public string? Class { get; set; }
    /// <summary>Aligns the menu to the page content when the header controls have room.</summary>
    [Parameter] public bool FollowContentWidth { get; set; }
    /// <summary>Independent launcher placed before the brand, typically an AppLauncher.</summary>
    [Parameter] public RenderFragment? ServiceLauncher { get; set; }
    /// <summary>Navigation beside the brand. Wraps below the first row when the controls cannot fit.</summary>
    [Parameter] public RenderFragment? Services { get; set; }
    [Parameter] public RenderFragment? LeadingActions { get; set; }
    /// <summary>Right-side controls. Direct children receive standard header spacing.</summary>
    [Parameter] public RenderFragment? EndActions { get; set; }
    private string IdentityClass => IdentityIconOnly ? "shell-header-identity shell-header-identity-icon" : "shell-header-identity";
    private string? EffectiveIdentityLabel => string.IsNullOrWhiteSpace(IdentityAriaLabel) ? IdentityName : IdentityAriaLabel;
    private string? IdentityTooltip => IdentityIconOnly ? IdentityName : null;
}
