@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
@inherits TextComponentBase
@typeparam TValue where TValue : struct
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="selection-dropdown-surface">
<div class="reference-dropdown" @ref="Root" @onkeydown="HandleKeyDownAsync" @onfocusout="CloseIfFocusLeftAsync">
    <button @ref="Trigger" id="@(Id + "-trigger")" class="reference-trigger selection-trigger" type="button"
            aria-haspopup="listbox" aria-expanded="@(IsOpen ? "true" : "false")" aria-controls="@(Id + "-options")"
            aria-labelledby="@LabelledBy" disabled="@(Disabled || Creating)" @onclick="Toggle">
        <span title="@SelectedName">@SelectedName</span><ExpansionIndicator Expanded="IsOpen" Class="reference-chevron selection-chevron" />
    </button>
    @if (IsOpen)
    {
        <div class="reference-panel selection-panel">
            <div class="selection-panel-width" aria-hidden="true">
                @foreach (var item in Items) { <span class="selection-option">@item.Name</span> }
            </div>
            <input @ref="SearchInput" class="reference-search selection-search" type="search"
                   form="@(Id + "-popup-search")" value="@Search" maxlength="@MaximumLength"
                   aria-label="@EffectiveSearchLabel" autocomplete="off" disabled="@Creating"
                   @oninput="SearchChanged" @oninput:stopPropagation @onkeydown="HandleSearchKeyDownAsync" />
            <div id="@(Id + "-options")" class="reference-options" role="listbox" aria-labelledby="@LabelledBy">
                @if (AllowNone)
                {
                    <button type="button" role="option" aria-selected="@((Value is null && string.IsNullOrWhiteSpace(UnlistedName)) ? "true" : "false")"
                            class="selection-option reference-option" disabled="@Creating" @onclick="() => SelectAsync(null)">@EffectiveEmptySelectionText</button>
                }
                @if (ShowUnlisted)
                {
                    <span class="selection-option reference-option reference-unlisted" role="option" aria-selected="true">@UnlistedName</span>
                }
                @foreach (var item in Matches)
                {
                    <button type="button" role="option" aria-selected="@(EqualityComparer<TValue?>.Default.Equals(Value, item.Id) ? "true" : "false")"
                            class="selection-option reference-option" disabled="@Creating" @onclick="() => SelectAsync(item.Id)">@item.Name</button>
                }
                @if (Matches.Count == 0 && !ShowUnlisted && !AllowNone)
                {
                    <span class="reference-empty">@Ui("Selection_NoOptions", "No options available.")</span>
                }
            </div>
            @if (CanCreate)
            {
                <button type="button" class="reference-create selection-create" disabled="@Creating" @onclick="CreateAsync">
                    @(Creating ? Ui("Selection_Adding", "Adding…") : Ui("Selection_Add", "Add \"{0}\"", Search.Trim()))
                </button>
            }
        </div>
    }
</div>

</div>

@code {
    private string EffectiveSearchLabel => DefaultText(nameof(SearchLabel), SearchLabel, "Selection_SearchOrAdd", "Search or add");
    private string EffectiveEmptySelectionText => DefaultText(nameof(EmptySelectionText), EmptySelectionText, "Selection_None", "None");
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string LabelledBy { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<ReferenceItem<TValue>> Items { get; set; } = [];
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public string? UnlistedName { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public Func<string, Task<TValue?>>? CreateRequested { get; set; }
    [Parameter] public string EmptySelectionText { get; set; } = "None";
    [Parameter] public string SearchLabel { get; set; } = "Search or add";
    [Parameter] public int MaximumLength { get; set; } = 120;
    [Parameter] public bool AllowNone { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }

    private ElementReference Root;
    private ElementReference Trigger;
    private ElementReference SearchInput;
    private IJSObjectReference? Module;
    private Task<IJSObjectReference?>? ModuleLoading;
    private bool Disposed;
    private bool IsOpen;
    private bool FocusSearch;
    private bool Creating;
    private string Search = string.Empty;
    private string SelectedName => Items.FirstOrDefault(item => EqualityComparer<TValue?>.Default.Equals(item.Id, Value))?.Name
        ?? (string.IsNullOrWhiteSpace(UnlistedName) ? EffectiveEmptySelectionText : UnlistedName);
    private IReadOnlyList<ReferenceItem<TValue>> Matches => Items
        .Where(item => string.IsNullOrWhiteSpace(Search)
            || item.Name.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase))
        .Take(50).ToArray();
    private bool CanCreate => CreateRequested is not null && !string.IsNullOrWhiteSpace(Search)
        && !Items.Any(item => string.Equals(item.Name.Trim(), Search.Trim(), StringComparison.OrdinalIgnoreCase));
    private bool ShowUnlisted => Value is null && !string.IsNullOrWhiteSpace(UnlistedName)
        && (string.IsNullOrWhiteSpace(Search) || UnlistedName.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase))
        && !Items.Any(item => string.Equals(item.Name, UnlistedName, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!FocusSearch) return;
        FocusSearch = false;
        await SearchInput.FocusAsync();
    }

    private void Toggle()
    {
        if (Disabled || Creating) return;
        IsOpen = !IsOpen;
        Search = string.Empty;
        FocusSearch = IsOpen;
    }

    private void SearchChanged(ChangeEventArgs args) => Search = args.Value?.ToString() ?? string.Empty;

    private async Task HandleSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key != "Enter") return;
        var existing = Items.FirstOrDefault(item =>
            string.Equals(item.Name.Trim(), Search.Trim(), StringComparison.OrdinalIgnoreCase));
        if (existing is not null) await SelectAsync(existing.Id);
        else if (CanCreate) await CreateAsync();
    }

    private async Task SelectAsync(TValue? id)
    {
        if (Disabled || Creating) return;
        IsOpen = false;
        Search = string.Empty;
        await ValueChanged.InvokeAsync(id);
        await Trigger.FocusAsync();
    }

    private async Task CreateAsync()
    {
        if (Disabled || Creating || !CanCreate || CreateRequested is null) return;
        Creating = true;
        try
        {
            var id = await CreateRequested(Search.Trim());
            if (id is null) return;
            IsOpen = false;
            Search = string.Empty;
            await ValueChanged.InvokeAsync(id);
            await Trigger.FocusAsync();
        }
        finally { Creating = false; }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key != "Escape" || !IsOpen) return;
        IsOpen = false;
        Search = string.Empty;
        await Trigger.FocusAsync();
    }

    private async Task CloseIfFocusLeftAsync()
    {
        if (Disposed || !IsOpen) return;
        await Task.Yield();
        if (Disposed) return;
        try
        {
            var activeModule = await GetModuleAsync();
            if (Disposed || activeModule is null) return;
            var containsFocus = await activeModule.InvokeAsync<bool>("containsFocus", Root);
            if (!Disposed && !containsFocus)
            {
                await InvokeAsync(() =>
                {
                    if (Disposed) return;
                    IsOpen = false;
                    Search = string.Empty;
                    StateHasChanged();
                });
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException)
        {
            if (!Disposed) IsOpen = false;
        }
    }

    private async Task<IJSObjectReference?> GetModuleAsync()
    {
        if (Module is not null) return Module;
        var loading = ModuleLoading ??= ImportModuleAsync();
        try { return await loading; }
        finally { if (ReferenceEquals(ModuleLoading, loading)) ModuleLoading = null; }
    }

    private async Task<IJSObjectReference?> ImportModuleAsync()
    {
        var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor.Framework/primitives/reference-dropdown.js");
        if (Disposed) { await ReleaseModuleAsync(imported); return null; }
        Module = imported;
        return imported;
    }

    private static async ValueTask ReleaseModuleAsync(IJSObjectReference activeModule)
    {
        try { await activeModule.DisposeAsync(); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (Disposed) return;
        Disposed = true;
        base.Dispose();
        var activeModule = Module;
        Module = null;
        if (activeModule is not null) await ReleaseModuleAsync(activeModule);
    }
}
