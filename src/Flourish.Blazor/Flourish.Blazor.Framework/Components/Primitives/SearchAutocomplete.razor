@namespace ArkheideSystem.Flourish.Blazor.Components.Primitives
@inherits TextComponentBase
@typeparam TItem
@implements IAsyncDisposable
@inject IJSRuntime JS

<span class="search-autocomplete" @ref="Root" data-f-popup-strength="@Strength.ToString().ToLowerInvariant()" @onfocusout="CloseAsync">
    <input @ref="Input" id="@Id" class="f-input"
           type="search"
           form="@Form"
           value="@Value"
           maxlength="@MaximumLength"
           placeholder="@Placeholder"
           autocomplete="off"
           role="combobox"
           aria-autocomplete="list"
           aria-expanded="@(IsOpen ? "true" : "false")"
           aria-controls="@ListboxId"
           aria-activedescendant="@ActiveOptionId"
           disabled="@Disabled"
           @oninput="InputAsync"
           @oninput:stopPropagation
           @onchange:stopPropagation
           @onfocus="Open"
           @onkeydown="HandleKeyDownAsync" />
    @if (IsOpen)
    {
        <span id="@ListboxId" class="search-autocomplete-options" popover="manual" role="listbox" aria-label="@EffectiveResultsLabel">
            @if (Matches.Count == 0)
            {
                <span class="search-autocomplete-empty" role="status">@EffectiveEmptyText</span>
            }
            else
            {
                @for (var index = 0; index < Matches.Count; index++)
                {
                    var optionIndex = index;
                    var item = Matches[index];
                    <span id="@OptionId(optionIndex)"
                          class="search-autocomplete-option @(optionIndex == ActiveIndex ? "is-active" : null)"
                          role="option"
                          aria-selected="@(optionIndex == ActiveIndex ? "true" : "false")"
                          @onmousedown:preventDefault
                          @onclick:preventDefault
                          @onclick="() => SelectAsync(item)">
                        @TextSelector(item)
                    </span>
                }
            }
            @if (Strength == PopupStrength.Strong)
            {
                <Button Variant="ButtonVariant.Quiet" Text="@Ui("Dialog_Close", "Close")" OnClick="CloseExplicitAsync" />
            }
        </span>
    }
</span>

@code {
    private string EffectiveResultsLabel => DefaultText(nameof(ResultsLabel), ResultsLabel, "Search_Suggestions", "Search suggestions");
    private string EffectiveEmptyText => DefaultText(nameof(EmptyText), EmptyText, "Selection_NoResults", "No results found.");
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public Func<TItem, string> ValueSelector { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<TItem, string> TextSelector { get; set; } = default!;

    [Parameter]
    public Func<TItem, string>? SearchTextSelector { get; set; }

    [Parameter]
    public Func<TItem, string>? KeySelector { get; set; }

    [Parameter]
    public bool FilterItems { get; set; } = true;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string> InputChanged { get; set; }

    [Parameter]
    public EventCallback<TItem> ItemSelected { get; set; }

    [Parameter]
    public EventCallback SearchCleared { get; set; }

    [Parameter]
    public int MaximumLength { get; set; } = 200;

    [Parameter]
    public int MaximumResults { get; set; } = 8;

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Form { get; set; }

    [Parameter]
    public string ResultsLabel { get; set; } = "Search suggestions";

    [Parameter]
    public string EmptyText { get; set; } = "No results found.";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter] public PopupStrength Strength { get; set; } = PopupStrength.Weak;
    private ElementReference Root, Input;
    private IJSObjectReference? Module;
    private DotNetObjectReference<SearchAutocomplete<TItem>>? Reference;
    private bool Disposed;
    private bool IgnoreNextFocus;
    private bool HasFocus;
    private int ActiveIndex = -1;
    private IReadOnlyList<TItem> Matches = [];
    private string ListboxId => $"{Id}-suggestions";
    private string? ActiveOptionId => ActiveIndex >= 0 && ActiveIndex < Matches.Count
        ? OptionId(ActiveIndex)
        : null;
    private bool IsOpen => HasFocus && !Disabled && !string.IsNullOrWhiteSpace(Value);
    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(Strength)) throw new ArgumentOutOfRangeException(nameof(Strength));
        RebuildMatches();
        if (Disabled || ActiveIndex >= Matches.Count) ActiveIndex = -1;
    }

    private bool MatchesValue(TItem item)
    {
        var query = Value.Trim();
        var searchable = SearchTextSelector?.Invoke(item) ?? TextSelector(item);
        return searchable.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private async Task InputAsync(ChangeEventArgs args)
    {
        if (Disabled) return;
        var input = args.Value?.ToString() ?? string.Empty;
        var wasCleared = !string.IsNullOrEmpty(Value) && string.IsNullOrEmpty(input);
        HasFocus = true;
        ActiveIndex = -1;
        await ValueChanged.InvokeAsync(input);
        await InputChanged.InvokeAsync(input);
        if (wasCleared)
        {
            HasFocus = false;
            await SearchCleared.InvokeAsync();
        }
    }

    private void Open()
    {
        if (IgnoreNextFocus) { IgnoreNextFocus = false; return; }
        if (Disabled) return;
        HasFocus = true;
        RebuildMatches();
    }

    private async Task CloseAsync()
    {
        if (Disposed || Strength == PopupStrength.Strong) return;
        await Task.Yield();
        if (Disposed || Strength == PopupStrength.Strong) return;
        HasFocus = false;
        ActiveIndex = -1;
        Matches = [];
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (!IsOpen) return;
        if (args.Key == "Escape" && Strength == PopupStrength.Weak)
        {
            HasFocus = false;
            ActiveIndex = -1;
            return;
        }

        if (Matches.Count == 0) return;
        if (args.Key == "ArrowDown")
        {
            ActiveIndex = (ActiveIndex + 1) % Matches.Count;
        }
        else if (args.Key == "ArrowUp")
        {
            ActiveIndex = ActiveIndex <= 0 ? Matches.Count - 1 : ActiveIndex - 1;
        }
        else if (args.Key == "Enter" && ActiveIndex >= 0)
        {
            await SelectAsync(Matches[ActiveIndex]);
        }
    }

    private async Task SelectAsync(TItem item)
    {
        if (Disabled) return;
        var selectedValue = ValueSelector(item);
        HasFocus = false;
        ActiveIndex = -1;
        await ValueChanged.InvokeAsync(selectedValue);
        await ItemSelected.InvokeAsync(item);
    }

    private async Task CloseExplicitAsync()
    {
        HasFocus = false;
        ActiveIndex = -1;
        Matches = [];
        IgnoreNextFocus = true;
        await Input.FocusAsync();
    }

    [JSInvokable]
    public Task RequestDismissAsync() => InvokeAsync(() =>
    {
        if (Disposed || Strength != PopupStrength.Weak) return;
        HasFocus = false; ActiveIndex = -1; Matches = [];
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Disposed) return;
        try
        {
            if (Module is null)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor.Framework/primitives/reference-dropdown.js");
                if (Disposed) { await module.DisposeAsync(); return; }
                Module = module;
            }
            Reference ??= DotNetObjectReference.Create(this);
            await Module.InvokeVoidAsync("attachPopupDismissal", Root, Reference);
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (Disposed) return;
        Disposed = true;
        base.Dispose();
        var module = Module; Module = null;
        try { if (module is not null) await module.InvokeVoidAsync("detachPopupDismissal", Root); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
        finally
        {
            Reference?.Dispose(); Reference = null;
            if (module is not null)
                try { await module.DisposeAsync(); }
                catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
        }
    }

    private string OptionId(int index) => $"{ListboxId}-{index}";

    private void RebuildMatches()
    {
        if (!IsOpen)
        {
            Matches = [];
            return;
        }

        var maximum = Math.Max(1, MaximumResults);
        var matches = new List<TItem>(maximum);
        var values = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var item in Items)
        {
            if ((FilterItems && !MatchesValue(item)) || !values.Add(KeySelector?.Invoke(item) ?? ValueSelector(item))) continue;
            matches.Add(item);
            if (matches.Count == maximum) break;
        }

        Matches = matches;
    }
}
