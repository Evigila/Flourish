@namespace ArkheideSystem.Flourish.Blazor.Components

<div @attributes="AdditionalAttributes" class="f-form-actions @Class"
     style="--f-action-columns:@Columns;--f-action-narrow-columns:@(Columns > 2 ? 2 : Columns)">@ChildContent</div>

@code {
    [Parameter] public int Columns { get; set; } = 2;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    protected override void OnParametersSet()
    {
        if (Columns is < 1 or > 5) throw new ArgumentOutOfRangeException(nameof(Columns));
    }
}
