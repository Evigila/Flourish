@namespace ArkheideSystem.Flourish.Blazor.Components
@typeparam TItem
@inherits TextComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

<details @ref="Disclosure" id="@RootId" class="f-collection-view f-dropdown-surface" data-f-popup="menu"
         data-f-popup-hover="true" data-f-popup-strength="weak" data-f-enhanced="@(Enhanced ? "true" : null)"
         inert="@(Unavailable ? true : (bool?)null)">
    <summary @ref="Trigger" id="@(RootId + "-trigger")" class="f-disclosure-button-trigger f-button f-button-quiet"
             aria-label="@AccessibleLabel" title="@AccessibleLabel" aria-haspopup="dialog" aria-controls="@PanelId"
             aria-disabled="@Unavailable.ToString().ToLowerInvariant()">
        @Items.Count.ToString(Texts.FormatCulture)
    </summary>
    <div @ref="Panel" id="@PanelId" class="f-menu-panel f-dropdown-panel f-collection-view-panel" data-f-popup-panel
         data-f-popup-strength="weak" role="dialog" aria-modal="false" aria-label="@Label" popover="@(Enhanced ? "manual" : null)">
        <ul class="f-collection-view-items" tabindex="0" aria-label="@Label">
            @foreach (var item in Items)
            {
                <li class="f-collection-view-item">
                    @if (ItemTemplate is not null) { @ItemTemplate(item) }
                    else { @(ItemText is null ? item?.ToString() : ItemText(item)) }
                </li>
            }
        </ul>
    </div>
</details>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public Func<TItem, string>? ItemText { get; set; }
    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private readonly string GeneratedId = "collection-" + Guid.NewGuid().ToString("N");
    private string RootId => Id ?? GeneratedId;
    private string PanelId => RootId + "-panel";
    private string AccessibleLabel => Label + ": " + Items.Count.ToString(Texts.FormatCulture);
    private bool Unavailable => Disabled || Items.Count == 0;
    private bool Enhanced, Disposed, Attached;
    private ElementReference Disclosure, Trigger, Panel, AttachedTrigger, AttachedPanel;
    private IJSObjectReference? Module;
    private Task<IJSObjectReference?>? ModuleLoading;

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(Items);
        if (string.IsNullOrWhiteSpace(Label)) throw new ArgumentException("A collection label is required.", nameof(Label));
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Disposed) return;
        try
        {
            var module = await GetModuleAsync();
            if (Disposed || module is null) return;
            if (!Enhanced) { Enhanced = true; StateHasChanged(); return; }
            if (Attached && (AttachedTrigger.Id != Trigger.Id || AttachedPanel.Id != Panel.Id))
                await module.InvokeVoidAsync("detachMenu", AttachedTrigger, AttachedPanel);
            AttachedTrigger = Trigger; AttachedPanel = Panel; Attached = true;
            await module.InvokeVoidAsync("attachDisclosureMenu", Disclosure, Trigger, Panel, false, true);
            if (Unavailable) await module.InvokeVoidAsync("closeMenu", Trigger, Panel, true);
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }
    private async Task<IJSObjectReference?> GetModuleAsync()
    {
        if (Module is not null) return Module;
        var loading = ModuleLoading ??= ImportModuleAsync();
        try { return await loading; }
        finally { if (ReferenceEquals(ModuleLoading, loading)) ModuleLoading = null; }
    }
    private async Task<IJSObjectReference?> ImportModuleAsync()
    {
        var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor.Framework/controls.js");
        if (Disposed) { await ReleaseModuleAsync(imported); return null; }
        Module = imported;
        return imported;
    }
    public async ValueTask DisposeAsync()
    {
        if (Disposed) return;
        Disposed = true;
        base.Dispose();
        var module = Module; Module = null;
        if (module is null) return;
        try { if (Attached) await module.InvokeVoidAsync("detachMenu", AttachedTrigger, AttachedPanel); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
        finally { await ReleaseModuleAsync(module); }
    }
    private static async ValueTask ReleaseModuleAsync(IJSObjectReference module)
    {
        try { await module.DisposeAsync(); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }
}
