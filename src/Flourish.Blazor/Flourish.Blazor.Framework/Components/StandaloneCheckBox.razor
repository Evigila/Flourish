@namespace ArkheideSystem.Flourish.Blazor.Components

@if (WrapLabel)
{
    <label class="f-checkbox-label @(Disabled ? "f-disabled" : null)" for="@Identifier">
        @Control
        @if (ChildContent is not null) { <span>@ChildContent</span> }
        else if (!string.IsNullOrWhiteSpace(Label)) { <span>@Label</span> }
    </label>
}
else
{
    @Control
}

@code {
    [CascadingParameter] private FieldContext? Field { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool WrapLabel { get; set; } = true;
    [Parameter] public string SubmissionValue { get; set; } = "true";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private readonly string GeneratedId = "f-check-" + Guid.NewGuid().ToString("N");
    private string Identifier => Id ?? Field?.Id ?? GeneratedId;
    private bool ShownValue, LastValue, Initialized;
    protected override void OnParametersSet()
    {
        if (!Initialized || ValueChanged.HasDelegate || Value != LastValue) ShownValue = Value;
        Initialized = true;
        LastValue = Value;
    }
    private RenderFragment Control => @<input @attributes="AdditionalAttributes" id="@Identifier" class="f-checkbox @Class" type="checkbox"
        checked="@ShownValue" value="@SubmissionValue" disabled="@Disabled" required="@InputSemantics.Required(Field, AdditionalAttributes)"
        aria-invalid="@InputSemantics.Invalid(null, default, Field, AdditionalAttributes)" aria-describedby="@InputSemantics.Description(Field, AdditionalAttributes)" @onchange="ChangeAsync" />;
    private async Task ChangeAsync(ChangeEventArgs args)
    {
        if (Disabled || args.Value is not bool value) return;
        ShownValue = value;
        await ValueChanged.InvokeAsync(value);
    }
}
