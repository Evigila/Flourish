@namespace ArkheideSystem.Flourish.Blazor.Components
@inherits TextComponentBase
@using System.Threading
@implements IDisposable

<label class="f-search" for="@Identifier">
    <span class="f-field-label">@EffectiveLabel</span>
    <input @attributes="AdditionalAttributes" id="@Identifier" class="f-input" type="search" value="@Value" autocomplete="off"
           disabled="@Disabled" maxlength="@MaxLength" @oninput="InputAsync" @onkeydown="KeyDownAsync" />
</label>

@code {
    private string EffectiveLabel => DefaultText(nameof(Label), Label, "Input_Search", "Search");
    private readonly string GeneratedId = "f-search-" + Guid.NewGuid().ToString("N");
    private string Identifier => Id ?? GeneratedId;
    private CancellationTokenSource? Pending;
    private long Revision;
    private bool Disposed;
    private string? ObservedValue;
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Label { get; set; } = "Search";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback<string> SearchChanged { get; set; }
    [Parameter] public Func<string, CancellationToken, Task>? SearchRequested { get; set; }
    [Parameter] public int DebounceMilliseconds { get; set; } = 400;
    [Parameter] public int MaxLength { get; set; } = 200;
    [Parameter] public bool Disabled { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    protected override void OnParametersSet()
    {
        if (DebounceMilliseconds < 0) throw new ArgumentOutOfRangeException(nameof(DebounceMilliseconds));
        if (ObservedValue != Value) { CancelPending(); ObservedValue = Value; }
        if (Disabled) CancelPending();
    }
    private void CancelPending() { Revision++; Pending?.Cancel(); Pending?.Dispose(); Pending = null; }
    private async Task InputAsync(ChangeEventArgs args)
    {
        if (Disabled || Disposed) return;
        var text = args.Value?.ToString() ?? "";
        CancelPending();
        ObservedValue = text;
        var revision = Revision;
        var pending = Pending = new CancellationTokenSource();
        var token = pending.Token;
        await ValueChanged.InvokeAsync(text);
        try
        {
            if (!string.IsNullOrEmpty(text) && DebounceMilliseconds > 0) await Task.Delay(DebounceMilliseconds, token);
            if (token.IsCancellationRequested || revision != Revision || Disposed) return;
            if (SearchRequested is not null) await SearchRequested(text, token);
            if (!token.IsCancellationRequested && revision == Revision && !Disposed) await SearchChanged.InvokeAsync(text);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }
    private Task KeyDownAsync(KeyboardEventArgs args) => args.Key == "Escape" ? InputAsync(new ChangeEventArgs { Value = "" }) : Task.CompletedTask;
    public override void Dispose() { base.Dispose(); Disposed = true; CancelPending(); }
}
