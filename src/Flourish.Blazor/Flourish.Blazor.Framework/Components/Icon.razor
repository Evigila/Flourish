@namespace ArkheideSystem.Flourish.Blazor.Components
<span class="f-icon @(Filled ? "f-icon-filled" : null) @Class" aria-hidden="true" data-icon="@Name">@IconCatalog.Glyph(Name)</span>
@code {
    [Parameter] public string Name { get; set; } = "description";
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Filled { get; set; }
}
