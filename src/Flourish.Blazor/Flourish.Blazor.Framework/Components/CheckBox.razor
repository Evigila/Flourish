@namespace ArkheideSystem.Flourish.Blazor.Components
@inherits InputBase<bool>

<label class="f-checkbox-label @(Disabled ? "f-disabled" : null)" for="@Identifier">
    <input @attributes="AdditionalAttributes" id="@Identifier" class="f-checkbox @CssClass" type="checkbox" checked="@CurrentValue"
           disabled="@Disabled" required="@InputSemantics.Required(Field, AdditionalAttributes)" aria-invalid="@InputSemantics.Invalid(EditContext, FieldIdentifier, Field, AdditionalAttributes)" aria-describedby="@InputSemantics.Description(Field, AdditionalAttributes)" @onchange="Change" />
    @if (ChildContent is not null) { <span>@ChildContent</span> }
    else if (!string.IsNullOrWhiteSpace(Label)) { <span>@Label</span> }
</label>

@code {
    private readonly string GeneratedId = "f-check-" + Guid.NewGuid().ToString("N");
    private string Identifier => Id ?? Field?.Id ?? GeneratedId;
    [CascadingParameter] private FieldContext? Field { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private void Change(ChangeEventArgs args) { if (!Disabled && args.Value is bool value) CurrentValue = value; }
    protected override bool TryParseValueFromString(string? value, out bool result, out string validationErrorMessage)
        => throw new NotSupportedException("Checkboxes bind boolean values through change events.");
}
