@namespace ArkheideSystem.Flourish.Blazor.Components
@inherits TextComponentBase
@using System.Globalization

<div @attributes="AdditionalAttributes" id="@(string.IsNullOrWhiteSpace(Heading) ? Id : null)" class="f-line-chart @Class" data-independent-scales="@IndependentScales.ToString().ToLowerInvariant()">
    @if (!string.IsNullOrWhiteSpace(Heading))
    {
        <Section Id="@Id" Title="@Heading" Actions="@(ControlsContent is not null || ShowDisplayOptions ? Controls(true) : null)" ChildContent="@Plot" />
    }
    else
    {
        @Controls(false)
        @Plot
    }
</div>

@code {
    private RenderFragment Controls(bool inHeading) => @<text>
    @if (ControlsContent is not null || ShowDisplayOptions)
    {
        <div class="@(inHeading ? "f-line-chart-controls f-line-chart-heading-controls" : "f-line-chart-controls")">
            @if (ControlsContent is not null) { <div class="f-line-chart-controls-content">@ControlsContent</div> }
            @if (ShowDisplayOptions) { <MultiSelectBox Items="DisplayItems" Label="@Ui("Table_Display", "Display")" Icon="remove_red_eye" TriggerVariant="ButtonVariant.Secondary" CanReorder="true" Changed="ApplyDisplayOptions" /> }
        </div>
    }
    </text>;

    private RenderFragment Plot => @<text>
    @if (VisibleSeries.Count == 0 || Labels.Count == 0)
    {
        <p class="f-line-chart-empty">@EffectiveEmptyText</p>
    }
    else
    {
        @if (ShowLegend)
        {
            <ul class="f-line-chart-legend">
                @foreach (var series in VisibleSeries)
                {
                    <li @key="series.Key" data-series="@SeriesIndex(series)"><span>@series.Label</span><strong>@EffectiveMaximumLabel @Format(series, Scale(series).Maximum)</strong></li>
                }
            </ul>
        }
        <div class="f-line-chart-plot">
            <svg viewBox="0 0 760 260" role="img" aria-labelledby="@TitleId" aria-describedby="@(string.IsNullOrWhiteSpace(Description) ? null : DescriptionId)" focusable="false" preserveAspectRatio="xMidYMid meet">
                <title id="@TitleId">@Title</title>
                @if (!string.IsNullOrWhiteSpace(Description)) { <desc id="@DescriptionId">@Description</desc> }
                @for (var grid = 0; grid <= 4; grid++)
                {
                    var y = 24 + grid * 55;
                    <line class="f-line-chart-grid" x1="40" y1="@y" x2="720" y2="@y" />
                }
                @foreach (var series in VisibleSeries)
                {
                    <g @key="series.Key" data-series="@SeriesIndex(series)">
                        <polyline class="f-line-chart-line" points="@Points(series)" />
                        @for (var index = 0; index < Labels.Count; index++)
                        {
                            var label = Labels[index];
                            var value = series.Values[index];
                            <circle @key="label.Key" class="f-line-chart-point" cx="@Number(X(index))" cy="@Number(Y(value, Scale(series)))" r="5">
                                <title>@series.Label — @(label.Tooltip ?? label.Text): @Format(series, value)</title>
                            </circle>
                        }
                    </g>
                }
            </svg>
            <div class="f-line-chart-labels" aria-hidden="true">
                @for (var index = 0; index < Labels.Count; index++)
                {
                    var label = Labels[index];
                    <span @key="label.Key" style="@($"left:{Number(X(index) / 760 * 100)}%")">@label.Text</span>
                }
            </div>
        </div>
        <table class="f-sr-only">
            <caption>@Title</caption>
            <thead><tr><th scope="col">@EffectivePointCaption</th>@foreach (var series in VisibleSeries) { <th scope="col">@series.Label</th> }</tr></thead>
            <tbody>
                @for (var index = 0; index < Labels.Count; index++)
                {
                    var label = Labels[index];
                    <tr @key="label.Key"><th scope="row">@(label.Tooltip ?? label.Text)</th>@foreach (var series in VisibleSeries) { <td>@Format(series, series.Values[index])</td> }</tr>
                }
            </tbody>
        </table>
    }
    </text>;

    public sealed record PointLabel(string Key, string Text, string? Tooltip = null);
    public sealed record DataSeries(string Key, string Label, IReadOnlyList<decimal> Values,
        Func<decimal, string>? Format = null, decimal? Maximum = null, bool Visible = true);
    [Parameter, EditorRequired] public IReadOnlyList<PointLabel> Labels { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<DataSeries> Series { get; set; } = [];
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Heading { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool IndependentScales { get; set; }
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public bool ShowDisplayOptions { get; set; } = true;
    [Parameter] public RenderFragment? ControlsContent { get; set; }
    [Parameter] public string MaximumLabel { get; set; } = "Maximum";
    [Parameter] public string PointCaption { get; set; } = "Point";
    [Parameter] public string EmptyText { get; set; } = "No series selected.";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private readonly string prefix = "line-chart-" + Guid.NewGuid().ToString("N");
    private string TitleId => prefix + "-title";
    private string DescriptionId => prefix + "-description";
    private string EffectiveMaximumLabel => DefaultText(nameof(MaximumLabel), MaximumLabel, "Chart_Maximum", "Maximum");
    private string EffectivePointCaption => DefaultText(nameof(PointCaption), PointCaption, "Chart_Point", "Point");
    private string EffectiveEmptyText => DefaultText(nameof(EmptyText), EmptyText, "Chart_NoSeries", "No series selected.");
    private readonly HashSet<string> KnownSeries = new(StringComparer.Ordinal);
    private readonly HashSet<string> HiddenSeries = new(StringComparer.Ordinal);
    private readonly List<string> SeriesOrder = [];
    private IReadOnlyList<DataSeries> OrderedSeries => SeriesOrder.Select(key => Series.Single(series => series.Key == key)).ToArray();
    private IReadOnlyList<DataSeries> VisibleSeries => OrderedSeries.Where(series => !HiddenSeries.Contains(series.Key)).ToArray();
    private IReadOnlyList<MultiSelectOption> DisplayItems => OrderedSeries.Select(series => new MultiSelectOption(series.Key,series.Label,!HiddenSeries.Contains(series.Key))).ToArray();
    private void ApplyDisplayOptions(MultiSelectChange change)
    {
        SeriesOrder.Clear(); SeriesOrder.AddRange(change.OrderedKeys);
        HiddenSeries.Clear();
        foreach (var series in Series) if (!change.SelectedKeys.Contains(series.Key)) HiddenSeries.Add(series.Key);
    }
    private int SeriesIndex(DataSeries series) => Series.ToList().IndexOf(series) % 4;
    private string Format(DataSeries series, decimal value) => series.Format?.Invoke(value) ?? value.ToString("N", Texts.FormatCulture);
    private double X(int index) => Labels.Count == 1 ? 380 : 40 + index * (680d / (Labels.Count - 1));
    private static string Number(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    private static double Y(decimal value, (decimal Minimum, decimal Maximum) scale)
    {
        // Convert before subtracting so the entire supported decimal range cannot overflow.
        var range = (double)scale.Maximum - (double)scale.Minimum;
        return 24 + (1 - ((double)value - (double)scale.Minimum) / range) * 220;
    }
    private (decimal Minimum, decimal Maximum) Scale(DataSeries series)
    {
        var sources = IndependentScales ? new[] { series } : VisibleSeries;
        var minimum = Math.Min(0, sources.SelectMany(item => item.Values).DefaultIfEmpty(0).Min());
        var maximum = sources.Select(item => item.Maximum ?? Math.Max(1, item.Values.DefaultIfEmpty(0).Max())).DefaultIfEmpty(1).Max();
        return (minimum, maximum);
    }
    private string Points(DataSeries series) => string.Join(' ', series.Values.Select((value, index) => $"{Number(X(index))},{Number(Y(value, Scale(series)))}"));
    protected override void OnParametersSet()
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(Title);
        if (Labels is null) throw new ArgumentNullException(nameof(Labels));
        if (Series is null) throw new ArgumentNullException(nameof(Series));
        var labelKeys = new HashSet<string>(StringComparer.Ordinal);
        foreach (var label in Labels)
        {
            if (label is null || string.IsNullOrWhiteSpace(label.Key) || string.IsNullOrWhiteSpace(label.Text) || !labelKeys.Add(label.Key))
                throw new ArgumentException("Chart labels require unique keys and readable text.", nameof(Labels));
        }
        var seriesKeys = new HashSet<string>(StringComparer.Ordinal);
        foreach (var series in Series)
        {
            if (series is null || string.IsNullOrWhiteSpace(series.Key) || string.IsNullOrWhiteSpace(series.Label) || !seriesKeys.Add(series.Key)
                || series.Values is null || series.Values.Count != Labels.Count)
                throw new ArgumentException("Every chart series requires a unique key, readable label and one value per point label.", nameof(Series));
            if (series.Maximum is <= 0 || series.Maximum < series.Values.DefaultIfEmpty(0).Max())
                throw new ArgumentException("An explicit chart maximum must be positive and include every value.", nameof(Series));
        }
        KnownSeries.IntersectWith(seriesKeys);
        HiddenSeries.IntersectWith(seriesKeys);
        SeriesOrder.RemoveAll(key => !seriesKeys.Contains(key));
        foreach (var series in Series)
        {
            if (!SeriesOrder.Contains(series.Key,StringComparer.Ordinal)) SeriesOrder.Add(series.Key);
            if (KnownSeries.Add(series.Key) && !series.Visible) HiddenSeries.Add(series.Key);
        }
    }
}
