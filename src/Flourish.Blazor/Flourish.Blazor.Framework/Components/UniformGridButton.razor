@namespace ArkheideSystem.Flourish.Blazor.Components

<Button AdditionalAttributes="AdditionalAttributes" Type="@Type" Disabled="Disabled" Busy="Busy" BusyLabel="@BusyLabel"
        Href="@Href" Class="@($"f-uniform-cell f-uniform-grid-button {(SupportsIcon ? "f-uniform-icon-support" : null)} {VariantClass} {Class}")" OnClick="OnClick">@Contents</Button>

@code {
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public bool? IconSupport { get; set; }
    [CascadingParameter(Name = "UniformGridIconSupport")] private bool? InheritedIconSupport { get; set; }
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public UniformGridVariant? Variant { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string BusyLabel { get; set; } = "Working...";
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private bool SupportsIcon => IconSupport ?? InheritedIconSupport ?? !string.IsNullOrWhiteSpace(Icon);
    private RenderFragment Contents => Internal.UniformGridContent.Create(Title, Busy ? string.Empty : Icon, Text, ChildContent, SupportsIcon);
    private string? VariantClass => Variant switch
    {
        null => null,
        UniformGridVariant.Elevated => "f-uniform-variant-elevated",
        UniformGridVariant.Filled => "f-uniform-variant-filled",
        UniformGridVariant.Outlined => "f-uniform-variant-outlined",
        UniformGridVariant.Danger => "f-uniform-variant-danger",
        _ => throw new ArgumentOutOfRangeException(nameof(Variant))
    };
}
