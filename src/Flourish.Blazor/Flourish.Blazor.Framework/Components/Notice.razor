@namespace ArkheideSystem.Flourish.Blazor.Components
@using ArkheideSystem.Flourish.Abstract
@inherits TextComponentBase

<div @attributes="AdditionalAttributes" class="f-notice f-notice-@Severity.ToString().ToLowerInvariant() @(Subtle ? "f-notice-subtle" : null) @(Actions is not null ? "f-notice-with-actions" : null) @Class"
     role="@(Role ?? (Announce ? !Subtle && Severity is NotificationSeverity.Error or NotificationSeverity.Warning ? "alert" : "status" : null))">
    @if (Actions is null)
    {
        <strong class="f-notice-title">@EffectiveTitle</strong>
        <div class="f-notice-body">@ChildContent</div>
    }
    else
    {
        <div class="f-notice-content">
            <strong class="f-notice-title">@EffectiveTitle</strong>
            @if (ChildContent is not null)
            {
                <div class="f-notice-body">@ChildContent</div>
            }
        </div>
        <div class="f-notice-actions">@Actions</div>
    }
</div>

@code {
    private string EffectiveTitle => string.IsNullOrWhiteSpace(Title)
        ? Ui("Notice_" + Severity, Severity.ToString()) : Title;
    [Parameter] public NotificationSeverity Severity { get; set; } = NotificationSeverity.Information;
    [Parameter] public bool Announce { get; set; } = true;
    [Parameter] public string? Role { get; set; }
    [Parameter] public bool Subtle { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Operation controls beside the message. Text wraps within its column while actions remain on the same row.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(Severity)) throw new ArgumentOutOfRangeException(nameof(Severity));
    }
}
