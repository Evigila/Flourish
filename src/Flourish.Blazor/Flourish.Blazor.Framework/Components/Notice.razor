@namespace ArkheideSystem.Flourish.Blazor.Components
@using ArkheideSystem.Flourish.Abstract
@inherits TextComponentBase

<div @attributes="AdditionalAttributes" class="f-notice f-notice-@Severity.ToString().ToLowerInvariant() @(Subtle ? "f-notice-subtle" : null) @Class"
     role="@(Role ?? (Announce ? !Subtle && Severity is NotificationSeverity.Error or NotificationSeverity.Warning ? "alert" : "status" : null))">
    <strong class="f-notice-title">@EffectiveTitle</strong>
    <div class="f-notice-body">@ChildContent</div>
</div>

@code {
    private string EffectiveTitle => string.IsNullOrWhiteSpace(Title)
        ? Ui("Notice_" + Severity, Severity.ToString()) : Title;
    [Parameter] public NotificationSeverity Severity { get; set; } = NotificationSeverity.Information;
    [Parameter] public bool Announce { get; set; } = true;
    [Parameter] public string? Role { get; set; }
    [Parameter] public bool Subtle { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(Severity)) throw new ArgumentOutOfRangeException(nameof(Severity));
    }
}
