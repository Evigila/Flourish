@implements IAsyncDisposable
@inject IJSRuntime JS
@namespace ArkheideSystem.Flourish.Blazor.Components
@inherits TextComponentBase

<nav @attributes="AdditionalAttributes" id="@navigatorId" @ref="root" class="f-section-navigator @Class" aria-label="@EffectiveLabel" data-content-id="@ContentId" hidden="@(Entries.Count == 0)">
    <ul>
        @foreach (var entry in Entries)
        {
            <li @key="entry.Id"><a class="f-section-link" href="@($"#{Uri.EscapeDataString(entry.Id)}")" aria-label="@entry.Title" aria-describedby="@($"{navigatorId}-{entry.Id}")">
                <span class="f-section-dot" aria-hidden="true"></span>
                <span id="@($"{navigatorId}-{entry.Id}")" class="f-section-label" role="tooltip">@entry.Title</span>
            </a></li>
        }
    </ul>
</nav>

@code {
    private string EffectiveLabel => DefaultText(nameof(Label), Label, "Shell_PageContents", "On this page");
    public sealed record Entry(string Id, string Title);
    [Parameter, EditorRequired] public string ContentId { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<Entry>? Items { get; set; }
    [Parameter] public string Label { get; set; } = "On this page";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private readonly string navigatorId = "section-navigation-" + Guid.NewGuid().ToString("N");
    private IReadOnlyList<Entry> discovered = Array.Empty<Entry>();
    private IReadOnlyList<Entry> Entries => Items ?? discovered;
    private ElementReference root;
    private IJSObjectReference? module;
    private Task<IJSObjectReference?>? moduleLoading;
    private DotNetObjectReference<SectionNavigator>? reference;
    private bool disposed;
    private string? previousContentId;

    protected override void OnParametersSet()
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(ContentId);
        if (ContentId.Any(char.IsWhiteSpace)) throw new ArgumentException("The scroll region must have a valid HTML identifier.", nameof(ContentId));
        if (previousContentId != ContentId) discovered = Array.Empty<Entry>();
        previousContentId = ContentId;
        if (Items is null) return;
        var ids = new HashSet<string>(StringComparer.Ordinal);
        foreach (var entry in Items)
        {
            ArgumentException.ThrowIfNullOrWhiteSpace(entry.Id);
            ArgumentException.ThrowIfNullOrWhiteSpace(entry.Title);
            if (entry.Id.Any(char.IsWhiteSpace) || !ids.Add(entry.Id)) throw new ArgumentException("Section targets must be unique HTML identifiers.", nameof(Items));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        try
        {
            var activeModule = await GetModuleAsync();
            if (disposed || activeModule is null) return;
            reference ??= DotNetObjectReference.Create(this);
            await activeModule.InvokeVoidAsync("synchronize", root, ContentId, Items is null, reference);
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }

    private async Task<IJSObjectReference?> GetModuleAsync()
    {
        if (module is not null) return module;
        var loading = moduleLoading ??= ImportModuleAsync();
        try { return await loading; }
        finally { if (ReferenceEquals(moduleLoading, loading)) moduleLoading = null; }
    }
    private async Task<IJSObjectReference?> ImportModuleAsync()
    {
        var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor.Framework/section-navigator.js");
        if (disposed) { await imported.DisposeAsync(); return null; }
        module = imported;
        return imported;
    }

    [JSInvokable]
    public Task UpdateSectionsAsync(Entry[] entries)
    {
        if (disposed || Items is not null || discovered.SequenceEqual(entries)) return Task.CompletedTask;
        discovered = entries;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        base.Dispose();
        disposed = true;
        try
        {
            if (module is not null) { await module.InvokeVoidAsync("detach", root); await module.DisposeAsync(); }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
        finally { reference?.Dispose(); }
    }
}
