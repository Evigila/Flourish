@inherits TextComponentBase
@using ArkheideSystem.Flourish.Blazor.Hosting
@implements IAsyncDisposable
@inject ApplicationOptions Options
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject ICommandDispatcher Commands

<div @ref="root" lang="@Texts.Culture" class="f-root @Theme?.CssClass f-shell @(HasNavigationTree ? "f-has-navigation-tree" : "") @(!Options.TopBar.Enabled ? "f-no-titlebar" : "") @(!PrimaryEntries.Any() && !FixedEntries.Any() ? "f-no-navigation" : !HasSecondary ? "f-no-secondary" : "")"
     style="@RootStyle" data-navigation-open="@navigationOpen.ToString().ToLowerInvariant()" data-f-document-shell="@(OwnsDocument ? "" : null)">
    <a class="f-skip-link" href="#@contentId">@SkipLabelText</a>
    @if (Options.TopBar.Enabled)
    {
        <header class="f-titlebar">
            @if (Options.TopBar.NavigationToggle && HasSecondary)
            {
                <button type="button" class="f-icon-button" aria-label="@MenuLabelText" aria-expanded="@navigationOpen.ToString().ToLowerInvariant()" aria-controls="@navigationId" @onclick="ToggleNavigation"><Icon Name="menu" /></button>
            }
            @if (Options.TopBar.DisplayLogo || Options.TopBar.DisplayProjectName)
            {
                <a class="f-application-brand" href="@HomeHref" aria-label="@(ProjectName)">
                    @if (Options.TopBar.DisplayLogo)
                    {
                        <span class="f-application-logo">
                            @if (TitleBarBrand is not null) { @TitleBarBrand }
                            else { <img src="@Options.Project.LogoPath" alt="@Options.Project.LogoAlternativeText" /> }
                        </span>
                    }
                    @if (Options.TopBar.DisplayProjectName)
                    {
                        <span class="f-application-title">@(ProjectName)</span>
                    }
                </a>
            }
            @if (TitleBarStart is not null || Options.TopBar.LeftItems.Count > 0)
            {
                <div class="f-titlebar-start f-topbar-slot">
                    @TitleBarStart
                    @foreach (var placement in Options.TopBar.LeftItems) { <DynamicComponent Type="@placement.ComponentType" /> }
                </div>
            }
            @if (Options.TopBar.MenuItems.Count > 0 || Options.TopBar.CenterItems.Count > 0)
            {
                <div class="f-titlebar-center f-topbar-slot">
                    @foreach (var menu in Options.TopBar.MenuItems)
                    {
                        <ActionMenu Strength="@Strength" Label="@Label(menu, menu.Label)" Actions="@CreateMenuActions(menu)" OpenOnHover="true">
                            <TriggerContent>@Label(menu, menu.Label) <ExpansionIndicator /></TriggerContent>
                        </ActionMenu>
                    }
                    @foreach (var placement in Options.TopBar.CenterItems) { <DynamicComponent Type="@placement.ComponentType" /> }
                </div>
            }
            @if (Options.TopBar.Search)
            {
                <form class="f-title-search" role="search" @onsubmit="SubmitSearch" @onsubmit:preventDefault>
                    <label class="f-sr-only" for="@searchId">@SearchCaption</label>
                    <input id="@searchId" type="search" @bind="search" />
                    <button type="submit" class="f-icon-button" aria-label="@SearchCaption"><Icon Name="search" /></button>
                </form>
            }
            <div class="f-titlebar-end f-topbar-slot">
                @foreach (var placement in Options.TopBar.RightItems) { <DynamicComponent Type="@placement.ComponentType" /> }
                @TitleBarEnd
            </div>
        </header>
    }
    @if (PrimaryEntries.Any() || FixedEntries.Any())
    {
        <aside id="@navigationId" class="f-navigation">
            <div class="f-primary-preview-slot" data-f-primary-preview-slot>
            <nav class="f-primary-navigation" aria-label="@MainNavigationLabelText" data-f-primary-preview="@(PrimaryNavigationPreview ? "" : null)">
                <div class="f-primary-navigation-main">
                    @foreach (var entry in PrimaryEntries) { @RenderPrimaryEntry(entry) }
                </div>
                @if (FixedEntries.Any())
                {
                    <div class="f-primary-navigation-fixed">
                        @foreach (var entry in FixedEntries) { @RenderPrimaryEntry(entry) }
                    </div>
                }
            </nav>
            </div>
            @if (HasSecondary && ActiveEntry is { } active)
            {
                <nav class="f-secondary-navigation" aria-label="@SecondaryNavigationLabelText">
                    <NavigationTree Items="active.SecondaryItems" CurrentPath="@Path" ItemLabel="@(item => Label(item, item.Label))"
                                    ExpandLabel="@ExpandNavigationLabelText" CollapseLabel="@CollapseNavigationLabelText" Navigated="CloseNavigation" />
                </nav>
            }
        </aside>
        <button class="f-navigation-backdrop" type="button" aria-label="@CloseMenuLabelText" tabindex="@(navigationOpen ? 0 : -1)" @onclick="CloseNavigation"></button>
    }
    <main id="@contentId" class="f-content-scroll" tabindex="-1" @ref="content">
        @ChildContent
    </main>
    <SectionNavigator ContentId="@contentId" />
    <BackToTop ContentId="@contentId" />
</div>

@code {
    /// <summary>Constrains a full application to the viewport; embedded shells leave this disabled.</summary>
    [Parameter] public bool OwnsDocument { get; set; }
    /// <summary>Previews primary icons and labels on mouse hover or keyboard focus without moving page content.</summary>
    [Parameter] public bool PrimaryNavigationPreview { get; set; } = true;
    [Parameter] public string? ApplicationTitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? TitleBarEnd { get; set; }
    [Parameter] public RenderFragment? TitleBarBrand { get; set; }
    [Parameter] public RenderFragment? TitleBarStart { get; set; }
    [Parameter] public EventCallback<string> OnSearch { get; set; }
    [Parameter] public string HomeHref { get; set; } = "/";
    [Parameter] public string SkipLabel { get; set; } = "Skip to content";
    [Parameter] public string MenuLabel { get; set; } = "Open navigation";
    [Parameter] public PopupStrength Strength { get; set; } = PopupStrength.Weak;
    [Parameter] public string CloseMenuLabel { get; set; } = "Close navigation";
    [Parameter] public string MainNavigationLabel { get; set; } = "Main navigation";
    [Parameter] public string SecondaryNavigationLabel { get; set; } = "Secondary navigation";
    [Parameter] public string ExpandNavigationLabel { get; set; } = "Expand";
    [Parameter] public string CollapseNavigationLabel { get; set; } = "Collapse";

    private string ProjectName => ApplicationTitle ?? (Options.Project.NameText is { } text ? Texts.Get(text) : Options.Project.Name);
    private string SearchCaption => Options.TopBar.SearchText is { } text ? Texts.Get(text) : Options.TopBar.SearchLabel;
    private string Label(object owner, string literal) => Options.LabelReferences.TryGetValue(owner, out var text) ? Texts.Get(text) : literal;
    private string SkipLabelText => DefaultText(nameof(SkipLabel), SkipLabel, "Shell_Skip", "Skip to content");
    private string MenuLabelText => DefaultText(nameof(MenuLabel), MenuLabel, "Shell_OpenNavigation", "Open navigation");
    private string CloseMenuLabelText => DefaultText(nameof(CloseMenuLabel), CloseMenuLabel, "Shell_CloseNavigation", "Close navigation");
    private string MainNavigationLabelText => DefaultText(nameof(MainNavigationLabel), MainNavigationLabel, "Shell_MainNavigation", "Main navigation");
    private string SecondaryNavigationLabelText => DefaultText(nameof(SecondaryNavigationLabel), SecondaryNavigationLabel, "Shell_SecondaryNavigation", "Secondary navigation");
    private string ExpandNavigationLabelText => DefaultText(nameof(ExpandNavigationLabel), ExpandNavigationLabel, "Shell_Expand", "Expand");
    private string CollapseNavigationLabelText => DefaultText(nameof(CollapseNavigationLabel), CollapseNavigationLabel, "Shell_Collapse", "Collapse");

    private readonly string contentId = "content-" + Guid.NewGuid().ToString("N");
    private readonly string navigationId = "nav-" + Guid.NewGuid().ToString("N");
    private readonly string searchId = "search-" + Guid.NewGuid().ToString("N");
    private ElementReference root, content;
    private IJSObjectReference? module;
    private IThemeProvider? Theme;
    private bool disposed, navigationOpen, resetScroll, navigationChanged;
    private string search = string.Empty;
    private IReadOnlyList<NavigationEntry>? previousPrimary;
    private NavigationEntry? activeEntry;
    private IReadOnlyList<NavigationEntry> PrimaryEntries => Options.PrimaryNavigation;
    private IReadOnlyList<NavigationEntry> FixedEntries => Options.FixedNavigation;
    private bool HasSecondary => ActiveEntry?.SecondaryItems.Count > 0;
    private bool HasNavigationTree => ActiveEntry?.SecondaryItems.Any(item => item.ChildItems.Count > 0) == true;
    private string Path => NavigationSelection.NormalizePath("/" + Navigation.ToBaseRelativePath(Navigation.Uri));
    private string RootStyle => $"--f-content-width:{Options.Layout.ContentWidth}px{(Theme is null ? null : ";" + Theme.CssVariables)}";

    private NavigationEntry? ActiveEntry => activeEntry;

    private void RefreshSelection()
    {
        activeEntry = null;
        var bestLength = -1;
        foreach (var entry in PrimaryEntries.Concat(FixedEntries))
        {
            if (entry.Kind != NavigationEntryKind.Route || entry.Disabled) continue;
            var path = NavigationSelection.FindActivePath(entry.SecondaryItems, Path);
            var length = Math.Max(path.LastOrDefault() is { } item ? NavigationSelection.Specificity(item) : -1,
                entry.Href is not null && NavigationSelection.Matches(Path, entry.Href, entry.Exact) ? NavigationSelection.NormalizePath(entry.Href).Length : -1);
            if (length <= bestLength) continue;
            activeEntry = entry;
            bestLength = length;
        }
        activeEntry ??= PrimaryEntries.FirstOrDefault(entry => entry.Kind == NavigationEntryKind.Route && !entry.Disabled);
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Theme = Services.GetService(typeof(IThemeProvider)) as IThemeProvider;
        if (Theme is not null) Theme.Changed += ThemeChanged;
        Navigation.LocationChanged += LocationChanged;
    }

    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(Strength)) throw new ArgumentOutOfRangeException(nameof(Strength));
        var current = PrimaryEntries;
        if (!ReferenceEquals(previousPrimary, current))
        {
            previousPrimary = current;
            navigationChanged = true;
        }
        RefreshSelection();
    }

    private RenderFragment RenderPrimaryEntry(NavigationEntry entry) => builder =>
    {
        var label = Label(entry, entry.Label);
        var selected = ReferenceEquals(entry, ActiveEntry) || entry == ActiveEntry;
        var sequence = 0;
        if (entry.Kind == NavigationEntryKind.Route)
        {
            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(sequence++, "class", $"f-primary-item {(selected ? "is-selected" : "")}");
            builder.AddAttribute(sequence++, "href", entry.Disabled ? null : entry.Href);
            builder.AddAttribute(sequence++, "aria-current", selected ? "true" : null);
            builder.AddAttribute(sequence++, "aria-disabled", entry.Disabled ? "true" : null);
            builder.AddAttribute(sequence++, "aria-label", label);
            builder.AddAttribute(sequence++, "title", PrimaryNavigationPreview ? null : label);
            builder.AddAttribute(sequence++, "tabindex", entry.Disabled ? -1 : 0);
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, CloseNavigation));
        }
        else
        {
            builder.OpenElement(sequence++, "button");
            builder.AddAttribute(sequence++, "type", "button");
            builder.AddAttribute(sequence++, "class", "f-primary-item f-primary-command");
            builder.AddAttribute(sequence++, "aria-label", label);
            builder.AddAttribute(sequence++, "title", PrimaryNavigationPreview ? null : label);
            builder.AddAttribute(sequence++, "disabled", entry.Disabled || !CanExecute(entry));
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => ExecuteAsync(entry, CommandSource.Navigation)));
        }
        builder.OpenComponent<Icon>(sequence++);
        builder.AddAttribute(sequence++, "Name", entry.Icon);
        builder.CloseComponent();
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "f-primary-preview-copy");
        builder.AddAttribute(sequence++, "aria-hidden", "true");
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "f-primary-preview-label");
        builder.AddContent(sequence++, label);
        builder.CloseElement();
        if (entry.Disabled || entry.Kind != NavigationEntryKind.Route && !CanExecute(entry))
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "f-primary-preview-reason");
            builder.AddContent(sequence++, Ui("Navigation_UnavailableStatus", "Unavailable"));
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
    };

    private bool CanExecute(NavigationEntry entry) => entry.CommandKey is not null && Commands.CanExecute(entry.CommandKey, source: CommandSource.Navigation);

    private IReadOnlyList<MenuAction> CreateMenuActions(TopBarMenu menu) => menu.Items
        .Select(item => new MenuAction(Label(item, item.Label), () => ExecuteAsync(item.CommandKey, CommandSource.TitleBar),
            item.Disabled || !Commands.CanExecute(item.CommandKey, source: CommandSource.TitleBar), item.Destructive))
        .ToArray();

    private Task ExecuteAsync(NavigationEntry entry, CommandSource source) =>
        entry.CommandKey is null ? Task.CompletedTask : ExecuteAsync(entry.CommandKey, source);

    private async Task ExecuteAsync(string commandKey, CommandSource source)
    {
        var result = await Commands.ExecuteAsync(commandKey, source: source);
        if (result.Status == CommandExecutionStatus.Failed && result.Exception is not null) throw result.Exception;
    }

    private void ThemeChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);
    private void LocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(() =>
    {
        navigationOpen = false;
        resetScroll = true;
        RefreshSelection();
        StateHasChanged();
    });
    private void ToggleNavigation() => navigationOpen = !navigationOpen;
    private void CloseNavigation() => navigationOpen = false;
    private Task SubmitSearch() => OnSearch.InvokeAsync(search);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        if (module is null)
        {
            var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor.Framework/shell.js");
            if (disposed) { await imported.DisposeAsync(); return; }
            module = imported;
            navigationChanged = true;
        }
        if (navigationChanged) { await module.InvokeVoidAsync("attach", root, content); navigationChanged = false; }
        await module.InvokeVoidAsync("synchronize", root, navigationOpen, resetScroll);
        resetScroll = false;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        disposed = true;
        Navigation.LocationChanged -= LocationChanged;
        if (Theme is not null) Theme.Changed -= ThemeChanged;
        try { if (module is not null) { await module.InvokeVoidAsync("detach", root); await module.DisposeAsync(); } }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }
}
