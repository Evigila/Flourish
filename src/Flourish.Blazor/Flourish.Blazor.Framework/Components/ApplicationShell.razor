@using ArkheideSystem.Flourish.Blazor.Hosting
@implements IAsyncDisposable
@inject ApplicationOptions Options
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject ICommandDispatcher Commands

<div @ref="root" class="f-root @Theme?.CssClass f-shell @(HasNavigationTree ? "f-has-navigation-tree" : "") @(!Options.TopBar.Enabled ? "f-no-titlebar" : "") @(!PrimaryEntries.Any() && !FixedEntries.Any() ? "f-no-navigation" : !HasSecondary ? "f-no-secondary" : "")"
     style="@RootStyle" data-navigation-open="@navigationOpen.ToString().ToLowerInvariant()" data-f-document-shell="@(OwnsDocument ? "" : null)">
    <a class="f-skip-link" href="#@contentId">@SkipLabel</a>
    @if (Options.TopBar.Enabled)
    {
        <header class="f-titlebar">
            @if (Options.TopBar.NavigationToggle && HasSecondary)
            {
                <button type="button" class="f-icon-button" aria-label="@MenuLabel" aria-expanded="@navigationOpen.ToString().ToLowerInvariant()" aria-controls="@navigationId" @onclick="ToggleNavigation"><Icon Name="menu" /></button>
            }
            <a class="f-application-brand" href="@HomeHref" aria-label="@(ApplicationTitle ?? Options.TopBar.AppName)">
                @if (TitleBarBrand is not null)
                {
                    <span class="f-application-logo">@TitleBarBrand</span>
                }
                else if (Options.TopBar.IconPath is not null)
                {
                    <span class="f-application-logo"><img src="@Options.TopBar.IconPath" alt="@Options.TopBar.IconAlternativeText" /></span>
                }
                <span class="f-application-title">@(ApplicationTitle ?? Options.TopBar.AppName)</span>
            </a>
            @if (TitleBarStart is not null || Options.TopBar.LeftItems.Count > 0)
            {
                <div class="f-titlebar-start">
                    @TitleBarStart
                    @foreach (var placement in Options.TopBar.LeftItems) { <DynamicComponent Type="@placement.ComponentType" /> }
                </div>
            }
            @if (Options.TopBar.MenuItems.Count > 0 || Options.TopBar.CenterItems.Count > 0)
            {
                <div class="f-titlebar-center">
                    @foreach (var menu in Options.TopBar.MenuItems)
                    {
                        <ActionMenu Label="@menu.Label" Actions="@CreateMenuActions(menu)" OpenOnHover="true">
                            <TriggerContent>@menu.Label <ExpansionIndicator /></TriggerContent>
                        </ActionMenu>
                    }
                    @foreach (var placement in Options.TopBar.CenterItems) { <DynamicComponent Type="@placement.ComponentType" /> }
                </div>
            }
            @if (Options.TopBar.Search)
            {
                <form class="f-title-search" role="search" @onsubmit="SubmitSearch" @onsubmit:preventDefault>
                    <label class="f-sr-only" for="@searchId">@Options.TopBar.SearchLabel</label>
                    <input id="@searchId" type="search" @bind="search" />
                    <button type="submit" class="f-icon-button" aria-label="@Options.TopBar.SearchLabel"><Icon Name="search" /></button>
                </form>
            }
            <div class="f-titlebar-end">
                @foreach (var placement in Options.TopBar.RightItems) { <DynamicComponent Type="@placement.ComponentType" /> }
                @TitleBarEnd
            </div>
        </header>
    }
    @if (PrimaryEntries.Any() || FixedEntries.Any())
    {
        <aside id="@navigationId" class="f-navigation">
            <nav class="f-primary-navigation" aria-label="@MainNavigationLabel">
                <div class="f-primary-navigation-main">
                    @foreach (var entry in PrimaryEntries) { @RenderPrimaryEntry(entry) }
                </div>
                @if (FixedEntries.Any())
                {
                    <div class="f-primary-navigation-fixed">
                        @foreach (var entry in FixedEntries) { @RenderPrimaryEntry(entry) }
                    </div>
                }
            </nav>
            @if (HasSecondary && ActiveEntry is { } active)
            {
                <nav class="f-secondary-navigation" aria-label="@SecondaryNavigationLabel">
                    <ul class="f-secondary-list">
                        @foreach (var item in active.SecondaryItems) { @RenderNavigationItem(item) }
                    </ul>
                </nav>
            }
        </aside>
        <button class="f-navigation-backdrop" type="button" aria-label="@CloseMenuLabel" tabindex="@(navigationOpen ? 0 : -1)" @onclick="CloseNavigation"></button>
    }
    <main id="@contentId" class="f-content-scroll" tabindex="-1" @ref="content">
        @ChildContent
    </main>
    <SectionNavigator ContentId="@contentId" />
</div>

@code {
    /// <summary>Constrains a full application to the viewport; embedded shells leave this disabled.</summary>
    [Parameter] public bool OwnsDocument { get; set; }
    [Parameter] public IReadOnlyList<NavigationGroup>? NavigationGroups { get; set; }
    [Parameter] public string? ApplicationTitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? TitleBarEnd { get; set; }
    [Parameter] public RenderFragment? TitleBarBrand { get; set; }
    [Parameter] public RenderFragment? TitleBarStart { get; set; }
    [Parameter] public EventCallback<string> OnSearch { get; set; }
    [Parameter] public string HomeHref { get; set; } = "/";
    [Parameter] public string SkipLabel { get; set; } = "Skip to content";
    [Parameter] public string MenuLabel { get; set; } = "Open navigation";
    [Parameter] public string CloseMenuLabel { get; set; } = "Close navigation";
    [Parameter] public string MainNavigationLabel { get; set; } = "Main navigation";
    [Parameter] public string SecondaryNavigationLabel { get; set; } = "Secondary navigation";
    [Parameter] public string ExpandNavigationLabel { get; set; } = "Expand";
    [Parameter] public string CollapseNavigationLabel { get; set; } = "Collapse";

    private readonly string contentId = "content-" + Guid.NewGuid().ToString("N");
    private readonly string navigationId = "nav-" + Guid.NewGuid().ToString("N");
    private readonly string searchId = "search-" + Guid.NewGuid().ToString("N");
    private ElementReference root, content;
    private IJSObjectReference? module;
    private IThemeProvider? Theme;
    private bool disposed, navigationOpen, resetScroll, navigationChanged;
    private string search = string.Empty;
    private IReadOnlyList<NavigationEntry>? previousPrimary;
    private NavigationEntry? activeEntry;
    private string? selectionPath;
    private IReadOnlyList<NavigationItem> activeItems = Array.Empty<NavigationItem>();
    private readonly HashSet<string> expandedItems = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> panelIds = new(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<NavigationEntry> PrimaryEntries => NavigationGroups is not null
        ? ConvertLegacy(NavigationGroups)
        : Options.PrimaryNavigation.Count > 0 ? Options.PrimaryNavigation : ConvertLegacy(Options.LegacyNavigation);
    private IReadOnlyList<NavigationEntry> FixedEntries => NavigationGroups is null ? Options.FixedNavigation : Array.Empty<NavigationEntry>();
    private bool HasSecondary => ActiveEntry?.SecondaryItems.Count > 0;
    private bool HasNavigationTree => ActiveEntry?.SecondaryItems.Any(item => item.ChildItems.Count > 0) == true;
    private NavigationItem? ActiveItem => activeItems.LastOrDefault();
    private string Path => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
    private string RootStyle => $"--f-content-width:{Options.Layout.ContentWidth}px{(Theme is null ? null : ";" + Theme.CssVariables)}";

    private NavigationEntry? ActiveEntry => activeEntry;

    private IReadOnlyList<NavigationItem> FindActivePath(IReadOnlyList<NavigationItem> items)
    {
        IReadOnlyList<NavigationItem> best = Array.Empty<NavigationItem>();
        foreach (var item in items)
        {
            if (item.Disabled) continue;
            var children = FindActivePath(item.ChildItems);
            IReadOnlyList<NavigationItem> candidate = Matches(item) ? [item] : Array.Empty<NavigationItem>();
            if (children.Count > 0 && (candidate.Count == 0 || children[^1].Href.Length >= item.Href.Length))
                candidate = [item, .. children];
            if (candidate.Count > 0 && (best.Count == 0 || candidate[^1].Href.Length > best[^1].Href.Length)) best = candidate;
        }
        return best;
    }

    private void RefreshSelection()
    {
        var previousPath = activeItems.Select(item => item.Href).ToArray();
        activeEntry = null;
        activeItems = Array.Empty<NavigationItem>();
        var bestLength = -1;
        var primary = PrimaryEntries;
        foreach (var entry in primary.Concat(FixedEntries))
        {
            if (entry.Kind != NavigationEntryKind.Route || entry.Disabled) continue;
            var path = FindActivePath(entry.SecondaryItems);
            var length = Math.Max(path.LastOrDefault()?.Href.Length ?? -1, Matches(entry) ? entry.Href?.Length ?? -1 : -1);
            if (length <= bestLength) continue;
            activeEntry = entry;
            activeItems = path;
            bestLength = length;
        }
        activeEntry ??= primary.FirstOrDefault(entry => entry.Kind == NavigationEntryKind.Route && !entry.Disabled);
        if (selectionPath != Path || !previousPath.SequenceEqual(activeItems.Select(item => item.Href), StringComparer.OrdinalIgnoreCase))
            foreach (var item in activeItems.Where(item => item.ChildItems.Count > 0)) expandedItems.Add(item.Href);
        selectionPath = Path;
    }

    private string PanelId(NavigationItem item)
    {
        if (!panelIds.TryGetValue(item.Href, out var id)) panelIds.Add(item.Href, id = "nav-children-" + Guid.NewGuid().ToString("N"));
        return id;
    }

    private void ToggleItem(NavigationItem item)
    {
        if (!expandedItems.Remove(item.Href)) expandedItems.Add(item.Href);
    }

    private RenderFragment RenderNavigationItem(NavigationItem item, bool third = false, bool parentDisabled = false)
    {
        var disabled = parentDisabled || item.Disabled;
        var expanded = expandedItems.Contains(item.Href);
        var selected = !disabled && activeItems.Contains(item);
        var primaryAttributes = new Dictionary<string, object> { ["title"] = item.Label };
        if (selected) primaryAttributes["aria-current"] = item == ActiveItem ? "page" : "true";
        return @<li class="f-navigation-node" @key="item.Href">
            @if (item.ChildItems.Count > 0)
            {
                <SplitButton Class="f-secondary-row" Href="@item.Href" Text="@item.Label" Icon="@item.Icon"
                             PrimaryClass="@($"f-secondary-item{(third ? " f-third-item" : null)}")" SecondaryClass="f-secondary-toggle"
                             Selected="selected" Disabled="disabled" Expanded="expanded" SecondaryControls="@PanelId(item)"
                             SecondaryLabel="@($"{(expanded ? CollapseNavigationLabel : ExpandNavigationLabel)} {item.Label}")"
                             PrimaryAttributes="primaryAttributes"
                             SecondaryAttributes="@(new Dictionary<string, object> { ["title"] = item.Label, ["data-navigation-target"] = item.Href })"
                             OnClick="CloseNavigation" OnSecondaryClick="() => ToggleItem(item)">
                </SplitButton>
            }
            else
            {
                <div class="f-secondary-row">
                    <a href="@(disabled ? null : item.Href)" class="@($"f-secondary-item{(third ? " f-third-item" : null)}{(selected ? " is-selected" : null)}")"
                       aria-current="@(selected ? "page" : null)" aria-disabled="@(disabled ? "true" : null)" title="@item.Label"
                       tabindex="@(disabled ? -1 : 0)" @onclick="() => { if (!disabled) CloseNavigation(); }"><Icon Name="@item.Icon" /><span class="f-navigation-label">@item.Label</span></a>
                </div>
            }
            @if (item.ChildItems.Count > 0)
            {
                <ul id="@PanelId(item)" class="f-third-navigation" hidden="@(!expanded)">
                    @foreach (var child in item.ChildItems) { @RenderNavigationItem(child, true, disabled) }
                </ul>
            }
        </li>;
    }

    protected override void OnInitialized()
    {
        Theme = Services.GetService(typeof(IThemeProvider)) as IThemeProvider;
        if (Theme is not null) Theme.Changed += ThemeChanged;
        Navigation.LocationChanged += LocationChanged;
    }

    protected override void OnParametersSet()
    {
        var current = PrimaryEntries;
        if (!ReferenceEquals(previousPrimary, current))
        {
            previousPrimary = current;
            navigationChanged = true;
        }
        RefreshSelection();
    }

    private RenderFragment RenderPrimaryEntry(NavigationEntry entry) => builder =>
    {
        var selected = ReferenceEquals(entry, ActiveEntry) || entry == ActiveEntry;
        var sequence = 0;
        if (entry.Kind == NavigationEntryKind.Route)
        {
            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(sequence++, "class", $"f-primary-item {(selected ? "is-selected" : "")}");
            builder.AddAttribute(sequence++, "href", entry.Disabled ? null : entry.Href);
            builder.AddAttribute(sequence++, "aria-current", selected ? "true" : null);
            builder.AddAttribute(sequence++, "aria-disabled", entry.Disabled ? "true" : null);
            builder.AddAttribute(sequence++, "aria-label", entry.Label);
            builder.AddAttribute(sequence++, "title", entry.Label);
            builder.AddAttribute(sequence++, "tabindex", entry.Disabled ? -1 : 0);
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, CloseNavigation));
        }
        else
        {
            builder.OpenElement(sequence++, "button");
            builder.AddAttribute(sequence++, "type", "button");
            builder.AddAttribute(sequence++, "class", "f-primary-item f-primary-command");
            builder.AddAttribute(sequence++, "aria-label", entry.Label);
            builder.AddAttribute(sequence++, "title", entry.Label);
            builder.AddAttribute(sequence++, "disabled", entry.Disabled || !CanExecute(entry));
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => ExecuteAsync(entry, CommandSource.Navigation)));
        }
        builder.OpenComponent<Icon>(sequence++);
        builder.AddAttribute(sequence++, "Name", entry.Icon);
        builder.CloseComponent();
        builder.CloseElement();
    };

    private bool Matches(NavigationItem item) => !item.Disabled && Matches(item.Href, item.Exact);
    private bool Matches(NavigationEntry entry) => !entry.Disabled && entry.Href is not null && Matches(entry.Href, entry.Exact);
    private bool Matches(string href, bool exact)
    {
        var normalized = href.TrimEnd('/') is "" ? "/" : href.TrimEnd('/');
        return string.Equals(Path, normalized, StringComparison.OrdinalIgnoreCase)
            || (!exact && normalized != "/" && Path.StartsWith(normalized + "/", StringComparison.OrdinalIgnoreCase));
    }

    private bool CanExecute(NavigationEntry entry) => entry.CommandKey is not null && Commands.CanExecute(entry.CommandKey, source: CommandSource.Navigation);

    private IReadOnlyList<MenuAction> CreateMenuActions(TopBarMenu menu) => menu.Items
        .Select(item => new MenuAction(item.Label, () => ExecuteAsync(item.CommandKey, CommandSource.TitleBar),
            item.Disabled || !Commands.CanExecute(item.CommandKey, source: CommandSource.TitleBar), item.Destructive))
        .ToArray();

    private Task ExecuteAsync(NavigationEntry entry, CommandSource source) =>
        entry.CommandKey is null ? Task.CompletedTask : ExecuteAsync(entry.CommandKey, source);

    private async Task ExecuteAsync(string commandKey, CommandSource source)
    {
        var result = await Commands.ExecuteAsync(commandKey, source: source);
        if (result.Status == CommandExecutionStatus.Failed && result.Exception is not null) throw result.Exception;
    }

    private static IReadOnlyList<NavigationEntry> ConvertLegacy(IReadOnlyList<NavigationGroup> groups) => groups
        .Select(group =>
        {
            var first = group.Items.FirstOrDefault(item => !item.Disabled);
            return new NavigationEntry(group.Label, group.Icon, NavigationEntryKind.Route, first?.Href, Children: group.SecondaryNavigation ? group.Items : Array.Empty<NavigationItem>(), Exact: first?.Exact ?? false, Disabled: first is null);
        })
        .ToArray();

    private void ThemeChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);
    private void LocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(() =>
    {
        navigationOpen = false;
        resetScroll = true;
        RefreshSelection();
        StateHasChanged();
    });
    private void ToggleNavigation() => navigationOpen = !navigationOpen;
    private void CloseNavigation() => navigationOpen = false;
    private Task SubmitSearch() => OnSearch.InvokeAsync(search);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        if (module is null)
        {
            var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor.Framework/shell.js");
            if (disposed) { await imported.DisposeAsync(); return; }
            module = imported;
            navigationChanged = true;
        }
        if (navigationChanged) { await module.InvokeVoidAsync("attach", root, content); navigationChanged = false; }
        await module.InvokeVoidAsync("synchronize", root, navigationOpen, resetScroll);
        resetScroll = false;
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Navigation.LocationChanged -= LocationChanged;
        if (Theme is not null) Theme.Changed -= ThemeChanged;
        try { if (module is not null) { await module.InvokeVoidAsync("detach", root); await module.DisposeAsync(); } }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }
}
