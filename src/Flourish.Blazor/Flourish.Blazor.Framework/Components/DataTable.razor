@inherits TextComponentBase
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@namespace ArkheideSystem.Flourish.Blazor.Components
@typeparam TItem
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_root" class="f-data" aria-busy="@(Loading ? "true" : "false")">
    @if (Searchable)
    {
        <div class="f-data-search">
            <label>
                <span>@EffectiveText.SearchBy</span>
                <select class="f-input f-select" value="@_searchColumn" @onchange="ChangeSearchColumn" aria-label="@EffectiveText.SearchBy">
                    <option value="">@EffectiveText.AllColumns</option>
                    @foreach (var column in Columns.Where(column => column.Searchable))
                    {
                        <option value="@column.Key">@column.Header</option>
                    }
                </select>
            </label>
            <label class="f-data-search-value">
                <span>@SearchLabel</span>
                <input type="search" value="@_query" @oninput="ChangeQuery" autocomplete="off" />
            </label>
        </div>
    }
    <div class="f-data-toolbar">
        @if (ShowCounts)
        {
            <div class="f-data-page-group">@Pager()</div>
        }
        <div class="f-data-tools">
            <div class="f-data-view" role="group" aria-label="@EffectiveText.Display">
                <button type="button" class="@(_view == TableView.Table ? "f-data-view-selected" : null)"
                        aria-label="@EffectiveText.List" aria-pressed="@(_view == TableView.Table ? "true" : "false")" @onclick="() => ChangeView(TableView.Table)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                    @if (_view == TableView.Table) { <span>@EffectiveText.List</span> }
                </button>
                <button type="button" class="@(_view == TableView.Cards ? "f-data-view-selected" : null)"
                        aria-label="@EffectiveText.Cards" aria-pressed="@(_view == TableView.Cards ? "true" : "false")" @onclick="() => ChangeView(TableView.Cards)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" fill="currentColor" /></svg>
                    @if (_view == TableView.Cards) { <span>@EffectiveText.Cards</span> }
                </button>
            </div>
            <details class="f-data-display">
                <summary class="f-dropdown-trigger" aria-controls="@($"{_instanceId}-display")">@EffectiveText.Display <ExpansionIndicator /></summary>
                <div id="@($"{_instanceId}-display")" class="f-data-display-options f-dropdown-panel f-menu-panel" popover="manual">
                    @foreach (var column in Columns)
                    {
                        <label class="f-dropdown-item @(!_hidden.Contains(column.Key) ? "is-selected" : null)">
                            <input type="checkbox" checked="@(!_hidden.Contains(column.Key))"
                                   data-f-display-column="@column.Key"
                                   disabled="@(!column.CanHide || (!_hidden.Contains(column.Key) && _visibleColumns.Count == 1))"
                                   @onchange="() => ToggleColumn(column.Key)" />
                            <span>@column.Header</span>
                        </label>
                    }
                </div>
            </details>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="f-data-status f-data-error" role="alert">@Error</div>
    }
    @if (Loading)
    {
        <div class="f-data-status" role="status">@LoadingText</div>
    }
    @if (_rows.Count == 0 && !Loading && string.IsNullOrWhiteSpace(Error))
    {
        <div class="f-data-empty" role="status">@EmptyText</div>
    }
    else if (_rows.Count > 0 && _view == TableView.Table)
    {
        <div class="f-data-scroll" tabindex="0" role="region" aria-label="@RecordsText">
            <table @ref="_table" class="f-data-table" data-f-table>
                <caption class="f-data-sr-only">@RecordsText</caption>
                <colgroup>
                    @for (var i = 0; i < _visibleColumns.Count; i++)
                    {
                        var column = _visibleColumns[i];
                        <col data-f-column="@column.Key" data-f-last-column="@(i == _visibleColumns.Count - 1 ? "true" : null)" />
                    }
                    <col class="f-data-spacer" />
                    @if (_hasActions) { <col class="f-data-action-column" /> }
                </colgroup>
                <thead>
                    <tr>
                        @for (var i = 0; i < _visibleColumns.Count; i++)
                        {
                            var column = _visibleColumns[i];
                            <th scope="col" data-f-column="@column.Key" data-f-last-column="@(i == _visibleColumns.Count - 1 ? "true" : null)" aria-sort="@AriaSort(column)">
                                @if (column.Sortable)
                                {
                                    <Button Variant="ButtonVariant.Quiet" Class="f-data-sort" title="@SortHint(column)" OnClick="@(_ => SortColumn(column))">
                                        <span class="f-data-sort-label">
                                            <span class="f-data-sort-text" title="@column.Header">@column.Header</span>
                                        @if (_sortKey == column.Key && _sortDirection != TableSortDirection.Default)
                                        {
                                            <span class="f-data-sort-mark" aria-hidden="true">@(_sortDirection == TableSortDirection.Descending ? "▼" : "▲")</span>
                                        }
                                        </span>
                                    </Button>
                                }
                                else
                                {
                                    <span class="f-data-cell" title="@column.Header">@column.Header</span>
                                }
                                <button class="f-data-resize" type="button" data-f-resize="@column.Key"
                                        role="slider" aria-orientation="horizontal" aria-label="@($"{EffectiveText.Width}: {column.Header}")"
                                        aria-valuemin="72" aria-valuemax="100000" aria-valuenow="72"
                                        title="@EffectiveText.ResizeHint" @onclick:stopPropagation="true"></button>
                            </th>
                        }
                        <th class="f-data-spacer" aria-hidden="true"></th>
                        @if (_hasActions) { <th class="f-data-actions"><span class="f-data-sr-only">@EffectiveText.Actions</span></th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr @key="row.Key" class="@(OnRowOpen.HasDelegate ? "f-data-openable" : null)" @ondblclick="() => Open(row.Item)">
                            @for (var i = 0; i < _visibleColumns.Count; i++)
                            {
                                <td data-f-column="@_visibleColumns[i].Key" data-f-last-column="@(i == _visibleColumns.Count - 1 ? "true" : null)"><span class="f-data-cell" title="@row.Values[i]">@Shown(row.Values[i])</span></td>
                            }
                            <td class="f-data-spacer" aria-hidden="true"></td>
                            @if (_hasActions)
                            {
                                <td class="f-data-actions" @ondblclick:stopPropagation="true">
                                    @if (row.Actions.Count > 0) { <ActionMenu Label="@($"{EffectiveText.Actions}: {row.Label}")" Actions="@row.Actions" /> }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_rows.Count > 0)
    {
        <div class="f-data-cards" role="list" aria-label="@RecordsText">
            @foreach (var row in _rows)
            {
                <article @key="row.Key" class="f-data-card @(OnRowOpen.HasDelegate ? "f-data-openable" : null)" role="listitem" @ondblclick="() => Open(row.Item)">
                    <div class="f-data-card-values">
                        @for (var i = 0; i < _visibleColumns.Count; i++)
                        {
                            <div class="f-data-card-value" title="@row.Values[i]">
                                <span class="f-data-sr-only">@_visibleColumns[i].Header: </span>@Shown(row.Values[i])
                            </div>
                        }
                    </div>
                    @if (row.Actions.Count > 0)
                    {
                        <div class="f-data-card-actions" @ondblclick:stopPropagation="true"><ActionMenu Label="@($"{EffectiveText.Actions}: {row.Label}")" Actions="@row.Actions" /></div>
                    }
                </article>
            }
        </div>
    }
    @if (ShowCounts && _processed.Count > 0)
    {
        <div class="f-data-footer">@Pager()</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = Array.Empty<TItem>();
    [Parameter, EditorRequired] public IReadOnlyList<TableColumn<TItem>> Columns { get; set; } = Array.Empty<TableColumn<TItem>>();
    [Parameter] public IReadOnlyList<RowAction<TItem>> Actions { get; set; } = Array.Empty<RowAction<TItem>>();
    [Parameter] public bool Searchable { get; set; } = true;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public TableView View { get; set; } = TableView.Table;
    [Parameter] public EventCallback<TableView> ViewChanged { get; set; }
    [Parameter] public EventCallback<TItem> OnRowOpen { get; set; }
    [Parameter] public Func<TItem, object>? ItemKey { get; set; }
    [Parameter] public Func<TItem, string>? RowLabel { get; set; }
    [Parameter] public CultureInfo Culture { get; set; } = CultureInfo.CurrentCulture;
    [Parameter] public TableText Text { get; set; } = new();
    [Parameter] public string Label { get; set; } = "Records";
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string LoadingMessage { get; set; } = "Loading…";
    [Parameter] public string? Error { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = "No items.";

    private CultureInfo EffectiveCulture => HasExplicitParameter(nameof(Culture)) ? Culture : Texts.FormatCulture;
    private string RecordsText => DefaultText(nameof(Label), Label, "Table_Label", "Records");
    private string LoadingText => DefaultText(nameof(LoadingMessage), LoadingMessage, "Table_Loading", "Loading…");
    private string EmptyText => DefaultText(nameof(EmptyMessage), EmptyMessage, "Table_Empty", "No items.");
    private TableText? localizedTableText;
    private TableText EffectiveText => HasExplicitParameter(nameof(Text)) ? Text : localizedTableText ??= new(
        SearchBy: Texts.Get(new TextReference("Flourish", "Table_SearchBy", "Search by")),
        AllColumns: Texts.Get(new TextReference("Flourish", "Table_AllColumns", "All columns")),
        SearchContent: Texts.Get(new TextReference("Flourish", "Table_SearchContent", "Content")),
        List: Texts.Get(new TextReference("Flourish", "Table_List", "List")),
        Cards: Texts.Get(new TextReference("Flourish", "Table_Cards", "Cards")),
        Display: Texts.Get(new TextReference("Flourish", "Table_Display", "Display")),
        Actions: Texts.Get(new TextReference("Flourish", "Table_Actions", "Actions")),
        Open: Texts.Get(new TextReference("Flourish", "Table_Open", "Open")),
        Items: Texts.Get(new TextReference("Flourish", "Table_Items", "Items")),
        Of: Texts.Get(new TextReference("Flourish", "Table_Of", "of")),
        Page: Texts.Get(new TextReference("Flourish", "Table_Page", "Page")),
        PreviousPage: Texts.Get(new TextReference("Flourish", "Table_PreviousPage", "Previous page")),
        NextPage: Texts.Get(new TextReference("Flourish", "Table_NextPage", "Next page")),
        Width: Texts.Get(new TextReference("Flourish", "Table_Width", "Width")),
        SortDescending: Texts.Get(new TextReference("Flourish", "Table_SortDescending", "sort descending")),
        SortAscending: Texts.Get(new TextReference("Flourish", "Table_SortAscending", "sort ascending")),
        SortDefault: Texts.Get(new TextReference("Flourish", "Table_SortDefault", "restore default order")),
        ResizeHint: Texts.Get(new TextReference("Flourish", "Table_ResizeHint", "Drag or use arrow keys; Shift changes 50 px; Home restores; Escape cancels.")),
        ItemsPerPage: Texts.Get(new TextReference("Flourish", "Table_ItemsPerPage", "Items per page")),
        Total: Texts.Get(new TextReference("Flourish", "Table_Total", "Total")),
        ItemRangeFormat: Texts.Get(new TextReference("Flourish", "Table_ItemRangeFormat", "{0} {1}-{2} / {3} {4}")));

    protected override void OnTextChanged() { localizedTableText = null; if (_initialized) Rebuild(); }

    private readonly HashSet<string> _hidden = new(StringComparer.Ordinal);
    private IReadOnlyList<TableColumn<TItem>> _visibleColumns = Array.Empty<TableColumn<TItem>>();
    private IReadOnlyList<TItem> _processed = Array.Empty<TItem>();
    private IReadOnlyList<RenderRow> _rows = Array.Empty<RenderRow>();
    private string _query = string.Empty;
    private string _searchColumn = string.Empty;
    private string? _sortKey;
    private TableSortDirection _sortDirection;
    private TableView _view;
    private TableView _incomingView;
    private int _pageSize;
    private int _incomingPageSize;
    private bool _initialized;
    private bool _hasActions;
    private int _page = 1;
    private ElementReference _table;
    private ElementReference _root;
    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private IJSObjectReference? _module;
    private bool _disposed;
    private bool _resizeDirty = true;
    private bool ShowCounts => Items.Count > 0 || (!Loading && string.IsNullOrWhiteSpace(Error));
    private int PageCount => Math.Max(1, (int)Math.Ceiling(_processed.Count / (double)_pageSize));
    private int FirstItem => _processed.Count == 0 ? 0 : (_page - 1) * _pageSize + 1;
    private int LastItem => (int)Math.Min((long)_page * _pageSize, _processed.Count);
    private string SearchLabel => Columns.FirstOrDefault(column => column.Key == _searchColumn)?.Header ?? EffectiveText.SearchContent;

    protected override void OnParametersSet()
    {
        localizedTableText = null;
        ArgumentOutOfRangeException.ThrowIfLessThan(PageSize, 1);
        if (Columns.Select(column => column.Key).Distinct(StringComparer.Ordinal).Count() != Columns.Count
            || Columns.Any(column => string.IsNullOrWhiteSpace(column.Key)))
            throw new ArgumentException("Each column must have a nonempty unique key.", nameof(Columns));
        if (!_initialized || _incomingView != View) { _view = View; _incomingView = View; }
        if (!_initialized || _incomingPageSize != PageSize) { _pageSize = PageSize; _incomingPageSize = PageSize; }
        _initialized = true;
        _hidden.RemoveWhere(key => Columns.All(column => column.Key != key || !column.CanHide));
        if (!string.IsNullOrEmpty(_searchColumn) && Columns.All(column => column.Key != _searchColumn || !column.Searchable)) _searchColumn = string.Empty;
        if (_sortKey is not null && Columns.All(column => column.Key != _sortKey || !column.Sortable)) { _sortKey = null; _sortDirection = TableSortDirection.Default; }
        Rebuild();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || !_resizeDirty) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor.Framework/data.js");
            if (_disposed) return;
            await _module.InvokeVoidAsync("synchronize", _root, _instanceId);
            _resizeDirty = false;
        }
        catch (InvalidOperationException) { /* Prerendering has no browser; static widths remain usable. */ }
        catch (JSDisconnectedException) { /* A reconnect does not discard local table state. */ }
    }

    private void Rebuild()
    {
        _visibleColumns = Columns.Where(column => !_hidden.Contains(column.Key)).ToArray();
        if (_visibleColumns.Count == 0 && Columns.Count > 0) { _hidden.Remove(Columns[0].Key); _visibleColumns = new[] { Columns[0] }; }
        _processed = TableData<TItem>.Sort(TableData<TItem>.Filter(Items, Columns, Searchable ? _query : null, _searchColumn, EffectiveCulture),
            Columns.FirstOrDefault(column => column.Key == _sortKey), _sortDirection, EffectiveCulture);
        _page = TableData<TItem>.ClampPage(_page, _processed.Count, _pageSize);
        var offset = (_page - 1) * _pageSize;
        _rows = _processed.Skip(offset).Take(_pageSize).Select((item, index) =>
        {
            var values = _visibleColumns.Select(column => TableData<TItem>.Display(item, column, EffectiveCulture)).ToArray();
            var label = RowLabel?.Invoke(item) ?? values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? Texts.Get(new TextReference("Flourish", "Table_Record", "Record {0}"), offset + index + 1);
            var actions = Actions.Where(action => action.IsAvailable?.Invoke(item) != false)
                .Select(action => new MenuAction(action.Label, () => action.OnClick(item), action.Disabled, action.Destructive)).ToList();
            if (OnRowOpen.HasDelegate) actions.Insert(0, new MenuAction(EffectiveText.Open, () => OnRowOpen.InvokeAsync(item)));
            return new RenderRow(item, ItemKey?.Invoke(item) ?? (object)(offset + index), values, actions, label);
        }).ToArray();
        _hasActions = OnRowOpen.HasDelegate || Actions.Count > 0;
        _resizeDirty = true;
    }

    private void ChangeQuery(ChangeEventArgs args) { _query = args.Value?.ToString() ?? string.Empty; _page = 1; Rebuild(); }
    private void ChangeSearchColumn(ChangeEventArgs args) { _searchColumn = args.Value?.ToString() ?? string.Empty; _page = 1; Rebuild(); }
    private void ToggleColumn(string key) { if (!_hidden.Add(key)) _hidden.Remove(key); Rebuild(); }
    private async Task ChangeView(TableView view) { _view = view; Rebuild(); await ViewChanged.InvokeAsync(view); }
    private void SortColumn(TableColumn<TItem> column)
    {
        _sortDirection = _sortKey != column.Key ? TableSortDirection.Descending : _sortDirection switch
        {
            TableSortDirection.Descending => TableSortDirection.Ascending,
            TableSortDirection.Ascending => TableSortDirection.Default,
            _ => TableSortDirection.Descending
        };
        _sortKey = _sortDirection == TableSortDirection.Default ? null : column.Key;
        _page = 1;
        Rebuild();
    }
    private string AriaSort(TableColumn<TItem> column) => _sortKey != column.Key ? "none" : _sortDirection == TableSortDirection.Descending ? "descending" : "ascending";
    private string SortHint(TableColumn<TItem> column) => _sortKey != column.Key || _sortDirection == TableSortDirection.Default
        ? $"{column.Header}: {EffectiveText.SortDescending}" : _sortDirection == TableSortDirection.Descending
            ? $"{column.Header}: {EffectiveText.SortAscending}" : $"{column.Header}: {EffectiveText.SortDefault}";
    private Task Open(TItem item) => OnRowOpen.HasDelegate ? OnRowOpen.InvokeAsync(item) : Task.CompletedTask;
    private static string Shown(string value) => string.IsNullOrEmpty(value) ? "—" : value;
    private void MovePage(int page) { _page = TableData<TItem>.ClampPage(page, _processed.Count, _pageSize); Rebuild(); }
    private void SetPage(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var page)) MovePage(page); }
    private async Task ChangePageSize(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize) || pageSize < 1 || pageSize == _pageSize) return;
        _pageSize = pageSize;
        _page = 1;
        Rebuild();
        await PageSizeChanged.InvokeAsync(pageSize);
    }

    private IEnumerable<int> PageSizes => new[] { 10, 20, 50, 100, _pageSize }.Distinct().Order();

    private RenderFragment Pager() => @<div class="f-data-pager-row">
        <div class="f-data-count"><span>@string.Format(EffectiveCulture, EffectiveText.ItemRangeFormat, EffectiveText.Items, FirstItem, LastItem, EffectiveText.Total, _processed.Count)</span></div>
        <div class="f-data-pager" role="group" aria-label="@EffectiveText.Page">
            <button type="button" aria-label="@EffectiveText.PreviousPage" disabled="@(_page <= 1)" @onclick="() => MovePage(_page - 1)">‹</button>
            <button type="button" aria-label="@EffectiveText.NextPage" disabled="@(_page >= PageCount)" @onclick="() => MovePage(_page + 1)">›</button>
            <span class="f-data-page-input"><input type="number" aria-label="@EffectiveText.Page" min="1" max="@PageCount" value="@_page" @onchange="SetPage" data-f-page /></span>
            <span class="f-data-page-total">@EffectiveText.Of @PageCount</span>
        </div>
        <label class="f-data-page-size">
            <span>@EffectiveText.ItemsPerPage</span>
            <select class="f-input f-select" value="@_pageSize" @onchange="ChangePageSize" data-f-page-size>
                @foreach (var pageSize in PageSizes) { <option value="@pageSize">@pageSize</option> }
            </select>
        </label>
    </div>;


    public async ValueTask DisposeAsync()
    {
        Dispose();
        _disposed = true;
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("detach", _instanceId); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    private sealed record RenderRow(TItem Item, object Key, IReadOnlyList<string> Values, IReadOnlyList<MenuAction> Actions, string Label);
}
