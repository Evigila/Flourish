@namespace ArkheideSystem.Flourish.Blazor.Components
@using System.Globalization

<span class="f-progress-ring @(Stopped ? "f-progress-stopped" : null)" role="progressbar" aria-label="@Label"
      aria-valuemin="0" aria-valuemax="100" aria-valuenow="@NumericValue" aria-valuetext="@StatusText" title="@StatusText">
    <svg viewBox="0 0 52 52" aria-hidden="true">
        <circle class="f-progress-ring-track" cx="26" cy="26" r="22" />
        <circle class="f-progress-ring-arc" cx="26" cy="26" r="22" pathLength="100" stroke-dasharray="@((Value ?? 28).ToString(CultureInfo.InvariantCulture) + " 100")" />
    </svg>
    @if (Value is null) { <span class="f-progress-ring-native" aria-hidden="true">@(StatusText ?? "In progress")</span> }
    @if (Value is not null) { <span aria-hidden="true">@Value.Value.ToString("0", CultureInfo.CurrentCulture)%</span> }
</span>

@code {
    [Parameter] public string Label { get; set; } = "Progress";
    [Parameter] public double? Value { get; set; }
    [Parameter] public string? StatusText { get; set; }
    [Parameter] public bool Stopped { get; set; }
    private string? NumericValue => Value?.ToString("0.##", CultureInfo.InvariantCulture);
    protected override void OnParametersSet()
    {
        if (Value is { } value && (double.IsNaN(value) || double.IsInfinity(value) || value is < 0 or > 100))
            throw new ArgumentOutOfRangeException(nameof(Value));
    }
}
