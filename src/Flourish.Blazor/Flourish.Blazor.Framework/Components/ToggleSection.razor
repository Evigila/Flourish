@namespace ArkheideSystem.Flourish.Blazor.Components

<div class="f-toggle-section @Class">
    <ToggleSwitch Label="@Label" Value="@Value" ValueChanged="@ValueChanged" Disabled="@Disabled" Controls="@ContentId" />
    <div id="@ContentId" class="f-toggle-section-content" hidden="@(!Value)">@ChildContent</div>
</div>

@code {
    private readonly string ContentId = "f-toggle-content-" + Guid.NewGuid().ToString("N");
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
