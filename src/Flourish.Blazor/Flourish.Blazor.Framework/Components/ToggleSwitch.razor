@namespace ArkheideSystem.Flourish.Blazor.Components

<button @attributes="AdditionalAttributes" type="button" class="f-toggle @Class" role="switch" aria-checked="@(Value ? "true" : "false")"
        aria-controls="@Controls" disabled="@Disabled" @onclick="ToggleAsync">
    <span class="f-toggle-track" aria-hidden="true"><span class="f-toggle-thumb"></span></span><span>@Label</span><span class="f-toggle-state" aria-hidden="true">@(Value ? OnLabel : OffLabel)</span>
</button>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string OnLabel { get; set; } = "On";
    [Parameter] public string OffLabel { get; set; } = "Off";
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Controls { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private Task ToggleAsync() => Disabled ? Task.CompletedTask : ValueChanged.InvokeAsync(!Value);
}
