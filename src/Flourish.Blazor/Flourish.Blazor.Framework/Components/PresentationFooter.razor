@namespace ArkheideSystem.Flourish.Blazor.Components
@inherits TextComponentBase
@using ArkheideSystem.Flourish.Blazor.Hosting
@inject ApplicationOptions Options
<footer class="@($"f-presentation-footer {Class}".Trim())" @attributes="AdditionalAttributes">
    <span class="f-presentation-watermark" aria-hidden="true">@ProjectName</span>
    <ContentContainer Class="f-presentation-footer-content">
        <div class="f-presentation-footer-identity"><strong>@ProjectName</strong>@if (!string.IsNullOrWhiteSpace(Copyright)) { <span>@Copyright</span> }</div>
        @if (Actions is not null) { <nav class="f-inline-actions" aria-label="@LinksLabel">@Actions</nav> }
    </ContentContainer>
</footer>
@code {
    [Parameter] public string? Copyright { get; set; }
    [Parameter] public string? LinksLabel { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private string ProjectName => Options.Project.NameText is { } text ? Texts.Get(text) : Options.Project.Name;
}
