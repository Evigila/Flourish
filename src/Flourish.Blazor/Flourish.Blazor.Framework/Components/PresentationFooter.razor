@namespace ArkheideSystem.Flourish.Blazor.Components
<footer class="@($"f-presentation-footer {Class}".Trim())" @attributes="AdditionalAttributes">
    <span class="f-presentation-watermark" aria-hidden="true">@(Watermark ?? BrandName)</span>
    <ContentContainer Class="f-presentation-footer-content">
        <div class="f-presentation-footer-identity"><strong>@BrandName</strong><span>@Copyright</span></div>
        @if (Actions is not null) { <nav class="f-inline-actions" aria-label="@LinksLabel">@Actions</nav> }
    </ContentContainer>
</footer>
@code {
    [Parameter, EditorRequired] public string BrandName { get; set; } = string.Empty;
    [Parameter] public string? Copyright { get; set; }
    [Parameter] public string? Watermark { get; set; }
    [Parameter] public string? LinksLabel { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
