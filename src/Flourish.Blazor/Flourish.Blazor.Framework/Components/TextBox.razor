@namespace ArkheideSystem.Flourish.Blazor.Components
@inherits InputBase<string?>
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Multiline)
{
    <textarea @ref="Element" @attributes="AdditionalAttributes" id="@(Id ?? Field?.Id)" class="f-input f-textarea @CssClass" rows="@Rows" maxlength="@MaxLength"
              placeholder="@Placeholder" disabled="@Disabled" required="@InputSemantics.Required(Field, AdditionalAttributes)" aria-invalid="@Invalid" aria-describedby="@Description" @oninput="Change">@CurrentValueAsString</textarea>
}
else
{
    <input @ref="Element" @attributes="AdditionalAttributes" id="@(Id ?? Field?.Id)" class="f-input @CssClass" type="@Type" value="@CurrentValueAsString"
           maxlength="@MaxLength" placeholder="@Placeholder" disabled="@Disabled" required="@InputSemantics.Required(Field, AdditionalAttributes)" aria-invalid="@Invalid" aria-describedby="@Description" @oninput="Change" />
}

@code {
    private ElementReference Element;
    private IJSObjectReference? Module;
    private ElementReference? AttachedElement;
    private bool Disposed;
    [CascadingParameter] private FieldContext? Field { get; set; }
    private string? Description => InputSemantics.Description(Field, AdditionalAttributes);
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public bool Multiline { get; set; }
    [Parameter] public int Rows { get; set; } = 4;
    [Parameter] public bool Disabled { get; set; }
    private string? Invalid => InputSemantics.Invalid(EditContext, FieldIdentifier, Field, AdditionalAttributes);
    private void Change(ChangeEventArgs args) { if (!Disabled) CurrentValueAsString = args.Value?.ToString(); }
    protected override bool TryParseValueFromString(string? value, out string? result, out string validationErrorMessage)
    { result = value; validationErrorMessage = ""; return true; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Disposed || AttachedElement?.Id == Element.Id) return;
        if (Module is null)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arkheide.Flourish.Blazor.Framework/controls.js");
            if (Disposed) { await module.DisposeAsync(); return; }
            Module = module;
        }
        if (AttachedElement is { } previous) await Module.InvokeVoidAsync("detachTextSelection", previous);
        await Module.InvokeVoidAsync("attachTextSelection", Element);
        AttachedElement = Element;
    }
    public async ValueTask DisposeAsync()
    {
        Disposed = true;
        ((IDisposable)this).Dispose();
        if (Module is null) return;
        try
        {
            if (AttachedElement is { } element) await Module.InvokeVoidAsync("detachTextSelection", element);
            await Module.DisposeAsync();
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }
}
