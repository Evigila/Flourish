<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <AssemblyName>Flourish.Blazor.Framework</AssemblyName>
    <RootNamespace>ArkheideSystem.Flourish.Blazor</RootNamespace>
    <PackageId>Arkheide.Flourish.Blazor.Framework</PackageId>
    <Authors>ArkheideSystem</Authors>
    <Description>Native Blazor components and functional browser behavior without a visual skin.</Description>
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Evigila/Flourish.git</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <StaticWebAssetBasePath>_content/Arkheide.Flourish.Blazor.Framework</StaticWebAssetBasePath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Remove="Localization/Culture.json" />
    <Content Remove="Localization/Culture.json" />
    <EmbeddedResource Include="Localization/Culture.json" LogicalName="Flourish.Blazor.Texts.json" />
    <EmbeddedResource Include="Icons/MaterialSymbolsOutlined.codepoints" LogicalName="Flourish.Blazor.Icons.Codepoints" />
    <ProjectReference Include="../Flourish.Blazor.Abstract/Flourish.Blazor.Abstract.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <CssBundleEntry>framework.css</CssBundleEntry>
  </PropertyGroup>
  <Import Project="../../../build/CssBundle.targets" />
</Project>
