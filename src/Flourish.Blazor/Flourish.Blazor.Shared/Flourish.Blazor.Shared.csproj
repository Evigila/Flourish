<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <AssemblyName>Flourish.Blazor.Shared</AssemblyName>
    <RootNamespace>ArkheideSystem.Flourish.Blazor</RootNamespace>
    <PackageId>Arkheide.Flourish.Blazor.Shared</PackageId>
    <Authors>ArkheideSystem</Authors>
    <Description>Shared immutable Blazor metadata and local data processing.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Evigila/Flourish.git</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Flourish.Core/Flourish.Core.csproj" />
  </ItemGroup>
</Project>