<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <VersionPrefix>1.1.0</VersionPrefix>
    <AssemblyName>Flourish.Blazor.Abstract</AssemblyName>
    <RootNamespace>ArkheideSystem.Flourish.Blazor</RootNamespace>
    <PackageId>Arkheide.Flourish.Blazor.Abstract</PackageId>
    <Authors>ArkheideSystem</Authors>
    <Description>Public contracts for the Blazor application shell and optional design.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Evigila/Flourish.git</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Flourish.Blazor.Shared/Flourish.Blazor.Shared.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>