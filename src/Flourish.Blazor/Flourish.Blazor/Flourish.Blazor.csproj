<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Arkheide.Flourish.Blazor</PackageId>
    <Description>Convenience package for Blazor contracts, framework components and optional design. Register design separately to enable its visual theme.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>false</IncludeContentInPack>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Flourish.Blazor.Abstract/Flourish.Blazor.Abstract.csproj" />
    <ProjectReference Include="../Flourish.Blazor.Framework/Flourish.Blazor.Framework.csproj" />
    <ProjectReference Include="../Flourish.Blazor.Design/Flourish.Blazor.Design.csproj" />
  </ItemGroup>
</Project>
