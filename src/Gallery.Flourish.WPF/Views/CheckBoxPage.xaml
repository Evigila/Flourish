<Page
  x:Class="ArkheideSystem.Gallery.Flourish.WPF.Views.CheckBoxPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:culture="clr-namespace:ArkheideSystem.Essential.Culture"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="{culture:Localize Key=Controls_RepresentABooleanOrOptionalThreeStatePreferenceWithACompactRowOr_87722721}"
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="CheckBox"
    />

    <flourish:Chunk
      Content="{culture:Localize Key=Controls_HorizontalIsTheDefaultForStandardSettingsVerticalAddsAnOptionalI_8F273260}"
      Title="Variant"
    >
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Content="{culture:Localize Key=Controls_PlacesTheStateIndicatorBeforeTheContentAnUncheckedOptionKeepsAnE_7062A2DC}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Horizontal"
        >
          <flourish:Presenter.Presentation>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <flourish:CheckBox Content="{culture:Localize Key=Controls_EnableNotifications_682BE64A}" />
              <flourish:CheckBox Margin="0,8,0,0" Content="{culture:Localize Key=Controls_SynchronizeAutomatically_EED48D4F}" IsChecked="True" />
            </StackPanel>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="{culture:Localize Key=Controls_PlacesTheIconAboveTheContentAndTheSelectedIndicatorAtTheUpperRig_3FC3895A}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Vertical"
        >
          <flourish:Presenter.Presentation>
            <UniformGrid HorizontalAlignment="Center" VerticalAlignment="Center" Columns="2">
              <flourish:CheckBox
                Margin="0,0,6,0"
                Content="{culture:Localize Key=Controls_LocalWorkspace_DFBBEC38}"
                Icon="&#xE8B7;"
                Variant="Vertical"
              />
              <flourish:CheckBox
                Margin="6,0,0,0"
                Content="{culture:Localize Key=Controls_CloudWorkspace_35AA5D58}"
                Icon="&#xE753;"
                IsChecked="True"
                Variant="Vertical"
              />
            </UniformGrid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Table_16D1C905}">
      <flourish:DataGrid
        x:Name="MemberGrid"
        AutoGenerateColumns="False"
        IsReadOnly="True"
      >
        <flourish:DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="{culture:Localize Key=Controls_Member_7C968FB7}" Width="220" />
          <DataGridTextColumn Binding="{culture:Localize KeyBinding={Binding DescriptionKey}}" Header="{culture:Localize Key=Controls_Purpose_D4E8830A}" Width="*" />
        </flourish:DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="{culture:Localize Key=Controls_UseTwoStateBehaviorForOrdinaryPreferencesAndEnableTheThirdStateO_A570F10E}"
      Title="{culture:Localize Key=Controls_Selection_CA406707}"
    >
      <UniformGrid Columns="3">
        <flourish:Presenter
          Margin="0,0,8,0"
          Content="{culture:Localize Key=Controls_FalseUsesAnEmptyCircularIndicator_6D99409C}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Unchecked"
        >
          <flourish:Presenter.Presentation>
            <flourish:CheckBox Width="160" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{culture:Localize Key=Controls_NotSelected_DF12AEBA}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0"
          Content="{culture:Localize Key=Controls_TrueUsesACheckMarkAndHighlightsTheContentAndBoundary_5528B53D}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Checked"
        >
          <flourish:Presenter.Presentation>
            <flourish:CheckBox Width="160" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{culture:Localize Key=Controls_Selected_57FD7A0C}" IsChecked="True" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="{culture:Localize Key=Controls_NullReplacesTheCheckMarkWithAHorizontalLine_4206EED2}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Indeterminate"
        >
          <flourish:Presenter.Presentation>
            <flourish:CheckBox
                Width="160"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{culture:Localize Key=Controls_Inherited_345F2AAB}"
                IsChecked="{x:Null}"
                IsThreeState="True"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Usage_8D59829C}">
      <StackPanel>
        <flourish:Presenter
          Content="{culture:Localize Key=Controls_HorizontalIsTheDefaultBindIsCheckedInTwoWayModeForAStandardSetti_923DEB45}"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_StandardOption_A9E7F4A2}"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="{Binding UsageCode, ElementName=RootPage}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="{culture:Localize Key=Controls_ChooseVerticalForACardShapedSelectionIconAcceptsArbitraryContent_2FA82121}"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_IconLedOption_2EF7009E}"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:CheckBox&#xA;  Content=&quot;Cloud workspace&quot;&#xA;  Icon=&quot;&amp;#xE753;&quot;&#xA;  IsChecked=&quot;{Binding UsesCloudWorkspace, Mode=TwoWay}&quot;&#xA;  Variant=&quot;Vertical&quot; /&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Reference_71BF9093}">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          Content="{culture:Localize Key=Controls_BrowseTheFlourishSourceRepository_5CC28F39}"
          Icon="&#xE943;"
          IsEnabled="False"
          Title="{culture:Localize Key=Controls_GitHubRepository_50555492}"
          ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}"
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          Content="{culture:Localize Key=Controls_ReadTheCheckBoxAPIAndLayoutContract_6B23CCB9}"
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="{culture:Localize Key=Controls_CheckBoxDocumentation_67B58CA4}"
          ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}"
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
