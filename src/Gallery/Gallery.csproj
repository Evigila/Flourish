<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ArkheideSystem.Gallery</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>ArkheideSystem.Gallery.Program</StartupObject>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <UserSecretsId>ArkheideSystem.Flourish.Gallery</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Arkheide.Flourish.Extension.Culture" Version="$(ArkheideFlourishExtensionCultureVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flourish\Arkheide.Flourish.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Localization\Culture.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Localization\Culture.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Culture.json</TargetPath>
    </None>
    <None Update="FlourishCulture.Json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
