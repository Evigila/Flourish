<Page
  x:Class="ArkheideSystem.Gallery.Views.RadioButtonPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Gallery.Controls.ChooseOneValueFromASmallVisibleMutuallyExclusiveOptionSet_4AA853D5"
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="FlourishRadioButton"
    />

    <flourish:Chunk Title="Gallery.Controls.Table_16D1C905">
      <flourish:DataGrid
        x:Name="MemberGrid"
        AutoGenerateColumns="False"
        IsReadOnly="True"
      >
        <flourish:DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="Gallery.Controls.Member_7C968FB7" Width="220" />
          <DataGridTextColumn Binding="{Binding Description}" Header="Gallery.Controls.Purpose_D4E8830A" Width="*" />
        </flourish:DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Gallery.Controls.KeepEveryChoiceVisibleUseOneGroupNameForOneDecisionAndBeginWithA_55C3AB43"
      Title="Gallery.Controls.Selection_CA406707"
    >
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Content="Gallery.Controls.ASharedGroupNameGuaranteesThatOnlyOneOptionStaysChecked_5AF1D305"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Gallery.Controls.Theme_EFB52E71"
        >
          <flourish:Presenter.Presentation>
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
                <flourish:FlourishRadioButton
                  Content="Gallery.Runtime.System_6725E7BB"
                  GroupName="ThemeExample"
                  IsChecked="True"
                />
                <flourish:FlourishRadioButton
                  Margin="0,8,0,0"
                  Content="Light"
                  GroupName="ThemeExample"
                />
                <flourish:FlourishRadioButton
                  Margin="0,8,0,0"
                  Content="Dark"
                  GroupName="ThemeExample"
                />
            </StackPanel>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="Gallery.Controls.ASeparateGroupNameCreatesAnotherIndependentDecisionInTheSamePage_71792381"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Gallery.Controls.Density_77A283D6"
        >
          <flourish:Presenter.Presentation>
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
                <flourish:FlourishRadioButton
                  Content="Gallery.Controls.Comfortable_459A23A5"
                  GroupName="DensityExample"
                  IsChecked="True"
                />
                <flourish:FlourishRadioButton
                  Margin="0,8,0,0"
                  Content="Gallery.Controls.Compact_99452646"
                  GroupName="DensityExample"
                />
            </StackPanel>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Gallery.Controls.Usage_8D59829C">
      <StackPanel>
        <flourish:Presenter
          Content="Gallery.Controls.GiveEveryOptionForOneDecisionTheSameGroupNameAndStartWithOneVali_DA92DB97"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Gallery.Controls.ExclusiveChoice_D47F7639"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="{Binding UsageCode, ElementName=RootPage}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="Gallery.Controls.BindASharedCommandWhenSelectingAnOptionMustInvokeApplicationBeha_CBA76246"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Gallery.Controls.CommandSelection_133BE884"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:FlourishRadioButton&#xA;  Content=&quot;Dark&quot;&#xA;  GroupName=&quot;Theme&quot;&#xA;  Command=&quot;{Binding SelectThemeCommand}&quot;&#xA;  CommandParameter=&quot;Dark&quot; /&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Gallery.Controls.Reference_71BF9093">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          Content="Gallery.Controls.BrowseTheFlourishSourceRepository_5CC28F39"
          Icon="&#xE943;"
          IsEnabled="False"
          Title="Gallery.Controls.GitHubRepository_50555492"
          ToolTip="Gallery.Controls.ExternalNavigationIsNotAvailableInGallery_E2F1482A"
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          Content="Gallery.Controls.ReadTheFlourishRadioButtonAPIReference_80C2E3F1"
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="Gallery.Controls.FlourishRadioButtonDocumentation_83BEED9E"
          ToolTip="Gallery.Controls.ExternalNavigationIsNotAvailableInGallery_E2F1482A"
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
