<Page
  x:Class="ArkheideSystem.Gallery.Views.ScrollViewerPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Host scrollable content with Flourish scroll bars, boundary handoff, and optional smooth wheel motion."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="ScrollViewer"
    />

    <flourish:Chunk Title="Table">
      <flourish:DataGrid ItemsSource="{Binding Properties, ElementName=RootPage}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Width="220" Binding="{Binding Name}" Header="Member" />
          <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="Purpose" />
        </DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="ScrollViewer uses one standard scroll-bar geometry so page content, nested surfaces, and control-owned viewports share the same visual weight."
      Title="Standard scrollbar"
    >
      <flourish:Presenter
        Content="The standard scroll bar preserves a usable pointer target while keeping its visible thumb light. Wheel input moves the deepest viewport first and bubbles to the page at a boundary."
        PresenterMode="TopDown"
        PresenterPosition="Left"
        Title="Standard"
      >
        <flourish:Presenter.Presentation>
          <Grid MinHeight="210">
            <flourish:ScrollViewer
              Width="260"
              Height="160"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              VerticalScrollBarVisibility="Visible"
            >
              <StackPanel>
                <flourish:Card Margin="0,0,0,8" Title="First" Content="Scroll through a bounded surface." />
                <flourish:Card Margin="0,0,0,8" Title="Second" Content="Wheel input moves the inner viewport first." />
                <flourish:Card Title="Third" Content="At the boundary, input may bubble to PageBody." />
              </StackPanel>
            </flourish:ScrollViewer>
          </Grid>
        </flourish:Presenter.Presentation>
      </flourish:Presenter>
    </flourish:Chunk>

    <flourish:Chunk
      Content="The deepest scrollable viewport consumes wheel input only while it can move in that direction."
      Title="Boundary scrolling"
    >
      <flourish:Card Title="Nested viewports" Content="Do not add a PreviewMouseWheel handler that marks every event handled. Flourish lets outward wheel events bubble at the top and bottom." />
    </flourish:Chunk>

    <flourish:Chunk Title="Usage">
      <StackPanel>
        <flourish:Presenter
          Content="Choose scroll-bar visibility with the native WPF properties and use IsSmoothScrollingEnabled to animate wheel movement. ScrollViewer always applies the standard Flourish scroll-bar geometry. Normal wheel input scrolls internally and bubbles at boundaries."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Configure the viewport"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace Text="&lt;flourish:ScrollViewer&#xA;  x:Name=&quot;ContentViewport&quot;&#xA;  IsSmoothScrollingEnabled=&quot;True&quot;&#xA;  VerticalScrollBarVisibility=&quot;Auto&quot;&gt;&#xA;  &lt;StackPanel&gt;&#xA;    &lt;!-- Scrollable content --&gt;&#xA;  &lt;/StackPanel&gt;&#xA;&lt;/flourish:ScrollViewer&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="Name the viewer when code must inspect or move the viewport. The inherited WPF scrolling methods provide deliberate navigation independently of mouse-wheel behavior."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Control scrolling"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace Text="// Move to a known section after navigation.&#xA;ContentViewport.ScrollToVerticalOffset(240);&#xA;&#xA;// Or return to the start.&#xA;ContentViewport.ScrollToTop();" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="Browse the Flourish source repository." Icon="&#xE943;" IsEnabled="False" Title="GitHub repository" ToolTip="External navigation is not available in Gallery." />
        <flourish:CardButton Margin="8,0,0,0" Content="Read the ScrollViewer API reference." Icon="&#xE8A5;" IsEnabled="False" Title="ScrollViewer documentation" ToolTip="External navigation is not available in Gallery." />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
