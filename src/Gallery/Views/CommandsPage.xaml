<Page
  x:Class="ArkheideSystem.Gallery.Views.CommandsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Define application actions independently from their UI, dispatch them asynchronously, and connect keyboard gestures to the same command pipeline. Commands are recommended when menus, toolbars, shortcuts, and background workflows must share one consistent operation."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="Commands &amp; shortcuts"
    />

    <flourish:Chunk
      Content="Register a keyed handler, provide an optional availability predicate, and dispatch it with a source and parameter. Use this pattern for actions that may be contributed or replaced while the application is running; the code below also shows how the disposable registration controls handler lifetime."
      Title="Commands"
    >
      <StackPanel>
        <UniformGrid VerticalAlignment="Stretch" Columns="2">
        <StackPanel Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE71B;"
            Title="Command key"
            Content="Identify the handler registered in the runtime command registry."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="CommandKeyBox" Width="220" Text="gallery.runtime.greet" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Dispatch parameter"
            Content="Provide the value passed to the demo handler."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="CommandParameterBox" Width="220" Text="Flourish user" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE74E;"
            Title="Command availability"
            Content="Choose whether the registered handler can execute."
          >
            <flourish:ActionCard.Body>
              <flourish:CheckBox x:Name="CommandEnabledBox" VerticalAlignment="Center" IsChecked="True" Content="Can execute" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE710;"
            Title="Register command"
            Content="Register the handler or replace its existing definition."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="RegisterCommand_Click" Content="Register / replace" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE72A;"
            Title="Execute command"
            Content="Dispatch the registered handler asynchronously."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="ExecuteCommand_Click" Content="Execute async" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE74D;"
            Title="Remove command"
            Content="Delete the handler from the runtime registry."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="RemoveCommand_Click" Content="Remove command" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard x:Name="CommandOutput" Margin="8,0,0,0" VerticalAlignment="Stretch" />
        </UniformGrid>
        <flourish:CodeSpace Text="// Keep the handle so the command can be replaced or removed.&#10;var registration = commandRegistry.Register(&#10;    &quot;reports.refresh&quot;,&#10;    RefreshReportsAsync,&#10;    _ =&gt; reportsCanRefresh,&#10;    new CommandRegistrationOptions&#10;    {&#10;        DuplicatePolicy = CommandDuplicatePolicy.Replace,&#10;        Priority = 100,&#10;    });&#10;&#10;var canExecute = commandDispatcher.CanExecute(&#10;    &quot;reports.refresh&quot;, reportId, CommandSource.Application);&#10;var result = await commandDispatcher.ExecuteAsync(&#10;    &quot;reports.refresh&quot;, reportId, CommandSource.Application);&#10;&#10;registration.NotifyCanExecuteChanged();&#10;registration.Dispose();" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Bind a key gesture to an existing command instead of duplicating its behavior in an input handler. Application-scoped shortcuts suit commands that should work throughout the shell; the code demonstrates conflict handling, explicit dispatch for testing, and disposal when the binding is no longer owned."
      Title="Shortcuts"
    >
      <StackPanel>
        <UniformGrid VerticalAlignment="Stretch" Columns="2">
        <StackPanel Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE710;"
            Title="Register Ctrl+Shift+G"
            Content="Bind the global shortcut to the runtime command."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="RegisterShortcut_Click" Content="Register Ctrl+Shift+G" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE72A;"
            Title="Dispatch shortcut"
            Content="Invoke the same command API from this page."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="ExecuteShortcut_Click" Content="Dispatch shortcut" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE74D;"
            Title="Remove shortcut"
            Content="Unregister the global Ctrl+Shift+G binding."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="RemoveShortcut_Click" Content="Remove shortcut" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard x:Name="ShortcutOutput" Margin="8,0,0,0" VerticalAlignment="Stretch" />
        </UniformGrid>
        <flourish:CodeSpace Text="var gesture = new KeyGesture(&#10;    Key.G, ModifierKeys.Control | ModifierKeys.Shift);&#10;&#10;var shortcut = shortcuts.Register(&#10;    gesture,&#10;    &quot;reports.refresh&quot;,&#10;    reportId,&#10;    new ShortcutRegistrationOptions&#10;    {&#10;        Scope = ShortcutScope.Application,&#10;        ConflictPolicy = ShortcutConflictPolicy.Replace,&#10;        Priority = 100,&#10;    });&#10;&#10;// Dispatch explicitly when a test or custom input source resolves the gesture.&#10;var result = await shortcuts.ExecuteAsync(&#10;    gesture, new ShortcutResolutionContext(pageKey: nameof(CommandsPage)));&#10;shortcut.Dispose();" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Read immutable command and shortcut snapshots and subscribe to change notifications without taking ownership of registrations. This is useful for diagnostics, command palettes, and management views; the example code refreshes a view whenever either registry changes."
      Title="Registry"
    >
      <StackPanel>
        <flourish:Presenter
        Content="Command and shortcut registries expose immutable snapshots and change events for diagnostic or management interfaces."
        PresenterMode="Split"
        PresenterPosition="Left"
        Title="Registry state"
      >
        <flourish:Presenter.Presentation>
          <StackPanel
            Width="360"
            Height="240"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
          >
            <flourish:FlourishTextBlock x:Name="RegistrySummaryText" Role="Status" />
            <flourish:ListBox x:Name="RegistryList" MinHeight="90" MaxHeight="220" Margin="0,10,0,0" />
          </StackPanel>
        </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:CodeSpace Text="commandRegistry.Changed += (_, _) =&gt; RefreshCommands();&#10;shortcuts.Changed += (_, _) =&gt; RefreshShortcuts();&#10;&#10;var commands = commandRegistry.Registrations;&#10;var bindings = shortcuts.Registrations;" />
      </StackPanel>
    </flourish:Chunk>
    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="Browse the Flourish source repository." Icon="&#xE943;" IsEnabled="False" Title="GitHub repository" ToolTip="External navigation is not available in Gallery." />
        <flourish:CardButton Margin="8,0,0,0" Content="Read the canonical Flourish documentation." Icon="&#xE946;" IsEnabled="False" Title="Flourish documentation" ToolTip="External navigation is not available in Gallery." />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
