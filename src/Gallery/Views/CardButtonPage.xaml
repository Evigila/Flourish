<Page
  x:Class="ArkheideSystem.Gallery.Views.CardButtonPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="A card-shaped action whose complete surface participates in button interaction."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="CardButton"
    />

    <flourish:Chunk Title="Variant">
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,8"
          Content="Uses the neutral interactive card surface."
          PresenterMode="TopDown"
          PresentationMinHeight="220"
          PresenterPosition="Left"
          Title="Standard"
        >
          <flourish:Presenter.Presentation>
            <flourish:CardButton
              Width="200"
              Height="120"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="Default card action."
              Icon="&#xE8A5;"
              Title="Standard"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,8"
          Content="Adds elevation while the complete surface remains interactive."
          PresenterMode="TopDown"
          PresentationMinHeight="220"
          PresenterPosition="Left"
          Title="Elevated"
        >
          <flourish:Presenter.Presentation>
            <flourish:CardButton
              Width="200"
              Height="120"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="Raised card action."
              Icon="&#xE8A5;"
              Title="Elevated"
              Variant="Elevated"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="0,8,8,0"
          Content="Uses primary-color emphasis for a prominent card action."
          PresenterMode="TopDown"
          PresentationMinHeight="220"
          PresenterPosition="Left"
          Title="Filled"
        >
          <flourish:Presenter.Presentation>
            <flourish:CardButton
              Width="200"
              Height="120"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="Prominent card action."
              Icon="&#xE8A5;"
              Title="Filled"
              Variant="Filled"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,8,0,0"
          Content="Provides a quieter filled card action."
          PresenterMode="TopDown"
          PresentationMinHeight="220"
          PresenterPosition="Left"
          Title="Tonal"
        >
          <flourish:Presenter.Presentation>
            <flourish:CardButton
              Width="200"
              Height="120"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="Softer card action."
              Icon="&#xE8A5;"
              Title="Tonal"
              Variant="Tonal"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Table">
      <flourish:DataGrid
        x:Name="PropertiesGrid"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        CanUserReorderColumns="False"
        FontWeight="Regular"
        IsReadOnly="True"
      >
        <flourish:DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="PROPERTY" Width="220" />
          <DataGridTextColumn Binding="{Binding Description}" Header="PURPOSE" Width="*" />
        </flourish:DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Layout">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          Content="The icon appears above the copy."
          Icon="&#xE8A5;"
          Title="Vertical content"
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          Content="The icon appears beside the copy."
          Icon="&#xE946;"
          IconPosition="Left"
          Title="Horizontal content"
        />
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Interaction contract">
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Title="Enabled card action"
          Content="The complete surface is one focusable action, so its icon, title, and supporting copy share the same pointer and keyboard target."
          PresenterMode="TopDown"
          PresentationMinHeight="220"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CardButton
              Width="200"
              Height="120"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              AutomationProperties.Name="Open reports"
              Content="Review generated reports."
              Icon="&#xE8A5;"
              Title="Reports"
              ToolTip="Open reports"
              Variant="Elevated"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Title="Disabled card action"
          Content="A disabled CardButton keeps the complete card unavailable and presents the disabled treatment across every visual region."
          PresenterMode="TopDown"
          PresentationMinHeight="220"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CardButton
              Width="200"
              Height="120"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="Available after validation."
              Icon="&#xE73E;"
              IsEnabled="False"
              Title="Publish report"
              Variant="Elevated"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Usage">
      <StackPanel>
        <flourish:Presenter
          Title="Make the whole card interactive"
          Content="Use CardButton when Title, Content, and Icon describe one destination or command and the complete surface should respond to pointer, keyboard, and command activation. Each visual property is optional and collapses when omitted. Choose Standard for neutral navigation, Tonal for gentle emphasis, Filled for the principal action, or Elevated for surface separation; use ActionCard when only an embedded control should be interactive."
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:CardButton&#xA;  Command=&quot;{Binding OpenReportsCommand}&quot;&#xA;  Title=&quot;Reports&quot;&#xA;  Content=&quot;Review generated reports.&quot;&#xA;  Icon=&quot;&amp;#xE8A5;&quot;&#xA;  Variant=&quot;Elevated&quot; /&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          AutomationProperties.Name="Flourish GitHub repository"
          Content="Repository link placeholder"
          Icon="&#xE943;"
          IsEnabled="False"
          Title="GitHub repository"
          ToolTip="External navigation is not available in Gallery."
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          AutomationProperties.Name="CardButton documentation"
          Content="Canonical documentation link placeholder"
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="CardButton documentation"
          ToolTip="External navigation is not available in Gallery."
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
