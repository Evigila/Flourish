<Page
  x:Class="ArkheideSystem.Gallery.Views.StatusBarConfigurationPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:culture="clr-namespace:Arkheide.Essential.Culture"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Title="{culture:Localize Key=Application_StatusBar_0BC4C2AF}"
      Content="{culture:Localize Key=Shell_DefinePersistentStatusItemsAndOptionalSystemIndicatorsShownByThe_6B2BB27D}"
      PresenterMode="Split"
      PresenterPosition="Right"
    />

    <flourish:Chunk
      Title="{culture:Localize Key=Shell_StatusItems_41C5C2E2}"
      Content="{culture:Localize Key=Shell_TheStatusBarKeepsApplicationStateAndBuiltInSystemDetailsVisibleW_B3D10F2D}"
    >
      <StackPanel>
        <UniformGrid Columns="2">
          <flourish:Card
            Margin="0,0,8,0"
            Icon="&#xE930;"
            Title="{culture:Localize Key=Shell_ApplicationStatus_CCDE872D}"
            Content="{culture:Localize Key=Shell_AddStatusItemRegistersCompactNonInteractiveApplicationStateInDis_ED3FC409}"
          />
          <flourish:Card
            Margin="8,0,0,0"
            Icon="&#xE968;"
            Title="{culture:Localize Key=Shell_SystemIndicators_F2F8C292}"
            Content="{culture:Localize Key=Shell_NetworkAndPowerDetailsShareOneConsolidatedSystemStatusSurface_75B32A78}"
          />
        </UniformGrid>
        <flourish:CodeSpace
          Margin="{DynamicResource FlourishCodeSpacePeerMargin}"
          Text="// Keep the status bar visible even when no background task is active.&#10;builder&#10;    .ConfigureStatusBar(status =&gt; status&#10;        .SetEnabled()&#10;        .AddStatusItem(&quot;Ready&quot;, &quot;\uE73E&quot;)&#10;        // Both system details appear in one consolidated indicator.&#10;        .SetLanStatusEnabled()&#10;        .SetPowerStatusEnabled());"
        />
      </StackPanel>
    </flourish:Chunk>
    <flourish:Chunk Title="{culture:Localize Key=Controls_Reference_71BF9093}">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="{culture:Localize Key=Controls_BrowseTheFlourishSourceRepository_5CC28F39}" Icon="&#xE943;" IsEnabled="False" Title="{culture:Localize Key=Controls_GitHubRepository_50555492}" ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}" />
        <flourish:CardButton Margin="8,0,0,0" Content="{culture:Localize Key=Shell_ReadTheCanonicalFlourishDocumentation_7BB05CDB}" Icon="&#xE946;" IsEnabled="False" Title="{culture:Localize Key=Shell_FlourishDocumentation_A1D1605B}" ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}" />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
