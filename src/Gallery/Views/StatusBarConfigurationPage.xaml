<Page
  x:Class="ArkheideSystem.Gallery.Views.StatusBarConfigurationPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Title="Status bar"
      Content="Define persistent status items and optional system indicators shown by the shell."
      PresenterMode="Split"
      PresenterPosition="Right"
    />

    <flourish:Chunk
      Title="Status items"
      Content="The status bar keeps application state and built-in system details visible without interrupting the current workflow. Enable the persistent surface with UseStatusBar, then add non-interactive text and glyphs or opt into the consolidated network and power indicator with ConfigStatusBar. This pattern is recommended for synchronization, workspace, connectivity, and power information; the code below covers every status-bar configuration API."
    >
      <StackPanel>
        <UniformGrid Columns="2">
          <flourish:Card
            Margin="0,0,8,0"
            Icon="&#xE930;"
            Title="Application status"
            Content="AddStatusItem registers compact, non-interactive application state in display order."
          />
          <flourish:Card
            Margin="8,0,0,0"
            Icon="&#xE968;"
            Title="System indicators"
            Content="Network and power details share one consolidated system-status surface."
          />
        </UniformGrid>
        <flourish:CodeSpace
          Margin="0,16,0,0"
          Text="// Keep the status bar visible even when no background task is active.&#10;builder&#10;    .ConfigShell(shell =&gt; shell.UseStatusBar())&#10;    .ConfigStatusBar(status =&gt; status&#10;        .AddStatusItem(&quot;Ready&quot;, &quot;\uE73E&quot;)&#10;        // Both system details appear in one consolidated indicator.&#10;        .UseLanConnectionStatus()&#10;        .UsePowerStatus());"
        />
      </StackPanel>
    </flourish:Chunk>
    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="Browse the Flourish source repository." Icon="&#xE943;" IsEnabled="False" Title="GitHub repository" ToolTip="External navigation is not available in Gallery." />
        <flourish:CardButton Margin="8,0,0,0" Content="Read the canonical Flourish documentation." Icon="&#xE946;" IsEnabled="False" Title="Flourish documentation" ToolTip="External navigation is not available in Gallery." />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
