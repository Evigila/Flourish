            Icon="&#xE708;"
            Title="{culture:Localize Key=Shell_ImmersiveDarkMode_7E1CB18B}"
            Content="{culture:Localize Key=Shell_RequestDarkNativeWindowChrome_4E04D64F}"
          >
            <flourish:ActionCard.Body>
              <flourish:CheckBox x:Name="MaterialDarkModeBox" VerticalAlignment="Center" Checked="MaterialDarkModeBox_Changed" Content="{culture:Localize Key=Shell_ImmersiveDarkMode_7E1CB18B}" Unchecked="MaterialDarkModeBox_Changed" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard x:Name="MaterialOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
      </Grid>
      <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="// Auto resolves to Mica on Windows 11, Acrylic on Windows 10,&#10;// and None on unsupported systems.&#10;material.SetEffect(MaterialEffect.Auto);&#10;material.SetDarkMode(theme.IsDark);&#10;&#10;// Concrete effects throw PlatformNotSupportedException when unavailable.&#10;if (material.IsSupported(MaterialEffect.MicaAlt))&#10;    material.SetEffect(MaterialEffect.MicaAlt);" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
