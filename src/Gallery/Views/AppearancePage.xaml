            </flourish:ActionCard>
            <flourish:ActionCard
              Margin="{DynamicResource FlourishActionCardPeerMargin}"
              Content="{culture:Localize Key=Shell_SetOneSharedRadiusOrLeaveTheFieldEmptyToRestoreTheStandardHierar_79220300}"
