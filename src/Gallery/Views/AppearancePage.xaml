<Page
  x:Class="ArkheideSystem.Gallery.Views.AppearancePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Configure shared Shell appearance and explore visual resources that can also change at runtime."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="Appearance"
    />

    <flourish:Chunk
      Content="Select the application color theme and switch among the supported modes without restarting the shell. Use this for a user-facing appearance preference or a theme preview; the code below shows direct selection, cycling, and the state-change event used to refresh dependent UI."
      Title="Theme"
    >
      <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE713;"
            Title="Theme"
            Content="Choose the requested application color mode."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishComboBox x:Name="ThemeBox" Width="220" SelectionChanged="ThemeBox_SelectionChanged" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE72C;"
            Title="Cycle theme"
            Content="Move through System, Light, and Dark."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="ToggleTheme_Click" Content="Cycle theme" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard
          x:Name="ThemeOutput"
          Grid.Column="1"
          Margin="8,0,0,0"
          VerticalAlignment="Stretch"
        />
      </Grid>
      <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="// Apply a specific theme or cycle through the supported modes.&#10;theme.SetTheme(FlourishTheme.Dark);&#10;theme.ToggleTheme();&#10;&#10;// Refresh theme-dependent UI after a change.&#10;theme.Changed += (_, _) =&gt; RefreshAppearance();" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Change the application-wide text scale, text family, and icon family through IFontService. Use this when typography is configurable for every page; the code below includes all defined font sizes and the separate icon font assignment."
      Title="Typography"
    >
      <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE8D2;"
            Title="Text font family"
            Content="Set the application-wide text family."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="FontFamilyBox" Width="220" KeyDown="TypographyBox_KeyDown" LostFocus="TypographyBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Small text size"
            Content="Set the small typography tier."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="SmallFontSizeBox" Width="120" KeyDown="TypographyBox_KeyDown" LostFocus="TypographyBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Standard text size"
            Content="Set the standard typography tier."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="StandardFontSizeBox" Width="120" KeyDown="TypographyBox_KeyDown" LostFocus="TypographyBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Icon size"
            Content="Set the dedicated icon glyph size."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="IconFontSizeBox" Width="120" KeyDown="TypographyBox_KeyDown" LostFocus="TypographyBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Large text size"
            Content="Set the bold large typography tier."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="LargeFontSizeBox" Width="120" KeyDown="TypographyBox_KeyDown" LostFocus="TypographyBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Extra-large text size"
            Content="Set the bold extra-large typography tier."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="ExtraLargeFontSizeBox" Width="120" KeyDown="TypographyBox_KeyDown" LostFocus="TypographyBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Header text size"
            Content="Set the bold page-header typography tier."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="HeaderSizeFontSizeBox" Width="120" KeyDown="TypographyBox_KeyDown" LostFocus="TypographyBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8B9;"
            Title="Icon font family"
            Content="Set the font used for application glyphs."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="IconFontFamilyBox" Width="220" KeyDown="TypographyBox_KeyDown" LostFocus="TypographyBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard x:Name="FontOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
      </Grid>
      <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="// Apply the complete application typography scale.&#10;font.SetFont(&#10;    &quot;Segoe UI Variable&quot;,&#10;    smallFontSize: 12,&#10;    standardFontSize: 14,&#10;    iconFontSize: 14,&#10;    largeFontSize: 16,&#10;    extraLargeFontSize: 24,&#10;    headerSizeFontSize: 32);&#10;font.SetIconFontFamily(&quot;Segoe Fluent Icons&quot;);" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Override selected typography resources for one Page type while all omitted values continue to inherit the application defaults. Use this for a page with distinct reading or presentation needs; the code below demonstrates adding and clearing a typed page override."
      Title="Page typography"
    >
      <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE8D2;"
            Title="Page font family"
            Content="Override the text family on this page."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="PageOverrideFontFamilyBox" Width="220" KeyDown="PageOverrideBox_KeyDown" LostFocus="PageOverrideBox_LostFocus" Text="Georgia" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Page small size"
            Content="Leave empty to follow the global small size."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="PageOverrideSmallFontSizeBox" Width="120" KeyDown="PageOverrideBox_KeyDown" LostFocus="PageOverrideBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Page standard size"
            Content="Leave empty to follow the global standard size."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="PageOverrideStandardFontSizeBox" Width="120" KeyDown="PageOverrideBox_KeyDown" LostFocus="PageOverrideBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Page icon size"
            Content="Leave empty to follow the global icon size."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="PageOverrideIconFontSizeBox" Width="120" KeyDown="PageOverrideBox_KeyDown" LostFocus="PageOverrideBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Page large size"
            Content="Leave empty to follow the global large size."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="PageOverrideLargeFontSizeBox" Width="120" KeyDown="PageOverrideBox_KeyDown" LostFocus="PageOverrideBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Page extra-large size"
            Content="Leave empty to follow the global extra-large size."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="PageOverrideExtraLargeFontSizeBox" Width="120" KeyDown="PageOverrideBox_KeyDown" LostFocus="PageOverrideBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Page header size"
            Content="Leave empty to follow the global header size."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="PageOverrideHeaderSizeFontSizeBox" Width="120" KeyDown="PageOverrideBox_KeyDown" LostFocus="PageOverrideBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE72C;"
            Title="Clear page override"
            Content="Restore the global application typography."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="ClearPageFontOverride_Click" Content="Clear override" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard x:Name="PageFontOverrideOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
      </Grid>
      <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="// Null size values keep the application-wide defaults.&#10;font.SetOverrideFont&lt;AppearancePage&gt;(&#10;    fontFamily: &quot;Georgia&quot;,&#10;    smallFontSize: null,&#10;    standardFontSize: 16,&#10;    iconFontSize: null,&#10;    largeFontSize: null,&#10;    extraLargeFontSize: null,&#10;    headerSizeFontSize: null);&#10;&#10;// Remove the typed override when the page should inherit again.&#10;font.RemoveOverrideFont&lt;AppearancePage&gt;();" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Apply shared palette and corner-radius overrides without replacing the active light or dark theme. Use these settings for live appearance editors and previews; passing null restores the standard theme resources."
      Title="Appearance overrides"
    >
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <flourish:ActionCard
              Content="Apply a sample primary, secondary, and accent palette."
              Icon="&#xE790;"
              Title="Color palette"
            >
              <flourish:ActionCard.Body>
                <flourish:Button Click="Palette_Click" Content="Preview palette" />
              </flourish:ActionCard.Body>
            </flourish:ActionCard>
            <flourish:ActionCard
              Margin="{DynamicResource FlourishActionCardPeerMargin}"
              Content="Set one shared radius or leave the field empty to restore the standard hierarchy."
              Icon="&#xE809;"
              Title="Corner radius"
            >
              <flourish:ActionCard.Body>
                <flourish:FlourishTextBox
                  x:Name="CornerRadiusBox"
                  Width="120"
                  KeyDown="CornerRadiusBox_KeyDown"
                  LostFocus="CornerRadiusBox_LostFocus"
                />
              </flourish:ActionCard.Body>
            </flourish:ActionCard>
            <flourish:ActionCard
              Margin="{DynamicResource FlourishActionCardPeerMargin}"
              Content="Remove both Flourish-owned overrides."
              Icon="&#xE777;"
              Title="Standard appearance"
            >
              <flourish:ActionCard.Body>
                <flourish:Button Click="ClearAppearance_Click" Content="Restore defaults" />
              </flourish:ActionCard.Body>
            </flourish:ActionCard>
          </StackPanel>
          <flourish:OutputCard
            x:Name="AppearanceOutput"
            Grid.Column="1"
            Margin="8,0,0,0"
            VerticalAlignment="Stretch"
          />
        </Grid>
        <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="// Apply or clear individual overrides.&#10;appearance.SetThemeColors(new FlourishThemeColors(primary, secondary, accent));&#10;appearance.SetCornerRadius(8);&#10;&#10;// Update both values atomically; null restores standard resources.&#10;appearance.SetAppearance(colors: null, cornerRadius: null);&#10;appearance.Changed += OnAppearanceChanged;" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Center page content within a shared maximum width and update both the active page and pages reached later through navigation. Use this for reading-focused or wide-screen layouts where long lines should remain comfortable to scan. The switch changes whether centering is active, the width field defines the shared limit, and the code demonstrates an atomic update plus state observation."
      Title="Content layout"
    >
      <StackPanel>
        <flourish:ActionCard
          Content="Enable or disable the centered page layout."
          Icon="&#xE8A7;"
          Title="Centered content"
        >
          <flourish:ActionCard.Body>
            <flourish:CheckBox
              x:Name="CenterContentBox"
              Checked="ContentLayout_Changed"
              Content="Center content"
              Unchecked="ContentLayout_Changed"
              VerticalAlignment="Center"
            />
          </flourish:ActionCard.Body>
        </flourish:ActionCard>
        <flourish:ActionCard
          Margin="{DynamicResource FlourishActionCardPeerMargin}"
          Content="Set the positive maximum width used by centered pages."
          Icon="&#xE8A7;"
          Title="Content width"
        >
          <flourish:ActionCard.Body>
            <flourish:FlourishTextBox
              x:Name="ContentWidthBox"
              Width="120"
              KeyDown="ContentWidthBox_KeyDown"
              LostFocus="ContentWidthBox_LostFocus"
            />
          </flourish:ActionCard.Body>
        </flourish:ActionCard>
        <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="// Change layout as one state transition.&#10;contentLayout.SetCenterContent(enabled: true, contentWidth: 1200);&#10;var current = contentLayout.Current;&#10;contentLayout.Changed += OnContentLayoutChanged;" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Choose the native material behind the shell and coordinate its immersive dark-mode flag with the active theme. Use this for Windows-integrated appearance where the requested effect may depend on platform support; the code below sets both material properties directly."
      Title="Window material"
    >
      <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE7F4;"
            Title="Window material"
            Content="Choose the native shell backdrop."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishComboBox x:Name="MaterialBox" Width="220" SelectionChanged="MaterialBox_SelectionChanged" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE708;"
            Title="Immersive dark mode"
            Content="Request dark native window chrome."
          >
            <flourish:ActionCard.Body>
              <flourish:CheckBox x:Name="MaterialDarkModeBox" VerticalAlignment="Center" Checked="MaterialDarkModeBox_Changed" Content="Immersive dark mode" Unchecked="MaterialDarkModeBox_Changed" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard x:Name="MaterialOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
      </Grid>
      <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="// Request the backdrop, then match native chrome to the theme.&#10;material.SetEffect(MaterialEffect.Mica);&#10;material.SetDarkMode(theme.IsDark);&#10;&#10;var supported = material.IsSupported(MaterialEffect.Mica);" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Choose whether Flourish-owned Shell, navigation, and page viewports smooth mouse-wheel movement. UseSmoothScroll sets the startup state, while IScrollService updates the active application immediately. An explicit IsSmoothScrollingEnabled value still overrides the application policy on an application-owned ScrollViewer."
      Title="Smooth scrolling"
    >
      <StackPanel>
        <flourish:ActionCard
          Content="The setting updates existing Flourish viewports through the shared dynamic resource."
          Icon="&#xE7C2;"
          Title="Shell scrolling"
        >
          <flourish:ActionCard.Body>
            <flourish:CheckBox
              x:Name="SmoothScrollingBox"
              Checked="SmoothScrollingBox_Changed"
              Content="Enable smooth scrolling"
              Unchecked="SmoothScrollingBox_Changed"
              VerticalAlignment="Center"
            />
          </flourish:ActionCard.Body>
        </flourish:ActionCard>
        <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}"
          Text="// Initialize the default for built-in Flourish scrolling surfaces.&#10;builder.ConfigShell(shell =&gt;&#10;    shell.UseSmoothScroll(enabled: true));&#10;&#10;// Change the active application and observe later changes.&#10;scroll.SetSmoothScrollingEnabled(false);&#10;var current = scroll.GetCurrent();&#10;scroll.Changed += OnScrollSettingsChanged;"
        />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="Browse the Flourish source repository." Icon="&#xE943;" IsEnabled="False" Title="GitHub repository" ToolTip="External navigation is not available in Gallery." />
        <flourish:CardButton Margin="8,0,0,0" Content="Read the canonical Flourish documentation." Icon="&#xE946;" IsEnabled="False" Title="Flourish documentation" ToolTip="External navigation is not available in Gallery." />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
