<Page
  x:Class="ArkheideSystem.Gallery.Views.ButtonPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Accessible application actions built on the WPF button contract."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="Button"
    />

    <flourish:Chunk Title="Variant">
      <UniformGrid Columns="3">
        <flourish:Presenter
          Margin="0,0,8,8"
          Content="Adds elevation to separate an action from its surrounding surface."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Elevated"
        >
          <flourish:Presenter.Presentation>
            <flourish:Button
              Width="120"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="Elevated"
              Variant="Elevated"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,8,8"
          Content="Expresses the primary action in a group."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Filled"
        >
          <flourish:Presenter.Presentation>
            <flourish:Button
              Width="120"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="Filled"
              Variant="Filled"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,8"
          Content="Provides a softer filled emphasis for supporting actions."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Tonal"
        >
          <flourish:Presenter.Presentation>
            <flourish:Button
              Width="120"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="Tonal"
              Variant="Tonal"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="0,8,8,0"
          Content="Uses a boundary for a medium-emphasis secondary action."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Outlined"
        >
          <flourish:Presenter.Presentation>
            <flourish:Button
              Width="120"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="Outlined"
              Variant="Outlined"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,8,8,0"
          Content="Keeps tertiary and toolbar actions visually quiet."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Text"
        >
          <flourish:Presenter.Presentation>
            <flourish:Button
              Width="120"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="Text"
              Variant="Text"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,8,0,0"
          Content="Identifies destructive or difficult-to-reverse intent."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Danger"
        >
          <flourish:Presenter.Presentation>
            <flourish:Button
              Width="120"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="Danger"
              Variant="Danger"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Table">
      <flourish:DataGrid
        x:Name="PropertiesGrid"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        CanUserReorderColumns="False"
        FontWeight="Regular"
        IsReadOnly="True"
      >
        <flourish:DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="PROPERTY" Width="220" />
          <DataGridTextColumn Binding="{Binding Description}" Header="PURPOSE" Width="*" />
        </flourish:DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Actions">
      <StackPanel>
        <flourish:Presenter
          Margin="0,0,0,16"
          Content="Bind Command for reusable actions, or handle Click for local behavior."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Standard action"
        >
          <flourish:Presenter.Presentation>
            <Grid
              Width="240"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
              >
                <flourish:Button Margin="0,0,8,0" Content="Continue" Variant="Filled" />
                <flourish:Button Content="Cancel" Variant="Outlined" />
              </StackPanel>
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Content="Use a ToolTip or automation name when the action has no visible label."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Icon actions"
        >
          <flourish:Presenter.Presentation>
            <Grid
              Width="264"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
              >
                <flourish:Button
                  Margin="0,0,8,0"
                  AutomationProperties.Name="Refresh"
                  Icon="&#xE72C;"
                  ToolTip="Refresh"
                  Variant="Text"
                />
                <flourish:Button
                  Margin="0,0,8,0"
                  AutomationProperties.Name="Search"
                  Icon="&#xE8D4;"
                  ToolTip="Search"
                  Variant="Text"
                />
                <flourish:Button Content="Add item" Icon="&#xE710;" Variant="Filled" />
              </StackPanel>
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Interaction contract">
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Title="Enabled action"
          Content="The enabled button accepts pointer and keyboard focus and exposes its icon and visible command label."
          PresenterMode="TopDown"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:Button
              Width="160"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              AutomationProperties.Name="Save report"
              Content="Save report"
              Icon="&#xE74E;"
              ToolTip="Save report"
              Variant="Filled"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Title="Disabled action"
          Content="IsEnabled=False preserves the selected variant while communicating that the command is currently unavailable."
          PresenterMode="TopDown"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:Button
              Width="160"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="Publish report"
              Icon="&#xE789;"
              IsEnabled="False"
              Variant="Filled"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Usage">
      <StackPanel>
        <flourish:Presenter
          Title="Create a command button"
          Content="Bind Command to application logic and set Content for the visible label. Add Icon when it improves recognition; either region collapses when omitted. Use Filled for a primary action, Tonal or Outlined for supporting actions, Text for low emphasis, and Danger only for destructive work."
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace Text="&lt;flourish:Button&#xA;  Command=&quot;{Binding SaveCommand}&quot;&#xA;  Content=&quot;Save&quot;&#xA;  Icon=&quot;&amp;#xE74E;&quot;&#xA;  Variant=&quot;Filled&quot; /&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Title="Make an icon-only action accessible"
          Content="When Content is omitted, give the icon-only button both AutomationProperties.Name and a matching ToolTip. This keeps the compact Text or Danger action understandable to assistive technology and pointer users."
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace Text="&lt;flourish:Button&#xA;  AutomationProperties.Name=&quot;Delete report&quot;&#xA;  Command=&quot;{Binding DeleteCommand}&quot;&#xA;  Icon=&quot;&amp;#xE74D;&quot;&#xA;  ToolTip=&quot;Delete report&quot;&#xA;  Variant=&quot;Danger&quot; /&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          AutomationProperties.Name="Flourish GitHub repository"
          Content="Repository link placeholder"
          Icon="&#xE943;"
          IsEnabled="False"
          Title="GitHub repository"
          ToolTip="External navigation is not available in Gallery."
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          AutomationProperties.Name="Button documentation"
          Content="Canonical documentation link placeholder"
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="Button documentation"
          ToolTip="External navigation is not available in Gallery."
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
