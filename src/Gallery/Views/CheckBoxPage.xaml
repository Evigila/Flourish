<Page
  x:Class="ArkheideSystem.Gallery.Views.CheckBoxPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Represent a Boolean or optional three-state preference with a compact row or an icon-led card."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="CheckBox"
    />

    <flourish:Chunk
      Content="Horizontal is the default for standard settings. Vertical adds an optional icon and uses a card-shaped layout."
      Title="Variant"
    >
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Content="Places the state indicator before the content. An unchecked option keeps an empty circular indicator."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Horizontal"
        >
          <flourish:Presenter.Presentation>
            <StackPanel MinHeight="152" HorizontalAlignment="Center" VerticalAlignment="Center">
              <flourish:CheckBox Content="Enable notifications" />
              <flourish:CheckBox Margin="0,8,0,0" Content="Synchronize automatically" IsChecked="True" />
            </StackPanel>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="Places the icon above the content and the selected indicator at the upper right. The indicator is hidden while unchecked."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Vertical"
        >
          <flourish:Presenter.Presentation>
            <UniformGrid MinHeight="152" Columns="2">
              <flourish:CheckBox
                Margin="0,0,6,0"
                Content="Local workspace"
                Icon="&#xE8B7;"
                Variant="Vertical"
              />
              <flourish:CheckBox
                Margin="6,0,0,0"
                Content="Cloud workspace"
                Icon="&#xE753;"
                IsChecked="True"
                Variant="Vertical"
              />
            </UniformGrid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Table">
      <flourish:DataGrid
        x:Name="MemberGrid"
        AutoGenerateColumns="False"
        IsReadOnly="True"
      >
        <flourish:DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="Member" Width="220" />
          <DataGridTextColumn Binding="{Binding Description}" Header="Purpose" Width="*" />
        </flourish:DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Use two-state behavior for ordinary preferences and enable the third state only when null has a clear meaning."
      Title="Selection"
    >
      <UniformGrid Columns="3">
        <flourish:Presenter
          Margin="0,0,8,0"
          Content="False uses an empty circular indicator."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Unchecked"
        >
          <flourish:Presenter.Presentation>
            <Grid MinHeight="120">
              <flourish:CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Content="Not selected" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0"
          Content="True uses a check mark and highlights the content and boundary."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Checked"
        >
          <flourish:Presenter.Presentation>
            <Grid MinHeight="120">
              <flourish:CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Content="Selected" IsChecked="True" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="Null replaces the check mark with a horizontal line."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Indeterminate"
        >
          <flourish:Presenter.Presentation>
            <Grid MinHeight="120">
              <flourish:CheckBox
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="Inherited"
                IsChecked="{x:Null}"
                IsThreeState="True"
              />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Usage">
      <StackPanel>
        <flourish:Presenter
          Content="Horizontal is the default. Bind IsChecked in TwoWay mode for a standard setting and enable IsThreeState only when null represents inherited, mixed, or unknown state."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Standard option"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace Text="{Binding UsageCode, ElementName=RootPage}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="Choose Vertical for a card-shaped selection. Icon accepts arbitrary content but is rendered only by the Vertical layout."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Icon-led option"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace Text="&lt;flourish:CheckBox&#xA;  Content=&quot;Cloud workspace&quot;&#xA;  Icon=&quot;&amp;#xE753;&quot;&#xA;  IsChecked=&quot;{Binding UsesCloudWorkspace, Mode=TwoWay}&quot;&#xA;  Variant=&quot;Vertical&quot; /&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          Content="Browse the Flourish source repository."
          Icon="&#xE943;"
          IsEnabled="False"
          Title="GitHub repository"
          ToolTip="External navigation is not available in Gallery."
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          Content="Read the CheckBox API and layout contract."
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="CheckBox documentation"
          ToolTip="External navigation is not available in Gallery."
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
