<Page
  x:Class="ArkheideSystem.Gallery.Views.SearchBoxPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Collect compact query text with a search glyph and an in-control placeholder."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="FlourishSearchBox"
    />

    <flourish:Chunk Title="Table">
      <flourish:DataGrid
        x:Name="MemberGrid"
        AutoGenerateColumns="False"
        IsReadOnly="True"
      >
        <flourish:DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="Member" Width="220" />
          <DataGridTextColumn Binding="{Binding Description}" Header="Purpose" Width="*" />
        </flourish:DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="The placeholder collapses when a query exists or the field receives focus."
      Title="Query"
    >
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Content="Placeholder supplies a concise hint before the user enters a query."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Empty query"
        >
          <flourish:Presenter.Presentation>
            <flourish:FlourishSearchBox
              Width="260"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Placeholder="Search controls"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="Text uses the same binding, validation, and change notification contract as FlourishTextBox."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Active query"
        >
          <flourish:Presenter.Presentation>
            <flourish:FlourishSearchBox
              Width="260"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Placeholder="Search controls"
              Text="Presenter"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Usage">
      <StackPanel>
        <flourish:Presenter
          Content="Bind Text with PropertyChanged updates when results should react continuously as the query changes. TextChanged is an alternative for lightweight view-owned filtering. Placeholder guides an empty field but does not replace a visible label when the search purpose is ambiguous."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Live query"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:FlourishSearchBox&#xA;  Placeholder=&quot;Search controls&quot;&#xA;  MaxLength=&quot;120&quot;&#xA;  Text=&quot;{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}&quot; /&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="Use the normal WPF keyboard contract when search should run only after explicit submission. The KeyDown handler checks Enter and passes the current Text to an application command; prefer a command binding when the same gesture must be shared across several controls."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Submitted query"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="{Binding UsageCode, ElementName=RootPage}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          Content="Browse the Flourish source repository."
          Icon="&#xE943;"
          IsEnabled="False"
          Title="GitHub repository"
          ToolTip="External navigation is not available in Gallery."
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          Content="Read the FlourishSearchBox API reference."
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="FlourishSearchBox documentation"
          ToolTip="External navigation is not available in Gallery."
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
