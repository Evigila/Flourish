<Page
  x:Class="ArkheideSystem.Gallery.Views.SearchBoxPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:culture="clr-namespace:Arkheide.Essential.Culture"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="{culture:Localize Key=Controls_CollectCompactQueryTextWithASearchGlyphAndAnInControlPlaceholder_53FB208B}"
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="FlourishSearchBox"
    />

    <flourish:Chunk Title="{culture:Localize Key=Controls_Table_16D1C905}">
      <flourish:DataGrid
        x:Name="MemberGrid"
        AutoGenerateColumns="False"
        IsReadOnly="True"
      >
        <flourish:DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="{culture:Localize Key=Controls_Member_7C968FB7}" Width="220" />
          <DataGridTextColumn Binding="{Binding Description}" Header="{culture:Localize Key=Controls_Purpose_D4E8830A}" Width="*" />
        </flourish:DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="{culture:Localize Key=Controls_ThePlaceholderCollapsesWhenAQueryExistsOrTheFieldReceivesFocus_4E01A3A3}"
      Title="{culture:Localize Key=Controls_Query_B80A3756}"
    >
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Content="{culture:Localize Key=Controls_PlaceholderSuppliesAConciseHintBeforeTheUserEntersAQuery_2BB544F0}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_EmptyQuery_F1E2C7E8}"
        >
          <flourish:Presenter.Presentation>
            <flourish:FlourishSearchBox
              Width="260"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Placeholder="{culture:Localize Key=Controls_SearchControls_71EB81F3}"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="{culture:Localize Key=Controls_TextUsesTheSameBindingValidationAndChangeNotificationContractAsF_A964198E}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_ActiveQuery_6DC1590A}"
        >
          <flourish:Presenter.Presentation>
            <flourish:FlourishSearchBox
              Width="260"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Placeholder="{culture:Localize Key=Controls_SearchControls_71EB81F3}"
              Text="Presenter"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Usage_8D59829C}">
      <StackPanel>
        <flourish:Presenter
          Content="{culture:Localize Key=Controls_BindTextWithPropertyChangedUpdatesWhenResultsShouldReactContinuo_6C0F24FC}"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_LiveQuery_5AC36933}"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:FlourishSearchBox&#xA;  Placeholder=&quot;Search controls&quot;&#xA;  MaxLength=&quot;120&quot;&#xA;  Text=&quot;{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}&quot; /&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="{culture:Localize Key=Controls_UseTheNormalWPFKeyboardContractWhenSearchShouldRunOnlyAfterExpli_F0AEADAD}"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_SubmittedQuery_65ED7722}"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="{Binding UsageCode, ElementName=RootPage}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Reference_71BF9093}">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          Content="{culture:Localize Key=Controls_BrowseTheFlourishSourceRepository_5CC28F39}"
          Icon="&#xE943;"
          IsEnabled="False"
          Title="{culture:Localize Key=Controls_GitHubRepository_50555492}"
          ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}"
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          Content="{culture:Localize Key=Controls_ReadTheFlourishSearchBoxAPIReference_BB6586CD}"
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="{culture:Localize Key=Controls_FlourishSearchBoxDocumentation_08AB34C9}"
          ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}"
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
