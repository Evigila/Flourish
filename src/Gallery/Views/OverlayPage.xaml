<Page
  x:Class="ArkheideSystem.Gallery.Views.OverlayPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  PreviewKeyDown="Page_PreviewKeyDown"
  SnapsToDevicePixels="True"
  Unloaded="Page_Unloaded"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Anchored floating content with two dismissal contracts."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="Overlay"
    />

    <flourish:Chunk Title="Variant">
      <UniformGrid Columns="2">
        <flourish:Presenter Margin="0,0,8,0" Content="Dismisses when pointer tracking leaves the surface and its anchor." PresenterMode="TopDown" PresentationMinHeight="240" PresenterPosition="Left" Title="Temporary">
          <flourish:Presenter.Presentation>
            <flourish:Overlay
              Width="320"
              Height="200"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="16"
              Variant="Temporary"
            >
              <flourish:ActionCard Content="Closes after pointer exit." Icon="&#xE823;" Title="Temporary" Variant="Vertical" />
            </flourish:Overlay>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter Margin="8,0,0,0" Content="Remains open until an explicit dismissal action occurs." PresenterMode="TopDown" PresentationMinHeight="240" PresenterPosition="Left" Title="Strong">
          <flourish:Presenter.Presentation>
            <flourish:Overlay
              Width="320"
              Height="200"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="16"
              Variant="Strong"
            >
              <flourish:ActionCard Content="Waits for an explicit action." Icon="&#xE77B;" Title="Strong" Variant="Vertical" />
            </flourish:Overlay>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Table">
      <flourish:DataGrid ItemsSource="{Binding Properties, ElementName=RootPage}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Width="220" Binding="{Binding Name}" Header="Member" />
          <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="Function" />
        </DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Example">
      <StackPanel>
        <flourish:ActionCard
          Content="Hover or activate the action to show a temporary surface."
          Icon="&#xE823;"
          Title="Temporary preview"
          Variant="Horizontal"
        >
          <flourish:ActionCard.Body>
            <flourish:Button
              x:Name="TemporaryTrigger"
              Click="TemporaryTrigger_Click"
              Content="Show temporary Overlay"
              MouseEnter="TemporaryTrigger_MouseEnter"
            />
          </flourish:ActionCard.Body>
        </flourish:ActionCard>
        <flourish:ActionCard
          Margin="{DynamicResource FlourishActionCardPeerMargin}"
          Content="Open until explicitly dismissed."
          Icon="&#xE77B;"
          Title="Strong preview"
          Variant="Horizontal"
        >
          <flourish:ActionCard.Body>
            <flourish:Button
              x:Name="StrongTrigger"
              Click="StrongTrigger_Click"
              Content="Show strong Overlay"
            />
          </flourish:ActionCard.Body>
        </flourish:ActionCard>

        <Popup
          x:Name="TemporaryPopup"
          AllowsTransparency="True"
          Placement="Bottom"
          PopupAnimation="Fade"
          StaysOpen="True"
        >
          <flourish:Overlay
            x:Name="TemporaryOverlay"
            Width="300"
            Margin="0,6,0,0"
            DismissRequested="Overlay_DismissRequested"
            Variant="Temporary"
          >
            <flourish:ActionCard
              Content="Move the pointer here, then leave both this surface and its trigger to close it."
              Icon="&#xE823;"
              Title="Temporary Overlay"
              Variant="Vertical"
            />
          </flourish:Overlay>
        </Popup>

        <Popup
          x:Name="StrongPopup"
          AllowsTransparency="True"
          Opened="StrongPopup_Opened"
          Placement="Bottom"
          PopupAnimation="Fade"
          StaysOpen="False"
        >
          <flourish:Overlay
            x:Name="StrongOverlay"
            Width="320"
            Margin="0,6,0,0"
            DismissRequested="Overlay_DismissRequested"
            PreviewKeyDown="Page_PreviewKeyDown"
            Variant="Strong"
          >
            <flourish:ActionCard
              Content="Pointer movement does not close this surface. Use the action, Escape, or click elsewhere."
              Icon="&#xE77B;"
              Title="Strong Overlay"
              Variant="Vertical"
            >
              <flourish:ActionCard.Body>
                <flourish:Button
                  x:Name="StrongCloseButton"
                  Click="StrongCloseButton_Click"
                  Content="Close Overlay"
                />
              </flourish:ActionCard.Body>
            </flourish:ActionCard>
          </flourish:Overlay>
        </Popup>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Custom layout">
      <flourish:Overlay x:Name="CustomLayoutOverlay" Variant="Strong">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border
            Width="48"
            Height="48"
            Background="{DynamicResource FlourishPrimarySurfaceBrush}"
            CornerRadius="24"
          >
            <flourish:FlourishTextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Role="CardTitle"
              Text="FL"
            />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <flourish:FlourishTextBlock Role="CardTitle" Text="Custom profile layout" />
            <flourish:FlourishTextBlock
              Margin="0,4,0,0"
              Role="Description"
              Text="Overlay also accepts a purpose-built layout when ActionCard is not sufficient."
              TextWrapping="Wrap"
            />
          </StackPanel>
        </Grid>
      </flourish:Overlay>
    </flourish:Chunk>

    <flourish:Chunk Title="Dismissal">
      <flourish:Card Content="PlacementTarget extends Temporary hover tracking to the anchor. DismissRequested tells the host to close." />
    </flourish:Chunk>

    <flourish:Chunk Title="Interactive triggers">
      <flourish:Card Content="Use Button or CardButton for activation. Card is an information surface and is not an Overlay trigger." />
    </flourish:Chunk>

    <flourish:Chunk Title="Usage">
      <StackPanel>
        <flourish:Presenter
          Content="Use Strong for a surface that remains open until the host handles an explicit dismissal request. A vertical ActionCard is the standard focused layout, while the surrounding Popup remains responsible for visibility and placement."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Strong overlay"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace Text="&lt;Popup x:Name=&quot;ProfilePopup&quot; Placement=&quot;Bottom&quot;&gt;&#xA;  &lt;flourish:Overlay&#xA;    x:Name=&quot;ProfileOverlay&quot;&#xA;    DismissRequested=&quot;Overlay_DismissRequested&quot;&#xA;    Variant=&quot;Strong&quot;&gt;&#xA;    &lt;flourish:ActionCard&#xA;      Title=&quot;Profile&quot;&#xA;      Content=&quot;Manage account details.&quot;&#xA;      Variant=&quot;Vertical&quot; /&gt;&#xA;  &lt;/flourish:Overlay&gt;&#xA;&lt;/Popup&gt;&#xA;&#xA;ProfilePopup.PlacementTarget = trigger;&#xA;ProfileOverlay.PlacementTarget = trigger;&#xA;ProfilePopup.IsOpen = true;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="Use Temporary for hover affordances and short previews. PlacementTarget extends hover tracking across the anchor and overlay; the host opens the Popup when the pointer enters or the trigger is activated."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Temporary overlay"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace Text="&lt;Popup x:Name=&quot;PreviewPopup&quot; Placement=&quot;Bottom&quot;&gt;&#xA;  &lt;flourish:Overlay&#xA;    x:Name=&quot;PreviewOverlay&quot;&#xA;    DismissRequested=&quot;Overlay_DismissRequested&quot;&#xA;    Variant=&quot;Temporary&quot;&gt;&#xA;    &lt;TextBlock Text=&quot;Preview details&quot; /&gt;&#xA;  &lt;/flourish:Overlay&gt;&#xA;&lt;/Popup&gt;&#xA;&#xA;PreviewPopup.PlacementTarget = previewButton;&#xA;PreviewOverlay.PlacementTarget = previewButton;&#xA;PreviewPopup.IsOpen = true;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="Overlay requests dismissal but does not own Popup visibility. Close the host in DismissRequested. For Strong, an explicit action can raise the routed event so every closing path shares the same handler."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Handle dismissal"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace Text="private void Close_Click(object sender, RoutedEventArgs e)&#xA;{&#xA;    ProfileOverlay.RaiseEvent(new RoutedEventArgs(&#xA;        Overlay.DismissRequestedEvent, ProfileOverlay));&#xA;}&#xA;&#xA;private void Overlay_DismissRequested(object sender, RoutedEventArgs e)&#xA;{&#xA;    ProfilePopup.IsOpen = false;&#xA;    e.Handled = true;&#xA;}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          AutomationProperties.Name="Flourish GitHub repository"
          Content="https://github.com/Evigila/Flourish"
          Icon="&#xE8A7;"
          IsEnabled="False"
          Title="GitHub repository"
          ToolTip="External navigation is not available in Gallery."
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          AutomationProperties.Name="Overlay documentation"
          Content="docs/en-us/controls/overlay.md"
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="Overlay documentation"
          ToolTip="External navigation is not available in Gallery."
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
