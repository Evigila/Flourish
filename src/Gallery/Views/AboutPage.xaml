<Page
  x:Class="ArkheideSystem.Gallery.Views.AboutPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Title="About Flourish"
      Content="Flourish is a WPF application framework for building consistent Windows desktop shells, navigation, surfaces, and controls. It brings application composition and reusable visual contracts together so teams can focus on product workflows instead of repeatedly rebuilding shell infrastructure."
      PresenterMode="Split"
      PresenterPosition="Right"
    />

    <flourish:Chunk Title="Project">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          Icon="&#xE943;"
          IsEnabled="False"
          Title="Repository"
          Content="Source, releases, issues, and contribution history are hosted on GitHub."
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="Documentation"
          Content="Concepts, guides, control contracts, and generated API references live with the repository."
        />
      </UniformGrid>
    </flourish:Chunk>

  </flourish:PageBody>
</Page>
