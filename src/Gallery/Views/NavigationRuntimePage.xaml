<Page
  x:Class="ArkheideSystem.Gallery.Views.NavigationRuntimePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Configure the navigation panel, routes, menu entries, and page caching while the application is running."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="Navigation"
    />

    <flourish:Chunk
      Content="Control whether the navigation panel is open and enabled, choose its host edge, and define its width constraints through INavigationPanelService. Use these settings for responsive shell layouts or user-selected navigation placement; the code below shows the complete panel state API used by this example."
      Title="Navigation panel"
    >
      <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE700;"
            Title="Panel state"
            Content="Open or close the live navigation panel."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="TogglePanel_Click" Content="Open / close" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE713;"
            Title="Panel availability"
            Content="Enable or disable navigation without recreating the shell."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="TogglePanelEnabled_Click" Content="Enable / disable" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE72A;"
            Title="Panel direction"
            Content="Choose the edge that hosts the navigation panel."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishComboBox x:Name="DirectionBox" Width="120" SelectionChanged="DirectionBox_SelectionChanged" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE713;"
            Title="Open width"
            Content="Set the panel width while navigation is open."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="OpenWidthBox" Width="110" KeyDown="WidthBox_KeyDown" LostFocus="WidthBox_LostFocus" Text="240" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE713;"
            Title="Closed width"
            Content="Set the panel width while navigation is closed."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="ClosedWidthBox" Width="110" KeyDown="WidthBox_KeyDown" LostFocus="WidthBox_LostFocus" Text="64" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE713;"
            Title="Minimum width"
            Content="Set the minimum allowed panel width."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="MinWidthBox" Width="110" KeyDown="WidthBox_KeyDown" LostFocus="WidthBox_LostFocus" Text="150" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE713;"
            Title="Maximum width"
            Content="Set the maximum allowed panel width."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="MaxWidthBox" Width="110" KeyDown="WidthBox_KeyDown" LostFocus="WidthBox_LostFocus" Text="480" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard x:Name="PanelOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
      </Grid>
      <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="// Panel changes apply immediately to the active shell.&#10;panel.SetEnabled(true);&#10;panel.SetDirection(NavigationPanelDirection.Left);&#10;panel.SetPanelWidth(&#10;    openWidth: 240,&#10;    closedWidth: 64,&#10;    maxWidth: 480,&#10;    minWidth: 150);&#10;panel.Toggle();" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Register a destination, place its item in the live navigation menu, navigate to it, and remove both pieces when the feature is unloaded. Use this for plugins or optional modules discovered after startup; the code below shows the route registry and menu update that must stay coordinated."
      Title="Routes"
    >
      <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE710;"
            Title="Install demo route"
            Content="Register the runtime route and its navigation item."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="InstallRoute_Click" Content="Install demo route" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE72A;"
            Title="Navigate to route"
            Content="Open the registered runtime destination."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="NavigateRoute_Click" Content="Navigate to route" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE713;"
            Title="Navigation item"
            Content="Enable or disable the installed menu item."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="ToggleMenuItem_Click" Content="Enable / disable item" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE74D;"
            Title="Remove demo route"
            Content="Remove the route and its navigation item."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="RemoveRoute_Click" Content="Remove route" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard x:Name="RouteOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
      </Grid>
      <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="// Register the destination before publishing its menu item.&#10;routes.Set(new FlourishNavigationRoute(&#10;    &quot;Reports&quot;,&#10;    typeof(ReportsPage),&#10;    FlourishPageCacheMode.Enabled));&#10;&#10;menu.Set(editor =&gt;&#10;{&#10;    editor.AppendGroup(&quot;reports&quot;, &quot;Reports&quot;);&#10;    editor.SetItem(&quot;reports&quot;, FlourishNavigationMenuItem.Page(&#10;        &quot;reports.summary&quot;, &quot;Reports&quot;, &quot;Summary&quot;, &quot;\uE9D2&quot;));&#10;});&#10;&#10;navigation.Navigate(&quot;Reports&quot;);&#10;menu.Set(editor =&gt; editor.RemoveItem(&quot;reports.summary&quot;));&#10;routes.Remove(&quot;Reports&quot;);" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Choose whether a registered route retains its Page instance and explicitly evict one or every cached page. Enable caching for stateful destinations that are revisited often, and disable it for short-lived or memory-heavy views; the code below keeps route metadata and the active cache policy in sync."
      Title="Page cache"
    >
      <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE74E;"
            Title="Enable cache"
            Content="Retain page instances for subsequent navigation."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="EnableCache_Click" Content="Enable cache" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE711;"
            Title="Disable cache"
            Content="Stop retaining page instances for this route."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="DisableCache_Click" Content="Disable cache" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE74D;"
            Title="Evict demo page"
            Content="Remove the demo instance while preserving its route."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="EvictCache_Click" Content="Evict demo page" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE74D;"
            Title="Clear page cache"
            Content="Remove every active cached page instance."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="ClearCache_Click" Content="Clear all" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard x:Name="CacheOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
      </Grid>
      <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="// Keep the route policy and active page cache aligned.&#10;routes.SetCacheMode(&quot;Reports&quot;, FlourishPageCacheMode.Enabled);&#10;cache.SetCacheMode(typeof(ReportsPage), FlourishPageCacheMode.Enabled);&#10;&#10;cache.Evict(typeof(ReportsPage));&#10;cache.Clear();" />
      </StackPanel>
    </flourish:Chunk>
    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="Browse the Flourish source repository." Icon="&#xE943;" IsEnabled="False" Title="GitHub repository" ToolTip="External navigation is not available in Gallery." />
        <flourish:CardButton Margin="8,0,0,0" Content="Read the canonical Flourish documentation." Icon="&#xE946;" IsEnabled="False" Title="Flourish documentation" ToolTip="External navigation is not available in Gallery." />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
