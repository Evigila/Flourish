<Page
  x:Class="ArkheideSystem.Gallery.Views.ToolTipsConfigurationPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Title="ToolTips"
      Content="Enable the Flourish tooltip presentation and define its initial display delay."
      PresenterMode="Split"
      PresenterPosition="Right"
    />

    <flourish:Chunk
      Title="Tooltip behavior"
      Content="Tooltips label compact or icon-only Flourish controls without adding permanent visual noise. UseTips selects the Flourish presentation and sets the initial hover delay, while each control continues to provide its own ToolTip content and accessible name. This is recommended for unfamiliar icons and secondary actions; the code below configures the host and shows the corresponding XAML."
    >
      <StackPanel>
        <flourish:Card
          Icon="&#xE823;"
          Title="Shared presentation"
          Content="Empty or whitespace-only tooltip content collapses completely, while native and third-party controls keep their own tooltip presentation."
        />
        <flourish:CodeSpace
          Margin="0,16,0,0"
          Text="// Delay is measured in milliseconds and must be non-negative.&#10;builder.ConfigureShell(shell =&gt;&#10;    shell.UseTips(enabled: true, delay: 200));&#10;&#10;// Supply a visible hint and an accessible action name.&#10;&lt;flourish:Button&#10;  AutomationProperties.Name=&quot;Refresh&quot;&#10;  Content=&quot;Refresh&quot;&#10;  ToolTip=&quot;Reload the current data.&quot; /&gt;"
        />
      </StackPanel>
    </flourish:Chunk>
    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="Browse the Flourish source repository." Icon="&#xE943;" IsEnabled="False" Title="GitHub repository" ToolTip="External navigation is not available in Gallery." />
        <flourish:CardButton Margin="8,0,0,0" Content="Read the canonical Flourish documentation." Icon="&#xE946;" IsEnabled="False" Title="Flourish documentation" ToolTip="External navigation is not available in Gallery." />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
