            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
              <flourish:TextBlock Margin="12" FontSize="{DynamicResource FlourishFontSizeLargeIcon}" Foreground="#80FFFFFF" LineHeight="{DynamicResource FlourishLineHeightLargeIcon}" Role="Icon" Text="&#xE8A5;" />
              <flourish:TextBlock Margin="12" FontSize="{DynamicResource FlourishFontSizeLargeIcon}" Foreground="#80FFFFFF" LineHeight="{DynamicResource FlourishLineHeightLargeIcon}" Role="Icon" Text="&#xE8B9;" />
