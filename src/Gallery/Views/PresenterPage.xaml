            <flourish:Button Content="{culture:Localize Key=Controls_ExploreLayout_559848C8}" Variant="Filled" />
          </flourish:Presenter.Body>
          <flourish:Presenter.Presentation>
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Orientation="Horizontal"
            >
              <flourish:TextBlock Margin="8" FontSize="{DynamicResource FlourishFontSizeLargeIcon}" LineHeight="{DynamicResource FlourishLineHeightLargeIcon}" Role="Icon" Text="&#xE8A5;" />
              <flourish:TextBlock Margin="8" FontSize="{DynamicResource FlourishFontSizeLargeIcon}" LineHeight="{DynamicResource FlourishLineHeightLargeIcon}" Role="Icon" Text="&#xE7C8;" />
              <flourish:TextBlock Margin="8" FontSize="{DynamicResource FlourishFontSizeLargeIcon}" LineHeight="{DynamicResource FlourishLineHeightLargeIcon}" Role="Icon" Text="&#xE790;" />
            </StackPanel>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>

        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="{culture:Localize Key=Controls_PresenterPositionRightMovesPresentationToTheRightWhileTitleConte_5C0E08C4}"
          PresenterMode="Split"
          PresenterPosition="Right"
          Title="{culture:Localize Key=Controls_RightPresentation_0EA252BB}"
        >
          <flourish:Presenter.Body>
            <flourish:Button Content="{culture:Localize Key=Controls_OpenDetails_67D16BB1}" Variant="Tonal" />
          </flourish:Presenter.Body>
          <flourish:Presenter.Presentation>
            <flourish:TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="{DynamicResource FlourishFontSizeLargeIcon}"
              LineHeight="{DynamicResource FlourishLineHeightLargeIcon}"
              Role="Icon"
              Text="&#xE950;"
              TextAlignment="Center"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="{culture:Localize Key=Controls_OverlayLayersCopyAndBodyOverPresentation_BCDA8D28}"
