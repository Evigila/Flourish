          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:Presenter&#xA;  Title=&quot;Featured workspace&quot;&#xA;  Content=&quot;Open the workspace summary.&quot;&#xA;  PresenterMode=&quot;Overlay&quot;&#xA;  PresenterPosition=&quot;Right&quot;&gt;&#xA;  &lt;flourish:Presenter.Presentation&gt;&#xA;    &lt;Image Source=&quot;Assets/workspace.png&quot; Stretch=&quot;UniformToFill&quot; /&gt;&#xA;  &lt;/flourish:Presenter.Presentation&gt;&#xA;&lt;/flourish:Presenter&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Reference_71BF9093}">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          Content="{culture:Localize Key=Controls_BrowseTheFlourishSourceRepository_5CC28F39}"
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="{culture:Localize Key=Controls_GitHubRepository_50555492}"
          ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}"
        />
        <flourish:CardButton
          Margin="8,0,0,0"
