          <flourish:Presenter.Presentation>
            <Grid
              Width="320"
              Height="160"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <Rectangle Margin="8" Fill="{DynamicResource FlourishNeutralBackground2Brush}" RadiusX="8" RadiusY="8" />
              <Rectangle Width="120" Height="64" Stroke="{DynamicResource FlourishNeutralStroke1Brush}" StrokeThickness="1" RadiusX="8" RadiusY="8" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter Margin="8,0,0,0" Content="{culture:Localize Key=Controls_PlacesPresentationAboveTheCopyAndBodyRegionAndMayShareARowWithPe_4926FF66}" PresenterMode="TopDown" PresenterPosition="Left" Title="TopDown">
