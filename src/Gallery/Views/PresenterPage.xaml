<Page
  x:Class="ArkheideSystem.Gallery.Views.PresenterPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Combine copy and controls with images, illustrations, or groups of icons in one full-width presentation layout."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="Presenter"
    />

    <flourish:Chunk
      Content="Each diagram summarizes a composition. The full-width live examples follow the member table."
      Title="Variant"
    >
      <UniformGrid Columns="3">
        <flourish:Presenter Margin="0,0,8,0" Content="Places Presentation beside the copy-and-body region." PresenterMode="TopDown" PresenterPosition="Left" Title="Split">
          <flourish:Presenter.Presentation>
            <Grid
              Width="320"
              Height="160"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Rectangle Margin="8" Fill="{DynamicResource FlourishNeutralBackground2Brush}" RadiusX="8" RadiusY="8" />
              <Rectangle Grid.Column="1" Margin="8" Stroke="{DynamicResource FlourishNeutralStroke1Brush}" StrokeThickness="1" RadiusX="8" RadiusY="8" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter Margin="4,0" Content="Layers the copy-and-body region over Presentation." PresenterMode="TopDown" PresenterPosition="Left" Title="Overlay">
          <flourish:Presenter.Presentation>
            <Grid
              Width="320"
              Height="160"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <Rectangle Margin="8" Fill="{DynamicResource FlourishNeutralBackground2Brush}" RadiusX="8" RadiusY="8" />
              <Rectangle Width="120" Height="64" Stroke="{DynamicResource FlourishNeutralStroke1Brush}" StrokeThickness="1" RadiusX="8" RadiusY="8" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter Margin="8,0,0,0" Content="Places Presentation above the copy-and-body region and may share a row with peer TopDown Presenters." PresenterMode="TopDown" PresenterPosition="Left" Title="TopDown">
          <flourish:Presenter.Presentation>
            <Grid
              Width="320"
              Height="160"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Rectangle Margin="8" Fill="{DynamicResource FlourishNeutralBackground2Brush}" RadiusX="8" RadiusY="8" />
              <Rectangle Grid.Row="1" Margin="8" Stroke="{DynamicResource FlourishNeutralStroke1Brush}" StrokeThickness="1" RadiusX="8" RadiusY="8" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Table">
      <flourish:DataGrid
        ItemsSource="{Binding Properties, ElementName=RootPage}"
        AutoGenerateColumns="False"
        IsReadOnly="True"
      >
        <DataGrid.Columns>
          <DataGridTextColumn Width="220" Binding="{Binding Name}" Header="Property" />
          <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="Purpose" />
        </DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Split places Presentation beside the copy-and-body region."
      Title="Split"
    >
      <StackPanel>
        <flourish:Presenter
          Content="Presentation defaults to the left. Body shares the copy region and stays aligned with the copy on the right."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Left presentation (default)"
        >
          <flourish:Presenter.Body>
            <flourish:Button Content="Explore layout" Variant="Filled" />
          </flourish:Presenter.Body>
          <flourish:Presenter.Presentation>
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Orientation="Horizontal"
            >
              <flourish:FlourishTextBlock Margin="8" Role="Icon" Text="&#xE8A5;" />
              <flourish:FlourishTextBlock Margin="8" Role="Icon" Text="&#xE7C8;" />
              <flourish:FlourishTextBlock Margin="8" Role="Icon" Text="&#xE790;" />
            </StackPanel>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>

        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="PresenterPosition Right moves Presentation to the right while Title, Content, and Body remain grouped and left-aligned on the left."
          PresenterMode="Split"
          PresenterPosition="Right"
          Title="Right presentation"
        >
          <flourish:Presenter.Body>
            <flourish:Button Content="Open details" Variant="Tonal" />
          </flourish:Presenter.Body>
          <flourish:Presenter.Presentation>
            <flourish:FlourishTextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Role="Icon"
              Text="&#xE950;"
              TextAlignment="Center"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Overlay layers copy and Body over Presentation."
      Title="Overlay"
    >
      <flourish:Presenter
        Content="The presentation fills the surface while the copy remains readable above its scrim."
        PresenterMode="Overlay"
        PresenterPosition="Right"
        Title="Layered presentation"
      >
        <flourish:Presenter.Body>
          <flourish:Button Content="Overlay action" Variant="Filled" />
        </flourish:Presenter.Body>
        <flourish:Presenter.Presentation>
          <Grid>
            <Grid.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#0F6CBD" />
                <GradientStop Offset="1" Color="#5C2E91" />
              </LinearGradientBrush>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
              <flourish:FlourishTextBlock Margin="12" Foreground="#80FFFFFF" Role="Icon" Text="&#xE8A5;" />
              <flourish:FlourishTextBlock Margin="12" Foreground="#80FFFFFF" Role="Icon" Text="&#xE8B9;" />
              <flourish:FlourishTextBlock Margin="12" Foreground="#80FFFFFF" Role="Icon" Text="&#xE790;" />
            </StackPanel>
          </Grid>
        </flourish:Presenter.Presentation>
      </flourish:Presenter>
    </flourish:Chunk>

    <flourish:Chunk
      Content="TopDown places Presentation above a left-aligned copy-and-body region."
      Title="TopDown"
    >
      <flourish:Presenter
        Content="Use the vertical composition when the presented visual should establish context before the supporting copy and action."
        PresenterMode="TopDown"
        PresenterPosition="Right"
        Title="Top-down presentation"
      >
        <flourish:Presenter.Body>
          <flourish:Button Content="Continue" Variant="Filled" />
        </flourish:Presenter.Body>
        <flourish:Presenter.Presentation>
          <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
          >
              <flourish:FlourishTextBlock Margin="12" Role="Icon" Text="&#xE7C8;" />
              <flourish:FlourishTextBlock Margin="12" Role="Icon" Text="&#xE8A5;" />
              <flourish:FlourishTextBlock Margin="12" Role="Icon" Text="&#xE950;" />
          </StackPanel>
        </flourish:Presenter.Presentation>
      </flourish:Presenter>
    </flourish:Chunk>

    <flourish:Chunk Title="Choosing a surface">
      <UniformGrid Columns="2">
        <flourish:Card
          Margin="0,0,8,0"
          Content="Use Card when concise copy needs exactly one icon and no arbitrary child controls."
          Title="One icon"
        />
        <flourish:Card
          Margin="8,0,0,0"
          Content="Use Presenter for images, multiple icons, illustrations, or controls arranged with copy."
          Title="Rich presentation"
        />
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Usage">
      <StackPanel>
        <flourish:Presenter
          Title="Arrange a split presentation"
          Content="Split is the standard full-width arrangement. Left places Presentation on the left and the Title and Content copy group on the right; Right reverses those regions. Omit PresenterPosition to use Left."
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:Presenter&#xA;  Title=&quot;Reports&quot;&#xA;  Content=&quot;Review recent activity.&quot;&#xA;  PresenterMode=&quot;Split&quot;&#xA;  PresenterPosition=&quot;Left&quot;&gt;&#xA;  &lt;flourish:Presenter.Presentation&gt;&#xA;    &lt;Image Source=&quot;Assets/reports.png&quot; Stretch=&quot;Uniform&quot; /&gt;&#xA;  &lt;/flourish:Presenter.Presentation&gt;&#xA;&lt;/flourish:Presenter&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Title="Add an action beside the copy"
          Content="Assign a supporting control through Presenter.Body. Body stays in the same copy-side region as Title and Content and follows their left alignment instead of joining Presentation."
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:Presenter&#xA;  Title=&quot;Reports&quot;&#xA;  Content=&quot;Review recent activity.&quot;&#xA;  PresenterMode=&quot;Split&quot;&gt;&#xA;  &lt;flourish:Presenter.Body&gt;&#xA;    &lt;flourish:Button Content=&quot;Open reports&quot; Variant=&quot;Filled&quot; /&gt;&#xA;  &lt;/flourish:Presenter.Body&gt;&#xA;  &lt;flourish:Presenter.Presentation&gt;&#xA;    &lt;Image Source=&quot;Assets/reports.png&quot; Stretch=&quot;Uniform&quot; /&gt;&#xA;  &lt;/flourish:Presenter.Presentation&gt;&#xA;&lt;/flourish:Presenter&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Title="Place a wide presentation above the copy"
          Content="TopDown is the only Presenter mode intended for multi-column placement. It puts Presentation first, followed by a left-aligned Title, Content, and Body group."
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:Presenter&#xA;  Title=&quot;Release timeline&quot;&#xA;  Content=&quot;Review milestones before publishing.&quot;&#xA;  PresenterMode=&quot;TopDown&quot;&gt;&#xA;  &lt;flourish:Presenter.Presentation&gt;&#xA;    &lt;Image Source=&quot;Assets/timeline.png&quot; Stretch=&quot;Uniform&quot; /&gt;&#xA;  &lt;/flourish:Presenter.Presentation&gt;&#xA;&lt;/flourish:Presenter&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Title="Layer copy over a visual"
          Content="Overlay fills the surface with Presentation and draws the copy-side content above it. Use it only when foreground text and controls remain legible over the visual in every theme."
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:Presenter&#xA;  Title=&quot;Featured workspace&quot;&#xA;  Content=&quot;Open the workspace summary.&quot;&#xA;  PresenterMode=&quot;Overlay&quot;&#xA;  PresenterPosition=&quot;Right&quot;&gt;&#xA;  &lt;flourish:Presenter.Presentation&gt;&#xA;    &lt;Image Source=&quot;Assets/workspace.png&quot; Stretch=&quot;UniformToFill&quot; /&gt;&#xA;  &lt;/flourish:Presenter.Presentation&gt;&#xA;&lt;/flourish:Presenter&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          Content="Browse the Flourish source repository."
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="GitHub repository"
          ToolTip="External navigation is not available in Gallery."
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          Content="Read the Presenter guide."
          Icon="&#xE946;"
          IsEnabled="False"
          Title="Presenter documentation"
          ToolTip="External navigation is not available in Gallery."
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
