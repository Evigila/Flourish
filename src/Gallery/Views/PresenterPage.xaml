            <Grid
              Width="320"
              Height="160"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Rectangle Margin="8" Fill="{DynamicResource FlourishNeutralBackground2Brush}" RadiusX="8" RadiusY="8" />
              <Rectangle Grid.Row="1" Margin="8" Stroke="{DynamicResource FlourishNeutralStroke1Brush}" StrokeThickness="1" RadiusX="8" RadiusY="8" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Table_16D1C905}">
      <flourish:DataGrid
        ItemsSource="{Binding Properties, ElementName=RootPage}"
        AutoGenerateColumns="False"
        IsReadOnly="True"
      >
        <DataGrid.Columns>
          <DataGridTextColumn Width="220" Binding="{Binding Name}" Header="{culture:Localize Key=Controls_Property_40040CB1}" />
          <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="{culture:Localize Key=Controls_Purpose_D4E8830A}" />
        </DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="{culture:Localize Key=Controls_SplitPlacesPresentationBesideTheCopyAndBodyRegion_6DD84EA6}"
      Title="Split"
    >
      <StackPanel>
        <flourish:Presenter
          Content="{culture:Localize Key=Controls_PresentationDefaultsToTheLeftBodySharesTheCopyRegionAndStaysAlig_60DAF47E}"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_LeftPresentationDefault_5AD2213C}"
