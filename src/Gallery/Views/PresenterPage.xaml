        <flourish:Card
          Margin="8,0,0,0"
          Content="{culture:Localize Key=Controls_UsePresenterForImagesMultipleIconsIllustrationsOrControlsArrange_46DFD6A5}"
          Title="{culture:Localize Key=Controls_RichPresentation_F63DA29B}"
        />
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Usage_8D59829C}">
      <StackPanel>
        <flourish:Presenter
          Title="{culture:Localize Key=Controls_ArrangeASplitPresentation_A85F75CF}"
          Content="{culture:Localize Key=Controls_SplitIsTheStandardFullWidthArrangementLeftPlacesPresentationOnTh_76F638A9}"
          PresenterMode="Split"
          PresenterPosition="Left"
