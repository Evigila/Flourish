        </flourish:Presenter.Body>
        <flourish:Presenter.Presentation>
          <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
          >
              <flourish:TextBlock Margin="12" FontSize="{DynamicResource FlourishFontSizeLargeIcon}" LineHeight="{DynamicResource FlourishLineHeightLargeIcon}" Role="Icon" Text="&#xE7C8;" />
              <flourish:TextBlock Margin="12" FontSize="{DynamicResource FlourishFontSizeLargeIcon}" LineHeight="{DynamicResource FlourishLineHeightLargeIcon}" Role="Icon" Text="&#xE8A5;" />
              <flourish:TextBlock Margin="12" FontSize="{DynamicResource FlourishFontSizeLargeIcon}" LineHeight="{DynamicResource FlourishLineHeightLargeIcon}" Role="Icon" Text="&#xE950;" />
          </StackPanel>
        </flourish:Presenter.Presentation>
      </flourish:Presenter>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_ChoosingASurface_CF128427}">
      <UniformGrid Columns="2">
        <flourish:Card
          Margin="0,0,8,0"
          Content="{culture:Localize Key=Controls_UseCardWhenConciseCopyNeedsExactlyOneIconAndNoArbitraryChildCont_35E9E94E}"
          Title="{culture:Localize Key=Controls_OneIcon_4563EB62}"
