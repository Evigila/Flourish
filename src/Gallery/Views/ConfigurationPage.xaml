<Page
  x:Class="ArkheideSystem.Gallery.Views.ConfigurationPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Edit configuration and localization while the app runs."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="Configuration &amp; localization"
    />

    <flourish:Chunk
      Content="Read effective values from the active provider chain, bind typed options, inspect immutable snapshots, and reload providers after external changes. Use this for diagnostics, settings screens, and configuration consumed across the application; the code below demonstrates change tracking, reload, raw and typed reads, section binding, and snapshots."
      Title="Configuration values"
    >
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE721;"
            Title="Configuration key"
            Content="Choose a value from the active provider chain."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="ReadKeyBox" Width="220" Text="Flourish:Preferences:Theme" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE721;"
            Title="Read merged value"
            Content="Resolve the selected configuration key."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="ReadValue_Click" Content="Read value" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE72C;"
            Title="Configuration providers"
            Content="Reload every registered provider."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="Reload_Click" Content="Reload providers" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          </StackPanel>
          <flourish:OutputCard x:Name="ReadOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
        </Grid>
        <flourish:CodeSpace Text="// Changes may arrive off the UI thread.&#10;configuration.Changed += (_, change) =&gt;&#10;{&#10;    var previous = change.Previous;&#10;    var current = change.Current;&#10;    var changedKeys = change.ChangedKeys;&#10;};&#10;&#10;// Reload every provider that supports reloading.&#10;configuration.Reload();&#10;&#10;// Read snapshot, raw, converted, and bound values.&#10;var snapshot = configuration.Current;&#10;var raw = configuration[&quot;Flourish:Preferences:Theme&quot;];&#10;var timeout = configuration.Get&lt;int&gt;(&quot;Network:Timeout&quot;);&#10;var reports = configuration.GetSection&lt;ReportOptions&gt;(&quot;Reports&quot;);" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Persist appsettings.json changes through atomic writes that reload host configuration. Use the single-operation methods for one preference and UpdateAsync when related edits must commit together; this is recommended for user or administrator settings that must remain consistent on disk. The code below covers the managed file path, set, merge, append, remove, batch editing, and update results."
      Title="App settings"
    >
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE71B;"
            Title="Configuration path"
            Content="Choose the appsettings key to edit."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="WriteKeyBox" Width="220" Text="Gallery:Runtime:Message" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE70F;"
            Title="String value"
            Content="Provide the value used by write operations."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="WriteValueBox" Width="220" Text="Hello from runtime" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE74E;"
            Title="Set value"
            Content="Replace the selected value and save atomically."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="SetValue_Click" Content="Set &amp; save" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE72D;"
            Title="Merge value"
            Content="Merge the value into its parent object."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="MergeValue_Click" Content="Merge into parent" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE710;"
            Title="Append value"
            Content="Append the value to the selected array."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="AppendValue_Click" Content="Append to array" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE74D;"
            Title="Remove value"
            Content="Remove the selected key from appsettings.json."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="RemoveValue_Click" Content="Remove" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          </StackPanel>
          <flourish:OutputCard x:Name="WriteOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
        </Grid>
        <flourish:CodeSpace Text="// Single-operation helpers each commit atomically.&#10;var filePath = settings.FilePath;&#10;await settings.SetAsync(&quot;Gallery:Theme&quot;, &quot;Dark&quot;);&#10;await settings.MergeAsync(&quot;Reports&quot;, new { PageSize = 50 });&#10;await settings.AppendAsync(&quot;Reports:Formats&quot;, &quot;PDF&quot;);&#10;await settings.RemoveAsync(&quot;Reports:Legacy&quot;);&#10;&#10;// Batch related edits into one write and one reload.&#10;var result = await settings.UpdateAsync(editor =&gt;&#10;{&#10;    editor.Set(&quot;Gallery:Theme&quot;, &quot;Light&quot;);&#10;    editor.Merge(&quot;Reports&quot;, new { PageSize = 100 });&#10;    editor.Append(&quot;Reports:Formats&quot;, &quot;CSV&quot;);&#10;    editor.Remove(&quot;Reports:Legacy&quot;);&#10;});&#10;&#10;// Inspect the transaction outcome.&#10;var changed = result.Changed;&#10;var savedPath = result.FilePath;&#10;var reloaded = result.ConfigurationReloaded;" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Choose the locale used by Flourish interface text and resolve localized strings with English fallback. Set the initial locale during app setup or switch it later through IFlourishLocalization. Use this for language preferences and in-app language selection; the code below demonstrates change notifications, locale selection, available locales, key lookup, and culture-aware formatting."
      Title="Localization"
    >
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <flourish:ActionCard
            Grid.Column="0"
            Margin="0,0,8,0"
            VerticalAlignment="Stretch"
            Icon="&#xE774;"
            Title="Application locale"
            Content="Choose a built-in or host-registered locale."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishComboBox
                x:Name="LocaleBox"
                Width="220"
                SelectionChanged="LocaleBox_SelectionChanged"
              />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:OutputCard x:Name="LocaleOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
        </Grid>
        <flourish:CodeSpace Text="// Select the initial language during application composition.&#10;builder.ConfigData(data =&gt; data.InitLocale(&quot;EN&quot;));&#10;&#10;// Observe and change the selected language while the app is running.&#10;localization.Changed += (_, change) =&gt;&#10;{&#10;    var kind = change.Kind;&#10;    var previous = change.PreviousLocale;&#10;    var current = change.CurrentLocale;&#10;};&#10;localization.SetLocale(&quot;CN&quot;);&#10;&#10;// Inspect locales and resolve localized text.&#10;var selected = localization.CurrentLocale;&#10;var available = localization.AvailableLocales;&#10;var title = localization.Get(&quot;TitleBar.Back&quot;);&#10;var status = localization.Format(&quot;TitleBar.ThemeSystem&quot;, &quot;Dark&quot;);" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Extend or override translations with UTF-8 lang_&lt;locale&gt;.json files. Add files during app setup or register, reload, and remove them through IFlourishLocalization. Use this for product-specific translations, plugins, and externally maintained language packs; the code below demonstrates both registration paths, registration metadata, file reload, and removal."
      Title="Locale files"
    >
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE8A5;"
            Title="Locale file path"
            Content="Choose an external lang_&lt;locale&gt;.json source."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="LocaleFilePathBox" Width="220" Text="lang_ES.json" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE710;"
            Title="Register locale file"
            Content="Register the selected source with localization."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="RegisterLocaleFile_Click" Content="Register file" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE72C;"
            Title="Reload locale file"
            Content="Reload edits from the registered source."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="ReloadLocaleFile_Click" Content="Reload file" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE74D;"
            Title="Remove locale file"
            Content="Unregister the current external source."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="UnregisterLocaleFile_Click" Content="Unregister" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          </StackPanel>
          <flourish:OutputCard x:Name="LocaleFileOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
        </Grid>
        <flourish:CodeSpace Text="// Load a custom locale during application composition.&#10;builder.ConfigData(data =&gt;&#10;    data.InitLocaleFile(&quot;Locales/lang_ES.json&quot;));&#10;&#10;// Keep the registration handle for inspection, reload, and removal.&#10;var registration = localization.RegisterFile(&quot;Locales/lang_ES.json&quot;);&#10;var id = registration.Id;&#10;var locale = registration.Locale;&#10;var filePath = registration.FilePath;&#10;localization.ReloadFile(registration);&#10;var removed = localization.Unregister(registration);" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="Browse the Flourish source repository." Icon="&#xE943;" IsEnabled="False" Title="GitHub repository" ToolTip="External navigation is not available in Gallery." />
        <flourish:CardButton Margin="8,0,0,0" Content="Read the canonical Flourish documentation." Icon="&#xE946;" IsEnabled="False" Title="Flourish documentation" ToolTip="External navigation is not available in Gallery." />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
