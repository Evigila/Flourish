<Page
  x:Class="ArkheideSystem.Gallery.Views.ToolTipPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:culture="clr-namespace:ArkheideSystem.Essential.Culture"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="{culture:Localize Key=Controls_ShowCompactTipTypographyHelpWithFlourishPlacementAndShellRegionB_9F8D2209}"
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="ToolTip"
    />

    <flourish:Chunk Title="{culture:Localize Key=Controls_Table_16D1C905}">
      <flourish:DataGrid ItemsSource="{Binding Properties, ElementName=RootPage}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Width="220" Binding="{Binding Name}" Header="{culture:Localize Key=Controls_Member_7C968FB7}" />
          <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="{culture:Localize Key=Controls_Purpose_D4E8830A}" />
        </DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="{culture:Localize Key=Controls_HoverOrFocusTheButtonTheTooltipOwnsItsNormalRegularTipTypography_B6AFCD5B}"
      Title="{culture:Localize Key=Controls_Example_D029F87E}"
    >
      <flourish:Presenter
        Content="{culture:Localize Key=Controls_DeclareToolTipExplicitlyWhenTheContentNeedsAControlInsta_6D46B98B}"
        PresenterMode="Split"
        PresenterPosition="Left"
        Title="{culture:Localize Key=Controls_HoverHelp_F1B1A282}"
      >
        <flourish:Presenter.Presentation>
          <flourish:Button
            Width="160"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Content="{culture:Localize Key=Controls_HoverForHelp_7C0F22E9}"
          >
            <flourish:Button.ToolTip>
              <flourish:ToolTip Content="{culture:Localize Key=Controls_ThisActionRefreshesTheCurrentWorkspace_FA18A8FA}" />
            </flourish:Button.ToolTip>
          </flourish:Button>
        </flourish:Presenter.Presentation>
      </flourish:Presenter>
    </flourish:Chunk>

    <flourish:Chunk
      Content="{culture:Localize Key=Controls_KeepTooltipTextShortAndActionableIconOnlyButtonsAlsoNeedAnAutoma_563B176E}"
      Title="Content"
    >
      <flourish:Card Title="{culture:Localize Key=Controls_EmptyValues_204A7F00}" Content="{culture:Localize Key=Controls_DoNotCreateATooltipForNullEmptyOrWhitespaceOnlyContentTheSharedP_62053DDB}" />
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Usage_8D59829C}">
      <StackPanel>
        <flourish:Presenter
          Content="{culture:Localize Key=Controls_AssignAToolTipInstanceWhenPlacementOpenStateOrAnotherToo_E76B093C}"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_ExplicitTooltip_DEEAC149}"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="{Binding UsageCode, ElementName=RootPage}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="{culture:Localize Key=Controls_UseASimpleToolTipStringWhenNoControlLevelConfigurationIsRequired_1D40248C}"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_SimpleTooltipAndTiming_37F431A5}"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:Button&#xA;  Content=&quot;Refresh&quot;&#xA;  ToolTip=&quot;Refresh the current workspace.&quot;&#xA;  ToolTipService.InitialShowDelay=&quot;400&quot;&#xA;  ToolTipService.ShowDuration=&quot;5000&quot; /&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Reference_71BF9093}">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="{culture:Localize Key=Controls_BrowseTheFlourishSourceRepository_5CC28F39}" Icon="&#xE943;" IsEnabled="False" Title="{culture:Localize Key=Controls_GitHubRepository_50555492}" ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}" />
        <flourish:CardButton Margin="8,0,0,0" Content="{culture:Localize Key=Controls_ReadTheToolTipAPIReference_54CBAEF9}" Icon="&#xE8A5;" IsEnabled="False" Title="{culture:Localize Key=Controls_ToolTipDocumentation_0F2F4561}" ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}" />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
