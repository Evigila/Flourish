            <Grid
              Width="320"
              Height="160"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Rectangle Margin="8" Stroke="{DynamicResource FlourishNeutralStroke1Brush}" StrokeThickness="1" RadiusX="8" RadiusY="8" />
              <Rectangle Grid.Column="1" Margin="8" Fill="{DynamicResource FlourishPrimarySurfaceBrush}" RadiusX="8" RadiusY="8" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="4,0"
          Content="Gallery.Controls.LayersTheHeaderCopyAndBodyOverPresentation_47160C98"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Overlay"
        >
          <flourish:Presenter.Presentation>
            <Grid
              Width="320"
              Height="160"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <Rectangle Margin="8" Fill="{DynamicResource FlourishPrimarySurfaceBrush}" RadiusX="8" RadiusY="8" />
              <Rectangle Width="120" Height="64" Stroke="{DynamicResource FlourishNeutralStroke1Brush}" StrokeThickness="1" RadiusX="8" RadiusY="8" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="Gallery.Controls.PlacesPresentationAboveALeftAlignedCopyAndBodyRegionWhileRemaini_6F58E2FF"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="TopDown"
        >
          <flourish:Presenter.Presentation>
            <Grid
              Width="320"
              Height="160"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Rectangle Margin="8" Fill="{DynamicResource FlourishPrimarySurfaceBrush}" RadiusX="8" RadiusY="8" />
              <Rectangle Grid.Row="1" Margin="8" Stroke="{DynamicResource FlourishNeutralStroke1Brush}" StrokeThickness="1" RadiusX="8" RadiusY="8" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Gallery.Controls.Table_16D1C905">
      <flourish:DataGrid ItemsSource="{Binding Properties, ElementName=RootPage}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Width="220" Binding="{Binding Name}" Header="Gallery.Controls.Property_40040CB1" />
          <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="Gallery.Controls.Purpose_D4E8830A" />
        </DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Presentation">
      <flourish:Card Content="Gallery.Controls.PresentationHostsThePageIllustrationWhileTitleContentAndBodyRema_7D5935AF" />
    </flourish:Chunk>

    <flourish:Chunk Title="Gallery.Controls.Usage_8D59829C">
      <StackPanel>
        <flourish:Presenter
          Title="Gallery.Controls.AddThePageHeader_D8878D17"
          Content="Gallery.Controls.PlaceExactlyOneHeaderChunkFirstInPageBodyTitleAndContentIdentify_6328997D"
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:HeaderChunk&#xA;  Title=&quot;Reports&quot;&#xA;  Content=&quot;Review generated reports and their current status.&quot;&#xA;  PresenterMode=&quot;Split&quot;&#xA;  PresenterPosition=&quot;Right&quot;&gt;&#xA;  &lt;flourish:HeaderChunk.Presentation&gt;&#xA;    &lt;Image Source=&quot;Assets/reports.png&quot; Stretch=&quot;Uniform&quot; /&gt;&#xA;  &lt;/flourish:HeaderChunk.Presentation&gt;&#xA;&lt;/flourish:HeaderChunk&gt;" />
