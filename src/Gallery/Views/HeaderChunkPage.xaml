          Content="Gallery.Controls.ChooseTopDownWhenABannerDiagramOrOtherWidePresentationShouldEsta_B0DC7FB3"
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:HeaderChunk&#xA;  Title=&quot;Workspace&quot;&#xA;  Content=&quot;Manage the active workspace.&quot;&#xA;  PresenterMode=&quot;TopDown&quot;&gt;&#xA;  &lt;flourish:HeaderChunk.Presentation&gt;&#xA;    &lt;Image Source=&quot;Assets/workspace.png&quot; Stretch=&quot;Uniform&quot; /&gt;&#xA;  &lt;/flourish:HeaderChunk.Presentation&gt;&#xA;&lt;/flourish:HeaderChunk&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
