  <flourish:PageBody>
    <flourish:HeaderChunk
      x:Name="HeaderPreview"
      Content="Gallery.Controls.IntroduceOnePageWithEmphasizedCopyAndPresentation_E657CE71"
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="HeaderChunk"
    >
      <flourish:HeaderChunk.Body>
        <WrapPanel>
          <flourish:Button Variant="Filled" Click="SplitRight_Click" Content="Gallery.Controls.SplitRight_AA9997BB" />
          <flourish:Button Margin="8,0,0,0" Variant="Tonal" Click="SplitLeft_Click" Content="Gallery.Controls.SplitLeft_CD600A74" />
          <flourish:Button Margin="8,0,0,0" Variant="Tonal" Click="Overlay_Click" Content="Overlay" />
