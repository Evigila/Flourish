          Title="Gallery.Controls.LayerCopyOverAPresentation_AB38BCEE"
          Content="Gallery.Controls.UseOverlayOnlyWhenTheImageOrIllustrationRemainsAnAppropriateRead_2ABEE85B"
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:HeaderChunk&#xA;  Title=&quot;Release ready&quot;&#xA;  Content=&quot;Review the final package before publishing.&quot;&#xA;  PresenterMode=&quot;Overlay&quot;&#xA;  PresenterPosition=&quot;Right&quot;&gt;&#xA;  &lt;flourish:HeaderChunk.Body&gt;&#xA;    &lt;flourish:Button Content=&quot;Review release&quot; Variant=&quot;Filled&quot; /&gt;&#xA;  &lt;/flourish:HeaderChunk.Body&gt;&#xA;  &lt;flourish:HeaderChunk.Presentation&gt;&#xA;    &lt;Image Source=&quot;Assets/release.png&quot; Stretch=&quot;UniformToFill&quot; /&gt;&#xA;  &lt;/flourish:HeaderChunk.Presentation&gt;&#xA;&lt;/flourish:HeaderChunk&gt;" />
          </flourish:Presenter.Presentation>
