<Page
  x:Class="ArkheideSystem.Gallery.Views.HeaderChunkPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:culture="clr-namespace:ArkheideSystem.Essential.Culture"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      x:Name="HeaderPreview"
      Content="{culture:Localize Key=Controls_IntroduceOnePageWithEmphasizedCopyAndPresentation_E657CE71}"
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="HeaderChunk"
    >
      <flourish:HeaderChunk.Body>
        <WrapPanel>
          <flourish:Button Variant="Filled" Click="SplitRight_Click" Content="{culture:Localize Key=Controls_SplitRight_AA9997BB}" />
          <flourish:Button Margin="8,0,0,0" Variant="Tonal" Click="SplitLeft_Click" Content="{culture:Localize Key=Controls_SplitLeft_CD600A74}" />
          <flourish:Button Margin="8,0,0,0" Variant="Tonal" Click="Overlay_Click" Content="Overlay" />
          <flourish:Button Margin="8,0,0,0" Variant="Tonal" Click="TopDown_Click" Content="{culture:Localize Key=Controls_TopDown_B2688B24}" />
        </WrapPanel>
      </flourish:HeaderChunk.Body>
      <flourish:HeaderChunk.Presentation>
        <Border MinHeight="220" Background="{DynamicResource FlourishPrimarySurfaceBrush}" CornerRadius="12">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <flourish:TextBlock FontFamily="{DynamicResource FlourishIconFontFamily}" FontSize="{DynamicResource FlourishFontSizeLargeIcon}" Foreground="{DynamicResource FlourishPrimaryForegroundBrush}" LineHeight="{DynamicResource FlourishLineHeightLargeIcon}" Role="Icon" Text="&#xE7C8;" />
            <flourish:TextBlock Margin="0,12,0,0" Role="CardTitle" Text="{culture:Localize Key=Controls_PageHeader_336C1F36}" />
          </StackPanel>
        </Border>
      </flourish:HeaderChunk.Presentation>
    </flourish:HeaderChunk>

    <flourish:Chunk
      Content="{culture:Localize Key=Controls_EachCompactDiagramIdentifiesThePresentationRegionThePageLeadingP_E716254E}"
      Title="Variant"
    >
      <UniformGrid Columns="3">
        <flourish:Presenter
          Margin="0,0,8,0"
          Content="{culture:Localize Key=Controls_PlacesPresentationBesideTheCopyRightIsTheHeaderChunkDefault_03BDA535}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Split"
        >
          <flourish:Presenter.Presentation>
            <Grid
              Width="320"
              Height="160"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Rectangle Margin="8" Stroke="{DynamicResource FlourishNeutralStroke1Brush}" StrokeThickness="1" RadiusX="8" RadiusY="8" />
              <Rectangle Grid.Column="1" Margin="8" Fill="{DynamicResource FlourishPrimarySurfaceBrush}" RadiusX="8" RadiusY="8" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="4,0"
          Content="{culture:Localize Key=Controls_LayersTheHeaderCopyAndBodyOverPresentation_47160C98}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Overlay"
        >
          <flourish:Presenter.Presentation>
            <Grid
              Width="320"
              Height="160"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <Rectangle Margin="8" Fill="{DynamicResource FlourishPrimarySurfaceBrush}" RadiusX="8" RadiusY="8" />
              <Rectangle Width="120" Height="64" Stroke="{DynamicResource FlourishNeutralStroke1Brush}" StrokeThickness="1" RadiusX="8" RadiusY="8" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="{culture:Localize Key=Controls_PlacesPresentationAboveALeftAlignedCopyAndBodyRegionWhileRemaini_6F58E2FF}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="TopDown"
        >
          <flourish:Presenter.Presentation>
            <Grid
              Width="320"
              Height="160"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Rectangle Margin="8" Fill="{DynamicResource FlourishPrimarySurfaceBrush}" RadiusX="8" RadiusY="8" />
              <Rectangle Grid.Row="1" Margin="8" Stroke="{DynamicResource FlourishNeutralStroke1Brush}" StrokeThickness="1" RadiusX="8" RadiusY="8" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Table_16D1C905}">
      <flourish:DataGrid ItemsSource="{Binding Properties, ElementName=RootPage}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Width="220" Binding="{Binding Name}" Header="{culture:Localize Key=Controls_Property_40040CB1}" />
          <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="{culture:Localize Key=Controls_Purpose_D4E8830A}" />
        </DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Presentation">
      <flourish:Card Content="{culture:Localize Key=Controls_PresentationHostsThePageIllustrationWhileTitleContentAndBodyRema_7D5935AF}" />
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Usage_8D59829C}">
      <StackPanel>
        <flourish:Presenter
          Title="{culture:Localize Key=Controls_AddThePageHeader_D8878D17}"
          Content="{culture:Localize Key=Controls_PlaceExactlyOneHeaderChunkFirstInPageBodyTitleAndContentIdentify_6328997D}"
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:HeaderChunk&#xA;  Title=&quot;Reports&quot;&#xA;  Content=&quot;Review generated reports and their current status.&quot;&#xA;  PresenterMode=&quot;Split&quot;&#xA;  PresenterPosition=&quot;Right&quot;&gt;&#xA;  &lt;flourish:HeaderChunk.Presentation&gt;&#xA;    &lt;Image Source=&quot;Assets/reports.png&quot; Stretch=&quot;Uniform&quot; /&gt;&#xA;  &lt;/flourish:HeaderChunk.Presentation&gt;&#xA;&lt;/flourish:HeaderChunk&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Title="{culture:Localize Key=Controls_PlaceAWideVisualAboveTheCopy_92D40603}"
          Content="{culture:Localize Key=Controls_ChooseTopDownWhenABannerDiagramOrOtherWidePresentationShouldEsta_B0DC7FB3}"
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:HeaderChunk&#xA;  Title=&quot;Workspace&quot;&#xA;  Content=&quot;Manage the active workspace.&quot;&#xA;  PresenterMode=&quot;TopDown&quot;&gt;&#xA;  &lt;flourish:HeaderChunk.Presentation&gt;&#xA;    &lt;Image Source=&quot;Assets/workspace.png&quot; Stretch=&quot;Uniform&quot; /&gt;&#xA;  &lt;/flourish:HeaderChunk.Presentation&gt;&#xA;&lt;/flourish:HeaderChunk&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Title="{culture:Localize Key=Controls_LayerCopyOverAPresentation_AB38BCEE}"
          Content="{culture:Localize Key=Controls_UseOverlayOnlyWhenTheImageOrIllustrationRemainsAnAppropriateRead_2ABEE85B}"
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:HeaderChunk&#xA;  Title=&quot;Release ready&quot;&#xA;  Content=&quot;Review the final package before publishing.&quot;&#xA;  PresenterMode=&quot;Overlay&quot;&#xA;  PresenterPosition=&quot;Right&quot;&gt;&#xA;  &lt;flourish:HeaderChunk.Body&gt;&#xA;    &lt;flourish:Button Content=&quot;Review release&quot; Variant=&quot;Filled&quot; /&gt;&#xA;  &lt;/flourish:HeaderChunk.Body&gt;&#xA;  &lt;flourish:HeaderChunk.Presentation&gt;&#xA;    &lt;Image Source=&quot;Assets/release.png&quot; Stretch=&quot;UniformToFill&quot; /&gt;&#xA;  &lt;/flourish:HeaderChunk.Presentation&gt;&#xA;&lt;/flourish:HeaderChunk&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Reference_71BF9093}">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="{culture:Localize Key=Controls_BrowseTheFlourishSourceRepository_5CC28F39}" Icon="&#xE8A5;" IsEnabled="False" Title="{culture:Localize Key=Controls_GitHubRepository_50555492}" ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}" />
        <flourish:CardButton Margin="8,0,0,0" Content="{culture:Localize Key=Controls_ReadTheHeaderChunkGuide_2CB0923C}" Icon="&#xE946;" IsEnabled="False" Title="{culture:Localize Key=Controls_HeaderChunkDocumentation_00F1735F}" ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}" />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
