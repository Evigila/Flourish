<Page
  x:Class="ArkheideSystem.Gallery.Views.BunchedListBoxItemPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Represent one generated or explicit item whose interaction feedback is coordinated by BunchedListBox."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="BunchedListBoxItem"
    />

    <flourish:Chunk
      Content="The container keeps inherited item semantics but does not draw an independent hover or selection background."
      Title="Variant"
    >
      <UniformGrid Columns="3">
        <flourish:Presenter Margin="0,0,8,0" Content="An ordinary selectable item." PresenterMode="TopDown" PresenterPosition="Left" Title="Item">
          <flourish:Presenter.Presentation>
            <Grid MinHeight="170">
              <flourish:BunchedListBox Width="210" HorizontalAlignment="Center" VerticalAlignment="Center" SelectedIndex="0">
                <flourish:BunchedListBoxItem Content="Selected item" />
              </flourish:BunchedListBox>
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter Margin="8,0" Content="A non-selectable semantic label in a navigation list." PresenterMode="TopDown" PresenterPosition="Left" Title="Group header">
          <flourish:Presenter.Presentation>
            <Grid MinHeight="170">
              <flourish:BunchedListBox Width="210" HorizontalAlignment="Center" VerticalAlignment="Center" Appearance="Navigation">
                <flourish:BunchedListBoxItem Content="Workspace" IsGroupHeader="True" />
              </flourish:BunchedListBox>
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter Margin="8,0,0,0" Content="An item whose activation dispatches a configured command." PresenterMode="TopDown" PresenterPosition="Left" Title="Command item">
          <flourish:Presenter.Presentation>
            <Grid MinHeight="170">
              <flourish:BunchedListBox Width="210" HorizontalAlignment="Center" VerticalAlignment="Center" Appearance="Navigation">
                <flourish:BunchedListBoxItem Content="Refresh" IsCommandItem="True" />
              </flourish:BunchedListBox>
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Table">
      <flourish:DataGrid ItemsSource="{Binding Properties, ElementName=RootPage}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Width="220" Binding="{Binding Name}" Header="Member" />
          <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="Purpose" />
        </DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Normally the parent generates this container. Declare it directly only when an item needs navigation-specific state."
      Title="Container"
    >
      <flourish:Card Title="Parent-owned feedback" Content="Hover, pressed, and selection backgrounds belong to the BunchedListBox template. Keep custom item templates transparent so the shared layer remains visible." />
    </flourish:Chunk>

    <flourish:Chunk Title="Usage">
      <StackPanel>
        <flourish:Presenter
          Content="Declare a container when you need IsGroupHeader or IsCommandItem on a specific navigation entry. Ordinary data-bound entries should be supplied through ItemsSource."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Navigation states"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace Text="{Binding UsageCode, ElementName=RootPage}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="The generated container inherits ContentControl and ListBoxItem behavior. Data templates, focus, keyboard navigation, and automation continue to work through the parent list."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Generated containers"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace Text="&lt;flourish:BunchedListBox&#xA;  ItemsSource=&quot;{Binding NavigationItems}&quot;&#xA;  SelectedItem=&quot;{Binding ActiveItem, Mode=TwoWay}&quot; /&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="Browse the Flourish source repository." Icon="&#xE943;" IsEnabled="False" Title="GitHub repository" ToolTip="External navigation is not available in Gallery." />
        <flourish:CardButton Margin="8,0,0,0" Content="Read the BunchedListBoxItem API reference." Icon="&#xE8A5;" IsEnabled="False" Title="BunchedListBoxItem documentation" ToolTip="External navigation is not available in Gallery." />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
