<Page
  x:Class="ArkheideSystem.Gallery.Views.BackgroundTasksPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Run application work outside the UI thread while retaining structured progress, cancellation, and completion results. The background task service is recommended for user-visible operations that must remain observable and responsive rather than for short, fire-and-forget callbacks."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="Background tasks"
    />

    <flourish:Chunk
      Content="Queue progress-only or typed-result work with descriptive metadata, then keep the returned handle to observe or cancel that task. Use this API for imports, synchronization, report generation, and similar operations; the code below shows cooperative cancellation, progress reporting, and result retrieval."
      Title="Task queue"
    >
      <StackPanel>
        <UniformGrid VerticalAlignment="Stretch" Columns="2">
        <StackPanel Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE768;"
            Content="Queue work that reports progress while it runs."
            Title="Progress task"
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="AddProgressTask_Click" Content="Add task" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8F1;"
            Content="Queue work that returns a captured value."
            Title="Result task"
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="AddResultTask_Click" Content="Add task" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8FD;"
            Content="Queue four tasks to demonstrate bounded concurrency."
            Title="Task burst"
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="AddBurst_Click" Content="Queue 4 tasks" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE711;"
            Content="Cancel the most recently submitted task."
            Title="Last task"
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="CancelLast_Click" Content="Cancel last" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE74D;"
            Content="Cancel the task selected in the live task list."
            Title="Selected task"
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="CancelSelected_Click" Content="Cancel selected" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard
          x:Name="ServiceOutput"
          Margin="8,0,0,0"
          VerticalAlignment="Stretch"
        />
        </UniformGrid>
        <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="var handle = backgroundTasks.QueueTask(&#10;    new FlourishBackgroundTaskMetadata(&#10;        &quot;Refresh reports&quot;, &quot;Downloads the latest report data.&quot;, &quot;\uE895&quot;),&#10;    async context =&gt;&#10;    {&#10;        for (var step = 1; step &lt;= 10; step++)&#10;        {&#10;            await RefreshBatchAsync(step, context.CancellationToken);&#10;            context.ReportProgress(step / 10d);&#10;        }&#10;&#10;        return await LoadReportCountAsync(context.CancellationToken);&#10;    });&#10;&#10;// Completion represents success, failure, or cancellation without faulting.&#10;var result = await handle.Completion;&#10;var count = result.Value;&#10;var cancelRequested = backgroundTasks.CancelTask(handle.Id);" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Subscribe to task changes and inspect active snapshots while work is queued, running, or cancelling. Combine the service snapshot with each handle's completion result when building status panels, activity centers, or diagnostics that must distinguish active work from recently completed outcomes."
      Title="Task state"
    >
      <StackPanel>
        <flourish:Presenter
          Content="Queued, running, and cancelling items update through TasksChanged."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Live tasks"
        >
          <flourish:Presenter.Presentation>
            <flourish:ListBox
              x:Name="ActiveTaskList"
              Width="480"
              Height="220"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="Completion never faults; failures and cancellation are represented in the result object."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Recent outcomes"
        >
          <flourish:Presenter.Presentation>
            <flourish:ListBox
              x:Name="OutcomeList"
              Width="480"
              Height="220"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="backgroundTasks.TasksChanged += (_, change) =&gt;&#10;    RefreshTaskList(change.Tasks);&#10;&#10;var activeTasks = backgroundTasks.ActiveTasks;&#10;var concurrencyLimit = backgroundTasks.MaxConcurrency;&#10;&#10;var completion = await handle.Completion;&#10;var finalState = completion.Info.State;&#10;var error = completion.Info.Exception;" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="Browse the Flourish source repository." Icon="&#xE943;" IsEnabled="False" Title="GitHub repository" ToolTip="External navigation is not available in Gallery." />
        <flourish:CardButton Margin="8,0,0,0" Content="Read the canonical Flourish documentation." Icon="&#xE946;" IsEnabled="False" Title="Flourish documentation" ToolTip="External navigation is not available in Gallery." />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
