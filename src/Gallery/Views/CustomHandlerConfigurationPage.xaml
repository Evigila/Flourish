<Page
  x:Class="ArkheideSystem.Gallery.Views.CustomHandlerConfigurationPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Title="Custom handler"
      Content="Place application-owned WPF content and command actions in predefined shell regions."
      PresenterMode="Split"
      PresenterPosition="Right"
    />

    <flourish:Chunk
      Title="Shell regions"
      Content="Custom handlers place application-owned WPF elements and actions in predefined Shell regions without changing the Shell template. Use element factories when a view needs dependency injection, command-key helpers for shared dispatch, and callback helpers for local behavior; enable each owning Shell surface separately. This is recommended for profile views, application status, and cross-page actions, and the code below covers every custom-handler API."
    >
      <StackPanel>
        <UniformGrid Columns="2">
          <flourish:Card
            Margin="0,0,8,0"
            Icon="&#xE8BA;"
            Title="WPF content"
            Content="Add and InitProfileContent create application elements when the Shell is composed, with access to registered services."
          />
          <flourish:Card
            Margin="8,0,0,0"
            Icon="&#xE756;"
            Title="Actions"
            Content="Title-bar and footer helpers support either stable command keys or service-aware callbacks."
          />
        </UniformGrid>
        <flourish:CodeSpace
          Margin="{DynamicResource FlourishCodeSpacePeerMargin}"
          Text="builder&#10;    // Custom content does not enable its owning Shell surface.&#10;    .ConfigShell(shell =&gt; shell.UseTitleBar().UseStatusBar())&#10;    .ConfigTitleBar(titleBar =&gt; titleBar.UseProfile())&#10;    .ConfigCustomHandler(custom =&gt; custom&#10;        .AddRegionContent(&#10;            FlourishRegion.TitlebarEnd,&#10;            services =&gt; new SyncStatusView(&#10;                services.GetRequiredService&lt;SyncService&gt;()),&#10;            order: 0)&#10;        .InitProfileContent(_ =&gt; new ProfileView())&#10;        .AddTitleBarAction(&quot;Refresh&quot;, &quot;\uE72C&quot;, &quot;app.refresh&quot;, order: 10)&#10;        .AddTitleBarActionHandler(&#10;            &quot;Sync&quot;, &quot;\uE895&quot;,&#10;            services =&gt; services.GetRequiredService&lt;SyncService&gt;().Start(),&#10;            order: 20)&#10;        .AddFooterCommand(&#10;            FlourishRegion.FooterEnd,&#10;            &quot;Settings&quot;, &quot;\uE713&quot;, &quot;app.settings&quot;)&#10;        .AddFooterCommandHandler(&#10;            FlourishRegion.FooterStart,&#10;            &quot;Help&quot;, &quot;\uE946&quot;,&#10;            services =&gt; services.GetRequiredService&lt;HelpService&gt;().Open()));"
        />
      </StackPanel>
    </flourish:Chunk>
    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="Browse the Flourish source repository." Icon="&#xE943;" IsEnabled="False" Title="GitHub repository" ToolTip="External navigation is not available in Gallery." />
        <flourish:CardButton Margin="8,0,0,0" Content="Read the canonical Flourish documentation." Icon="&#xE946;" IsEnabled="False" Title="Flourish documentation" ToolTip="External navigation is not available in Gallery." />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
