<Page
  x:Class="ArkheideSystem.Gallery.Views.TextBoxPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Collect and edit a single value or a small block of text with the native WPF text contract."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="FlourishTextBox"
    />

    <flourish:Chunk Title="Table">
      <flourish:DataGrid
        x:Name="MemberGrid"
        AutoGenerateColumns="False"
        IsReadOnly="True"
      >
        <flourish:DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="Member" Width="220" />
          <DataGridTextColumn Binding="{Binding Description}" Header="Purpose" Width="*" />
        </flourish:DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Use the native TextBox properties to select single-line, read-only, or multiline behavior."
      Title="Editing"
    >
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Content="Text updates through the regular WPF binding and TextChanged contracts."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Single line"
        >
          <flourish:Presenter.Presentation>
            <flourish:FlourishTextBox
              Width="240"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Text="Editable text"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="AcceptsReturn and TextWrapping create a bounded multiline editor."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Multiline"
        >
          <flourish:Presenter.Presentation>
            <flourish:FlourishTextBox
              Width="240"
              Height="80"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              AcceptsReturn="True"
              Text="First line&#x0a;Second line"
              TextWrapping="Wrap"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Usage">
      <StackPanel>
        <flourish:Presenter
          Content="Bind Text in TwoWay mode when the value belongs to a view model, and choose PropertyChanged only when every edit must update the source. MaxLength limits input at the control boundary. Name the control when code must replace, select, or focus its value through the native TextBox methods."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Bound value"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="{Binding UsageCode, ElementName=RootPage}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="Handle TextChanged when each edit must trigger view-owned behavior that is not represented by the binding alone, such as a local character counter. The event fires for both user and application changes, so keep its handler lightweight. AcceptsReturn and TextWrapping can independently turn the same control into a bounded multiline editor."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Edit notifications"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:FlourishTextBox&#xA;  x:Name=&quot;NotesBox&quot;&#xA;  Height=&quot;96&quot;&#xA;  AcceptsReturn=&quot;True&quot;&#xA;  TextWrapping=&quot;Wrap&quot;&#xA;  TextChanged=&quot;NotesBox_TextChanged&quot; /&gt;&#xA;&#xA;private void NotesBox_TextChanged(object sender, TextChangedEventArgs e)&#xA;{&#xA;    CharacterCount.Text = NotesBox.Text.Length.ToString();&#xA;}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          Content="Browse the Flourish source repository."
          Icon="&#xE943;"
          IsEnabled="False"
          Title="GitHub repository"
          ToolTip="External navigation is not available in Gallery."
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          Content="Read the FlourishTextBox API reference."
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="FlourishTextBox documentation"
          ToolTip="External navigation is not available in Gallery."
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
