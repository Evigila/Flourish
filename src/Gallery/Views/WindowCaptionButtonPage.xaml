<Page
  x:Class="ArkheideSystem.Gallery.Views.WindowCaptionButtonPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="A dedicated title-bar action with caption geometry and window interaction semantics."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="WindowCaptionButton"
    />

    <flourish:Chunk Title="Variant">
      <flourish:Presenter
        Content="Use Text for ordinary caption commands and reserve Danger for the close command."
        PresenterMode="Split"
        PresenterPosition="Left"
        Title="Caption semantics"
      >
        <flourish:Presenter.Presentation>
          <Border
            Background="{DynamicResource FlourishNeutralBackground1Brush}"
            BorderBrush="{DynamicResource FlourishNeutralStroke1Brush}"
            BorderThickness="1"
          >
            <StackPanel Orientation="Horizontal">
              <flourish:WindowCaptionButton AutomationProperties.Name="Minimize" Icon="&#xE921;" ToolTip="Minimize" Variant="Text" />
              <flourish:WindowCaptionButton AutomationProperties.Name="Maximize" Icon="&#xE922;" ToolTip="Maximize" Variant="Text" />
              <flourish:WindowCaptionButton AutomationProperties.Name="Close" Icon="&#xE8BB;" ToolTip="Close" Variant="Danger" />
            </StackPanel>
          </Border>
        </flourish:Presenter.Presentation>
      </flourish:Presenter>
    </flourish:Chunk>

    <flourish:Chunk Title="Table">
      <flourish:DataGrid
        x:Name="PropertiesGrid"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        CanUserReorderColumns="False"
        FontWeight="Regular"
        IsReadOnly="True"
      >
        <flourish:DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="PROPERTY" Width="220" />
          <DataGridTextColumn Binding="{Binding Description}" Header="PURPOSE" Width="*" />
        </flourish:DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Caption geometry">
      <flourish:Card Content="WindowCaptionButton is sized for the title bar and keeps the caption hit target separate from ordinary application buttons." />
    </flourish:Chunk>

    <flourish:Chunk Title="Interaction contract">
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Title="Window controls"
          Content="Minimize, maximize, and restore change the window state without discarding work. Use the neutral Text variant so these routine caption actions remain visually quiet."
          PresenterMode="TopDown"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <Border MinHeight="160" Padding="16">
              <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
              >
                <flourish:WindowCaptionButton
                  AutomationProperties.Name="Minimize"
                  Icon="&#xE921;"
                  ToolTip="Minimize"
                  Variant="Text"
                />
                <flourish:WindowCaptionButton
                  AutomationProperties.Name="Maximize"
                  Icon="&#xE922;"
                  ToolTip="Maximize"
                  Variant="Text"
                />
                <flourish:WindowCaptionButton
                  AutomationProperties.Name="Restore"
                  Icon="&#xE923;"
                  ToolTip="Restore"
                  Variant="Text"
                />
              </StackPanel>
            </Border>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Title="Close action"
          Content="Closing can end the current session or discard unsaved work. Use the Danger variant to give this destructive caption action distinct warning feedback."
          PresenterMode="TopDown"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <Border MinHeight="160" Padding="16">
              <flourish:WindowCaptionButton
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Close"
                Icon="&#xE8BB;"
                ToolTip="Close"
                Variant="Danger"
              />
            </Border>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Usage">
      <StackPanel>
        <flourish:Presenter
          Title="Bind caption commands"
          Content="Use WindowCaptionButton only in the title bar and bind it to a SystemCommands minimize, maximize, restore, or close command. Icon-only actions need matching ToolTip and AutomationProperties.Name values, and Danger supplies the expected close-button feedback. Keep the caption group at the title-bar edge and ordinary toolbar commands outside it so Windows corner hit targets remain intact."
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace Text="&lt;flourish:WindowCaptionButton&#xA;  AutomationProperties.Name=&quot;Close&quot;&#xA;  Command=&quot;{x:Static SystemCommands.CloseWindowCommand}&quot;&#xA;  Icon=&quot;&amp;#xE8BB;&quot;&#xA;  ToolTip=&quot;Close&quot;&#xA;  Variant=&quot;Danger&quot; /&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          AutomationProperties.Name="Flourish GitHub repository"
          Content="Repository link placeholder"
          Icon="&#xE943;"
          IsEnabled="False"
          Title="GitHub repository"
          ToolTip="External navigation is not available in Gallery."
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          AutomationProperties.Name="WindowCaptionButton documentation"
          Content="Canonical documentation link placeholder"
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="WindowCaptionButton documentation"
          ToolTip="External navigation is not available in Gallery."
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
