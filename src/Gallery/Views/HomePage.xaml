<Page
  x:Class="ArkheideSystem.Gallery.Views.HomePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:culture="clr-namespace:Arkheide.Essential.Culture"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="{culture:Localize Key=Shell_ExploreFlourishThroughFocusedInteractiveExamplesEachFeaturePageE_74D8E627}"
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="{culture:Localize Key=Shell_FlourishGallery_E383A04F}"
    >
      <flourish:HeaderChunk.Presentation>
        <Border MinHeight="180" Background="{DynamicResource FlourishHeroBackgroundBrush}" CornerRadius="12">
          <flourish:FlourishTextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{DynamicResource FlourishIconFontFamily}"
            FontSize="{DynamicResource FlourishFontSizeIcon}"
            Foreground="{DynamicResource FlourishAccentForegroundBrush}"
            Role="Icon"
            Text="&#xE950;"
          />
        </Border>
      </flourish:HeaderChunk.Presentation>
    </flourish:HeaderChunk>

    <flourish:Chunk
      Content="{culture:Localize Key=Shell_ChooseAFeatureAreaToOpenItsInteractiveGuideStartWithConfiguratio_E9A7BC4A}"
      Title="{culture:Localize Key=Shell_Explore_3B73900B}"
    >
      <UniformGrid
        x:Name="DemoGrid"
        Margin="0,6,-6,-6"
        Columns="3"
        SizeChanged="DemoGrid_SizeChanged"
      >
        <flourish:CardButton
          MinHeight="150"
          Margin="6"
          AutomationProperties.Name="{culture:Localize Key=Shell_ConfigurationAndLocale_35353B16}"
          Click="DemoCard_Click"
          Content="{culture:Localize Key=Shell_ReadEditAppendSaveReloadAndSwitchLocale_76DF4139}"
          Icon="&#xE713;"
          Tag="Configuration"
          Title="{culture:Localize Key=Shell_ConfigurationLocale_7E731F1B}"
        />
        <flourish:CardButton
          MinHeight="150"
          Margin="6"
          AutomationProperties.Name="{culture:Localize Key=Application_Appearance_3907FA7F}"
          Click="DemoCard_Click"
          Content="{culture:Localize Key=Shell_ThemeTypographyPageOverridesAndMaterialEffects_492AA572}"
          Icon="&#xE790;"
          Tag="Appearance"
          Title="{culture:Localize Key=Application_Appearance_3907FA7F}"
        />
        <flourish:CardButton
          MinHeight="150"
          Margin="6"
          AutomationProperties.Name="{culture:Localize Key=Shell_TitleBarAndSearch_9A83ACC8}"
          Click="DemoCard_Click"
          Content="{culture:Localize Key=Shell_IdentityElementVisibilityTitleBarAvailabilityAndSearchHandlers_26D40801}"
          Icon="&#xE8A4;"
          Tag="TitleBarRuntime"
          Title="{culture:Localize Key=Shell_TitleBarSearch_89590FBD}"
        />
        <flourish:CardButton
          MinHeight="150"
          Margin="6"
          AutomationProperties.Name="{culture:Localize Key=Application_Projects_04E2A972}"
          Click="DemoCard_Click"
          Content="{culture:Localize Key=Shell_RegisterProjectMetadataChangeTheActiveProjectAndHandleTitleBarRe_D4CB5B7C}"
          Icon="&#xE8F9;"
          Tag="ProjectRuntime"
          Title="{culture:Localize Key=Application_Projects_04E2A972}"
        />
        <flourish:CardButton
          MinHeight="150"
          Margin="6"
          AutomationProperties.Name="{culture:Localize Key=Application_Navigation_3DB65F8C}"
          Click="DemoCard_Click"
          Content="{culture:Localize Key=Shell_PanelPlacementSizingRoutesCacheAndMenuItems_6A4D8C17}"
          Icon="&#xE700;"
          Tag="NavigationRuntime"
          Title="{culture:Localize Key=Application_Navigation_3DB65F8C}"
        />
        <flourish:CardButton
          MinHeight="150"
          Margin="6"
          AutomationProperties.Name="{culture:Localize Key=Application_DynamicToolbar_2B28D7DF}"
          Click="DemoCard_Click"
          Content="{culture:Localize Key=Shell_AssociateCommandActionsWithThePageThatOwnsEachWorkflow_4A3E4136}"
          Icon="&#xE945;"
          Tag="DynamicToolbarConfiguration"
          Title="{culture:Localize Key=Application_DynamicToolbar_2B28D7DF}"
        />
        <flourish:CardButton
          MinHeight="150"
          Margin="6"
          AutomationProperties.Name="{culture:Localize Key=Shell_CommandsAndShortcuts_2F563C72}"
          Click="DemoCard_Click"
          Content="{culture:Localize Key=Shell_RegisterDispatchDisableRemoveAndBindKeyboardInput_B95578BC}"
          Icon="&#xE756;"
          Tag="Commands"
          Title="{culture:Localize Key=Shell_CommandsShortcuts_04462026}"
        />
        <flourish:CardButton
          MinHeight="150"
          Margin="6"
          AutomationProperties.Name="{culture:Localize Key=Application_Window_19734A1B}"
          Click="DemoCard_Click"
          Content="{culture:Localize Key=Shell_WindowStateTrayBehaviorCloseGuardsDialogsAndNotifications_836C8064}"
          Icon="&#xE737;"
          Tag="WindowRuntime"
          Title="{culture:Localize Key=Application_Window_19734A1B}"
        />
        <flourish:CardButton
          MinHeight="150"
          Margin="6"
          AutomationProperties.Name="{culture:Localize Key=Shell_BackgroundTasks_C6907E94}"
          Click="DemoCard_Click"
          Content="{culture:Localize Key=Shell_QueueWorkObserveProgressCancelAndCaptureResults_E7CAD9FD}"
          Icon="&#xE895;"
          Tag="BackgroundTasks"
          Title="{culture:Localize Key=Shell_BackgroundTasks_C6907E94}"
        />
      </UniformGrid>
    </flourish:Chunk>
    <flourish:Chunk Title="{culture:Localize Key=Controls_Reference_71BF9093}">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="{culture:Localize Key=Controls_BrowseTheFlourishSourceRepository_5CC28F39}" Icon="&#xE943;" IsEnabled="False" Title="{culture:Localize Key=Controls_GitHubRepository_50555492}" ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}" />
        <flourish:CardButton Margin="8,0,0,0" Content="{culture:Localize Key=Shell_ReadTheCanonicalFlourishDocumentation_7BB05CDB}" Icon="&#xE946;" IsEnabled="False" Title="{culture:Localize Key=Shell_FlourishDocumentation_A1D1605B}" ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}" />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
