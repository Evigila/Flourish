<Page
  x:Class="ArkheideSystem.Gallery.Views.ComboBoxPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Choose one value from a compact collection using Flourish item containers."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="FlourishComboBox"
    />

    <flourish:Chunk Title="Table">
      <flourish:DataGrid
        x:Name="MemberGrid"
        AutoGenerateColumns="False"
        IsReadOnly="True"
      >
        <flourish:DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="Member" Width="220" />
          <DataGridTextColumn Binding="{Binding Description}" Header="Purpose" Width="*" />
        </flourish:DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Declare a short static list in XAML or bind ItemsSource to application-owned data. The closed selector uses HoverReveal for pointer feedback."
      Title="Selection"
    >
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Content="Direct items make a concise fixed option list."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Declared items"
        >
          <flourish:Presenter.Presentation>
            <flourish:FlourishComboBox
                Width="240"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                SelectedIndex="0"
              >
                <flourish:FlourishComboBoxItem Content="System" />
                <flourish:FlourishComboBoxItem Content="Light" />
                <flourish:FlourishComboBoxItem Content="Dark" />
            </flourish:FlourishComboBox>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="ItemsSource automatically receives FlourishComboBoxItem containers."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Generated items"
        >
          <flourish:Presenter.Presentation>
            <flourish:FlourishComboBox
                Width="240"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ItemsSource="{Binding DensityOptions, ElementName=RootPage}"
                SelectedIndex="0"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Usage">
      <StackPanel>
        <flourish:Presenter
          Content="Bind ItemsSource to application data and SelectedItem in TwoWay mode when selection belongs to the view model. DisplayMemberPath selects the label for non-string items. Handle SelectionChanged only when added or removed selections must trigger immediate view-owned work beyond the binding update."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Bound collection"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace Text="{Binding UsageCode, ElementName=RootPage}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="Declare FlourishComboBoxItem children for a short fixed list whose entries need individual content, enabled state, or tooltips. Use SelectedIndex for a simple initial choice; for application data, prefer the collection-binding pattern above."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Declared choices"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace Text="&lt;flourish:FlourishComboBox SelectedIndex=&quot;0&quot;&gt;&#xA;  &lt;flourish:FlourishComboBoxItem Content=&quot;System&quot; /&gt;&#xA;  &lt;flourish:FlourishComboBoxItem Content=&quot;Light&quot; /&gt;&#xA;  &lt;flourish:FlourishComboBoxItem Content=&quot;Dark&quot; /&gt;&#xA;&lt;/flourish:FlourishComboBox&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          Content="Browse the Flourish source repository."
          Icon="&#xE943;"
          IsEnabled="False"
          Title="GitHub repository"
          ToolTip="External navigation is not available in Gallery."
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          Content="Read the FlourishComboBox API reference."
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="FlourishComboBox documentation"
          ToolTip="External navigation is not available in Gallery."
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
