<Page
  x:Class="ArkheideSystem.Gallery.Views.ComboBoxPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:culture="clr-namespace:Arkheide.Essential.Culture"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="{culture:Localize Key=Controls_ChooseOneValueFromACompactCollectionUsingFlourishItemContainers_1BCC40CE}"
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="FlourishComboBox"
    />

    <flourish:Chunk Title="{culture:Localize Key=Controls_Table_16D1C905}">
      <flourish:DataGrid
        x:Name="MemberGrid"
        AutoGenerateColumns="False"
        IsReadOnly="True"
      >
        <flourish:DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="{culture:Localize Key=Controls_Member_7C968FB7}" Width="220" />
          <DataGridTextColumn Binding="{Binding Description}" Header="{culture:Localize Key=Controls_Purpose_D4E8830A}" Width="*" />
        </flourish:DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="{culture:Localize Key=Controls_DeclareAShortStaticListInXAMLOrBindItemsSourceToApplicationOwned_11F057C7}"
      Title="{culture:Localize Key=Controls_Selection_CA406707}"
    >
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Content="{culture:Localize Key=Controls_DirectItemsMakeAConciseFixedOptionList_F140A3D5}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_DeclaredItems_637C98BD}"
        >
          <flourish:Presenter.Presentation>
            <flourish:FlourishComboBox
                Width="240"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                SelectedIndex="0"
              >
                <flourish:FlourishComboBoxItem Content="{culture:Localize Key=Runtime_System_6725E7BB}" />
                <flourish:FlourishComboBoxItem Content="Light" />
                <flourish:FlourishComboBoxItem Content="Dark" />
            </flourish:FlourishComboBox>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="{culture:Localize Key=Controls_ItemsSourceAutomaticallyReceivesFlourishComboBoxItemContainers_8B5CAF1F}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_GeneratedItems_88FD720E}"
        >
          <flourish:Presenter.Presentation>
            <flourish:FlourishComboBox
                Width="240"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ItemsSource="{Binding DensityOptions, ElementName=RootPage}"
                SelectedIndex="0"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="{culture:Localize Key=Controls_FlourishComboBoxGeneratesFlourishComboBoxItemContainersExplicitI_7C64B62F}"
      Title="ComboBoxItem"
    >
      <flourish:Presenter
        Content="{culture:Localize Key=Controls_ADisabledItemRemainsVisibleWhileItsTooltipExplainsWhyTheOptionIs_438D4035}"
        PresenterMode="Split"
        PresenterPosition="Left"
        Title="{culture:Localize Key=Controls_UnavailableItem_F920918D}"
      >
        <flourish:Presenter.Presentation>
          <flourish:FlourishComboBox Width="240" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" SelectedIndex="0">
            <flourish:FlourishComboBoxItem Content="{culture:Localize Key=Controls_StableChannel_D95A55C4}" />
            <flourish:FlourishComboBoxItem Content="{culture:Localize Key=Controls_PreviewChannel_42D3F713}" IsEnabled="False" ToolTip="{culture:Localize Key=Controls_PreviewUpdatesAreNotConfigured_89C03B8C}" />
          </flourish:FlourishComboBox>
        </flourish:Presenter.Presentation>
      </flourish:Presenter>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Usage_8D59829C}">
      <StackPanel>
        <flourish:Presenter
          Content="{culture:Localize Key=Controls_BindItemsSourceToApplicationDataAndSelectedItemInTwoWayModeWhenS_51BDFE32}"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_BoundCollection_E687780D}"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="{Binding UsageCode, ElementName=RootPage}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="{culture:Localize Key=Controls_DeclareFlourishComboBoxItemChildrenForAShortFixedListWhoseEntrie_C333712A}"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_DeclaredChoices_66BD7A74}"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:FlourishComboBox SelectedIndex=&quot;0&quot;&gt;&#xA;  &lt;flourish:FlourishComboBoxItem Content=&quot;System&quot; /&gt;&#xA;  &lt;flourish:FlourishComboBoxItem Content=&quot;Light&quot; /&gt;&#xA;  &lt;flourish:FlourishComboBoxItem Content=&quot;Dark&quot; /&gt;&#xA;&lt;/flourish:FlourishComboBox&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Reference_71BF9093}">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          Content="{culture:Localize Key=Controls_BrowseTheFlourishSourceRepository_5CC28F39}"
          Icon="&#xE943;"
          IsEnabled="False"
          Title="{culture:Localize Key=Controls_GitHubRepository_50555492}"
          ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}"
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          Content="{culture:Localize Key=Controls_ReadTheFlourishComboBoxAPIReference_8F90207E}"
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="{culture:Localize Key=Controls_FlourishComboBoxDocumentation_C7A61837}"
          ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}"
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
