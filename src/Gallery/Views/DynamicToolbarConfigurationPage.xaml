<Page
  x:Class="ArkheideSystem.Gallery.Views.DynamicToolbarConfigurationPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Title="Dynamic toolbar"
      Content="Associate toolbar actions with the page type that owns their workflow."
      PresenterMode="Split"
      PresenterPosition="Right"
    />

    <flourish:Chunk
      Title="Page actions"
      Content="The dynamic toolbar changes its commands with the active page, keeping page-specific actions close to their workflow. Enable the surface once, then associate each WPF Page type with FlourishToolbarItem values that provide display text, a glyph, and a stable command key. Use it for actions such as refresh, export, or preview; the code below demonstrates both registration overloads, including the text-only option."
    >
      <StackPanel>
        <flourish:Card
          Icon="&#xE945;"
          Title="Toolbar items"
          Content="Only the items registered for the active page are shown, and their command keys are dispatched through the shared command system."
        />
        <flourish:CodeSpace
          Margin="{DynamicResource FlourishCodeSpacePeerMargin}"
          Text="builder&#10;    .ConfigShell(shell =&gt; shell.UseDynamicToolbar())&#10;    .ConfigDynamicToolbar(toolbar =&gt; toolbar&#10;        // Icons are shown by default.&#10;        .InitToolbarItems&lt;ReportsPage&gt;(&#10;            new FlourishToolbarItem(&quot;Refresh&quot;, &quot;\uE72C&quot;, &quot;reports.refresh&quot;),&#10;            new FlourishToolbarItem(&quot;Export&quot;, &quot;\uE898&quot;, &quot;reports.export&quot;))&#10;        // Set iconOnly: false for actions that show text.&#10;        .InitToolbarItems&lt;EditorPage&gt;(&#10;            iconOnly: false,&#10;            new FlourishToolbarItem(&quot;Preview&quot;, &quot;\uE8A7&quot;, &quot;editor.preview&quot;)));"
        />
      </StackPanel>
    </flourish:Chunk>
    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="Browse the Flourish source repository." Icon="&#xE943;" IsEnabled="False" Title="GitHub repository" ToolTip="External navigation is not available in Gallery." />
        <flourish:CardButton Margin="8,0,0,0" Content="Read the canonical Flourish documentation." Icon="&#xE946;" IsEnabled="False" Title="Flourish documentation" ToolTip="External navigation is not available in Gallery." />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
