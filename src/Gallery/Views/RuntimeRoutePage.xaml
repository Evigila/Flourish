<Page
  x:Class="ArkheideSystem.Gallery.Views.RuntimeRoutePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Inspect a page created from a route that was registered after application startup. Dynamic routes are useful for optional modules, plug-ins, and user-selected workflows that cannot be fully declared during initial shell composition."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="Dynamic route"
    />

    <flourish:Chunk
      Content="Review the page instance and parameter produced by dynamic navigation. The route registry supplies the page factory and cache policy, while the navigation service passes context to the created page; the code below shows registration and navigation with the same route key."
      Title="Route details"
    >
      <StackPanel>
        <flourish:Presenter
        Content="This page was not present in ConfigNavigation; its route and menu entry were registered while Gallery was already running."
        PresenterMode="Split"
        PresenterPosition="Left"
        Title="Route instance"
      >
        <flourish:Presenter.Presentation>
          <StackPanel
            Width="360"
            Height="160"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
          >
            <flourish:FlourishTextBlock Role="FieldLabel" Margin="0,22,0,0" Text="PAGE INSTANCE" />
            <flourish:FlourishTextBlock x:Name="InstanceText" Foreground="{DynamicResource FlourishPrimaryForegroundBrush}" TextWrapping="Wrap" />
            <flourish:FlourishTextBlock Role="FieldLabel" Margin="0,18,0,0" Text="NAVIGATION PARAMETER" />
            <flourish:FlourishTextBlock x:Name="ParameterText" Foreground="{DynamicResource FlourishNeutralForeground1Brush}" TextWrapping="Wrap" />
          </StackPanel>
        </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="routes.Set(new FlourishNavigationRoute(&#10;    &quot;ReportPreview&quot;,&#10;    typeof(RuntimeRoutePage),&#10;    FlourishPageCacheMode.Enabled,&#10;    provider =&gt; new RuntimeRoutePage(&#10;        provider.GetRequiredService&lt;INavigationService&gt;())));&#10;&#10;// The parameter is available to the page through navigation state.&#10;navigation.Navigate(&quot;ReportPreview&quot;, reportId);" />
      </StackPanel>
    </flourish:Chunk>
    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="Browse the Flourish source repository." Icon="&#xE943;" IsEnabled="False" Title="GitHub repository" ToolTip="External navigation is not available in Gallery." />
        <flourish:CardButton Margin="8,0,0,0" Content="Read the navigation documentation." Icon="&#xE946;" IsEnabled="False" Title="Navigation documentation" ToolTip="External navigation is not available in Gallery." />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
