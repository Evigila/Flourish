<Page
  x:Class="ArkheideSystem.Gallery.Views.ListBoxPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Select items through a Flourish-styled list that generates FlourishListBoxItem containers."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="ListBox"
    />

    <flourish:Chunk
      Content="Both appearances use the same selection model and an equal-height demonstration surface."
      Title="Variant"
    >
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Content="A bordered list for ordinary selectable content."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Standard"
        >
          <flourish:Presenter.Presentation>
            <flourish:ListBox
              Width="240"
              Height="132"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              SelectedIndex="0"
            >
                <flourish:FlourishListBoxItem Content="Design" />
                <flourish:FlourishListBoxItem Content="Build" />
                <flourish:FlourishListBoxItem Content="Verify" />
            </flourish:ListBox>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="A borderless list for shell navigation items and group labels."
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Borderless"
        >
          <flourish:Presenter.Presentation>
            <flourish:ListBox
              Width="240"
              Height="132"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Appearance="Borderless"
            >
                <flourish:FlourishListBoxItem Content="Workspace" IsGroupHeader="True" />
                <flourish:FlourishListBoxItem Content="Overview" IsSelected="True" />
                <flourish:FlourishListBoxItem Content="Settings" />
            </flourish:ListBox>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Table">
      <flourish:DataGrid ItemsSource="{Binding Properties, ElementName=RootPage}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Width="220" Binding="{Binding Name}" Header="Member" />
          <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="Purpose" />
        </DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Bind ItemsSource for application data; the control creates FlourishListBoxItem containers automatically."
      Title="Selection"
    >
      <flourish:Card Title="State ownership" Content="Bind SelectedItem or SelectedValue to the view model. IsCompact affects navigation geometry without changing selection state." />
    </flourish:Chunk>

    <flourish:Chunk
      Content="ListBox generates FlourishListBoxItem containers. Declare one explicitly only when a fixed entry needs item-level state."
      Title="ListBoxItem"
    >
      <UniformGrid Columns="3">
        <flourish:Card Title="Selectable" Content="Content and IsSelected describe a normal selectable entry." />
        <flourish:Card Margin="8,0" Title="Group header" Content="IsGroupHeader creates a non-selectable label in a Borderless list." />
        <flourish:Card Title="Command item" Content="IsCommandItem marks an entry invoked as a command rather than retained as the active destination." />
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="Usage">
      <StackPanel>
        <flourish:Presenter
          Content="Use Standard for ordinary selectable collections. Bind ItemsSource and SelectedItem as with native WPF ListBox, using a two-way selection binding to synchronize the active view-model item. Choose Borderless when entries represent destinations or commands, and define group-header or command semantics through FlourishListBoxItem."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Standard list"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="{Binding UsageCode, ElementName=RootPage}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="Use Borderless when entries represent destinations or commands. Explicit FlourishListBoxItem containers can mark group headings and command entries; IsCompact collapses their geometry without changing selection semantics."
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="Borderless list"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:ListBox&#xA;  Appearance=&quot;Borderless&quot;&#xA;  IsCompact=&quot;False&quot;&gt;&#xA;  &lt;flourish:FlourishListBoxItem&#xA;    Content=&quot;Workspace&quot;&#xA;    IsGroupHeader=&quot;True&quot; /&gt;&#xA;  &lt;flourish:FlourishListBoxItem&#xA;    Content=&quot;Refresh&quot;&#xA;    IsCommandItem=&quot;True&quot; /&gt;&#xA;&lt;/flourish:ListBox&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="Browse the Flourish source repository." Icon="&#xE943;" IsEnabled="False" Title="GitHub repository" ToolTip="External navigation is not available in Gallery." />
        <flourish:CardButton Margin="8,0,0,0" Content="Read the ListBox API reference." Icon="&#xE8A5;" IsEnabled="False" Title="ListBox documentation" ToolTip="External navigation is not available in Gallery." />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
