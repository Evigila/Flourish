<Page
  x:Class="ArkheideSystem.Gallery.Views.GridSplitterPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:culture="clr-namespace:ArkheideSystem.Essential.Culture"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="{culture:Localize Key=Controls_ResizeAdjacentGridRowsOrColumnsWithAFlourishInteractionAndFocusS_B6594F54}"
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="GridSplitter"
    />

    <flourish:Chunk
      Content="{culture:Localize Key=Controls_BothLayoutRolesUseTheSame4DIPInteractionSurfaceCentered2DIPHighl_FE794693}"
      Title="Variant"
    >
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Content="{culture:Localize Key=Controls_TheGeneralPurposeRoleForRowsOrColumnsInAnApplicationGrid_D607231F}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="Standard"
        >
          <flourish:Presenter.Presentation>
            <Grid
              Width="300"
              Height="150"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="80" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" MinWidth="80" />
                </Grid.ColumnDefinitions>
              <Grid Background="{DynamicResource FlourishPrimarySurfaceBrush}" />
                <flourish:GridSplitter
                  Grid.Column="1"
                  HorizontalAlignment="Center"
                  ResizeDirection="Columns"
                />
              <Grid Grid.Column="2" Background="{DynamicResource FlourishNeutralBackground2Brush}" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="{culture:Localize Key=Controls_TheShellEdgeRoleWithHorizontalColumnResizeDefaultsAndTheSameGeom_6A72AE95}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="NavigationPane"
        >
          <flourish:Presenter.Presentation>
            <Grid
              Width="300"
              Height="150"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" MinWidth="80" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" MinWidth="80" />
                </Grid.ColumnDefinitions>
              <Grid Background="{DynamicResource FlourishPrimarySurfaceBrush}" />
                <flourish:GridSplitter Grid.Column="1" Variant="NavigationPane" />
              <Grid Grid.Column="2" Background="{DynamicResource FlourishNeutralBackground2Brush}" />
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Table_16D1C905}">
      <flourish:DataGrid ItemsSource="{Binding Properties, ElementName=RootPage}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Width="220" Binding="{Binding Name}" Header="{culture:Localize Key=Controls_Member_7C968FB7}" />
          <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="{culture:Localize Key=Controls_Purpose_D4E8830A}" />
        </DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="{culture:Localize Key=Controls_GridOwnsRowAndColumnConstraintsDraggingTheSplitterUpdatesAdjacen_D8EB9697}"
      Title="{culture:Localize Key=Controls_Layout_A5119091}"
    >
      <flourish:Card Title="{culture:Localize Key=Controls_ResizeContract_C80B1EDB}" Content="{culture:Localize Key=Controls_SetResizeDirectionExplicitlyForAStandardSplitterNavigationPaneCo_11E6A483}" />
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Usage_8D59829C}">
      <StackPanel>
        <flourish:Presenter
          Content="{culture:Localize Key=Controls_UseStandardBetweenOrdinaryGridDefinitionsPlaceTheSplitterInAnAut_D696E7E8}"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_StandardSplitter_113A303F}"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;Grid&gt;&#xA;  &lt;Grid.ColumnDefinitions&gt;&#xA;    &lt;ColumnDefinition Width=&quot;*&quot; MinWidth=&quot;160&quot; /&gt;&#xA;    &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;&#xA;    &lt;ColumnDefinition Width=&quot;*&quot; MinWidth=&quot;240&quot; /&gt;&#xA;  &lt;/Grid.ColumnDefinitions&gt;&#xA;&#xA;  &lt;local:EditorPane /&gt;&#xA;  &lt;flourish:GridSplitter&#xA;    Grid.Column=&quot;1&quot;&#xA;    ResizeBehavior=&quot;PreviousAndNext&quot;&#xA;    ResizeDirection=&quot;Columns&quot; /&gt;&#xA;  &lt;local:PreviewPane Grid.Column=&quot;2&quot; /&gt;&#xA;&lt;/Grid&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="{culture:Localize Key=Controls_ChooseNavigationPaneOnlyForTheDividerAtAShellNavigationEdgeTheVa_75ADE1D3}"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_NavigationPane_81207563}"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="{Binding UsageCode, ElementName=RootPage}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Reference_71BF9093}">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="{culture:Localize Key=Controls_BrowseTheFlourishSourceRepository_5CC28F39}" Icon="&#xE943;" IsEnabled="False" Title="{culture:Localize Key=Controls_GitHubRepository_50555492}" ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}" />
        <flourish:CardButton Margin="8,0,0,0" Content="{culture:Localize Key=Controls_ReadTheGridSplitterAPIReference_DEC55185}" Icon="&#xE8A5;" IsEnabled="False" Title="{culture:Localize Key=Controls_GridSplitterDocumentation_1825574B}" ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}" />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
