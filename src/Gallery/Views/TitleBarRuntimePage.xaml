<Page
  x:Class="ArkheideSystem.Gallery.Views.TitleBarRuntimePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="Change title-bar identity, features, and search at runtime."
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="Title bar &amp; search"
    />

    <flourish:Chunk
      Content="Set the application title, subtitle, logo, fallback text, and unnamed-project label shown by the shell. Configure stable defaults during startup and use ITitleBarService when identity must follow the active workspace; the code below demonstrates both approaches."
      Title="Application identity"
    >
      <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE8D2;"
            Title="Application title"
            Content="Set the application name used by the title and logo surfaces."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="TitleBox" Width="220" KeyDown="IdentityBox_KeyDown" LostFocus="IdentityBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Application subtitle"
            Content="Set supporting application text shown in the logo surface."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="SubtitleBox" Width="220" KeyDown="IdentityBox_KeyDown" LostFocus="IdentityBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8B9;"
            Title="Logo path"
            Content="Optionally provide an image for the title-bar logo."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="LogoPathBox" Width="220" KeyDown="LogoBox_KeyDown" LostFocus="LogoBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Logo fallback text"
            Content="Provide text to use when an image is unavailable."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="LogoFallbackBox" Width="220" KeyDown="LogoBox_KeyDown" LostFocus="LogoBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Unnamed project"
            Content="Set the title shown when no project is active."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="UnnamedProjectBox" Width="220" KeyDown="UnnamedProjectBox_KeyDown" LostFocus="UnnamedProjectBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard x:Name="IdentityOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
      </Grid>
      <flourish:CodeSpace Text="// Configure stable identity fields when composing the application.&#10;builder.ConfigTitleBar(titleBar =&gt; titleBar&#10;    .InitApplicationTitle(&quot;Flourish Gallery&quot;)&#10;    .InitApplicationSubTitle(&quot;Component reference&quot;)&#10;    .UseLogo(logoPath: &quot;Assets/AppLogo.png&quot;)&#10;    .InitUnnamedProjectPlaceholder(&quot;Untitled&quot;));&#10;&#10;// Update identity atomically when the active context changes.&#10;titleBar.SetApplicationIdentity(&quot;Flourish Gallery&quot;, &quot;Reports&quot;);&#10;titleBar.SetLogo(null, fallbackText: &quot;FG&quot;);" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Show or hide individual title-bar elements and choose when breadcrumbs are visible. Use these focused settings when a workflow needs to simplify chrome without disabling the whole title bar; the code below applies an element switch and breadcrumb policy."
      Title="Element visibility"
    >
      <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch">
        <flourish:ActionCard
          Icon="&#xE713;"
          Title="Title-bar element"
          Content="Choose the element whose visibility will change."
        >
          <flourish:ActionCard.Body>
            <flourish:FlourishComboBox x:Name="TitleBarElementBox" Width="220" SelectionChanged="TitleBarElementBox_SelectionChanged" />
          </flourish:ActionCard.Body>
        </flourish:ActionCard>
        <flourish:ActionCard
          Margin="{DynamicResource FlourishActionCardPeerMargin}"
          Icon="&#xE7B3;"
          Title="Element visibility"
          Content="Show or hide the selected title-bar element."
        >
          <flourish:ActionCard.Body>
            <flourish:FlourishCheckBox
              x:Name="TitleBarElementVisibleBox"
              VerticalAlignment="Center"
              Checked="TitleBarElementVisibleBox_Changed"
              Content="Visible"
              Unchecked="TitleBarElementVisibleBox_Changed"
            />
          </flourish:ActionCard.Body>
        </flourish:ActionCard>
        <flourish:ActionCard
          Margin="{DynamicResource FlourishActionCardPeerMargin}"
          Icon="&#xE72A;"
          Title="Breadcrumb display"
          Content="Choose the breadcrumb visibility policy."
        >
          <flourish:ActionCard.Body>
            <flourish:FlourishComboBox x:Name="BreadcrumbModeBox" Width="220" SelectionChanged="BreadcrumbModeBox_SelectionChanged" />
          </flourish:ActionCard.Body>
        </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard x:Name="ElementOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
      </Grid>
      <flourish:CodeSpace Text="// Change one surface without rebuilding the title bar.&#10;titleBar.SetElementVisible(TitleBarElement.Search, visible: true);&#10;titleBar.SetBreadcrumbMode(BreadcrumbShowOption.Auto);" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Control title-bar search text, visibility, focus, placeholder, and asynchronous query handling through ITitleBarSearchService. Use a disposable subscription for page- or feature-scoped search behavior; the code below registers a cancellable handler and updates the visible search state."
      Title="Search"
    >
      <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE721;"
            Title="Search query"
            Content="Set the text shared with the title-bar search box."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="SearchTextBox" Width="220" KeyDown="SearchTextBox_KeyDown" LostFocus="SearchTextBox_LostFocus" Text="runtime API" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8A7;"
            Title="Search focus"
            Content="Move keyboard focus to the title-bar search box."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="FocusSearch_Click" Content="Focus search" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE74D;"
            Title="Clear query"
            Content="Remove the current title-bar search text."
          >
            <flourish:ActionCard.Body>
              <flourish:Button Click="ClearSearch_Click" Content="Clear" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE8D2;"
            Title="Search placeholder"
            Content="Set the hint shown when the search box is empty."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishTextBox x:Name="SearchPlaceholderBox" Width="220" KeyDown="SearchPlaceholderBox_KeyDown" LostFocus="SearchPlaceholderBox_LostFocus" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
          <flourish:ActionCard
            Margin="{DynamicResource FlourishActionCardPeerMargin}"
            Icon="&#xE7B3;"
            Title="Search visibility"
            Content="Show or hide the title-bar search feature."
          >
            <flourish:ActionCard.Body>
              <flourish:Button x:Name="ToggleSearchVisibilityButton" Click="ToggleSearchVisibility_Click" />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard x:Name="SearchOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
      </Grid>
      <flourish:CodeSpace Text="// Dispose the subscription when its owning page or feature unloads.&#10;using var subscription = search.Subscribe(async (query, cancellationToken) =&gt;&#10;{&#10;    await FindMatchesAsync(query.Text, cancellationToken);&#10;});&#10;&#10;search.SetPlaceholder(&quot;Search reports&quot;);&#10;search.SetText(&quot;quarterly&quot;);&#10;search.SetVisible(true);&#10;search.Focus();&#10;search.Clear();" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Content="Use ITitleBarService when an application mode should switch the complete Flourish title bar on or off, rather than hide one title-bar element. SetEnabled updates the authoritative title-bar state and Changed keeps the checkbox synchronized. Configure navigation, toolbar, status, tooltips, motion, and profile availability through their own domain services."
      Title="Title bar availability"
    >
      <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch">
          <flourish:ActionCard
            Icon="&#xE74E;"
            Title="Title bar"
            Content="Enable or disable the complete title-bar surface."
          >
            <flourish:ActionCard.Body>
              <flourish:FlourishCheckBox
                x:Name="TitleBarEnabledBox"
                VerticalAlignment="Center"
                Checked="TitleBarEnabledBox_Changed"
                Content="Enabled"
                Unchecked="TitleBarEnabledBox_Changed"
              />
            </flourish:ActionCard.Body>
          </flourish:ActionCard>
        </StackPanel>
        <flourish:OutputCard x:Name="TitleBarAvailabilityOutput" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" />
      </Grid>
      <flourish:CodeSpace Text="// Each domain service owns its availability state.&#10;titleBar.SetEnabled(true);&#10;var isEnabled = titleBar.Current.IsEnabled;" />
      </StackPanel>
    </flourish:Chunk>
    <flourish:Chunk Title="Reference">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="Browse the Flourish source repository." Icon="&#xE943;" IsEnabled="False" Title="GitHub repository" ToolTip="External navigation is not available in Gallery." />
        <flourish:CardButton Margin="8,0,0,0" Content="Read the canonical Flourish documentation." Icon="&#xE946;" IsEnabled="False" Title="Flourish documentation" ToolTip="External navigation is not available in Gallery." />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
