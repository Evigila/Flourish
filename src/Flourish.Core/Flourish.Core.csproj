<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <VersionPrefix>1.1.0</VersionPrefix>
    <AssemblyName>Flourish.Core</AssemblyName>
    <PackageId>Arkheide.Flourish.Core</PackageId>
    <Title>Flourish Core</Title>
    <Authors>ArkheideSystem</Authors>
    <Description>Platform-neutral contracts and application services for Flourish.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Evigila/Flourish</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Evigila/Flourish.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RootNamespace>ArkheideSystem.Flourish</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\FlourishCulture.Json" LogicalName="Flourish.Core.Assets.FlourishCulture.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
  </ItemGroup>
</Project>
