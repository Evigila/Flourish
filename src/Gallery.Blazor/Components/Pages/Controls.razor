@page "/controls"
<PageTitle>控件 · 组件演示</PageTitle>
<PageBody>
    <PageHeading Title="控件" />
    <Section Title="操作">
        <FormActions Columns="3">
            <Button OnClick="Increment">主要操作</Button>
            <Button Variant="ButtonVariant.Secondary" OnClick="Increment">辅助操作</Button>
            <Button Variant="ButtonVariant.Danger" OnClick="Reset">重置计数</Button>
        </FormActions>
        <ActionMenu Label="更多演示操作" Actions="CounterActions" />
        <p aria-live="polite">本页操作次数：@ActivationCount</p>
        <Button Disabled="true">不可用操作</Button>
        <Button Variant="ButtonVariant.Quiet" Busy="Working" OnClick="WorkAsync">@(Working ? "处理中" : "执行演示任务")</Button>
        @if (Working) { <LoadingState Message="正在执行演示任务…" /> }
    </Section>
    <Section Title="字段与验证">
        <EditForm novalidate OnInvalidSubmit="InvalidSubmit" Model="Demo" OnValidSubmit="ValidateDemo" FormName="controls-example">
            <DataAnnotationsValidator />
            <FormLayout>
                <Field Label="名称" Id="control-name" Required="true" For="@(() => Demo.Name)">
                    <TextBox Id="control-name" @bind-Value="Demo.Name" MaxLength="120" />
                </Field>
                <Field Label="邮箱" Id="control-email" Required="true" For="@(() => Demo.Email)">
                    <TextBox Id="control-email" Type="email" @bind-Value="Demo.Email" />
                </Field>
                <Field Label="分类" Id="control-category" Required="true" For="@(() => Demo.Category)">
                    <SelectBox TValue="string" Id="control-category" Options="Categories" @bind-Value="Demo.Category" />
                </Field>
                <Field Label="联系人" Id="control-contact" Required="true" For="@(() => Demo.Contact)">
                    <TextBox Id="control-contact" @bind-Value="Demo.Contact" />
                </Field>
                <CheckBox Label="独立选择" Id="control-checked" @bind-Value="Demo.Active" />
                <ToggleSwitch Label="显示辅助区域" @bind-Value="ShowOptional" />
            </FormLayout>
            <FormActions Columns="1"><Button Type="submit">检查输入</Button></FormActions>
        </EditForm>
        @if (ValidationResult is not null) { <Notice Severity="NotificationSeverity.Success">@ValidationResult</Notice> }
        @if (ShowOptional) { <p>这个区域由开关的真实值控制。</p> }
    </Section>
    <Section Title="搜索">
        <SearchBox Label="搜索演示项目" Value="@Query" ValueChanged="QueryChanged" SearchChanged="QueryChanged" />
        <p role="status">@(string.IsNullOrWhiteSpace(Query) ? "输入文字检查搜索事件。" : $"收到查询：{Query}")</p>
    </Section>
    <Section Title="数值与进度">
        <ToggleSection Label="显示进度设置" @bind-Value="ShowProgressSettings">
            <FormLayout Columns="1">
                <Field Label="完成比例（0–100）" Id="progress-value">
                    <NumberBox TValue="int" Id="progress-value" @bind-Value="Completion" Min="0" Max="100" Step="5" />
                </Field>
                <ToggleSwitch Label="不确定进度" @bind-Value="Indeterminate" />
                <ToggleSwitch Label="暂停进度环" @bind-Value="ProgressStopped" />
            </FormLayout>
            <UniformGrid Columns="3" NarrowColumns="1" Filled="true">
                <Button Variant="ButtonVariant.Secondary" OnClick="DecreaseProgress">减少 5%</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="IncreaseProgress">增加 5%</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="ResetProgress">恢复 35%</Button>
            </UniformGrid>
        </ToggleSection>
        <ProgressBar Label="演示任务进度" Value="DisplayedProgress" StatusText="@ProgressStatus" />
        <ProgressRing Label="演示任务进度环" Value="DisplayedProgress" StatusText="@RingStatus" Stopped="ProgressStopped" />
        <p>隐藏设置后再展开，输入值和开关选择仍然保留。进度使用 0–100 的显示范围。</p>
    </Section>
    <Section Title="状态反馈">
        <Button Variant="ButtonVariant.Secondary" OnClick="() => SetFeedback(NotificationSeverity.Information)">信息</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => SetFeedback(NotificationSeverity.Success)">成功</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => SetFeedback(NotificationSeverity.Warning)">警告</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => SetFeedback(NotificationSeverity.Error)">错误</Button>
        <Notice Severity="FeedbackSeverity">@FeedbackMessage</Notice>
        <Disclosure Title="展开交互说明"><p>通知、字段错误与加载状态具有各自的可访问语义。键盘可以打开本区域。</p></Disclosure>
    </Section>
    <Section Title="弹层">
        <Button Variant="ButtonVariant.Secondary" OnClick="() => DialogOpen = true">打开对话框</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => SheetOpen = true">打开底部面板</Button>
        <p aria-live="polite">已确认 @ConfirmationCount 次。</p>
    </Section>
    <Section Title="内容组成">
        <Card Title="操作摘要"><p>本页已完成 @ActivationCount 次操作。</p></Card>
        <IdentityCard>
            <dl>
                <div><dt>名称</dt><dd class="f-identity-primary">演示工作区成员</dd></div>
                <div><dt>访问范围</dt><dd>当前组件演示</dd></div>
            </dl>
        </IdentityCard>
    </Section>
    <Section Title="空结果">
        @if (AttachmentAdded) { <Notice Severity="NotificationSeverity.Success">已添加内存中的演示附件条目。</Notice> }
        else { <EmptyState Title="没有演示附件"><Actions><Button Variant="ButtonVariant.Secondary" OnClick="AddAttachment">添加演示附件</Button></Actions></EmptyState> }
    </Section>
    <Section Title="接入字段">
        <CodeBlock Text="@FieldExample" Language="razor" />
    </Section>
</PageBody>
<Dialog Title="确认演示操作" @bind-IsOpen="DialogOpen" CloseLabel="关闭">
    <ChildContent><p>检查 Tab 焦点限制、Escape 关闭和关闭后焦点返回。</p></ChildContent>
    <Actions><Button OnClick="ConfirmDialog">确认</Button><Button Variant="ButtonVariant.Secondary" OnClick="() => DialogOpen = false">取消</Button></Actions>
</Dialog>
<BottomSheet Title="底部面板" @bind-IsOpen="SheetOpen" CloseLabel="关闭">
    <ChildContent><p>底部面板提供独立的内容滚动区域与明确关闭动作。</p></ChildContent>
    <Actions><Button OnClick="ConfirmSheet">确认</Button><Button Variant="ButtonVariant.Secondary" OnClick="() => SheetOpen = false">取消</Button></Actions>
</BottomSheet>

@code {
    private void InvalidSubmit(EditContext _) => ValidationResult = null;
    private int Completion = 35;
    private bool ShowProgressSettings = true, Indeterminate, ProgressStopped;
    private double? DisplayedProgress => Indeterminate ? null : Math.Clamp(Completion, 0, 100);
    private string ProgressStatus => Indeterminate ? "正在处理…" : $"已完成 {Math.Clamp(Completion, 0, 100)}%";
    private string RingStatus => ProgressStopped ? "已暂停演示进度环" : ProgressStatus;
    private void DecreaseProgress() => Completion = Math.Clamp(Completion - 5, 0, 100);
    private void IncreaseProgress() => Completion = Math.Clamp(Completion + 5, 0, 100);
    private void ResetProgress() { Completion = 35; Indeterminate = false; ProgressStopped = false; }
    private int ActivationCount, ConfirmationCount;
    private bool Working, ShowOptional, DialogOpen, SheetOpen, AttachmentAdded;
    private string Query = string.Empty;
    private string? ValidationResult;
    private NotificationSeverity FeedbackSeverity = NotificationSeverity.Information;
    private string FeedbackMessage = "选择一种状态检查真实反馈。";
    private RecordDraft Demo = new() { Name = "演示名称", Email = "demo@example.com", Category = "客户", Contact = "演示联系人", Active = true };
    private static readonly IReadOnlyList<SelectOption<string>> Categories =
    [ new("", "请选择"), new("客户", "客户"), new("供应商", "供应商"), new("内部部门", "内部部门") ];
    private const string FieldExample = """
        <EditForm Model="Draft" OnValidSubmit="SaveAsync" FormName="my-form" novalidate>
            <DataAnnotationsValidator />
            <FormLayout>
                <Field Label="名称" Id="name" Required="true" For="@(() => Draft.Name)">
                    <TextBox Id="name" @bind-Value="Draft.Name" />
                </Field>
            </FormLayout>
            <FormActions>
                <Button Type="submit" Busy="Saving">保存</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="Cancel">取消</Button>
            </FormActions>
        </EditForm>
        """;
    private IReadOnlyList<MenuAction> CounterActions =>
    [
        new("增加计数", () => { Increment(); return Task.CompletedTask; }),
        new("不可用操作", () => Task.CompletedTask, Disabled: true),
        new("清除计数", () => { Reset(); return Task.CompletedTask; }, Destructive: true)
    ];
    private void Increment() => ActivationCount++;
    private void Reset() => ActivationCount = 0;
    private async Task WorkAsync()
    {
        if (Working) return;
        Working = true;
        try { await Task.Delay(600); ActivationCount++; }
        finally { Working = false; }
    }
    private void ValidateDemo() => ValidationResult = "这些演示字段通过了数据注解验证。";
    private void QueryChanged(string value) => Query = value;
    private void SetFeedback(NotificationSeverity severity)
    {
        FeedbackSeverity = severity;
        FeedbackMessage = severity switch { NotificationSeverity.Success => "演示操作完成。", NotificationSeverity.Warning => "演示操作需要注意。",
            NotificationSeverity.Error => "演示操作失败，输入仍然保留。", _ => "这是一次新的演示状态更新。" };
    }
    private void ConfirmDialog() { ConfirmationCount++; DialogOpen = false; }
    private void ConfirmSheet() { ConfirmationCount++; SheetOpen = false; }
    private void AddAttachment() => AttachmentAdded = true;
}
