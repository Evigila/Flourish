@page "/"
@inject RecordStore Store
<PageTitle>概览 · 组件演示</PageTitle>
<PageBody>
    <PageHeading Title="概览" />
    <Notice Subtle="true" Announce="false">演示数据仅存于当前连接；重新连接后重置。</Notice>
    <Section Title="记录">
        <FactList>
            <div><dt>演示记录</dt><dd>@Store.Records.Count</dd></div>
            <div><dt>已启用</dt><dd>@Store.Records.Count(record => record.Status == "启用")</dd></div>
        </FactList>
    </Section>
    <Section Title="快捷入口">
        <ul>
            <li><a href="/records">列表</a></li>
            <li><a href="/forms">创建记录</a></li>
            <li><a href="/records/sample">记录详情</a></li>
            <li><a href="/controls">控件</a></li>
            <li><a href="/appearance">样式与接入</a></li>
        </ul>
    </Section>
</PageBody>