@inherits LayoutComponentBase
@using ArkheideSystem.Flourish.Blazor.Components.Patterns
@using ArkheideSystem.Flourish.Blazor.Components.Primitives
<ThemeScope>
    <NavigationSurface DocumentKey="@Navigation.Uri" PrimaryLabel="Modules" SecondaryLabel="Pages">
        <TitleBar>
            <ShellHeader HomeHref="/" HomeAriaLabel="Gallery home" LogoPath="gallery.svg" BrandName="Gallery" IdentityName="Demo">
                <Services><ServiceMenu Label="Gallery" Items="serviceLinks" /></Services>
            </ShellHeader>
        </TitleBar>
        <PrimaryNavigation>
            <PrimaryNavigationItem Id="preview-home" Label="Gallery" Icon="home" Href="/" Match="NavLinkMatch.All" />
            <PrimaryNavigationItem Id="preview-records" Label="Records" Icon="boxes" Href="/patterns" />
            <PrimaryNavigationItem Id="preview-finance" Label="Example module" Icon="document" Disabled="true" DisabledMessage="Disabled example" />
        </PrimaryNavigation>
        <SecondaryNavigation>
            <NavLink class="secondary-nav-item" href="/patterns">Surface patterns</NavLink>
            <NavLink class="secondary-nav-item" href="/forms">Forms</NavLink>
            <NavLink class="secondary-nav-item" href="/controls">Controls</NavLink>
        </SecondaryNavigation>
        <ChildContent>@Body</ChildContent>
    </NavigationSurface>
</ThemeScope>
@inject NavigationManager Navigation
@code { private static readonly IReadOnlyList<ServiceLink> serviceLinks = [new("Home", "/"), new("Appearance", "/appearance"), new("Controls", "/controls")]; }
