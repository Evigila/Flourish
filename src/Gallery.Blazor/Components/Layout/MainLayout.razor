@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IAppearanceService Appearance

<ApplicationShell MenuLabel="打开导航" CloseMenuLabel="关闭导航"
                  MainNavigationLabel="工作区模块" SecondaryNavigationLabel="模块页面" SkipLabel="跳到正文">
    <TitleBarBrand><Icon Name="home" /></TitleBarBrand>
    <TitleBarStart>
        <ActionMenu Label="页面入口" Actions="PageActions">
            <TriggerContent>页面 <span aria-hidden="true">▾</span></TriggerContent>
        </ActionMenu>
    </TitleBarStart>
    <TitleBarEnd>
        <Button Variant="ButtonVariant.Quiet" IconOnly="true" OnClick="ToggleTheme" aria-label="切换浅色或深色主题" title="切换主题">
            <Icon Name="palette" />
        </Button>
    </TitleBarEnd>
    <ChildContent>@Body</ChildContent>
</ApplicationShell>

@code {
    private IReadOnlyList<MenuAction> PageActions => [
        new("演示记录", () => { Navigation.NavigateTo("/records"); return Task.CompletedTask; }),
        new("公共控件", () => { Navigation.NavigateTo("/controls"); return Task.CompletedTask; }),
        new("外观与接入", () => { Navigation.NavigateTo("/appearance"); return Task.CompletedTask; })];
    private void ToggleTheme() => Appearance.SetTheme(Appearance.Current.Theme == ApplicationTheme.Dark
        ? ApplicationTheme.Light : ApplicationTheme.Dark);
}
