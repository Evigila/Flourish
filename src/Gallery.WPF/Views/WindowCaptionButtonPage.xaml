<Page
  x:Class="ArkheideSystem.Gallery.WPF.Views.WindowCaptionButtonPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:culture="clr-namespace:ArkheideSystem.Essential.Culture"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="{culture:Localize Key=Controls_ADedicatedTitleBarActionWithCaptionGeometryAndWindowInteractionS_99BF0EA9}"
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="WindowCaptionButton"
    />

    <flourish:Chunk Title="Variant">
      <flourish:Presenter
        Content="{culture:Localize Key=Controls_UseTextForOrdinaryCaptionCommandsAndReserveDangerForTheCloseComm_CAE8A103}"
        PresenterMode="Split"
        PresenterPosition="Left"
        Title="{culture:Localize Key=Controls_CaptionSemantics_6928015C}"
      >
        <flourish:Presenter.Presentation>
          <Grid
            Width="320"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource FlourishNeutralBackground1Brush}"
          >
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Orientation="Horizontal"
            >
              <flourish:WindowCaptionButton AutomationProperties.Name="{culture:Localize Key=Controls_Minimize_D72E311C}" Icon="&#xE921;" ToolTip="{culture:Localize Key=Controls_Minimize_D72E311C}" Variant="Text" />
              <flourish:WindowCaptionButton AutomationProperties.Name="{culture:Localize Key=Controls_Maximize_FBA6C2C5}" Icon="&#xE922;" ToolTip="{culture:Localize Key=Controls_Maximize_FBA6C2C5}" Variant="Text" />
              <flourish:WindowCaptionButton AutomationProperties.Name="{culture:Localize Key=Controls_Close_7D9EB7AC}" Icon="&#xE8BB;" ToolTip="{culture:Localize Key=Controls_Close_7D9EB7AC}" Variant="Danger" />
            </StackPanel>
          </Grid>
        </flourish:Presenter.Presentation>
      </flourish:Presenter>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Table_16D1C905}">
      <flourish:DataGrid
        x:Name="PropertiesGrid"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        CanUserReorderColumns="False"
        FontWeight="Regular"
        IsReadOnly="True"
      >
        <flourish:DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="{culture:Localize Key=Controls_PROPERTY_638D02E6}" Width="220" />
          <DataGridTextColumn Binding="{culture:Localize KeyBinding={Binding DescriptionKey}}" Header="{culture:Localize Key=Controls_PURPOSE_D31A37AD}" Width="*" />
        </flourish:DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_CaptionGeometry_F705FE33}">
      <flourish:Card Content="{culture:Localize Key=Controls_WindowCaptionButtonIsSizedForTheTitleBarAndKeepsTheCaptionHitTar_C277C7B9}" />
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_InteractionContract_BCA9C747}">
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Title="{culture:Localize Key=Controls_WindowControls_9CEA69FD}"
          Content="{culture:Localize Key=Controls_MinimizeMaximizeAndRestoreChangeTheWindowStateWithoutDiscardingW_DF87D21D}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <Grid
              Width="200"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
              >
                <flourish:WindowCaptionButton
                  AutomationProperties.Name="{culture:Localize Key=Controls_Minimize_D72E311C}"
                  Icon="&#xE921;"
                  ToolTip="{culture:Localize Key=Controls_Minimize_D72E311C}"
                  Variant="Text"
                />
                <flourish:WindowCaptionButton
                  AutomationProperties.Name="{culture:Localize Key=Controls_Maximize_FBA6C2C5}"
                  Icon="&#xE922;"
                  ToolTip="{culture:Localize Key=Controls_Maximize_FBA6C2C5}"
                  Variant="Text"
                />
                <flourish:WindowCaptionButton
                  AutomationProperties.Name="{culture:Localize Key=Controls_Restore_A76E13B9}"
                  Icon="&#xE923;"
                  ToolTip="{culture:Localize Key=Controls_Restore_A76E13B9}"
                  Variant="Text"
                />
              </StackPanel>
            </Grid>
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Title="{culture:Localize Key=Controls_CloseAction_E312EBE7}"
          Content="{culture:Localize Key=Controls_ClosingCanEndTheCurrentSessionOrDiscardUnsavedWorkUseTheDangerVa_9B7343DB}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:WindowCaptionButton
              Width="48"
              Height="32"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              AutomationProperties.Name="{culture:Localize Key=Controls_Close_7D9EB7AC}"
              Icon="&#xE8BB;"
              ToolTip="{culture:Localize Key=Controls_Close_7D9EB7AC}"
              Variant="Danger"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Usage_8D59829C}">
      <StackPanel>
        <flourish:Presenter
          Title="{culture:Localize Key=Controls_BindCaptionCommands_DC880523}"
          Content="{culture:Localize Key=Controls_UseWindowCaptionButtonOnlyInTheTitleBarAndBindItToASystemCommand_5E0921E9}"
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:WindowCaptionButton&#xA;  AutomationProperties.Name=&quot;Close&quot;&#xA;  Command=&quot;{x:Static SystemCommands.CloseWindowCommand}&quot;&#xA;  Icon=&quot;&amp;#xE8BB;&quot;&#xA;  ToolTip=&quot;Close&quot;&#xA;  Variant=&quot;Danger&quot; /&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Reference_71BF9093}">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          AutomationProperties.Name="{culture:Localize Key=Controls_FlourishGitHubRepository_52730F6E}"
          Content="{culture:Localize Key=Controls_RepositoryLinkPlaceholder_ACCB5690}"
          Icon="&#xE943;"
          IsEnabled="False"
          Title="{culture:Localize Key=Controls_GitHubRepository_50555492}"
          ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}"
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          AutomationProperties.Name="{culture:Localize Key=Controls_WindowCaptionButtonDocumentation_0D35F729}"
          Content="{culture:Localize Key=Controls_CanonicalDocumentationLinkPlaceholder_90AB4F65}"
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="{culture:Localize Key=Controls_WindowCaptionButtonDocumentation_0D35F729}"
          ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}"
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
