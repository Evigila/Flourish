<Page
  x:Class="ArkheideSystem.Gallery.WPF.Views.ChunkPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:culture="clr-namespace:ArkheideSystem.Essential.Culture"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="{culture:Localize Key=Controls_GroupOnePageTopicIntoAFullWidthSection_08AD89D7}"
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="Chunk"
    />

    <flourish:Chunk Title="{culture:Localize Key=Controls_Table_16D1C905}">
      <flourish:DataGrid
        ItemsSource="{Binding Properties, ElementName=RootPage}"
        AutoGenerateColumns="False"
        IsReadOnly="True"
      >
        <DataGrid.Columns>
          <DataGridTextColumn Width="220" Binding="{Binding Name}" Header="{culture:Localize Key=Controls_Property_40040CB1}" />
          <DataGridTextColumn Width="*" Binding="{culture:Localize KeyBinding={Binding DescriptionKey}}" Header="{culture:Localize Key=Controls_Purpose_D4E8830A}" />
        </DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <!--<flourish:Chunk Title="{culture:Localize Key=Controls_Example_D029F87E}">
      <UniformGrid Columns="2">
        <flourish:Card
          Margin="0,0,8,0"
          Icon="&#xE8A5;"
          Content="Shows one topic in a full-width Chunk."
          Title="Content surface"
        />
        <flourish:Card
          Margin="8,0,0,0"
          Content="Group only closely related content."
          Title="Custom body"
        />
      </UniformGrid>
    </flourish:Chunk>-->

    <!--<flourish:Chunk Title="Content">
      <flourish:Card Content="Title names the topic, Content adds optional context, and Body contains the required section content. Empty optional copy collapses with its spacing." />
    </flourish:Chunk>-->

    <flourish:Chunk Title="{culture:Localize Key=Controls_Usage_8D59829C}">
      <StackPanel>
        <flourish:Presenter
          Title="{culture:Localize Key=Controls_CreateAPageSection_4F196611}"
          Content="{culture:Localize Key=Controls_DeclareChunkDirectlyUnderPageBodyGiveItAConciseTitleAndPlaceTheS_27E63969}"
          PresenterMode="Split"
          PresenterPosition="Left"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:Chunk&#xA;  Title=&quot;Recent reports&quot;&#xA;  Content=&quot;Review reports generated by the current workspace.&quot;&gt;&#xA;  &lt;flourish:Card&#xA;    Title=&quot;Quarterly report&quot;&#xA;    Content=&quot;Ready to review.&quot; /&gt;&#xA;&lt;/flourish:Chunk&gt;" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Reference_71BF9093}">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          Content="{culture:Localize Key=Controls_BrowseTheFlourishSourceRepository_5CC28F39}"
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="{culture:Localize Key=Controls_GitHubRepository_50555492}"
          ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}"
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          Content="{culture:Localize Key=Controls_ReadTheChunkGuide_71E29FEB}"
          Icon="&#xE946;"
          IsEnabled="False"
          Title="{culture:Localize Key=Controls_ChunkDocumentation_FE325A53}"
          ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}"
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
