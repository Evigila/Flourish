<Page
  x:Class="ArkheideSystem.Gallery.WPF.Views.ProfileConfigurationPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:culture="clr-namespace:ArkheideSystem.Essential.Culture"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Title="{culture:Localize Key=Application_Profile_D696A35B}"
      Content="{culture:Localize Key=Shell_ChooseThePageHostedByTheTitleBarProfileFlyout_F41ECA04}"
      PresenterMode="Split"
      PresenterPosition="Right"
    />

    <flourish:Chunk
      Title="{culture:Localize Key=Shell_ProfilePage_AF8EC386}"
      Content="{culture:Localize Key=Shell_ChooseThePageResolvedThroughDependencyInjectionWhenTheTitleBarPr_02EBE78E}"
    >
      <StackPanel>
        <flourish:Card
          Icon="&#xE77B;"
          Title="{culture:Localize Key=Shell_DependencyInjectedContent_D8E54D22}"
          Content="{culture:Localize Key=Shell_RegisterThePageWithTheServiceContainerSoItsConstructorDependenci_25A4551B}"
        />
        <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="// Enable the title-bar trigger, then select its hosted page.&#10;builder.ConfigureTitleBar(titleBar =&gt;&#10;    titleBar&#10;        .SetProfile(nameOrder: NameOrder.FirstLast)&#10;        .SetProfilePage&lt;AccountPage&gt;());" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk
      Title="{culture:Localize Key=Shell_NameOrder_15B7537D}"
      Content="{culture:Localize Key=Shell_ChangeTheApplicationWideDisplayOrderUsedByTheSignedOutPlaceholde_8FFD7F5E}"
    >
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <flourish:ActionCard
              Icon="&#xE8D2;"
              Title="{culture:Localize Key=Shell_FirstNameFirst_CCA39506}"
              Content="{culture:Localize Key=Shell_DisplayTheGivenNameBeforeTheFamilyName_1B0BCAFC}"
            >
              <flourish:ActionCard.Body>
                <flourish:Button Click="FirstLast_Click" Content="{culture:Localize Key=Shell_FirstLast_1F4F7841}" />
              </flourish:ActionCard.Body>
            </flourish:ActionCard>
            <flourish:ActionCard
              Margin="{DynamicResource FlourishActionCardPeerMargin}"
              Icon="&#xE8D2;"
              Title="{culture:Localize Key=Shell_LastNameFirst_034D9C7C}"
              Content="{culture:Localize Key=Shell_DisplayTheFamilyNameBeforeTheGivenName_4313096A}"
            >
              <flourish:ActionCard.Body>
                <flourish:Button Click="LastFirst_Click" Content="{culture:Localize Key=Shell_LastFirst_3025E73F}" />
              </flourish:ActionCard.Body>
            </flourish:ActionCard>
          </StackPanel>
          <flourish:OutputCard
            x:Name="ProfileOutput"
            Grid.Column="1"
            Margin="8,0,0,0"
            VerticalAlignment="Stretch"
          />
        </Grid>
        <flourish:CodeSpace Margin="{DynamicResource FlourishCodeSpacePeerMargin}" Text="// Change the global profile presentation without signing out.&#10;await profile.SetNameOrderAsync(NameOrder.LastFirst);&#10;var state = profile.Current;&#10;profile.Changed += OnProfileChanged;" />
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Reference_71BF9093}">
      <UniformGrid Columns="2">
        <flourish:CardButton Margin="0,0,8,0" Content="{culture:Localize Key=Controls_BrowseTheFlourishSourceRepository_5CC28F39}" Icon="&#xE943;" IsEnabled="False" Title="{culture:Localize Key=Controls_GitHubRepository_50555492}" ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}" />
        <flourish:CardButton Margin="8,0,0,0" Content="{culture:Localize Key=Shell_ReadTheCanonicalFlourishDocumentation_7BB05CDB}" Icon="&#xE946;" IsEnabled="False" Title="{culture:Localize Key=Shell_FlourishDocumentation_A1D1605B}" ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}" />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
