<Page
  x:Class="ArkheideSystem.Gallery.WPF.Views.TextBoxPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:culture="clr-namespace:ArkheideSystem.Essential.Culture"
  xmlns:flourish="http://schemas.arkheide.system/flourish"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
>
  <flourish:PageBody>
    <flourish:HeaderChunk
      Content="{culture:Localize Key=Controls_CollectAndEditASingleValueOrASmallBlockOfTextWithTheNativeWPFTex_214CC14B}"
      PresenterMode="Split"
      PresenterPosition="Right"
      Title="TextBox"
    />

    <flourish:Chunk Title="{culture:Localize Key=Controls_Table_16D1C905}">
      <flourish:DataGrid
        x:Name="MemberGrid"
        AutoGenerateColumns="False"
        IsReadOnly="True"
      >
        <flourish:DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="{culture:Localize Key=Controls_Member_7C968FB7}" Width="220" />
          <DataGridTextColumn Binding="{culture:Localize KeyBinding={Binding DescriptionKey}}" Header="{culture:Localize Key=Controls_Purpose_D4E8830A}" Width="*" />
        </flourish:DataGrid.Columns>
      </flourish:DataGrid>
    </flourish:Chunk>

    <flourish:Chunk
      Content="{culture:Localize Key=Controls_UseTheNativeTextBoxPropertiesToSelectSingleLineReadOnlyOrMultili_F8FF545F}"
      Title="{culture:Localize Key=Controls_Editing_FAB4539D}"
    >
      <UniformGrid Columns="2">
        <flourish:Presenter
          Margin="0,0,8,0"
          Content="{culture:Localize Key=Controls_TextUpdatesThroughTheRegularWPFBindingAndTextChangedContracts_B1BABA40}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_SingleLine_D66572A5}"
        >
          <flourish:Presenter.Presentation>
            <flourish:TextBox
              Width="240"
              Height="40"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Text="Editable text"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="8,0,0,0"
          Content="{culture:Localize Key=Controls_AcceptsReturnAndTextWrappingCreateABoundedMultilineEditor_DE62A053}"
          PresenterMode="TopDown"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_Multiline_D3FD4F92}"
        >
          <flourish:Presenter.Presentation>
            <flourish:TextBox
              Width="240"
              Height="80"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              AcceptsReturn="True"
              Text="First line&#x0a;Second line"
              TextWrapping="Wrap"
            />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </UniformGrid>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Usage_8D59829C}">
      <StackPanel>
        <flourish:Presenter
          Content="{culture:Localize Key=Controls_BindTextInTwoWayModeWhenTheValueBelongsToAViewModelAndChooseProp_61CCCFF7}"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_BoundValue_CA1F3FD0}"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="{Binding UsageCode, ElementName=RootPage}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
        <flourish:Presenter
          Margin="{DynamicResource FlourishPresenterPeerMargin}"
          Content="{culture:Localize Key=Controls_HandleTextChangedWhenEachEditMustTriggerViewOwnedBehaviorThatIsN_7963AEB1}"
          PresenterMode="Split"
          PresenterPosition="Left"
          Title="{culture:Localize Key=Controls_EditNotifications_F44B9B2A}"
        >
          <flourish:Presenter.Presentation>
            <flourish:CodeSpace CanCollapse="False" IsExpanded="True" Text="&lt;flourish:TextBox&#xA;  x:Name=&quot;NotesBox&quot;&#xA;  Height=&quot;96&quot;&#xA;  AcceptsReturn=&quot;True&quot;&#xA;  TextWrapping=&quot;Wrap&quot;&#xA;  TextChanged=&quot;NotesBox_TextChanged&quot; /&gt;&#xA;&#xA;private void NotesBox_TextChanged(object sender, TextChangedEventArgs e)&#xA;{&#xA;    CharacterCount.Text = NotesBox.Text.Length.ToString();&#xA;}" />
          </flourish:Presenter.Presentation>
        </flourish:Presenter>
      </StackPanel>
    </flourish:Chunk>

    <flourish:Chunk Title="{culture:Localize Key=Controls_Reference_71BF9093}">
      <UniformGrid Columns="2">
        <flourish:CardButton
          Margin="0,0,8,0"
          Content="{culture:Localize Key=Controls_BrowseTheFlourishSourceRepository_5CC28F39}"
          Icon="&#xE943;"
          IsEnabled="False"
          Title="{culture:Localize Key=Controls_GitHubRepository_50555492}"
          ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}"
        />
        <flourish:CardButton
          Margin="8,0,0,0"
          Content="{culture:Localize Key=Controls_ReadTheTextBoxAPIReference_EA748C36}"
          Icon="&#xE8A5;"
          IsEnabled="False"
          Title="{culture:Localize Key=Controls_TextBoxDocumentation_07D8D1EF}"
          ToolTip="{culture:Localize Key=Controls_ExternalNavigationIsNotAvailableInGallery_E2F1482A}"
        />
      </UniformGrid>
    </flourish:Chunk>
  </flourish:PageBody>
</Page>
