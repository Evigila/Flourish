@inherits LayoutComponentBase
@implements IDisposable
@inject IServiceProvider Services

<HeadContent>
    <link rel="icon" href="gallery-favicon.svg" />
    <link rel="stylesheet" href="_content/Arkheide.Flourish.Blazor.Framework/framework.css" />
    @if (Theme is not null)
    {
        <link rel="stylesheet" href="@Theme.StylesheetHref" />
    }
</HeadContent>
@* Host resource/theme glue only: the routed AccessSurface owns the document's sole main landmark. *@
<div class="f-root @Theme?.CssClass" style="@Theme?.CssVariables">@Body</div>

@code {
    private IThemeProvider? Theme;
    protected override void OnInitialized()
    {
        Theme = Services.GetService(typeof(IThemeProvider)) as IThemeProvider;
        if (Theme is not null) Theme.Changed += ThemeChanged;
    }
    private void ThemeChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { if (Theme is not null) Theme.Changed -= ThemeChanged; }
}
