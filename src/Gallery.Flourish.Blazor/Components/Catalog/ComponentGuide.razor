@using ArkheideSystem.Gallery.Flourish.Blazor.Models
@inherits LocalizedComponentBase
@inject ITextProvider Texts
<article class="component-guide" id="@Sample.Key" data-component="@Entry.Name" data-component-use="@Entry.Usage.Kind">
    <Section Title="@Localization.Parse("Key.Guide_Intro")">
        <p><strong>@UseLabel</strong> · @Texts.Get(Entry.Usage.Scenario)</p>
        @foreach (var paragraph in Paragraphs(Texts.Get(Entry.Usage.Guidance))) { <p>@paragraph</p> }
        @if (PreferredEntry is { } preferred)
        {
            <p>@Localization.Parse("Key.Guide_PreferredEntry") <Button Variant="ButtonVariant.Underline" Href="@CatalogSections.ComponentHref(preferred)">@preferred.Name</Button></p>
        }
        @foreach (var paragraph in Paragraphs(Localization.Parse(Entry.PurposeKey))) { <p>@paragraph</p> }
        @foreach (var paragraph in Paragraphs(Localization.Parse(Entry.VariantsKey))) { <p>@paragraph</p> }
    </Section>
    <Section Title="@Localization.Parse("Key.Guide_ControlExample")">
        <DisplayBoard><DynamicComponent Type="@Sample.ComponentType" Parameters="@Sample.PreviewParameters" /></DisplayBoard>
    </Section>
    <Section Title="@Localization.Parse("Key.Guide_Api")">
        <p>@Localization.Parse("Key.Guide_Namespace", Entry.Namespace)</p>
        <DisplayBoard Dotted="false" Centered="false" CopyText="@Entry.Example">
            <CodeBlock Text="@Entry.Example" Language="razor" />
        </DisplayBoard>
        <div class="api-parameters"><DataTable TItem="ComponentParameter" Items="Entry.ApiParameters" Columns="ApiColumns"
                   ItemKey="@(parameter => parameter.Name)" RowLabel="@(parameter => parameter.Name)"
                   Label="@Localization.Parse("Key.Guide_ApiLabel", Entry.Name)" Searchable="false"
                   EmptyMessage="@Localization.Parse("Key.Guide_ApiEmpty")" /></div>
    </Section>
    <Section Title="@Localization.Parse("Key.Guide_ScenarioExample")">
        @if (Sample.DescriptionKey is { } descriptionKey)
        {
            @foreach (var paragraph in Paragraphs(Localization.Parse(descriptionKey))) { <p>@paragraph</p> }
        }
        <DisplayBoard><DynamicComponent Type="@Sample.ComponentType" /></DisplayBoard>
    </Section>
    <Section Title="@Localization.Parse("Key.Guide_ScenarioCode")">
        <DisplayBoard Dotted="false" Centered="false" CopyText="@Sample.Source">
            <CodeBlock Text="@Sample.Source" Language="razor" />
        </DisplayBoard>
    </Section>
</article>
@code {
    [Parameter, EditorRequired] public ComponentEntry Entry { get; set; } = default!;
    [Parameter] public string Category { get; set; } = "actions";
    [Parameter] public bool ShowDetailLink { get; set; } = true;
    private ComponentSample Sample => SampleCatalog.For(Entry);
    private ComponentEntry? PreferredEntry => Entry.Usage.PreferredEntry is { } preferred
        ? ComponentCatalog.Groups.SelectMany(group => group.Entries).FirstOrDefault(entry => entry.ComponentType == preferred) : null;
    private string UseLabel => Localization.Parse(Entry.Usage.Kind switch
    {
        ComponentUseKind.General => "Key.Guide_UseGeneral",
        ComponentUseKind.Scenario => "Key.Guide_UseScenario",
        _ => "Key.Guide_UseBuildingBlock"
    });
    // Resolve captions and values in this scope on every render; catalog metadata stores only keys.
    private IReadOnlyList<TableColumn<ComponentParameter>> ApiColumns =>
    [
        new("name", Localization.Parse("Key.Guide_Parameter"), parameter => parameter.Name, CanHide: false),
        new("type", Localization.Parse("Key.Guide_Type"), parameter => parameter.Type),
        new("default", Localization.Parse("Key.Guide_Default"), parameter => parameter.DefaultValue),
        new("required", Localization.Parse("Key.Guide_Requirement"), parameter => parameter.Required ? "EditorRequired" : Localization.Parse("Key.Guide_Optional")),
        new("description", Localization.Parse("Key.Guide_Description"), Describe)
    ];
    private string Describe(ComponentParameter parameter) => parameter.DescriptionPrefixKey is { } prefix
        ? Localization.Parse(prefix, parameter.DescriptionOwner) + " " + Localization.Parse(parameter.DescriptionKey)
        : Localization.Parse(parameter.DescriptionKey);
    private static IEnumerable<string> Paragraphs(string text) => text.Split('\n', StringSplitOptions.RemoveEmptyEntries);
}
