@page "/examples/display/wizard"
@inherits LocalizedComponentBase

<PageTitle>@Localization.Parse(TextKey.Nav_DisplayWizard) · Gallery</PageTitle>
<PageBody>
    <PageHeading Title="@Localization.Parse(TextKey.Nav_DisplayWizard)" />
    @if (Step == 0)
    {
        <UniformGrid Columns="2" NarrowColumns="1" aria-label="@Localization.Parse(TextKey.Nav_DisplayWizard)">
            <UniformGridButton Title="@Localization.Parse(TextKey.Wizard_Personal)" Variant="UniformGridVariant.Filled" OnClick="@(() => ChooseUse(false))" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Wizard_Workspace)" Variant="UniformGridVariant.Filled" OnClick="@(() => ChooseUse(true))" />
        </UniformGrid>
    }
    else if (Step == 1)
    {
        <UniformGrid Columns="3" NarrowColumns="1" aria-label="@Localization.Parse(TextKey.Nav_DisplayWizard)">
            <UniformGridButton Title="@Localization.Parse(TextKey.Wizard_Standard)" Variant="UniformGridVariant.Filled" OnClick="@(() => ChoosePlan("Standard"))" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Wizard_Professional)" Variant="UniformGridVariant.Filled" OnClick="@(() => ChoosePlan("Professional"))" Disabled="WorkspaceUse" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Wizard_Back)" Variant="UniformGridVariant.Outlined" OnClick="@(() => Step = 0)" />
        </UniformGrid>
    }
    else
    {
        <UniformGrid Columns="2" NarrowColumns="1" aria-label="@Localization.Parse(TextKey.Nav_DisplayWizard)">
            <UniformGridButton Title="@($"{Localization.Parse(WorkspaceUse ? TextKey.Wizard_Workspace : TextKey.Wizard_Personal)} · {PlanLabel}")" Disabled="true" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Wizard_Restart)" Variant="UniformGridVariant.Outlined" OnClick="Restart" />
        </UniformGrid>
    }
</PageBody>

@code {
    // Fictitious choices stay in this Gallery instance; no purchase or provisioning occurs.
    private int Step;
    private bool WorkspaceUse;
    private string Plan = string.Empty;
    private string PlanLabel => Plan == "Standard" ? Localization.Parse(TextKey.Wizard_Standard) : Plan == "Professional" ? Localization.Parse(TextKey.Wizard_Professional) : string.Empty;

    private void ChooseUse(bool workspace)
    {
        WorkspaceUse = workspace;
        Plan = string.Empty;
        Step = 1;
    }
    private void ChoosePlan(string plan) { Plan = plan; Step = 2; }
    private void Restart() { Plan = string.Empty; Step = 0; }
}
