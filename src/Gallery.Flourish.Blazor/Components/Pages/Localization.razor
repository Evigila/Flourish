@page "/framework/localization"
@inherits LocalizedComponentBase

<PageTitle>@Localization.Parse(TextKey.Nav_Localization) · Gallery</PageTitle>
<PageBody>
    <PageHeading Title="@Localization.Parse(TextKey.Nav_Localization)" />
    <Section Title="@Localization.Parse(TextKey.Localization_IntroTitle)">
        @foreach (var paragraph in Localization.Parse(TextKey.Localization_Introduction).Split('\n')) { <p>@paragraph</p> }
        @foreach (var paragraph in Localization.Parse(TextKey.Localization_Scope).Split('\n')) { <p>@paragraph</p> }
    </Section>
    <Section Title="@Localization.Parse(TextKey.Localization_Sample)">
        <DisplayBoard>
            <LanguagePicker MaxWidth="16rem" />
            <Button Text="@Localization.Parse(TextKey.Show_Dialog)" OnClick="@(_ => open = true)" />
        </DisplayBoard>
        <Dialog Title="@Localization.Parse(TextKey.Dialog_Title)" @bind-IsOpen="open">
            <p>@Localization.Parse(TextKey.Dialog_Body)</p>
        </Dialog>
    </Section>
    <Section Title="@Localization.Parse(TextKey.Localization_API)">
        <DisplayBoard Dotted="false" Centered="false" CopyText="@Registration"><CodeBlock Text="@Registration" Language="csharp" /></DisplayBoard>
    </Section>
    <Section Title="@Localization.Parse(TextKey.Localization_Scenario)">
        <DisplayBoard>
            <Field Id="localization-format" Label="@Localization.Parse(TextKey.Format)" style="width:20rem;max-width:100%">
                <LanguagePicker FormatCulture="true" />
            </Field>
            <p>@Localization.Parse(TextKey.Formatted_Sample, arguments)</p>
        </DisplayBoard>
        <DataTable TItem="SampleRecord" Items="@records" Columns="@Columns" />
    </Section>
    <Section Title="@Localization.Parse(TextKey.Localization_Code)">
        <DisplayBoard Dotted="false" Centered="false" CopyText="@Scenario"><CodeBlock Text="@Scenario" Language="razor" /></DisplayBoard>
    </Section>
</PageBody>

@code {
    private bool open;
    private readonly object?[] arguments = [12345.67m, new DateTime(2026, 10, 5)];
    private readonly IReadOnlyList<SampleRecord> records = [new(12345.67m)];
    private IReadOnlyList<TableColumn<SampleRecord>> Columns =>
        [new("name", Localization.Parse(TextKey.Record_Name), _ => Localization.Parse(TextKey.Record_One)),
         new("amount", Localization.Parse(TextKey.Amount), row => row.Amount)];
    private sealed record SampleRecord(decimal Amount);
    private const string Registration = """
        using ArkheideSystem.Flourish.Extensions.Culture.Blazor;
        builder.Services.AddFlourishFramework(builder.Configuration, framework => framework
            .ConfigureCulture(culture => culture
                .AddCatalog<Program>("App", "App.Texts.json")
                .SetDefaultCatalog("App"))
            .ConfigureNavigation(nav => nav.AddNav(
                new TextReference("App", TextKey.Nav_Home, "主页"), "home", "/", exact: true)));
        builder.Services.AddFlourishDesign(builder.Configuration);
        """;
    private const string Scenario = """
        @inherits LocalizedComponentBase
        <LanguagePicker />
        <LanguagePicker FormatCulture="true" />
        <p>@Localization.Parse(TextKey.Formatted_Sample, arguments)</p>
        @code {
            private readonly object?[] arguments = [12345.67m, new DateTime(2026, 10, 5)];
            private async Task<bool> UseChineseWithBrazilianFormats()
            {
                return await Localization.SelectAsync("zh-CN", "pt-BR");
            }
        }
        """;
}
