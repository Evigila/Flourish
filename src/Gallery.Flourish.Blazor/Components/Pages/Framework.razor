@page "/framework"
@page "/framework/{Topic}"
@inherits LocalizedComponentBase
<PageTitle>@Title · Gallery</PageTitle>
<PageBody>
    <PageHeading Title="@Title" />
    @if (TopicKey == "start")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_GetStarted)">
        <p>@Localization.Parse(TextKey.Framework_StartFramework)<br />@Localization.Parse(TextKey.Framework_StartDesign)</p>
        <DisplayBoard Dotted="false" Centered="false" CopyText="@Startup" CopyLabel="@Localization.Parse(TextKey.Common_CopyCode)" CopiedLabel="@Localization.Parse(TextKey.Common_Copied)" CopyingLabel="@Localization.Parse(TextKey.Common_Copying)" CopyFailedLabel="@Localization.Parse(TextKey.Common_CopyFailed)"><CodeBlock Text="@Startup" Language="csharp" /></DisplayBoard>
        <p>@Localization.Parse(TextKey.Framework_HostRouter)<br />@Localization.Parse(TextKey.Framework_HostConfiguration)</p>
        <DisplayBoard Dotted="false" Centered="false" CopyText="@Host" CopyLabel="@Localization.Parse(TextKey.Common_CopyCode)" CopiedLabel="@Localization.Parse(TextKey.Common_Copied)" CopyingLabel="@Localization.Parse(TextKey.Common_Copying)" CopyFailedLabel="@Localization.Parse(TextKey.Common_CopyFailed)"><CodeBlock Text="@Host" Language="razor" /></DisplayBoard>
    </Section>
    }
    @if (TopicKey == "topbar")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_TopBar)">
        <p>@Localization.Parse(TextKey.Framework_ProjectBrand)<br />@Localization.Parse(TextKey.Framework_Favicon)<br />@Localization.Parse(TextKey.Framework_TopVisibility)<br />@Localization.Parse(TextKey.Framework_Menu)<br />@Localization.Parse(TextKey.Framework_Injection)</p>
        <p>@Localization.Parse(TextKey.Framework_IconPaths)<br />@Localization.Parse(TextKey.Framework_StatusComponent)<br />@Localization.Parse(TextKey.Framework_NavigationToggle)</p>
        <DisplayBoard Dotted="false" Centered="false" CopyText="@TopBar" CopyLabel="@Localization.Parse(TextKey.Common_CopyCode)" CopiedLabel="@Localization.Parse(TextKey.Common_Copied)" CopyingLabel="@Localization.Parse(TextKey.Common_Copying)" CopyFailedLabel="@Localization.Parse(TextKey.Common_CopyFailed)"><CodeBlock Text="@TopBar" Language="csharp" /></DisplayBoard>
    </Section>
    }
    @if (TopicKey == "navigation")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_Navigation)">
        <p>@Localization.Parse(TextKey.Framework_AddNav)<br />@Localization.Parse(TextKey.Framework_AddSubNav)<br />@Localization.Parse(TextKey.Framework_NavButton)<br />@Localization.Parse(TextKey.Framework_FixedNav)<br />@Localization.Parse(TextKey.Framework_ButtonChildren)</p>
        <p>@Localization.Parse(TextKey.Framework_NavPaths)<br />@Localization.Parse(TextKey.Framework_RouteSelection)<br />@Localization.Parse(TextKey.Framework_CategoryActions)<br />@Localization.Parse(TextKey.Framework_CategoryState)<br />@Localization.Parse(TextKey.Framework_NavLabels)<br />@Localization.Parse(TextKey.Framework_NavSurface)</p>
        <p>@Localization.Parse(TextKey.Framework_SubNavContract)<br />@Localization.Parse(TextKey.Framework_NavDisabled)<br />@Localization.Parse(TextKey.Framework_ExpansionLifetime)</p>
        <DisplayBoard Dotted="false" Centered="false" CopyText="@Navigation" CopyLabel="@Localization.Parse(TextKey.Common_CopyCode)" CopiedLabel="@Localization.Parse(TextKey.Common_Copied)" CopyingLabel="@Localization.Parse(TextKey.Common_Copying)" CopyFailedLabel="@Localization.Parse(TextKey.Common_CopyFailed)"><CodeBlock Text="@Navigation" Language="csharp" /></DisplayBoard>
    </Section>
    }
    @if (TopicKey == "commands")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_Commands)">
        <p>@Localization.Parse(TextKey.Framework_RegisterCommands)<br />@Localization.Parse(TextKey.Framework_CommandLifetime)<br />@Localization.Parse(TextKey.Framework_CommandUnavailable)</p>
        <DisplayBoard Dotted="false" Centered="false" CopyText="@Commands" CopyLabel="@Localization.Parse(TextKey.Common_CopyCode)" CopiedLabel="@Localization.Parse(TextKey.Common_Copied)" CopyingLabel="@Localization.Parse(TextKey.Common_Copying)" CopyFailedLabel="@Localization.Parse(TextKey.Common_CopyFailed)"><CodeBlock Text="@Commands" Language="csharp" /></DisplayBoard>
    </Section>
    }
    @if (TopicKey == "layout")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_PageLayout)">
        <p>@Localization.Parse(TextKey.Framework_ContentLayout)<br />@Localization.Parse(TextKey.Framework_PageComposition)</p>
        <DisplayBoard Dotted="false" Centered="false" CopyText="@Layout" CopyLabel="@Localization.Parse(TextKey.Common_CopyCode)" CopiedLabel="@Localization.Parse(TextKey.Common_Copied)" CopyingLabel="@Localization.Parse(TextKey.Common_Copying)" CopyFailedLabel="@Localization.Parse(TextKey.Common_CopyFailed)"><CodeBlock Text="@Layout" Language="csharp" /></DisplayBoard>
        <DisplayBoard Dotted="false" Centered="false" CopyText="@Page" CopyLabel="@Localization.Parse(TextKey.Common_CopyCode)" CopiedLabel="@Localization.Parse(TextKey.Common_Copied)" CopyingLabel="@Localization.Parse(TextKey.Common_Copying)" CopyFailedLabel="@Localization.Parse(TextKey.Common_CopyFailed)"><CodeBlock Text="@Page" Language="razor" /></DisplayBoard>
    </Section>
    }
    @if (TopicKey == "interactions")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_Interactions)">
        <UniformGrid>
            <UniformGridItem Title="@Localization.Parse(TextKey.Nav_Navigation)" Icon="navigation" Text="@Localization.Parse(TextKey.Framework_NavigationDescription)" />
            <UniformGridItem Title="@Localization.Parse(TextKey.Framework_Title)" Icon="title" Text="@Localization.Parse(TextKey.Framework_HeadingDescription)" />
            <UniformGridItem Title="@Localization.Parse(TextKey.Framework_Overlays)" Icon="layers" Text="@Localization.Parse(TextKey.Framework_OverlayDescription)" />
            <UniformGridItem Title="@Localization.Parse(TextKey.Framework_Inputs)" Icon="input" Text="@Localization.Parse(TextKey.Framework_InputDescription)" />
            <UniformGridItem Title="@Localization.Parse(TextKey.Framework_Tables)" Icon="table_chart" Text="@Localization.Parse(TextKey.Framework_TableDescription)" />
        </UniformGrid>
        <div class="f-inline-actions">
            <Button Variant="ButtonVariant.Underline" Href="/controls" Text="@Localization.Parse(TextKey.Framework_ControlGuide)" />
            <Button Variant="ButtonVariant.Underline" Href="/examples" Text="@Localization.Parse(TextKey.Framework_RunExamples)" />
            <Button Variant="ButtonVariant.Underline" Href="/foundations" Text="@Localization.Parse(TextKey.Framework_ConfigureTheme)" />
        </div>
    </Section>
    }
    @if (!Topics.ContainsKey(TopicKey))
    {
        <EmptyState Title="@Localization.Parse(TextKey.Common_NoTopic)"><Actions><Button Variant="ButtonVariant.Underline" Href="/framework" Text="@Localization.Parse(TextKey.Common_BackIndex)" /></Actions></EmptyState>
    }
</PageBody>
@code {
    [Parameter] public string? Topic { get; set; }
    public override Task SetParametersAsync(ParameterView parameters)
    {
        Topic = null;
        return base.SetParametersAsync(parameters);
    }
    private string TopicKey => Topic?.ToLowerInvariant() ?? "start";
    private string Title => Localization.Parse(Topics.GetValueOrDefault(TopicKey, TextKey.Page_NotFound));
    private static readonly IReadOnlyDictionary<string, string> Topics = new Dictionary<string, string>
    {
        ["start"] = TextKey.Nav_GetStarted,
        ["topbar"] = TextKey.Nav_TopBar,
        ["navigation"] = TextKey.Nav_Navigation,
        ["commands"] = TextKey.Nav_Commands,
        ["layout"] = TextKey.Nav_PageLayout,
        ["interactions"] = TextKey.Nav_Interactions,
    };

    private const string Startup = """
        using ArkheideSystem.Flourish.Blazor;

        var builder = WebApplication.CreateBuilder(args);
        builder.Services.AddRazorComponents().AddInteractiveServerComponents();
        builder.Services.AddFlourishFramework(framework => framework
            .ConfigureProject(project => project.SetProjectName("My application"))
            .ConfigureTopBar(top => top.DisplayLogo().DisplayProjectName())
            .ConfigureNavigation(nav => nav.AddNav("主页", "home", "/", exact: true)));
        builder.Services.AddFlourishDesign(); // Optional

        var app = builder.Build();
        app.UseAntiforgery();
        app.MapStaticAssets().ShortCircuit();
        app.MapRazorComponents<App>().AddInteractiveServerRenderMode();
        app.Run();
        """;
    private const string Host = """
        <!-- Routes.razor: inside Router's Found fragment -->
        <RouteView RouteData="routeData" DefaultLayout="typeof(ApplicationLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />

        <!-- App.razor: inside the standard head/body -->
        <HeadOutlet @rendermode="InteractiveServer" />
        <Routes @rendermode="InteractiveServer" />
        <script src="_framework/blazor.web.js"></script>
        """;
    private const string TopBar = """
        framework.ConfigureProject(project => project
            .SetProjectName("My application")
            .SetLogo("app.svg")
            .SetFavicon("favicon.svg"))
        .ConfigureTopBar(top => top
            .DisplayLogo()
            .DisplayProjectName()
            .AddMenu("操作", menu => menu
                .AddMenuItem("打开案例", "open-examples")
                .AddMenuItem("暂不可用", "unavailable", disabled: true))
            .InjectToRight<StatusButton>());
        """;
    private const string Navigation = """
        framework.ConfigureNavigation(nav => nav
            .AddNav("主页", "home", "/", exact: true)
            .AddNav("案例", "list", "/examples", sub => sub
                .AddSubNav("表单", "edit", "/forms", third => third
                    .AddSubNav("新建", "add", "/forms/create", exact: true)
                    .AddSubNav("编辑", "edit", "/forms/edit", exact: true), exact: true))
            .AddNavButton("刷新", "search", "refresh")
            .AddFixedNav("设置", "settings", "/settings")
            .AddFixedNavButton("帮助", "description", "help"));
        """;
    private const string Commands = """
        // Program.cs
        framework.SetCommandParser<CommandParser>();

        // CommandParser.cs
        using ArkheideSystem.Flourish.Abstract;
        using Microsoft.AspNetCore.Components;

        public sealed class CommandParser(NavigationManager navigation) : ICommandParser
        {
            public void RegisterCommands(ICommandRegistrar commands)
            {
                commands.Register("open-examples", () => navigation.NavigateTo("/examples"));
            }
        }
        """;
    private const string Layout = """
        framework.ConfigureLayout(layout => layout
            .SetContentWidth(1180)
            .SetFluidContent(true));
        """;
    private const string Page = """
        @page "/example"
        @using ArkheideSystem.Flourish.Blazor.Components

        <PageBody>
            <PageHeading Title="案例" />
            <Section Title="内容">
                <p>页面提供内容和数据。</p>
            </Section>
        </PageBody>
        """;
}
