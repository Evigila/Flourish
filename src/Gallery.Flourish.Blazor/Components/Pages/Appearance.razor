@page "/foundations"
@page "/foundations/{Topic}"
@inherits LocalizedComponentBase
@inject IAppearanceService AppearanceService
<PageTitle>@Title · Gallery</PageTitle>
<PageBody>
    <PageHeading Title="@Title" />
    @if (TopicKey == "colors")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_Theme)">
        <UniformGrid Shape="UniformGridShape.Rectangle" Columns="3" Rows="1">
            <UniformGridButton Title="@Localization.Parse(TextKey.Appearance_System)" Disabled="@(AppearanceService.Current.Theme == ApplicationTheme.System)" OnClick="() => ChangeTheme(ApplicationTheme.System)" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Appearance_Light)" Disabled="@(AppearanceService.Current.Theme == ApplicationTheme.Light)" OnClick="() => ChangeTheme(ApplicationTheme.Light)" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Appearance_Dark)" Disabled="@(AppearanceService.Current.Theme == ApplicationTheme.Dark)" OnClick="() => ChangeTheme(ApplicationTheme.Dark)" />
        </UniformGrid>
        <p role="status">@Localization.Parse(TextKey.Appearance_Selection, ThemeLabel)</p>
    </Section>
    }
    @if (TopicKey == "colors")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_Colors)">
        <p>@Localization.Parse(TextKey.Appearance_ColorDescription)<br />@Localization.Parse(TextKey.Appearance_ColorInteractions)</p>
        <EditForm @key="Palette" novalidate OnInvalidSubmit="InvalidSubmit" Model="Palette" OnValidSubmit="ApplyPalette" FormName="palette-example">
            <DataAnnotationsValidator />
            <FormLayout>
                <Field Label="@Localization.Parse(TextKey.Appearance_Primary)" Id="palette-primary" Required="true" For="@(() => Palette.Primary)" MessageFormatter="LocalizeValidation">
                    <TextBox Id="palette-primary" @bind-Value="Palette.Primary" MaxLength="7" />
                </Field>
                <Field Label="@Localization.Parse(TextKey.Appearance_Accent)" Id="palette-accent" Required="true" For="@(() => Palette.Accent)" MessageFormatter="LocalizeValidation">
                    <TextBox Id="palette-accent" @bind-Value="Palette.Accent" MaxLength="7" />
                </Field>
            </FormLayout>
            <div class="f-inline-actions">
                <Button Variant="ButtonVariant.Primary" Type="submit" Text="@Localization.Parse(TextKey.Appearance_Apply)" />
                <Button Variant="ButtonVariant.Secondary" OnClick="ResetPalette" Text="@Localization.Parse(TextKey.Appearance_Reset)" />
            </div>
        </EditForm>
        @if (ColorsApplied) { <Notice Severity="NotificationSeverity.Success">@Localization.Parse(TextKey.Appearance_Applied)</Notice> }
        <UniformGrid>
            @foreach (var token in Colors)
            {
                <UniformGridItem Title="@Localization.Parse(token.Label)"><span aria-hidden="true" style="@($"display:inline-block;width:24px;height:24px;vertical-align:middle;background:var({token.Name});border:1px solid var(--f-border);border-radius:6px")"></span> @token.Name</UniformGridItem>
            }
        </UniformGrid>
    </Section>
    }
    @if (TopicKey == "typography")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_Typography)">
        <p>Noto Sans · 中文 日本語 한국어 · ABC abc 0123456789 · g j p q y</p>
        <p>@Localization.Parse(TextKey.Appearance_FontDescription)<br />@Localization.Parse(TextKey.Appearance_FontLanguages)</p>
        <UniformGrid>
            <UniformGridItem Title="@Localization.Parse(TextKey.Appearance_FontStack)">@AppearanceService.Current.FontFamily</UniformGridItem>
            <UniformGridItem Title="@Localization.Parse(TextKey.Appearance_BodyType)">@Localization.Parse(TextKey.Appearance_BodyMetrics)</UniformGridItem>
            <UniformGridItem Title="@Localization.Parse(TextKey.Appearance_LabelWeight)">--f-label-weight: 400</UniformGridItem>
            <UniformGridItem Title="@Localization.Parse(TextKey.Appearance_PageType)">@Localization.Parse(TextKey.Appearance_PageMetrics)</UniformGridItem>
            <UniformGridItem Title="@Localization.Parse(TextKey.Appearance_SemanticType)">H1：34px；H2：28px；H3：20px</UniformGridItem>
        </UniformGrid>
    </Section>
    }
    @if (TopicKey == "spacing")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_Spacing)">
        <UniformGrid>
            @foreach (var token in Spacing) { <UniformGridItem Title="@token.Name">@token.Value</UniformGridItem> }
        </UniformGrid>
    </Section>
    }
    @if (TopicKey == "shape")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_Shape)">
        <UniformGrid>
            <UniformGridItem Title="--f-radius-small">10px</UniformGridItem>
            <UniformGridItem Title="--f-radius-control">12px</UniformGridItem>
            <UniformGridItem Title="--f-radius-panel">16px</UniformGridItem>
            <UniformGridItem Title="--f-radius-emphasis">28px</UniformGridItem>
            <UniformGridItem Title="--f-shadow-control">@Localization.Parse(TextKey.Appearance_ControlShadow)</UniformGridItem>
            <UniformGridItem Title="--f-shadow-popup">@Localization.Parse(TextKey.Appearance_PopupShadow)</UniformGridItem>
            <UniformGridItem Title="--f-shadow-card">@Localization.Parse(TextKey.Appearance_CardShadow)</UniformGridItem>
            <UniformGridItem Title="--f-focus-width">3px</UniformGridItem>
        </UniformGrid>
    </Section>
    }
    @if (TopicKey == "dimensions")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_Dimensions)">
        <UniformGrid>
            <UniformGridItem Title="--f-control-height / --f-dense-height">48px / 36px</UniformGridItem>
            <UniformGridItem Title="--f-topbar-height">68px</UniformGridItem>
            <UniformGridItem Title="--f-primary-width / --f-secondary-width">76px / 232px</UniformGridItem>
            <UniformGridItem Title="--f-content-width">@Localization.Parse(TextKey.Appearance_ContentWidth)</UniformGridItem>
            <UniformGridItem Title="--f-page-gutter">@Localization.Parse(TextKey.Appearance_Gutter)</UniformGridItem>
            <UniformGridItem Title="@Localization.Parse(TextKey.Appearance_Breakpoints)">980px / 760px / 520px</UniformGridItem>
        </UniformGrid>
    </Section>
    }
    @if (TopicKey == "colors")
    {
    <Section Title="@Localization.Parse(TextKey.Appearance_Configure)">
        <p>@Localization.Parse(TextKey.Appearance_Tokens)<br />@Localization.Parse(TextKey.Appearance_ThemeProvider)</p>
        <p><a href="/framework">@Localization.Parse(TextKey.Appearance_FrameworkLink)</a></p>
        <DisplayBoard Dotted="false" Centered="false" CopyText="@DesignExample" CopyLabel="@Localization.Parse(TextKey.Common_CopyCode)" CopiedLabel="@Localization.Parse(TextKey.Common_Copied)" CopyingLabel="@Localization.Parse(TextKey.Common_Copying)" CopyFailedLabel="@Localization.Parse(TextKey.Common_CopyFailed)"><CodeBlock Text="@DesignExample" Language="csharp" /></DisplayBoard>
    </Section>
    }
    @if (!Topics.ContainsKey(TopicKey))
    {
        <EmptyState Title="@Localization.Parse(TextKey.Common_NoTopic)"><Actions><a href="/foundations">@Localization.Parse(TextKey.Common_BackIndex)</a></Actions></EmptyState>
    }
</PageBody>
@code {
    [Parameter] public string? Topic { get; set; }
    public override Task SetParametersAsync(ParameterView parameters)
    {
        Topic = null;
        return base.SetParametersAsync(parameters);
    }
    private string TopicKey => Topic?.ToLowerInvariant() ?? "colors";
    private string Title => Localization.Parse(Topics.GetValueOrDefault(TopicKey, TextKey.Page_NotFound));
    private static readonly IReadOnlyDictionary<string, string> Topics = new Dictionary<string, string>
    {
        ["colors"] = TextKey.Nav_Colors,
        ["typography"] = TextKey.Nav_Typography,
        ["spacing"] = TextKey.Nav_Spacing,
        ["shape"] = TextKey.Nav_Shape,
        ["dimensions"] = TextKey.Nav_Dimensions,
    };

    private string LocalizeValidation(string message) => Localization.TryParse(message, [], out var text) ? text : message;
    private PaletteDraft Palette = new();
    private bool ColorsApplied;
    private string ThemeLabel => Localization.Parse(AppearanceService.Current.Theme switch { ApplicationTheme.Dark => TextKey.Appearance_Dark, ApplicationTheme.Light => TextKey.Appearance_Light, _ => TextKey.Appearance_System });
    private static readonly (string Label, string Name)[] Colors =
    [ (TextKey.Appearance_Primary, "--f-primary"), (TextKey.Appearance_Accent, "--f-accent"), (TextKey.Appearance_Canvas, "--f-canvas"), (TextKey.Appearance_Surface, "--f-surface"),
      (TextKey.Appearance_Text, "--f-text"), (TextKey.Appearance_Muted, "--f-muted"), (TextKey.Appearance_Board, "--f-display-board"),
      (TextKey.Appearance_PreviewLight, "--f-preview-light"), (TextKey.Appearance_PreviewDark, "--f-preview-dark"),
      (TextKey.Appearance_ClickLight, "--f-click-light"), (TextKey.Appearance_ClickDark, "--f-click-dark"),
      (TextKey.Appearance_Danger, "--f-danger"), (TextKey.Appearance_DangerPreview, "--f-preview-danger"), (TextKey.Appearance_DangerClick, "--f-click-danger"),
      (TextKey.Appearance_InfoText, "--f-info-text"), (TextKey.Appearance_WarningBackground, "--f-warning-background"), (TextKey.Appearance_Border, "--f-border") ];
    private static readonly (string Name, string Value)[] Spacing =
    [ ("--f-space-1", "4px"), ("--f-space-2", "8px"), ("--f-space-3", "12px"), ("--f-space-4", "16px"),
      ("--f-space-5", "20px"), ("--f-space-6", "24px"), ("--f-space-8", "32px"), ("--f-space-11", "44px"),
      ("--f-space-16", "64px"), ("--f-space-21", "84px") ];
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Palette.Primary = AppearanceService.Current.Primary; Palette.Accent = AppearanceService.Current.Accent;
        AppearanceService.Changed += AppearanceChanged;
    }
    private void InvalidSubmit(EditContext _) => ColorsApplied = false;
    private void AppearanceChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
    private void ChangeTheme(ApplicationTheme theme) => AppearanceService.SetTheme(theme);
    private void ApplyPalette() { AppearanceService.SetColors(Palette.Primary, Palette.Accent); ColorsApplied = true; }
    private void ResetPalette() { Palette = new(); ApplyPalette(); }
    public override void Dispose()
    {
        AppearanceService.Changed -= AppearanceChanged;
        base.Dispose();
    }
    private const string DesignExample = """
        builder.Services.AddFlourishDesign(design => design
            .SetColors("#153A32", "#16745F")
            .SetTheme(ApplicationTheme.System)
            .SetFont("'Noto Sans', 'Noto Sans CJK SC', system-ui, sans-serif"));
        """;
}
