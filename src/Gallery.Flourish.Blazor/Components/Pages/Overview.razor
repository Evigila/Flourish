@page "/"
@inherits LocalizedComponentBase
<PageTitle>@Localization.Parse(TextKey.Nav_Home) · @Localization.Parse(TextKey.Project_Name)</PageTitle>
<PageBody>
    <PageHeading Title="@Localization.Parse(TextKey.Nav_Home)" />
    <Section Title="@Localization.Parse(TextKey.Home_Start)">
        <UniformGrid>
            <UniformGridButton Title="@Localization.Parse(TextKey.Home_Framework)" Icon="responsive_layout" Href="/framework" Text="@Localization.Parse(TextKey.Home_FrameworkDescription)" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Home_Controls)" Icon="crossword" Href="/controls" Text="@Localization.Parse(TextKey.Home_ControlsDescription)" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Home_Foundations)" Icon="shapes" Href="/foundations" Text="@Localization.Parse(TextKey.Home_FoundationsDescription)" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Home_Examples)" Icon="explore" Href="/examples" Text="@Localization.Parse(TextKey.Home_ExamplesDescription)" />
        </UniformGrid>
    </Section>
    <Section Title="@Localization.Parse(TextKey.Home_Setup)">
        @foreach (var paragraph in Localization.Parse(TextKey.Home_SetupDescription).Split('\n')) { <p>@paragraph</p> }
        <DisplayBoard Dotted="false" Centered="false" CopyText="@Startup"><CodeBlock Text="@Startup" Language="csharp" /></DisplayBoard>
    </Section>
</PageBody>
@code {
    private const string Startup = """
        builder.Services.AddFlourishFramework(framework => framework
            .ConfigureProject(project => project.SetProjectName("My application"))
            .ConfigureTopBar(top => top.DisplayLogo().DisplayProjectName())
            .ConfigureNavigation(nav => nav.AddNav("主页", "home", "/", exact: true)));
        builder.Services.AddFlourishDesign();
        """;
}
