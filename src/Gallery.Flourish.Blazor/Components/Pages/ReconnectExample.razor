@page "/examples/overlays/reconnect"
@inherits LocalizedComponentBase
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Localization.Parse(TextKey.Page_Reconnect) · Gallery</PageTitle>
<PageBody>
    <PageHeading Title="@Localization.Parse(TextKey.Page_Reconnect)" ParentHref="/controls/overlays/dialogsample" ParentLabel="Dialog" />
    <Section Title="@Localization.Parse(TextKey.Reconnect_DescriptionTitle)">
        <p>@Localization.Parse(TextKey.Reconnect_Description)</p>
        <p>@Localization.Parse(TextKey.Reconnect_Protocol)</p>
    </Section>
    <Section Title="@Localization.Parse(TextKey.Reconnect_StatesTitle)">
        <div @ref="Root">
            <DisplayBoard>
                <InlineActions>
                    <Button data-gallery-reconnect-view="reconnecting">@Localization.Parse(TextKey.Reconnect_Reconnecting)</Button>
                    <Button data-gallery-reconnect-view="retrying">@Localization.Parse(TextKey.Reconnect_Retrying)</Button>
                    <Button data-gallery-reconnect-view="failed">@Localization.Parse(TextKey.Reconnect_Failed)</Button>
                    <Button data-gallery-reconnect-view="paused">@Localization.Parse(TextKey.Reconnect_Paused)</Button>
                    <Button data-gallery-reconnect-view="resume-failed">@Localization.Parse(TextKey.Reconnect_ResumeFailed)</Button>
                </InlineActions>
            </DisplayBoard>
            <Dialog Id="@Identifier" Title="@Localization.Parse(TextKey.Reconnect_Title)" BrowserControlled="true" Dismissible="false" Views="Views">
                <Actions>
                    <Button data-gallery-reconnect-view="reconnecting" data-f-dialog-views="failed">@Localization.Parse(TextKey.Reconnect_Retry)</Button>
                    <Button data-gallery-reconnect-view="reconnecting" data-f-dialog-views="paused resume-failed">@Localization.Parse(TextKey.Reconnect_Resume)</Button>
                    <Button Variant="ButtonVariant.Secondary" data-gallery-reconnect-close>@Localization.Parse(TextKey.Reconnect_End)</Button>
                </Actions>
            </Dialog>
        </div>
    </Section>
</PageBody>

@code {
    private readonly string Identifier = "gallery-reconnect-" + Guid.NewGuid().ToString("N");
    private ElementReference Root;
    private IJSObjectReference? Module;
    private bool Disposed;
    private IReadOnlyList<DialogView> Views =>
    [
        new("reconnecting", @<div><Notice Severity="NotificationSeverity.Information">@Localization.Parse(TextKey.Reconnect_ConnectingMessage)</Notice><ProgressBar Label="@Localization.Parse(TextKey.Reconnect_Progress)" /></div>),
        new("retrying", @<Notice Severity="NotificationSeverity.Warning">@Localization.Parse(TextKey.Reconnect_RetryMessage)</Notice>),
        new("failed", @<Notice Severity="NotificationSeverity.Error">@Localization.Parse(TextKey.Reconnect_FailedMessage)</Notice>),
        new("paused", @<Notice Severity="NotificationSeverity.Information">@Localization.Parse(TextKey.Reconnect_PausedMessage)</Notice>),
        new("resume-failed", @<Notice Severity="NotificationSeverity.Error">@Localization.Parse(TextKey.Reconnect_ResumeFailedMessage)</Notice>)
    ];
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Disposed) return;
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./reconnect-example.js");
        if (Disposed) { await module.DisposeAsync(); return; }
        Module = module;
        await Module.InvokeVoidAsync("attach", Root);
    }
    public async ValueTask DisposeAsync()
    {
        base.Dispose();
        Disposed = true;
        if (Module is null) return;
        try { await Module.InvokeVoidAsync("detach", Root); await Module.DisposeAsync(); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException) { }
    }
}
