@page "/records"
@inject RecordStore Store
@inject NavigationManager Navigation
<PageTitle>列表 · 组件演示</PageTitle>
<PageBody>
    <PageHeading Title="列表">
        <Actions><Button OnClick="Create">创建记录</Button></Actions>
    </PageHeading>
    @if (!string.IsNullOrWhiteSpace(Search))
    {
        <Notice Severity="NotificationSeverity.Information">全局搜索：@Search <a href="/records">清除</a></Notice>
    }
    @if (Message is not null) { <Notice Severity="NotificationSeverity.Success">@Message</Notice> }
    <DataTable TItem="BusinessRecord" Items="FilteredRecords" Columns="Columns" Actions="Actions"
               ItemKey="record => record.Id" RowLabel="record => record.Name" OnRowOpen="Open"
               EmptyMessage="没有符合条件的演示记录。" Culture="ChineseCulture" Label="演示记录" Text="ChineseTableText" />
</PageBody>
<Dialog Title="删除演示记录" @bind-IsOpen="DeleteOpen" OnClose="CancelDelete" CloseLabel="取消删除">
    <ChildContent>
        <p>删除“@PendingDelete?.Name”后，该记录将从当前演示连接中移除。</p>
    </ChildContent>
    <Actions>
        <Button Variant="ButtonVariant.Danger" OnClick="Delete">确认删除</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="CancelDelete">取消</Button>
    </Actions>
</Dialog>

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    private string? Message;
    private static readonly TableText ChineseTableText = new(SearchBy: "搜索字段", AllColumns: "全部字段", SearchContent: "搜索内容",
        List: "列表", Cards: "网格", Display: "显示", Actions: "操作", Open: "打开", Items: "项", Of: "共",
        Page: "页", PreviousPage: "上一页", NextPage: "下一页", Width: "列宽", SortDescending: "降序",
        SortAscending: "升序", SortDefault: "恢复默认排序", ResizeHint: "拖动或使用左右方向键；Shift 调整 50px；Home 恢复；Escape 取消。",
        ItemsPerPage: "每页数量", Total: "共", ItemRangeFormat: "{0}{1}-{2} / {3}{4}");
    private static readonly CultureInfo ChineseCulture = CultureInfo.GetCultureInfo("zh-CN");
    private BusinessRecord? PendingDelete;
    private bool DeleteOpen;
    private IReadOnlyList<BusinessRecord> FilteredRecords => string.IsNullOrWhiteSpace(Search)
        ? Store.Records : Store.Records.Where(record => string.Join(' ', record.Code, record.Name, record.Category, record.Contact)
            .Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();
    private static readonly IReadOnlyList<TableColumn<BusinessRecord>> Columns =
    [
        new("code", "编号", record => record.Code, CanHide: false),
        new("name", "名称", record => record.Name, CanHide: false),
        new("category", "分类", record => record.Category),
        new("contact", "联系人", record => record.Contact),
        new("status", "状态", record => record.Status),
        new("updated", "更新日期", record => record.UpdatedOn, Format: record => record.UpdatedOn.ToString("yyyy-MM-dd"))
    ];
    private IReadOnlyList<RowAction<BusinessRecord>> Actions =>
    [
        new("编辑", record => { Navigation.NavigateTo("/forms?id=" + Uri.EscapeDataString(record.Id)); return Task.CompletedTask; }),
        new("删除", record => { PendingDelete = record; DeleteOpen = true; return Task.CompletedTask; }, Destructive: true)
    ];
    private void Create() => Navigation.NavigateTo("/forms");
    private void Open(BusinessRecord record) => Navigation.NavigateTo("/records/" + Uri.EscapeDataString(record.Id));
    private void CancelDelete() { DeleteOpen = false; PendingDelete = null; }
    private void Delete()
    {
        if (PendingDelete is null) return;
        var name = PendingDelete.Name;
        Message = Store.Remove(PendingDelete.Id) ? $"已删除演示记录“{name}”。" : "该演示记录已经不存在。";
        CancelDelete();
    }
}
