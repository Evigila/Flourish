@page "/records"
@inherits LocalizedComponentBase
@inject RecordStore Store
@inject NavigationManager Navigation
<PageTitle>@Localization.Parse(TextKey.Nav_Records) · Gallery</PageTitle>
<PageBody>
    <PageHeading Title="@Localization.Parse(TextKey.Nav_Records)">
        <Actions><Button OnClick="Create">@Localization.Parse(TextKey.Page_RecordCreate)</Button></Actions>
    </PageHeading>
    @if (!string.IsNullOrWhiteSpace(Search))
    {
        <Notice Severity="NotificationSeverity.Information">@Localization.Parse(TextKey.Records_Search, Search) <a href="/records">@Localization.Parse(TextKey.Common_Clear)</a></Notice>
    }
    @if (MessageKey is not null) { <Notice Severity="NotificationSeverity.Success">@Localization.Parse(MessageKey, DeletedName)</Notice> }
    <DataTable TItem="BusinessRecord" Items="FilteredRecords" Columns="Columns" Actions="Actions"
               ItemKey="record => record.Id" RowLabel="record => record.Name" OnRowOpen="Open"
               EmptyMessage="@Localization.Parse(TextKey.Records_Empty)" Culture="Localization.FormatCulture" Label="@Localization.Parse(TextKey.Records_Label)" />
</PageBody>
<Dialog Title="@Localization.Parse(TextKey.Records_DeleteTitle)" @bind-IsOpen="DeleteOpen" OnClose="CancelDelete" CloseLabel="@Localization.Parse(TextKey.Records_CancelDelete)">
    <ChildContent>
        <p>@Localization.Parse(TextKey.Records_DeleteBody, PendingDelete?.Name)</p>
    </ChildContent>
    <Actions>
        <Button Variant="ButtonVariant.Danger" OnClick="Delete">@Localization.Parse(TextKey.Records_ConfirmDelete)</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="CancelDelete">@Localization.Parse(TextKey.Common_Cancel)</Button>
    </Actions>
</Dialog>

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    private string? MessageKey;
    private string? DeletedName;
    private BusinessRecord? PendingDelete;
    private bool DeleteOpen;
    private IReadOnlyList<BusinessRecord> FilteredRecords => string.IsNullOrWhiteSpace(Search)
        ? Store.Records : Store.Records.Where(record => string.Join(' ', record.Code, record.Name, record.Category, record.Contact)
            .Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();
    private IReadOnlyList<TableColumn<BusinessRecord>> Columns =>
    [
        new("code", Localization.Parse(TextKey.Common_Code), record => record.Code, CanHide: false),
        new("name", Localization.Parse(TextKey.Record_Name), record => record.Name, CanHide: false),
        new("category", Localization.Parse(TextKey.Common_Category), record => record.Category),
        new("contact", Localization.Parse(TextKey.Common_Contact), record => record.Contact),
        new("status", Localization.Parse(TextKey.Common_Status), record => record.Status),
        new("updated", Localization.Parse(TextKey.Common_Updated), record => record.UpdatedOn, Format: record => record.UpdatedOn.ToString("yyyy-MM-dd"))
    ];
    private IReadOnlyList<RowAction<BusinessRecord>> Actions =>
    [
        new(Localization.Parse(TextKey.Common_Edit), record => { Navigation.NavigateTo("/forms?id=" + Uri.EscapeDataString(record.Id)); return Task.CompletedTask; }),
        new(Localization.Parse(TextKey.Common_Delete), record => { PendingDelete = record; DeleteOpen = true; return Task.CompletedTask; }, Destructive: true)
    ];
    private void Create() => Navigation.NavigateTo("/forms");
    private void Open(BusinessRecord record) => Navigation.NavigateTo("/records/" + Uri.EscapeDataString(record.Id));
    private void CancelDelete() { DeleteOpen = false; PendingDelete = null; }
    private void Delete()
    {
        if (PendingDelete is null) return;
        var name = PendingDelete.Name;
        DeletedName = name;
        MessageKey = Store.Remove(PendingDelete.Id) ? TextKey.Records_Deleted : TextKey.Records_AlreadyMissing;
        CancelDelete();
    }
}
