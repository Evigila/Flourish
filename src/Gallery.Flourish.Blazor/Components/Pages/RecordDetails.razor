@page "/records/{Id}"
@inherits LocalizedComponentBase
@inject RecordStore Store
@inject NavigationManager Navigation
<PageTitle>@DetailTitle · Gallery</PageTitle>
<PageBody>
    <PageHeading Title="@DetailTitle" ParentHref="/records" ParentLabel="@Localization.Parse(TextKey.Nav_Records)">
        <Actions>
            @if (Record is not null) { <Button OnClick="Edit">@Localization.Parse(TextKey.Page_RecordEdit)</Button> }
        </Actions>
    </PageHeading>
    @if (Record is { } record)
    {
        <Section>
        <IdentityCard>
            <dl>
                <div><dt>@Localization.Parse(TextKey.Record_Name)</dt><dd class="f-identity-primary">@record.Name</dd></div>
                <div><dt>@Localization.Parse(TextKey.Common_Code)</dt><dd>@record.Code</dd></div>
                <div><dt>@Localization.Parse(TextKey.Common_Category)</dt><dd>@record.Category</dd></div>
                <div><dt>@Localization.Parse(TextKey.Common_Status)</dt><dd>@record.Status</dd></div>
            </dl>
        </IdentityCard>
        </Section>
        <Section Title="@Localization.Parse(TextKey.Records_ContactInformation)">
            <UniformGrid>
                <UniformGridItem Title="@Localization.Parse(TextKey.Common_Contact)" Text="@record.Contact" />
                <UniformGridItem Title="@Localization.Parse(TextKey.Common_Email)"><Button Variant="ButtonVariant.Underline" Href="@($"mailto:{record.Email}")" Text="@record.Email" /></UniformGridItem>
                <UniformGridItem Title="@Localization.Parse(TextKey.Common_Updated)" Text="@record.UpdatedOn.ToString("yyyy-MM-dd")" />
            </UniformGrid>
        </Section>
    }
    else
    {
        <EmptyState Title="@Localization.Parse(TextKey.Records_Missing)">
            <Actions><Button Variant="ButtonVariant.Secondary" OnClick="Back">@Localization.Parse(TextKey.Common_BackList)</Button></Actions>
        </EmptyState>
    }
</PageBody>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private BusinessRecord? Record => Store.Find(Id);
    private string DetailTitle => Record?.Name ?? Localization.Parse(TextKey.Page_RecordMissing);
    private void Edit() => Navigation.NavigateTo("/forms?id=" + Uri.EscapeDataString(Id));
    private void Back() => Navigation.NavigateTo("/records");
}
