@page "/patterns"
@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Blazor.Components.Primitives
@using ArkheideSystem.Flourish.Blazor.Components.Patterns
<PageTitle>@Localization.Parse(TextKey.Nav_Patterns) · Gallery</PageTitle>
<PageBody>
    <PageHeading Title="@Localization.Parse(TextKey.Page_Products)"><Actions><Button OnClick="() => formOpen = true">@Localization.Parse(TextKey.Patterns_Create)</Button></Actions></PageHeading>
    @if (message is not null) { <Notice Severity="NotificationSeverity.Information" Subtle="true">@message</Notice> }
    <Section Title="@Localization.Parse(TextKey.Patterns_Catalog)">
        <p>@Localization.Parse(TextKey.Patterns_Description)</p>
        <DataTable TItem="Entry" Label="@Localization.Parse(TextKey.Page_Products)" Purpose="TablePurpose.Registry" PreferenceKey="gallery-sample-records" Items="entries" Columns="columns" Searchable="true" OnRowOpen="Open" Actions="actions" ItemKey="@(item => item.Id)" />
    </Section>
</PageBody>
<Dialog Presentation="DialogPresentation.BottomSheet" Title="@Localization.Parse(TextKey.Nav_RecordDetails)" @bind-IsOpen="inspectOpen">
    <p>@message</p>
</Dialog>
<Dialog Presentation="DialogPresentation.BottomSheet" Title="@Localization.Parse(TextKey.Patterns_Create)" @bind-IsOpen="formOpen">
    <ChildContent>
        <FormLayout Columns="1">
            <Field Label="@Localization.Parse(TextKey.Record_Name)" Id="pattern-name"><StandaloneTextBox Id="pattern-name" @bind-Value="name" /></Field>
            <Field Label="SKU" Id="pattern-sku"><StandaloneTextBox Id="pattern-sku" @bind-Value="sku" /></Field>
        </FormLayout>
    </ChildContent>
    <Actions><Button Variant="ButtonVariant.Primary" OnClick="Complete">@Localization.Parse(TextKey.Patterns_UseSample)</Button><Button Variant="ButtonVariant.Secondary" OnClick="() => formOpen = false">@Localization.Parse(TextKey.Common_Cancel)</Button></Actions>
</Dialog>
@code {
    private sealed record Entry(int Id, string Name, string Sku, decimal Price);
    private readonly IReadOnlyList<Entry> entries = [new(1, "Notebook", "PAP-0096", 12.90m), new(2, "Detergent", "LIMP-0500", 3.49m), new(3, "Chocolate", "ALIM-0100", 5.99m)];
    private IReadOnlyList<TableColumn<Entry>> columns => [new("name", Localization.Parse(TextKey.Patterns_Product), item => item.Name, CardField: TableCardField.Title), new("sku", "SKU", item => item.Sku, CardField: TableCardField.Identifier), new("price", Localization.Parse(TextKey.Patterns_Price), item => item.Price, SortValue: item => item.Price)];
    private IReadOnlyList<RowAction<Entry>> actions => [new(Localization.Parse(TextKey.Patterns_Inspect), item => { Inspect(item); return Task.CompletedTask; })];
    private bool formOpen, inspectOpen;
    private string? name = "", sku = "";
    private string? MessageKey;
    private object?[] MessageArguments = [];
    private string? message => MessageKey is null ? null : Localization.Parse(MessageKey, MessageArguments);
    private void Open(Entry item) { MessageKey = TextKey.Patterns_Opened; MessageArguments = [item.Name]; }
    private void Inspect(Entry item) { MessageKey = TextKey.Patterns_Sample; MessageArguments = [item.Name, item.Sku]; inspectOpen = true; }
    private void Complete() { MessageKey = TextKey.Patterns_Sample; MessageArguments = [name, sku]; formOpen = false; }
}
