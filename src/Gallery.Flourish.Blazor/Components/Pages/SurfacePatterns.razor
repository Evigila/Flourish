@page "/patterns"
@using ArkheideSystem.Flourish.Blazor.Components.Primitives
@using ArkheideSystem.Flourish.Blazor.Components.Patterns
<PageTitle>组合布局 · Examples</PageTitle>
<PageBody Fluid="false">
    <PageHeading Title="Products"><Actions><Button OnClick="() => formOpen = true">Create product</Button></Actions></PageHeading>
    @if (message is not null) { <Notice Severity="NotificationSeverity.Information" Subtle="true">@message</Notice> }
    <Section Title="Catalog">
        <p>Registry uses the shared DataTable contract for records, preferences and actions.</p>
        <DataTable TItem="Entry" Label="Products" Purpose="TablePurpose.Registry" PreferenceKey="gallery-sample-records" Items="entries" Columns="columns" Searchable="true" OnRowOpen="Open" Actions="actions" ItemKey="@(item => item.Id)" />
    </Section>
</PageBody>
<Dialog Presentation="DialogPresentation.BottomSheet" Title="Record details" @bind-IsOpen="inspectOpen">
    <p>@message</p>
</Dialog>
<Dialog Presentation="DialogPresentation.BottomSheet" Title="Create product" @bind-IsOpen="formOpen">
    <ChildContent>
        <FormLayout Columns="1">
            <Field Label="Name" Id="pattern-name"><StandaloneTextBox Id="pattern-name" @bind-Value="name" /></Field>
            <Field Label="SKU" Id="pattern-sku"><StandaloneTextBox Id="pattern-sku" @bind-Value="sku" /></Field>
        </FormLayout>
    </ChildContent>
    <Actions><Button Variant="ButtonVariant.Primary" OnClick="Complete">Use sample</Button><Button Variant="ButtonVariant.Secondary" OnClick="() => formOpen = false">Cancel</Button></Actions>
</Dialog>
@code {
    private sealed record Entry(int Id, string Name, string Sku, decimal Price);
    private readonly IReadOnlyList<Entry> entries = [new(1, "Notebook", "PAP-0096", 12.90m), new(2, "Detergent", "LIMP-0500", 3.49m), new(3, "Chocolate", "ALIM-0100", 5.99m)];
    private readonly IReadOnlyList<TableColumn<Entry>> columns = [new("name", "Product", item => item.Name, CardField: TableCardField.Title), new("sku", "SKU", item => item.Sku, CardField: TableCardField.Identifier), new("price", "Price", item => item.Price, SortValue: item => item.Price)];
    private IReadOnlyList<RowAction<Entry>> actions => [new("Inspect", item => { Inspect(item); return Task.CompletedTask; })];
    private bool formOpen, inspectOpen;
    private string? name = "", sku = "";
    private string? message;
    private void Open(Entry item) => message = "Opened " + item.Name;
    private void Inspect(Entry item) { message = item.Name + " / " + item.Sku; inspectOpen = true; }
    private void Complete() { message = "Sample: " + name + " / " + sku; formOpen = false; }
}
