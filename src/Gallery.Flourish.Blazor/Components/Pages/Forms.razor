@page "/forms"
@inherits LocalizedComponentBase
@inject RecordStore Store
@inject NavigationManager Navigation
<PageTitle>@FormTitle · Gallery</PageTitle>
<NavigationLock ConfirmExternalNavigation="Dirty" OnBeforeInternalNavigation="BeforeNavigation" />
<PageBody>
    <PageHeading Title="@FormTitle" ParentHref="/records" ParentLabel="@Localization.Parse(TextKey.Nav_Records)" />
    @if (MissingRecord)
    {
        <EmptyState Title="@Localization.Parse(TextKey.Forms_Missing)"><Actions><Button OnClick="Cancel">@Localization.Parse(TextKey.Common_BackList)</Button></Actions></EmptyState>
    }
    else
    {
        <EditForm @key="Context" novalidate EditContext="Context" OnValidSubmit="SaveAsync" FormName="demo-record">
            <DataAnnotationsValidator />
            <Section Title="@Localization.Parse(TextKey.Forms_Basic)">
                <FormLayout>
                    <Field Label="@Localization.Parse(TextKey.Record_Name)" Id="record-name" Required="true" For="@(() => Draft.Name)" MessageFormatter="LocalizeValidation">
                        <TextBox Id="record-name" @bind-Value="Draft.Name" MaxLength="120" Disabled="Busy" />
                    </Field>
                    <Field Label="@Localization.Parse(TextKey.Common_Category)" Id="record-category" Required="true" For="@(() => Draft.Category)" MessageFormatter="LocalizeValidation">
                        <SelectBox TValue="string" Id="record-category" @bind-Value="Draft.Category" Options="Categories" Disabled="Busy" />
                    </Field>
                    <Field Label="@Localization.Parse(TextKey.Common_Contact)" Id="record-contact" Required="true" For="@(() => Draft.Contact)" MessageFormatter="LocalizeValidation">
                        <TextBox Id="record-contact" @bind-Value="Draft.Contact" MaxLength="80" Disabled="Busy" />
                    </Field>
                    <Field Label="@Localization.Parse(TextKey.Common_Email)" Id="record-email" Required="true" For="@(() => Draft.Email)" MessageFormatter="LocalizeValidation">
                        <TextBox Id="record-email" Type="email" @bind-Value="Draft.Email" Disabled="Busy" />
                    </Field>
                    <CheckBox Id="record-active" Label="@Localization.Parse(TextKey.Forms_Active)" @bind-Value="Draft.Active" Disabled="Busy" />
                </FormLayout>
            </Section>
            <FormActions>
                <UniformGridButton Title="@Localization.Parse(TextKey.Common_Save)" Variant="UniformGridVariant.FilledElevated" Type="submit" Busy="Busy" />
                <UniformGridButton Title="@Localization.Parse(TextKey.Common_Cancel)" Variant="UniformGridVariant.Elevated" Disabled="Busy" OnClick="Cancel" />
            </FormActions>
        </EditForm>
    }
</PageBody>
<Dialog Title="@Localization.Parse(TextKey.Forms_DiscardTitle)" @bind-IsOpen="DiscardOpen" OnClose="KeepEditing" CloseLabel="@Localization.Parse(TextKey.Forms_KeepEditing)">
    <ChildContent><p>@Localization.Parse(TextKey.Forms_DiscardBody)</p></ChildContent>
    <Actions>
        <Button Variant="ButtonVariant.Danger" OnClick="DiscardAndNavigate">@Localization.Parse(TextKey.Forms_DiscardAction)</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="KeepEditing">@Localization.Parse(TextKey.Forms_KeepEditing)</Button>
    </Actions>
</Dialog>

@code {
    [SupplyParameterFromQuery] public string? Id { get; set; }
    private string LocalizeValidation(string message) => Localization.TryParse(message, [], out var text) ? text : message;
    private RecordDraft Draft = new();
    private string FormTitle => Localization.Parse(Id is null ? TextKey.Page_RecordCreate : TextKey.Page_RecordEdit);
    private EditContext Context = default!;
    private string? BoundId;
    private bool Initialized, Dirty, Busy, DiscardOpen, MissingRecord;
    private string? PendingTarget;
    private IReadOnlyList<SelectOption<string>> Categories =>
    [ new("", Localization.Parse(TextKey.Common_Choose)), new("客户", Localization.Parse(TextKey.Forms_Customer)), new("供应商", Localization.Parse(TextKey.Forms_Supplier)), new("内部部门", Localization.Parse(TextKey.Forms_Department)) ];

    protected override void OnParametersSet()
    {
        if (Initialized && BoundId == Id) return;
        if (Context is not null) Context.OnFieldChanged -= FieldChanged;
        Initialized = true; BoundId = Id;
        var record = Id is null ? null : Store.Find(Id);
        MissingRecord = Id is not null && record is null;
        Draft = record is null ? new() : new() { Name = record.Name, Category = record.Category,
            Contact = record.Contact, Email = record.Email, Active = record.Status == "启用" };
        Context = new(Draft);
        Context.OnFieldChanged += FieldChanged;
        Dirty = false; DiscardOpen = false; PendingTarget = null;
    }
    private void FieldChanged(object? sender, FieldChangedEventArgs args) => Dirty = Context.IsModified();
    private void BeforeNavigation(LocationChangingContext args)
    {
        if (!Dirty) return;
        args.PreventNavigation();
        PendingTarget = args.TargetLocation;
        DiscardOpen = true;
    }
    private async Task SaveAsync()
    {
        if (Busy) return;
        Busy = true;
        try
        {
            await Task.Yield();
            var record = Store.Save(Draft, Id);
            Context.MarkAsUnmodified(); Dirty = false;
            Navigation.NavigateTo("/records/" + Uri.EscapeDataString(record.Id));
        }
        finally { Busy = false; }
    }
    private void Cancel() => Navigation.NavigateTo("/records");
    private void KeepEditing() { DiscardOpen = false; PendingTarget = null; }
    private void DiscardAndNavigate()
    {
        var target = PendingTarget ?? "/records";
        PendingTarget = null;
        Dirty = false;
        DiscardOpen = false;
        Context.MarkAsUnmodified();
        Navigation.NavigateTo(target);
    }
    public override void Dispose() { if (Context is not null) Context.OnFieldChanged -= FieldChanged; base.Dispose(); }
}
