@page "/examples"
@page "/examples/{Topic}"
@inherits LocalizedComponentBase
<PageTitle>@Title · Gallery</PageTitle>
<PageBody>
    <PageHeading Title="@Title" />
    @if (TopicKey == "index")
    {
    <Section Title="@Localization.Parse(TextKey.Examples_CompletePages)">
        <p>@Localization.Parse(TextKey.Examples_SessionData)</p>
        <UniformGrid>
            <UniformGridButton Title="@Localization.Parse(TextKey.Nav_Forms)" Href="/forms" Text="@Localization.Parse(TextKey.Examples_FormDescription)" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Nav_Records)" Href="/records" Text="@Localization.Parse(TextKey.Examples_RecordsDescription)" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Nav_RecordDetails)" Href="/records/sample" Text="@Localization.Parse(TextKey.Examples_DetailsDescription)" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Nav_Patterns)" Href="/patterns" Text="@Localization.Parse(TextKey.Examples_PatternsDescription)" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Nav_DisplayPages)" Href="/examples/display" Text="@Localization.Parse(TextKey.Examples_DisplayDescription)" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Nav_FormPage)" Href="/examples/form" Text="@Localization.Parse(TextKey.Examples_CreateDescription)" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Nav_Enums)" Href="/examples/enum" Text="@Localization.Parse(TextKey.Examples_EnumDescription)" />
            <UniformGridButton Title="@Localization.Parse(TextKey.Nav_Search)" Href="/examples/search" Text="@Localization.Parse(TextKey.Examples_SearchDescription)" />
        </UniformGrid>
    </Section>
    }
    @if (TopicKey == "form")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_FormPage)">
        <p>@Localization.Parse(TextKey.Examples_FormValidation)<br />@Localization.Parse(TextKey.Examples_FormLayout)<br />@Localization.Parse(TextKey.Examples_FormVariants)</p>
        <DisplayBoard Dotted="false" Centered="false" CopyText="@FormExample" CopyLabel="@Localization.Parse(TextKey.Common_CopyCode)" CopiedLabel="@Localization.Parse(TextKey.Common_Copied)" CopyingLabel="@Localization.Parse(TextKey.Common_Copying)" CopyFailedLabel="@Localization.Parse(TextKey.Common_CopyFailed)"><CodeBlock Text="@FormExample" Language="razor" /></DisplayBoard>
    </Section>
    }
    @if (TopicKey == "enum")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_Enums)">
        <Field Label="@Localization.Parse(TextKey.Examples_TaskStatus)" Id="example-state">
            <SelectBox TValue="TaskState" Id="example-state" Options="States" @bind-Value="SelectedState" />
        </Field>
        <p aria-live="polite">@Localization.Parse(TextKey.Examples_CurrentValue, StateLabel(SelectedState), SelectedState)</p>
        <DisplayBoard Dotted="false" Centered="false" CopyText="@EnumExample" CopyLabel="@Localization.Parse(TextKey.Common_CopyCode)" CopiedLabel="@Localization.Parse(TextKey.Common_Copied)" CopyingLabel="@Localization.Parse(TextKey.Common_Copying)" CopyFailedLabel="@Localization.Parse(TextKey.Common_CopyFailed)"><CodeBlock Text="@EnumExample" Language="razor" /></DisplayBoard>
    </Section>
    }
    @if (TopicKey == "search")
    {
    <Section Title="@Localization.Parse(TextKey.Nav_Search)">
        <SearchBox Label="@Localization.Parse(TextKey.Examples_SearchNames)" @bind-Value="Query" SearchChanged="Filter" DebounceMilliseconds="300" />
        @if (FilteredEntries.Count == 0)
        {
            <EmptyState Title="@Localization.Parse(TextKey.Examples_NoMatches)"><Actions><Button Variant="ButtonVariant.Secondary" OnClick="ClearSearch">@Localization.Parse(TextKey.Examples_ClearSearch)</Button></Actions></EmptyState>
        }
        else
        {
            <ul aria-label="@Localization.Parse(TextKey.Examples_MatchesLabel)">
                @foreach (var entry in FilteredEntries) { <li>@entry</li> }
            </ul>
        }
        <p role="status">@Localization.Parse(TextKey.Examples_Found, FilteredEntries.Count)</p>
        <p>@Localization.Parse(TextKey.Examples_SearchEvents)<br />@Localization.Parse(TextKey.Examples_RemoteSearch)</p>
        <DisplayBoard Dotted="false" Centered="false" CopyText="@SearchExample" CopyLabel="@Localization.Parse(TextKey.Common_CopyCode)" CopiedLabel="@Localization.Parse(TextKey.Common_Copied)" CopyingLabel="@Localization.Parse(TextKey.Common_Copying)" CopyFailedLabel="@Localization.Parse(TextKey.Common_CopyFailed)"><CodeBlock Text="@SearchExample" Language="razor" /></DisplayBoard>
    </Section>
    }
    @if (!Topics.ContainsKey(TopicKey))
    {
        <EmptyState Title="@Localization.Parse(TextKey.Common_NoTopic)"><Actions><a href="/examples">@Localization.Parse(TextKey.Common_BackIndex)</a></Actions></EmptyState>
    }
</PageBody>
@code {
    [Parameter] public string? Topic { get; set; }
    public override Task SetParametersAsync(ParameterView parameters)
    {
        Topic = null;
        return base.SetParametersAsync(parameters);
    }
    private string TopicKey => Topic?.ToLowerInvariant() ?? "index";
    private string Title => Localization.Parse(Topics.GetValueOrDefault(TopicKey, TextKey.Page_NotFound));
    private static readonly IReadOnlyDictionary<string, string> Topics = new Dictionary<string, string>
    {
        ["index"] = TextKey.Nav_ExampleIndex,
        ["form"] = TextKey.Nav_FormPage,
        ["enum"] = TextKey.Nav_Enums,
        ["search"] = TextKey.Nav_Search,
    };

    private enum TaskState { Planned, Active, Completed }
    private TaskState SelectedState = TaskState.Planned;
    private string StateLabel(TaskState state) => Localization.Parse(state switch
    { TaskState.Planned => TextKey.Examples_Planned, TaskState.Active => TextKey.Examples_Active, _ => TextKey.Examples_Completed });
    private IReadOnlyList<SelectOption<TaskState>> States => Enum.GetValues<TaskState>()
        .Select(state => new SelectOption<TaskState>(state, StateLabel(state))).ToArray();
    private static readonly IReadOnlyList<string> EntryKeys = [TextKey.Examples_SearchForm, TextKey.Examples_SearchRecords, TextKey.Examples_SearchEnums, TextKey.Examples_SearchSearch, TextKey.Examples_SearchLayout];
    private string Query = "";
    private string AppliedQuery = "";
    private IReadOnlyList<string> FilteredEntries => EntryKeys.Select(key => Localization.Parse(key))
        .Where(entry => entry.Contains(AppliedQuery.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();
    private void Filter(string query) => AppliedQuery = query;
    private void ClearSearch() { Query = ""; Filter(""); }
    private const string FormExample = """
        <PageBody>
            <PageHeading Title="创建记录" />
            <EditForm Model="Draft" OnValidSubmit="SaveAsync" FormName="record" novalidate>
                <DataAnnotationsValidator />
                <FormLayout>
                    <Field Label="名称" Id="name" Required="true" For="@(() => Draft.Name)">
                        <TextBox Id="name" @bind-Value="Draft.Name" />
                    </Field>
                </FormLayout>
                <FormActions>
                    <UniformGridButton Title="保存" Variant="UniformGridVariant.Filled" Type="submit" Busy="Saving" />
                    <UniformGridButton Title="取消" Variant="UniformGridVariant.Outlined" OnClick="Cancel" />
                </FormActions>
            </EditForm>
        </PageBody>
        """;
    private const string EnumExample = """
        <Field Label="状态" Id="state">
            <SelectBox TValue="TaskState" Id="state" Options="States" @bind-Value="SelectedState" />
        </Field>

        @code {
            private enum TaskState { Planned, Active, Completed }
            private TaskState SelectedState;
            private static readonly IReadOnlyList<SelectOption<TaskState>> States =
                Enum.GetValues<TaskState>().Select(state =>
                    new SelectOption<TaskState>(state, state.ToString())).ToArray();
        }
        """;
    private const string SearchExample = """
        <SearchBox Label="搜索" @bind-Value="Query" SearchChanged="Filter" DebounceMilliseconds="300" />
        <ul>
            @foreach (var item in Filtered) { <li>@item</li> }
        </ul>

        @code {
            private string Query = "";
            private readonly string[] Items = ["Form", "List", "Search"];
            private IReadOnlyList<string> Filtered = ["Form", "List", "Search"];
            private void Filter(string query) => Filtered = Items.Where(item =>
                item.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();
        }
        """;
}
