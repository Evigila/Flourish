@page "/foundations/icons"
@inherits LocalizedComponentBase
<PageTitle>@Localization.Parse(TextKey.Nav_Icons) · Gallery</PageTitle>
<PageBody>
    <PageHeading Title="@Localization.Parse(TextKey.Nav_Icons)" />
    <Section Title="@Localization.Parse(TextKey.Icons_IntroductionTitle)">
        <p>@Localization.Parse(TextKey.Icons_FontDescription)<br />@Localization.Parse(TextKey.Icons_LocalFont)</p>
        <div class="f-inline-actions">
            <Button Variant="ButtonVariant.Underline" Href="https://github.com/google/material-design-icons" Text="@Localization.Parse(TextKey.Icons_Repository)" target="_blank" rel="noopener noreferrer" />
            <Button Variant="ButtonVariant.Underline" Href="https://github.com/google/material-design-icons/blob/master/LICENSE" Text="@Localization.Parse(TextKey.Icons_License)" target="_blank" rel="noopener noreferrer" />
            <Button Variant="ButtonVariant.Underline" Href="https://fonts.google.com/icons" Text="@Localization.Parse(TextKey.Icons_Browser)" target="_blank" rel="noopener noreferrer" />
            <Button Variant="ButtonVariant.Underline" Href="https://developers.google.com/fonts/docs/material_symbols" Text="@Localization.Parse(TextKey.Icons_Documentation)" target="_blank" rel="noopener noreferrer" />
        </div>
    </Section>
    <Section Title="Material Symbols Outlined">
        <p>@Localization.Parse(TextKey.Icons_Count, IconCatalog.Names.Count)</p>
        <SearchBox Label="@Localization.Parse(TextKey.Icons_Search)" @bind-Value="Query" SearchChanged="ResetPage" />
        <p role="status">@Localization.Parse(TextKey.Icons_Matches, VisibleNames.Count, MatchingNames.Count)</p>
        @if (MatchingNames.Count == 0)
        {
            <EmptyState Title="@Localization.Parse(TextKey.Icons_Empty)" />
        }
        else
        {
            <UniformGrid Shape="UniformGridShape.Square">
                @foreach (var name in VisibleNames)
                {
                    <UniformGridItem @key="name" Icon="@name" Text="@name" />
                }
            </UniformGrid>
            @if (VisibleNames.Count < MatchingNames.Count)
            {
                <Button Variant="ButtonVariant.Secondary" OnClick="ShowMore">@Localization.Parse(TextKey.Icons_ShowMore)</Button>
            }
        }
    </Section>
    <Section Title="@Localization.Parse(TextKey.Icons_Usage)">
        <UniformGrid>
            <UniformGridItem Title="@Localization.Parse(TextKey.Icons_Default)" Text="26px · --f-icon-default-size" />
            <UniformGridItem Title="@Localization.Parse(TextKey.Icons_Navigation)" Text="24px · --f-icon-primary-size" />
            <UniformGridItem Title="@Localization.Parse(TextKey.Icons_Tool)" Text="26px · --f-icon-tool-size" />
            <UniformGridItem Title="@Localization.Parse(TextKey.Icons_Information)" Text="22px · --f-icon-information-size" />
        </UniformGrid>
        <p>@Localization.Parse(TextKey.Icons_FontAxes)<br />@Localization.Parse(TextKey.Icons_DefaultAxes)<br />@Localization.Parse(TextKey.Icons_VersionedNames)</p>
        <p>@Localization.Parse(TextKey.Icons_InheritColor)<br />@Localization.Parse(TextKey.Icons_Accessibility)<br />@Localization.Parse(TextKey.Icons_CatalogContract)<br />@Localization.Parse(TextKey.Icons_Unknown)</p>
        <p>@Localization.Parse(TextKey.Icons_CurrentNames)</p>
        <DisplayBoard Dotted="false" Centered="false" CopyText="@Example" CopyLabel="@Localization.Parse(TextKey.Common_CopyCode)" CopiedLabel="@Localization.Parse(TextKey.Common_Copied)" CopyingLabel="@Localization.Parse(TextKey.Common_Copying)" CopyFailedLabel="@Localization.Parse(TextKey.Common_CopyFailed)"><CodeBlock Text="@Example" Language="razor" /></DisplayBoard>
    </Section>
</PageBody>
@code {
    private string Query = "";
    private int Limit = 72;
    private IReadOnlyList<string> MatchingNames => IconCatalog.Names
        .Where(name => name.Contains(Query.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();
    private IReadOnlyList<string> VisibleNames => MatchingNames.Take(Limit).ToArray();
    private void ResetPage(string _) => Limit = 72;
    private void ShowMore() => Limit += 72;
    private const string Example = """
        <Icon Name="home" />
        <Icon Name="search" />

        <Button Icon="settings" aria-label="打开设置" OnClick="OpenSettings" />
        """;
}
