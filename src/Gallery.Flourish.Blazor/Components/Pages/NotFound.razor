@page "/not-found"
@inherits LocalizedComponentBase
@inject NavigationManager Navigation
<PageTitle>@Localization.Parse(TextKey.Page_NotFound) · Gallery</PageTitle>
<PageBody>
    <PageHeading Title="@Localization.Parse(TextKey.Page_NotFound)" />
    <EmptyState Title="@Localization.Parse(TextKey.NotFound_Path)">
        <ChildContent><p>@Localization.Parse(TextKey.NotFound_Description)</p></ChildContent>
        <Actions><Button OnClick="GoHome">@Localization.Parse(TextKey.Common_BackHome)</Button></Actions>
    </EmptyState>
</PageBody>

@code {
    private void GoHome() => Navigation.NavigateTo("/");
}
