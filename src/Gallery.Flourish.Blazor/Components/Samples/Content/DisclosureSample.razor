@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System
@using System.Collections.Generic
@using System.Linq
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Content
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Disclosure", DescriptionKey = "Key.Sample_DisclosureSample_Description")]
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@if (Preview)
{
    <Disclosure Title="@Localization.Parse(TextKey.Sample_InitiallyClosed)" />
    <Disclosure Title="@Localization.Parse(TextKey.Sample_InitiallyOpen)" InitiallyOpen="true" />
}
else
{
    <Disclosure Title="@Localization.Parse(TextKey.Sample_DemoOrderShippingDetails)"><p>@Localization.Parse(TextKey.Sample_TheDemoOrderIsScheduledForTheNextBusinessDayNoShipmentIsMade)</p></Disclosure>
    <Disclosure Title="@Localization.Parse(TextKey.Sample_DemoOrderReturnConditions)" InitiallyOpen="true"><p>@Localization.Parse(TextKey.Sample_TheDemoAllowsCancellationWhileTheOrderIsADraft)</p></Disclosure>
}
@code { [Parameter] public bool Preview { get; set; } }
