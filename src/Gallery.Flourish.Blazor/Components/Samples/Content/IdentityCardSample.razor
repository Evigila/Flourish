@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System
@using System.Collections.Generic
@using System.Linq
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Content
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("IdentityCard")]
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@if (Preview)
{
    <IdentityCard Columns="false" />
    <IdentityCard Title="@Localization.Parse(TextKey.Sample_EmptyIdentityCardWithTwoColumns)" Columns="true" />
    <IdentityCard Title="@Localization.Parse(TextKey.Sample_WithASidebar)"><ChildContent><dl></dl></ChildContent><SideContent><dl></dl></SideContent></IdentityCard>
}
else
{
    <ToggleSwitch Label="@Localization.Parse(TextKey.Sample_ShowDemoIdentitySidebar)" @bind-Value="WithSidebar" />
    <IdentityCard Title="@Localization.Parse(TextKey.Sample_FictionalMember)" SideContent="@(WithSidebar ? Sidebar : null)">
        <dl><div><dt>@Localization.Parse(TextKey.Record_Name)</dt><dd class="f-identity-primary">演示成员</dd></div><div><dt>@Localization.Parse(TextKey.Sample_Identifier)</dt><dd>DEMO-001</dd></div></dl>
    </IdentityCard>
}
@code {
    [Parameter] public bool Preview { get; set; }
    private bool WithSidebar = true;
    private RenderFragment Sidebar => @<dl><div><dt>@Localization.Parse(TextKey.Sample_DemoAccessScope)</dt><dd>演示区域</dd></div></dl>;
}
