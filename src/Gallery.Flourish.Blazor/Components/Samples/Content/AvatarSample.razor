@inherits LocalizedComponentBase
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Content
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Avatar")]

<UniformGrid Columns="2" NarrowColumns="1">
    <Avatar Url="@Photo" Name="Alex Morgan" Size="96" SaveAsync="SavePhoto"
            Description="@Localization.Parse(TextKey.Catalog_Avatar_SampleDescription)"
            HelpText="@(!Preview ? Localization.Parse(TextKey.Catalog_Avatar_SampleHelp) : null)" />
</UniformGrid>

@code {
    [Parameter] public bool Preview { get; set; }

    private string? Photo;
    private Func<string, Task<bool>>? SavePhoto => Preview ? null : SavePhotoAsync;

    private Task<bool> SavePhotoAsync(string dataUrl)
    {
        Photo = dataUrl;
        StateHasChanged();
        return Task.FromResult(true);
    }
}
