@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System
@using System.Collections.Generic
@using System.Linq
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Content
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Card", DescriptionKey = "Key.Sample_CardSample_Description")]
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@if (Preview)
{
    <Card />
    <Card Title="@Localization.Parse(TextKey.Sample_EmptyCardWithATitle)" />
    <Card Prominent="true" Text="@Localization.Parse(TextKey.Sample_TurnIdeasIntoSharedResources)">
        <Actions><Button Variant="ButtonVariant.Elevated" Href="/examples/display/pricing">@Localization.Parse(TextKey.Sample_ExploreDemoPlans)</Button></Actions>
    </Card>
}
else
{
    <Button Variant="ButtonVariant.Secondary" OnClick="() => Selected = !Selected">@Localization.Parse(TextKey.Sample_SwitchDemoProject)</Button>
    <Card Title="@(Selected ? Localization.Parse(TextKey.Sample_DemoProjectB) : Localization.Parse(TextKey.Sample_DemoProjectA))">
        <p>@Localization.Parse(TextKey.Sample_OrganizeProjectResourcesAndShareProgressWithMembers)</p>
        <p>@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_CardState), Selected ? Localization.Parse(TextKey.Sample_Processing) : Localization.Parse(TextKey.Sample_Draft))</p>
    </Card>
    <Section Title="@Localization.Parse(TextKey.Sample_PresentationVariants)">
        <AccessActions Label="@Localization.Parse(TextKey.Sample_CardDemoSettings)">
            <StandaloneCheckBox Label="@Localization.Parse(TextKey.Sample_UseProminentCard)" @bind-Value="Prominent" />
            <StandaloneCheckBox Label="@Localization.Parse(TextKey.Sample_AlwaysStackVertically)" @bind-Value="Stacked" />
            <StandaloneCheckBox Label="@Localization.Parse(TextKey.Sample_ShowActions)" @bind-Value="ShowActions" />
            <StandaloneCheckBox Label="@Localization.Parse(TextKey.Sample_LongTextAndActionLabels)" @bind-Value="LongText" />
        </AccessActions>
        <Card Prominent="Prominent" Stacked="Stacked" Text="@PresentationText" Actions="PresentationActions" />
        <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_LocalActionCount), ActionCount)</p>
    </Section>
}
@code {
    [Parameter] public bool Preview { get; set; }
    private bool Selected, Prominent = true, ShowActions = true, LongText, Stacked;
    private int ActionCount;
    private string PresentationText => LongText
        ? Localization.Parse(TextKey.Sample_KeepTheIntroductionAndNextActionInOneStandardCardThisLongerFictionalDescriptionChecksNaturalWrappingAndGrowthP)
        : Localization.Parse(TextKey.Sample_TurnProjectIdeasIntoResourcesToShare);
    private RenderFragment? PresentationActions => ShowActions ? @<Button Variant="ButtonVariant.Elevated" OnClick="() => ActionCount++">@(LongText ? Localization.Parse(TextKey.Sample_ReadAllDetailsOfTheLocalFictionalOfferForDemonstration) : Localization.Parse(TextKey.Sample_LocalDemoAction))</Button> : null;
}
