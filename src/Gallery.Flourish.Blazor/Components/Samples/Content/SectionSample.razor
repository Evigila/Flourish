@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System
@using System.Collections.Generic
@using System.Linq
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Content
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Section")]
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@if (Preview)
{
    <Section />
    <Section Title="@Localization.Parse(TextKey.Sample_EmptySectionWithATitle)" />
    <Section Title="@Localization.Parse(TextKey.Sample_EmptySectionWithActions)"><Actions><Button Disabled="true">@Localization.Parse(TextKey.Sample_Action)</Button></Actions></Section>
}
else
{
    <Section Title="@Localization.Parse(TextKey.Sample_DemoContactDetails)">
        <ChildContent><p>@Localization.Parse(TextKey.Sample_FictionalContactDemoMemberEmailSampleExampleCom)</p><p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_CheckCount), Checks)</p></ChildContent>
        <Actions><Button OnClick="() => Checks++">@Localization.Parse(TextKey.Sample_CheckDemoDetails)</Button></Actions>
    </Section>
}
@code { [Parameter] public bool Preview { get; set; } private int Checks; }
