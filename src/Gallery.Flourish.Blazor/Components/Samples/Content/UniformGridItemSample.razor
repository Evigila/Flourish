@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Blazor.Components
@using Microsoft.AspNetCore.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Content
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("UniformGridItem")]

@if (Preview)
{
    <UniformGrid Shape="UniformGridShape.Square">
        <UniformGridItem Variant="UniformGridVariant.Elevated" aria-label="@Localization.Parse(TextKey.Sample_EmptyElevatedInformationTile)" />
        <UniformGridItem Variant="UniformGridVariant.FilledElevated" aria-label="@Localization.Parse(TextKey.Sample_EmptyFilledElevatedInformationTile)" />
        <UniformGridItem Variant="UniformGridVariant.Danger" aria-label="@Localization.Parse(TextKey.Sample_EmptyDangerInformationTile)" />
    </UniformGrid>
}
else
{
    <div class="f-inline-actions">
        <Button Variant="ButtonVariant.Secondary" Text="@(ShowArchived ? Localization.Parse(TextKey.Sample_ViewActiveProjects) : Localization.Parse(TextKey.Sample_ViewArchivedProjects))" OnClick="() => ShowArchived = !ShowArchived" />
    </div>
    <UniformGrid Shape="UniformGridShape.Square" Variant="UniformGridVariant.FilledElevated">
        <UniformGridItem Title="@Localization.Parse(TextKey.Sample_Design)" Icon="palette" Text="@(ShowArchived ? Localization.Parse(TextKey.Sample_Archived) : Localization.Parse(TextKey.Sample_InProgress))" />
        <UniformGridItem Title="@Localization.Parse(TextKey.Sample_Documents)" Icon="description" Text="@(ShowArchived ? Localization.Parse(TextKey.Sample_Archived) : Localization.Parse(TextKey.Sample_PendingReview))" />
        <UniformGridItem Title="@Localization.Parse(TextKey.Sample_Components)" Icon="widgets" Text="@(ShowArchived ? Localization.Parse(TextKey.Sample_Archived) : Localization.Parse(TextKey.Sample_PendingPublication))" Variant="UniformGridVariant.Elevated" />
    </UniformGrid>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private bool ShowArchived;
}
