@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System
@using System.Collections.Generic
@using System.Linq
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Content
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("UniformGrid")]
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor
@using ArkheideSystem.Flourish.Blazor.Components
@if (Preview)
{
    <UniformGrid>
        <UniformGridItem Variant="UniformGridVariant.Elevated" aria-label="@Localization.Parse(TextKey.Sample_EmptyRectangularElevatedTile)" />
        <UniformGridItem Variant="UniformGridVariant.Filled" aria-label="@Localization.Parse(TextKey.Sample_EmptyRectangularFilledTile)" />
        <UniformGridItem Variant="UniformGridVariant.Outlined" aria-label="@Localization.Parse(TextKey.Sample_EmptyRectangularOutlinedTile)" />
        <UniformGridItem Variant="UniformGridVariant.Danger" aria-label="@Localization.Parse(TextKey.Sample_EmptyRectangularDangerActionTile)" />
    </UniformGrid>
    <UniformGrid Shape="UniformGridShape.Square" Variant="UniformGridVariant.Filled">
        <UniformGridItem aria-label="@Localization.Parse(TextKey.Sample_EmptySquareTile)" />
        <UniformGridItem aria-label="@Localization.Parse(TextKey.Sample_EmptySquareTile)" />
        <UniformGridItem aria-label="@Localization.Parse(TextKey.Sample_EmptySquareTile)" />
    </UniformGrid>
}
else
{
    <div class="f-inline-actions">
        <Button Text="@(Shape == UniformGridShape.Square ? Localization.Parse(TextKey.Sample_SwitchToRectangle) : Localization.Parse(TextKey.Sample_SwitchToSquare))" OnClick="ToggleShape" />
        <Button Variant="ButtonVariant.Secondary" Text="@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_SwitchAppearance), Variant)" OnClick="ToggleVariant" />
        <Button Variant="ButtonVariant.Secondary" Text="@(Columns.HasValue ? Localization.Parse(TextKey.Sample_AutomaticColumns) : Localization.Parse(TextKey.Sample_ThreeFixedColumns))" OnClick="ToggleColumns" />
        <Button Variant="ButtonVariant.Secondary" Text="@(Rows.HasValue ? Localization.Parse(TextKey.Sample_AutomaticRows) : Localization.Parse(TextKey.Sample_TwoFixedRows))" OnClick="ToggleRows" />
        <Button Variant="ButtonVariant.Secondary" Text="@(IconSupport == false ? Localization.Parse(TextKey.Sample_EnableIconSection) : Localization.Parse(TextKey.Sample_UseContinuousLayout))" OnClick="ToggleIconSupport" />
    </div>
    <UniformGrid Shape="Shape" Variant="Variant" Columns="Columns" Rows="Rows" IconSupport="IconSupport">
        <UniformGridItem Title="@Localization.Parse(TextKey.Sample_Draft)" Icon="palette" Text="@Localization.Parse(TextKey.Sample_PendingReview)" />
        <UniformGridItem Title="@Localization.Parse(TextKey.Sample_Resources)" Icon="folder" Text="@Localization.Parse(TextKey.Sample_Archived)" />
        <UniformGridButton Title="@Localization.Parse(TextKey.Sample_Open)" Icon="edit" Text="@Localization.Parse(TextKey.Sample_UpdateCount)" OnClick="() => OpenedCount++" />
    </UniformGrid>
    <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_OpenedDraftCount), OpenedCount)</p>
    <UniformGrid Columns="2" NarrowColumns="1" CellHeight="100" IconSupport="false">
        <UniformGridButton Title="@Localization.Parse(TextKey.Common_Save)" Variant="UniformGridVariant.Filled" OnClick="() => OpenedCount++" />
        <UniformGridButton Title="@Localization.Parse(TextKey.Common_Cancel)" Variant="UniformGridVariant.Outlined" OnClick="() => OpenedCount = 0" />
    </UniformGrid>
}
@code {
    [Parameter] public bool Preview { get; set; }
    private int? Columns, Rows;
    private bool? IconSupport;
    private int OpenedCount;
    private UniformGridShape Shape = UniformGridShape.Rectangle;
    private UniformGridVariant Variant = UniformGridVariant.Elevated;
    private void ToggleShape() => Shape = Shape == UniformGridShape.Rectangle ? UniformGridShape.Square : UniformGridShape.Rectangle;
    private void ToggleVariant() => Variant = Variant switch
    {
        UniformGridVariant.Elevated => UniformGridVariant.Filled,
        UniformGridVariant.Filled => UniformGridVariant.Outlined,
        UniformGridVariant.Outlined => UniformGridVariant.Danger,
        _ => UniformGridVariant.Elevated
    };
    private void ToggleColumns() => Columns = Columns.HasValue ? null : 3;
    private void ToggleRows() => Rows = Rows.HasValue ? null : 2;
    private void ToggleIconSupport() => IconSupport = IconSupport == false ? true : false;
}
