@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System
@using System.Collections.Generic
@using System.Linq
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Content
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Icon", DescriptionKey = "Key.Sample_IconSample_Description")]
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor
@using ArkheideSystem.Flourish.Blazor.Components
@if (Preview)
{
    <span aria-label="@Localization.Parse(TextKey.Sample_DefaultIcon)"><Icon /></span>
    <Icon Name="home" /><Icon Name="search" /><Icon Name="menu" /><Icon Name="close" />
}
else
{
    <Field Label="@Localization.Parse(TextKey.Sample_DemoIcon)" Id="@Id"><SelectBox TValue="string" Options="Names" @bind-Value="Name" /></Field>
    <Button Icon="@Name" aria-label="@Localization.Parse(TextKey.Sample_RunDemoIconAction)" OnClick="() => Count++" />
    <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_DemoActionCount), Count)</p>
    <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_AvailableIconCount), IconCatalog.Names.Count)</p>
}
@code {
    [Parameter] public bool Preview { get; set; }
    private static readonly SelectOption<string>[] Names = new[] { "home", "search", "settings", "inventory_2" }
        .Select(name => new SelectOption<string>(name, name)).ToArray();
    private readonly string Id = $"icon-choice-{Guid.NewGuid():N}";
    private string Name = "settings";
    private int Count;
}
