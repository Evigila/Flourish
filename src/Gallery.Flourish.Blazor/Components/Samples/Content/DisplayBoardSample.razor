@inherits LocalizedComponentBase
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Content
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("DisplayBoard")]
@using System
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using ArkheideSystem.Flourish.Blazor.Components
@if (Preview)
{
    <DisplayBoard />
    <DisplayBoard Dotted="false" CopyText="" CopyLabel="@Localization.Parse(TextKey.Sample_CopyCode)" CopiedLabel="@Localization.Parse(TextKey.Sample_Copied)">
        <CodeBlock Text="" Language="razor" />
    </DisplayBoard>
}
else
{
    <CheckBox Label="@Localization.Parse(TextKey.Sample_ShowDotPattern)" @bind-Value="Dotted" />
    <CheckBox Label="@Localization.Parse(TextKey.Sample_CenterContent)" @bind-Value="Centered" />
    <DisplayBoard Dotted="Dotted" Centered="Centered">
        <Button Icon="add" Text="@Localization.Parse(TextKey.Sample_CreateDemoItem)" OnClick="() => Count++" />
        <span role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_CreatedItemsCount), Count)</span>
    </DisplayBoard>
    <DisplayBoard Dotted="false" Centered="false">
        <Section Title="@Localization.Parse(TextKey.Sample_Venue)">
            <FormLayout Columns="1">
                <Field Id="@VenueFieldId" Label="@Localization.Parse(TextKey.Sample_VenueName)">
                    <StandaloneTextBox @bind-Value="VenueName" />
                </Field>
            </FormLayout>
        </Section>
    </DisplayBoard>
    <DisplayBoard Dotted="false" CopyText="@Example"
                  CopyLabel="@Localization.Parse(TextKey.Sample_CopyCode)" CopiedLabel="@Localization.Parse(TextKey.Sample_Copied)" CopyingLabel="@Localization.Parse(TextKey.Sample_Copying)"
                  CopyFailedLabel="@Localization.Parse(TextKey.Sample_CouldNotCopySelectTheCodeAndCopyItManually)">
        <CodeBlock Text="@Example" Language="razor" />
    </DisplayBoard>
}
@code {
    [Parameter] public bool Preview { get; set; }
    private bool Dotted = true;
    private bool Centered = true;
    private int Count;
    private readonly string VenueFieldId = $"board-venue-{Guid.NewGuid():N}";
    private string? VenueName;
    private const string Example = """
        @using ArkheideSystem.Flourish.Blazor.Components
        <CheckBox Label="显示点阵" @bind-Value="Dotted" />
        <CheckBox Label="内容居中" @bind-Value="Centered" />
        <DisplayBoard Dotted="Dotted" Centered="Centered">
            <Button Icon="add" Text="创建演示项" OnClick="() => Count++" />
            <span role="status">已创建 @Count 个演示项</span>
        </DisplayBoard>
        @code {
            private bool Dotted = true;
            private bool Centered = true;
            private int Count;
        }
        """;
}
