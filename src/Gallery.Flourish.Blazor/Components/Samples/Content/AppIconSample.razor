@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System
@using System.Collections.Generic
@using System.Linq
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Content
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.AppIcon")]
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives
@if (Preview)
{
    @foreach (var size in Sizes) { <span>@size <ArkheideSystem.Flourish.Blazor.Components.Primitives.AppIcon Name="home" Size="@size" /></span> }
}
else
{
    <Field Label="尺寸角色" Id="@Id"><SelectBox TValue="string" Options="SizeOptions" @bind-Value="Size" /></Field>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.AppIcon Name="inventory_2" Size="@Size" />
    <Button Icon="inventory_2" aria-label="检查模拟项目" OnClick="() => Count++" />
    <p role="status">模拟检查次数：@Count</p>
}
@code {
    [Parameter] public bool Preview { get; set; }
    private static readonly string[] Sizes = ["standard", "primary", "tool", "search", "information"];
    private static readonly SelectOption<string>[] SizeOptions = Sizes.Select(size => new SelectOption<string>(size, size)).ToArray();
    private readonly string Id = $"appicon-size-{Guid.NewGuid():N}";
    private string Size = "standard";
    private int Count;
}
