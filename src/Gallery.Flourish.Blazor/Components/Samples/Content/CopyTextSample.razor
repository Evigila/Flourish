@inherits LocalizedComponentBase
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Content
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("CopyText", DescriptionKey = "Key.Sample_CopyTextSample_Description")]

<CopyText Value="@Value" />
@if (!Preview)
{
    <Button Variant="ButtonVariant.Secondary" OnClick="Change">@Localization.Parse(TextKey.Sample_SwitchDemoRawValue)</Button>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private string Value = "DEMO-001";
    private void Change() => Value = Value == "DEMO-001" ? "<demo>&文本" : "DEMO-001";
}
