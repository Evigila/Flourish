@inherits LocalizedComponentBase
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Content
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("InlineActions")]

<InlineActions>
    <Button OnClick="Increment">@Localization.Parse(TextKey.Sample_IncrementDemo)</Button>
    <Button Variant="ButtonVariant.Secondary" OnClick="Reset">@Localization.Parse(TextKey.Sample_Reset)</Button>
</InlineActions>
<PageBody Fluid="false">
    @foreach (var alignment in Enum.GetValues<HorizontalAlignment>())
    {
        <InlineActions Alignment="alignment">
            <Button OnClick="Increment">@Localization.Parse(TextKey.Sample_IncrementDemo)</Button>
            <Button Variant="ButtonVariant.Secondary" OnClick="Reset">@Localization.Parse(TextKey.Sample_Reset)</Button>
        </InlineActions>
    }
</PageBody>
<Field Id="inline-actions-name" Label="@Localization.Parse(TextKey.Sample_ExampleName)" Required="true">
    <ChildContent><StandaloneTextBox @bind-Value="Name" MaxLength="100" /></ChildContent>
    <Actions>
        <InlineActions Alignment="HorizontalAlignment.End">
            <Button Type="button" Disabled="@string.IsNullOrWhiteSpace(Name)" OnClick="Create">@Localization.Parse(TextKey.Sample_Create)</Button>
        </InlineActions>
    </Actions>
</Field>
@if (!Preview) { <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_LocalOnlyActionCount), Count)</p> }

@code {
    [Parameter] public bool Preview { get; set; }
    private int Count;
    private string Name = string.Empty;
    private void Create() { if (string.IsNullOrWhiteSpace(Name)) return; Count++; Name = string.Empty; }
    private void Increment() => Count++;
    private void Reset() => Count = 0;
}
