@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Display
@attribute [SampleFor("OfferStage")]
<UniformGrid Centered="true" Columns="2" NarrowColumns="1" id="@(Id + "-links")">
    <UniformGridButton Title="Basic" Href="@("#" + Id + "-basic")" />
    <UniformGridButton Title="Plus" Href="@("#" + Id + "-plus")" />
</UniformGrid>
<OfferStage Id="@Id" LinkScopeId="@(Id + "-links")" AutoRotate="@(!Preview)" Label="虚构报价">
    <OfferCard Id="@(Id + "-basic")" Title="Basic" Description="虚构基础方案，不执行许可判断。"><Button Disabled="true">仅作展示</Button></OfferCard>
    <OfferCard Id="@(Id + "-plus")" Title="Plus" Description="虚构扩展方案，不执行计费。"><Button Disabled="true">仅作展示</Button></OfferCard>
</OfferStage>
@if (!Preview) { <p>AutoRotate 启用时提供库内 Quiet 暂停/恢复按钮，增强完成后可使用；按钮文字跟随框架本地化，也可用 PauseRotationLabel / ResumeRotationLabel 明确覆盖。焦点、指针与减少动态效果由舞台处理。没有 JavaScript 时仍显示全部报价内容。</p> }
@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = "offer-stage-" + Guid.NewGuid().ToString("N");
}
