@inherits LocalizedComponentBase
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Display
@attribute [SampleFor("OfferStage", DescriptionKey = "Key.Sample_OfferStageSample_Description")]
<UniformGrid Centered="true" Columns="2" NarrowColumns="1" id="@(Id + "-links")">
    <UniformGridButton Title="Basic" Href="@("#" + Id + "-basic")" />
    <UniformGridButton Title="Plus" Href="@("#" + Id + "-plus")" />
</UniformGrid>
<OfferStage Id="@Id" LinkScopeId="@(Id + "-links")" AutoRotate="@(!Preview)" Label="@Localization.Parse(TextKey.Sample_FictionalOffers)">
    <OfferCard Id="@(Id + "-basic")" Title="Basic" Description="@Localization.Parse(TextKey.Sample_FictionalBasicPlanNoLicenseChecksArePerformed)"><Button Disabled="true">@Localization.Parse(TextKey.Display_DemoOnly)</Button></OfferCard>
    <OfferCard Id="@(Id + "-plus")" Title="Plus" Description="@Localization.Parse(TextKey.Sample_FictionalExtendedPlanNoBillingTakesPlace)"><Button Disabled="true">@Localization.Parse(TextKey.Display_DemoOnly)</Button></OfferCard>
</OfferStage>
@if (!Preview) {
    <OfferStage Id="@(Id + "-icons")" RotationControlIconOnly="true" Label="@Localization.Parse(TextKey.Sample_IconCarouselControlExample)">
        <OfferCard Id="@(Id + "-icons-basic")" Title="Basic" Description="@Localization.Parse(TextKey.Sample_IconButtonExampleNoLicenseChecksArePerformed)"><Button Disabled="true">@Localization.Parse(TextKey.Display_DemoOnly)</Button></OfferCard>
        <OfferCard Id="@(Id + "-icons-plus")" Title="Plus" Description="@Localization.Parse(TextKey.Sample_OneOfferStageWithoutASeparateCarouselController)"><Button Disabled="true">@Localization.Parse(TextKey.Display_DemoOnly)</Button></OfferCard>
    </OfferStage>
}
@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = "offer-stage-" + Guid.NewGuid().ToString("N");
}
