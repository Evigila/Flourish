@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Display
@attribute [SampleFor("LogoDisplayer", DescriptionKey = "Key.Sample_LogoDisplayerSample_Description")]
@inherits LocalizedComponentBase

@if (!Preview)
{
    <StandaloneCheckBox Label="@Localization.Parse(TextKey.Sample_ShowAnExplicitIdentityOverride)" @bind-Value="OverrideIdentity" />
}
<LogoDisplayer LogoPath="@(OverrideIdentity ? "gallery.svg" : null)"
               ProjectName="@(OverrideIdentity ? Localization.Parse(TextKey.Display_DemoOnly) : null)"
               ContextName="@Localization.Parse(TextKey.Nav_DisplayLogin)"
               Description="@Localization.Parse(TextKey.Access_LoginDescription)" TitleId="@TitleId" HeadingLevel="2" />
@if (!Preview)
{
    <Button Variant="ButtonVariant.Underline" Href="/examples/display/login">@Localization.Parse(TextKey.Nav_DisplayLogin)</Button>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private bool OverrideIdentity;
    private readonly string TitleId = "logo-displayer-sample-" + Guid.NewGuid().ToString("N");
}
