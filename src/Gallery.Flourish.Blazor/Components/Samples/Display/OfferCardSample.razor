@inherits LocalizedComponentBase
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Display
@attribute [SampleFor("OfferCard")]
<OfferStage Id="@Id" AutoRotate="false" Label="@Localization.Parse(TextKey.Sample_StaticFictionalOffers)">
    <OfferCard Id="@(Id + "-basic")" Title="Basic" Description="@Localization.Parse(TextKey.Sample_UseOnlyAsAnOfferStageChild)"><Button Variant="ButtonVariant.Secondary" Disabled="true">@Localization.Parse(TextKey.Sample_0NoncommercialOffer)</Button></OfferCard>
    <OfferCard Id="@(Id + "-team")" Title="Team" Description="@Localization.Parse(TextKey.Sample_NoLicensingOrPricingRulesAreIncluded)"><Button Variant="ButtonVariant.Secondary" Disabled="true">@Localization.Parse(TextKey.Sample_10NoncommercialOffer)</Button></OfferCard>
</OfferStage>
@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = "offer-card-" + Guid.NewGuid().ToString("N");
}
