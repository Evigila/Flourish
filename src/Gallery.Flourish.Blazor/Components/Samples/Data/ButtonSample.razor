@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Button")]

@if (Preview)
{
    <div class="f-inline-actions">
        @foreach (var variant in Variants) { <Button Variant="variant" Text="@variant.ToString()" /> }
    </div>
    <div class="f-inline-actions">
        @foreach (var variant in Variants) { <Button Variant="variant" Icon="add" Text="@variant.ToString()" /> }
    </div>
    <div class="f-inline-actions">
        @foreach (var variant in Variants) { <Button Variant="variant" Icon="add" aria-label="@Localization.Parse(TextKey.Sample_VariantAdd, variant)" /> }
        <Button Text="@Localization.Parse(TextKey.Sample_Unavailable)" Disabled="true" />
        <Button Icon="save" Text="@Localization.Parse(TextKey.Sample_Save)" Busy="true" BusyLabel="@Localization.Parse(TextKey.Sample_Processing)" />
    </div>
}
else
{
    <div class="f-inline-actions">
        <Button Icon="save" Text="@Localization.Parse(TextKey.Sample_SaveDraft)" Busy="Saving" BusyLabel="@Localization.Parse(TextKey.Sample_Saving)" OnClick="SaveAsync" />
        <Button Variant="ButtonVariant.Secondary" Icon="restart_alt" Text="@Localization.Parse(TextKey.Sample_Reset)" Disabled="Saving" OnClick="Reset" />
        <Button Variant="ButtonVariant.Quiet" Icon="info" Text="@Localization.Parse(TextKey.Sample_Instructions)" OnClick="() => HelpVisible = !HelpVisible" />
    </div>
    <p role="status">@Localization.Parse(TextKey.Sample_SavedCount, SavedCount)</p>
    @if (HelpVisible) { <p>@Localization.Parse(TextKey.Sample_SaveUsesFilledResetUsesOutlinedAndLowerPriorityActionsUseQuiet)</p> }
}

@code {
    [Parameter] public bool Preview { get; set; }
    private static readonly ButtonVariant[] Variants = [ButtonVariant.Primary, ButtonVariant.Secondary,
        ButtonVariant.Danger, ButtonVariant.Quiet, ButtonVariant.Underline, ButtonVariant.Elevated];
    private bool Saving, HelpVisible;
    private int SavedCount;
    private async Task SaveAsync()
    {
        if (Saving) return;
        Saving = true;
        try { await Task.Delay(600); SavedCount++; }
        finally { Saving = false; }
    }
    private void Reset() => SavedCount = 0;
}
