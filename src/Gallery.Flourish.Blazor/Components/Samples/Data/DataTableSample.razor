@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("DataTable<TItem>", DescriptionKey = "Key.Sample_DataTableSample_Description")]

@if (Preview)
{
    <p>@Localization.Parse(TextKey.Sample_ListMode)</p>
    <DataTable TItem="Entry" Items="Array.Empty<Entry>()" Columns="Columns" View="TableView.Table" Label="@Localization.Parse(TextKey.Sample_EmptyList)" EmptyMessage="@Localization.Parse(TextKey.Sample_NoDataYet)" />
    <p>@Localization.Parse(TextKey.Sample_CardMode)</p>
    <DataTable TItem="Entry" Items="Array.Empty<Entry>()" Columns="Columns" View="TableView.Cards" Label="@Localization.Parse(TextKey.Sample_EmptyCards)" EmptyMessage="@Localization.Parse(TextKey.Sample_NoDataYet)" />
}
else
{
    <div class="f-inline-actions">
        <Button Variant="ButtonVariant.Secondary" OnClick="() => State = DemoState.Loaded">@Localization.Parse(TextKey.Sample_WithData)</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => State = DemoState.Empty">@Localization.Parse(TextKey.Sample_EmptyData)</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => State = DemoState.Loading">@Localization.Parse(TextKey.Sample_Loading)</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => State = DemoState.Error">@Localization.Parse(TextKey.Sample_LoadFailed)</Button>
    </div>
    <DataTable TItem="Entry" Items="ShownItems" Columns="Columns" Actions="Actions" @bind-PageSize="PageSize" @bind-View="View"
               ItemKey="@(item => item.Id)" RowLabel="@(item => item.Name)" OnRowOpen="Open"
               Loading="@(State == DemoState.Loading)" Error="@(State == DemoState.Error ? Localization.Parse(TextKey.Sample_SimulatedLoadFailureSelectWithDataToRetry) : null)"
               Label="@Localization.Parse(TextKey.Sample_FictionalSuppliesDirectory)" LoadingMessage="@Localization.Parse(TextKey.Sample_LoadingFictionalRecords)" EmptyMessage="@Localization.Parse(TextKey.Sample_NoFictionalRecords)" />
    <p role="status">@Message</p>
    <h3 id="native-row-demo">@Localization.Parse(TextKey.Sample_NativeGETPOSTRowActions)</h3>
    <DataTable TItem="Entry" Items="NativeItems" Columns="Columns" ItemKey="@(item => item.Id)" RowLabel="@(item => item.Name)"
               OnRowOpen="Open" RowOpenAvailable="@(item => item.Id == 1)" PreferenceKey="gallery.data-table.native-records" Label="@Localization.Parse(TextKey.Sample_NativeTransportExample)">
        <RowActionsContent Context="item">
            @if (item.Id == 1)
            {
                <Button Variant="ButtonVariant.Quiet" Class="f-menu-item f-dropdown-item" role="menuitem"
                        Href="@($"/controls/data/datatablesample/?demo={item.Id}#native-row-demo")" target="_blank" rel="noopener" data-record-open>@Localization.Parse(TextKey.Sample_OpenExampleGET)</Button>
                <form method="post" action="/controls/data/datatablesample/" target="_blank" data-enhance="false"
                      @onsubmit="() => SimulatePost(item)" @onsubmit:preventDefault="true">
                    <input type="hidden" name="recordId" value="@item.Id" />
                    <Button Variant="ButtonVariant.Quiet" Class="f-menu-item f-dropdown-item" role="menuitem" Type="submit" Disabled="@(!NativeDemoReady)">@Localization.Parse(TextKey.Sample_DemoSubmissionPOST)</Button>
                </form>
            }
            else
            {
                <Button Variant="ButtonVariant.Quiet" Class="f-menu-item f-dropdown-item" role="menuitem" Disabled="true">@Localization.Parse(TextKey.Sample_RecordCannotBeOpened)</Button>
            }
        </RowActionsContent>
    </DataTable>
    <h3>@Localization.Parse(TextKey.Sample_BusinessEditingInTheSameTable)</h3>
    <DataTable TItem="Entry" Items="NativeItems" Columns="EditableColumns" Purpose="TablePurpose.Worklist" PageSize="1" ItemKey="item => item.Id" Label="@Localization.Parse(TextKey.Sample_WorklistWithRetainedDrafts)">
        <CellTemplate Context="cell">
            <StandaloneTextBox Value="@(Drafts.GetValueOrDefault(cell.Item.Id) ?? cell.Item.Name)" ValueChanged="value => Drafts[cell.Item.Id] = value ?? string.Empty" aria-label="@Localization.Parse(TextKey.Sample_NameNumber, cell.Item.Id)" required />
        </CellTemplate>
    </DataTable>
    <DataTable TItem="Entry" Items="NativeItems" Columns="BulkColumns" ItemKey="item => item.Id" Label="@Localization.Parse(TextKey.Sample_OptionalBulkEditing)" PreferenceKey="gallery.data-table.bulk"
               BulkEditRequested="() => DemoBulk = true" BulkEditing="DemoBulk" AllEditSelected="@(Selected.Count == NativeItems.Count)"
               IsSelectedForEditing="item => Selected.Contains(item.Id)" ToggleEditSelection="ToggleDemoSelection" ToggleAllEditSelection="ToggleAllDemoSelection">
        <BulkEditCell Context="column">
            @if (column.Key == "group")
            {
                <StandaloneSelectBox TValue="string" Value="@BulkDrafts.GetValueOrDefault(column.Key)" ValueChanged="value => BulkDrafts[column.Key] = value ?? string.Empty" aria-label="@Localization.Parse(TextKey.Sample_BulkColumn, column.Header)">
                    @foreach (var group in Items.Select(item => item.Group).Distinct()) { <option value="@group">@group</option> }
                </StandaloneSelectBox>
            }
            else { <StandaloneTextBox Value="@BulkDrafts.GetValueOrDefault(column.Key)" ValueChanged="value => BulkDrafts[column.Key] = value ?? string.Empty" aria-label="@Localization.Parse(TextKey.Sample_BulkColumn, column.Header)" /> }
        </BulkEditCell>
        <BulkEditActions>
            <p>@Localization.Parse(TextKey.Sample_LocalSelectionCount, Selected.Count)</p>
            <Button Variant="ButtonVariant.Secondary" OnClick="() => { RecordDemoIntent(); DemoBulk = false; }">@Localization.Parse(TextKey.Sample_EndDemoEditing)</Button>
        </BulkEditActions>
    </DataTable>
    <h3>@Localization.Parse(TextKey.Sample_RemoteResultsWithTheSameSearchContract)</h3>
    <DataTable TItem="Entry" Items="RemoteItems" Columns="Columns" SearchMode="TableSearchMode.Remote" SearchColumnKey="@RemoteColumn"
               SearchQuery="@RemoteQuery" SearchChanged="SimulateRemoteSearch" PaginationResetKey="@((RemoteColumn, RemoteQuery))" ItemKey="item => item.Id" Label="@Localization.Parse(TextKey.Sample_SimulatedRemoteDirectory)" />
    <h3>@Localization.Parse(TextKey.Sample_ProgressiveDirectoryWithoutACircuit)</h3>
    <DataTable TItem="Entry" Items="Items" Columns="DirectoryColumns" Progressive="true" RowOpenHref="DirectoryHref" ItemKey="item => item.Id" Label="@Localization.Parse(TextKey.Sample_ProgressiveFictionalDirectory)" />
}

@code {
    [Parameter] public bool Preview { get; set; }
    private enum DemoState { Loaded, Empty, Loading, Error }
    private sealed record Entry(int Id, string Name, string Group, decimal Price);
    private DemoState State = DemoState.Loaded;
    private TableView View;
    private int PageSize = 10;
    private bool NativeDemoReady;
    private bool DemoBulk;
    private readonly Dictionary<int, string> Drafts = [];
    private readonly Dictionary<string, string> BulkDrafts = [];
    private readonly HashSet<int> Selected = [];
    private string RemoteQuery = string.Empty;
    private string? RemoteColumn = "name";
    private IReadOnlyList<Entry> RemoteItems => TableData<Entry>.Filter(Items, Columns, RemoteQuery, RemoteColumn, System.Globalization.CultureInfo.CurrentCulture);
    private IReadOnlyList<TableColumn<Entry>> EditableColumns => [new("name", Localization.Parse(TextKey.Record_Name), item => item.Name, CanHide: false, UsesTemplate: true)];
    private IReadOnlyList<TableColumn<Entry>> DirectoryColumns => [new("name", Localization.Parse(TextKey.Record_Name), item => item.Name, CanHide: false), new("group", Localization.Parse(TextKey.Sample_Category), item => item.Group)];
    private string MessageKey = "Key.Sample_NoRowActionPerformedYet";
    private object?[] MessageArguments = [];
    private string Message => Localization.Parse(MessageKey, MessageArguments);
    private void SetMessage(string key, params object?[] arguments) { MessageKey = key; MessageArguments = arguments; }
    private readonly IReadOnlyList<Entry> Items = Enumerable.Range(1, 23)
        .Select(index => new Entry(index, $"演示用品 {index:00}", index % 2 == 0 ? "文具" : "日用品", 3.5m + index)).ToArray();
    private IReadOnlyList<Entry> ShownItems => State == DemoState.Loaded ? Items : Array.Empty<Entry>();
    private IReadOnlyList<Entry> NativeItems => Items.Take(2).ToArray();
    private IReadOnlyList<TableColumn<Entry>> BulkColumns => [Columns[0], Columns[2], Columns[1]];
    private IReadOnlyList<TableColumn<Entry>> Columns =>
    [
        new("name", Localization.Parse(TextKey.Record_Name), item => item.Name, CanHide: false),
        new("group", Localization.Parse(TextKey.Sample_Category), item => item.Group),
        new("price", Localization.Parse(TextKey.Sample_UnitPrice), item => item.Price, Format: item => item.Price.ToString("0.00", CultureInfo.GetCultureInfo(Localization.Culture)))
    ];
    private IReadOnlyList<RowAction<Entry>> Actions =>
    [new(Localization.Parse(TextKey.Sample_AddToLocalFavorites), item => { SetMessage(TextKey.Sample_FavoriteRecord, item.Name); return InvokeAsync(StateHasChanged); })];
    private void Open(Entry item) => SetMessage(TextKey.Sample_OpenRecord, item.Name, item.Group, item.Price);
    private void SimulatePost(Entry item) => SetMessage(TextKey.Sample_PostIntent, item.Name);
    private void SimulateRemoteSearch(TableSearchRequest request) { RemoteColumn = request.ColumnKey; RemoteQuery = request.Value; }
    private void RecordDemoIntent() => SetMessage(TextKey.Sample_EditIntent, Selected.Count);
    private static string DirectoryHref(Entry _) => "/controls/data/datatablesample/#native-row-demo";
    private void ToggleDemoSelection(Entry item) { if (!Selected.Remove(item.Id)) Selected.Add(item.Id); }
    private void ToggleAllDemoSelection() { if (Selected.Count == NativeItems.Count) Selected.Clear(); else Selected.UnionWith(NativeItems.Select(item => item.Id)); }
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        NativeDemoReady = true;
        StateHasChanged();
    }
}
