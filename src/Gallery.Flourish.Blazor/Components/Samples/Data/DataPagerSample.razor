@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Collections.Generic
@using System
@using System.Linq
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.DataPager", DescriptionKey = "Key.Sample_DataPagerSample_Description")]

@if (Preview)
{
    <p>@Localization.Parse(TextKey.Sample_WithRange)</p><ArkheideSystem.Flourish.Blazor.Components.Primitives.DataPager TotalCount="0" Label="@Localization.Parse(TextKey.Sample_EmptyListPagination)" />
    <p>@Localization.Parse(TextKey.Sample_CompactMode)</p><ArkheideSystem.Flourish.Blazor.Components.Primitives.DataPager TotalCount="0" ShowRange="false" Label="@Localization.Parse(TextKey.Sample_CompactPagination)" />
    <p>@Localization.Parse(TextKey.Sample_UnavailableState)</p><ArkheideSystem.Flourish.Blazor.Components.Primitives.DataPager TotalCount="0" Disabled="true" Label="@Localization.Parse(TextKey.Sample_UnavailablePagination)" />
}
else
{
    <div class="f-inline-actions">
        <Button Variant="ButtonVariant.Secondary" OnClick="() => SetPageSize(5)">@Localization.Parse(TextKey.Sample_5PerPage)</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => SetPageSize(10)">@Localization.Parse(TextKey.Sample_10PerPage)</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => Limited = !Limited">@(Limited ? Localization.Parse(TextKey.Sample_FullCollection) : Localization.Parse(TextKey.Sample_SimulateLimitedCollection))</Button>
    </div>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.DataPager TotalCount="23" CurrentPage="Page" PageSize="PageSize" PageChanged="page => Page = page" IsLimited="Limited" Label="@Localization.Parse(TextKey.Sample_FictionalRecordPagination)" />
    <ol start="@((Page - 1) * PageSize + 1)">
        @foreach (var value in Enumerable.Range(1, 23).Skip((Page - 1) * PageSize).Take(PageSize))
        {
            <li>@Localization.Parse(TextKey.Sample_FictionalRecord, value.ToString("00"))</li>
        }
    </ol>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private int Page = 1, PageSize = 5;
    private bool Limited;
    private void SetPageSize(int size) { PageSize = size; Page = 1; }
}
