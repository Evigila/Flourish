@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("LoadingState")]

@if (Preview)
{
    <LoadingState Message="正在加载…" />
    <LoadingState><span>自定义加载内容</span></LoadingState>
}
else
{
    <Button Busy="Loading" BusyLabel="正在加载" OnClick="LoadAsync">重新加载演示记录</Button>
    @if (Loading) { <LoadingState Message="正在读取演示记录…" /> }
    else if (Loaded) { <Notice Severity="NotificationSeverity.Success">已加载演示记录：示例项目 A。</Notice> }
    else { <EmptyState Title="尚未加载" /> }
}

@code {
    [Parameter] public bool Preview { get; set; }
    private bool Loading, Loaded;
    private async Task LoadAsync()
    {
        if (Loading) return;
        Loading = true;
        try { await Task.Delay(800); Loaded = true; }
        finally { Loading = false; }
    }
}
