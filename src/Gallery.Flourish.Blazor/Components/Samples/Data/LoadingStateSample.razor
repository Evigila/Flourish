@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("LoadingState")]

@if (Preview)
{
    <LoadingState Message="@Localization.Parse(TextKey.Sample_Loading_Demo)" />
    <LoadingState><span>@Localization.Parse(TextKey.Sample_CustomLoadingContent)</span></LoadingState>
}
else
{
    <Button Busy="Loading" BusyLabel="@Localization.Parse(TextKey.Sample_LoadingInProgress)" OnClick="LoadAsync">@Localization.Parse(TextKey.Sample_ReloadDemoRecords)</Button>
    @if (Loading) { <LoadingState Message="@Localization.Parse(TextKey.Sample_ReadingDemoRecords)" /> }
    else if (Loaded) { <Notice Severity="NotificationSeverity.Success">@Localization.Parse(TextKey.Sample_DemoRecordsLoadedDemoProjectA)</Notice> }
    else { <EmptyState Title="@Localization.Parse(TextKey.Sample_NotLoadedYet)" /> }
}

@code {
    [Parameter] public bool Preview { get; set; }
    private bool Loading, Loaded;
    private async Task LoadAsync()
    {
        if (Loading) return;
        Loading = true;
        try { await Task.Delay(800); Loaded = true; }
        finally { Loading = false; }
    }
}
