@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.EditingGrid", DescriptionKey = "Key.Sample_EditingGridSample_Description")]

@if (Preview)
{
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.EditingGrid Columns="Columns" Rows="Array.Empty<ArkheideSystem.Flourish.Blazor.Components.Primitives.GridRow>()" Label="@Localization.Parse(TextKey.Sample_EmptyEditingGrid)" EmptyMessage="@Localization.Parse(TextKey.Sample_NoDataYet)" Text="Captions" />
}
else
{
    <div class="f-inline-actions">
        <Button Variant="ButtonVariant.Secondary" OnClick="() => ReadOnly = !ReadOnly">@(ReadOnly ? Localization.Parse(TextKey.Sample_EnableEditing) : Localization.Parse(TextKey.Sample_DisableEditing))</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="UndoAsync" Disabled="@(History.Count == 0)">@Localization.Parse(TextKey.Sample_Undo)</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="RedoAsync" Disabled="@(RedoHistory.Count == 0)">@Localization.Parse(TextKey.Sample_Redo)</Button>
        <Button OnClick="SaveAsync">@Localization.Parse(TextKey.Sample_SaveLocalDraft)</Button>
    </div>
    <div class="f-inline-actions">
        <Button Variant="ButtonVariant.Quiet" OnClick="ShowValidationError">@Localization.Parse(TextKey.Sample_SimulateValidationError)</Button>
        <Button Variant="ButtonVariant.Quiet" OnClick="Reset">@Localization.Parse(TextKey.Sample_ResetFictionalData)</Button>
    </div>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.EditingGrid Columns="Columns" Rows="LocalizedRows" CellChanged="ChangeCell" Interactions="Interactions" EditDisabled="ReadOnly"
                            MeasurementRevision="Revision" Label="@Localization.Parse(TextKey.Sample_FictionalSuppliesEditingGrid)" TableLabel="@Localization.Parse(TextKey.Sample_FictionalSupplies)" Text="Captions" />
    <p role="status">@LocalizeText(Message)</p>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.EditingGrid Columns="TagColumns" Rows="TagRows" EditDisabled="ReadOnly" Label="@Localization.Parse(TextKey.Sample_StandardMultiSelectionCell)" TableLabel="@Localization.Parse(TextKey.Sample_CompositeCell)" Text="Captions">
        <CellTemplate Context="cell">
            <MultiSelectBox Id="@(InfoId + "-tags")" Label="@Localization.Parse(TextKey.Sample_Tags)" Items="LocalizedTagOptions" Changed="ChangeTags"
                            EmptySelectionText="@Localization.Parse(TextKey.Sample_NotSelected)" MultipleSelectionText="@Localization.Parse(TextKey.Sample_SelectedItems)" Disabled="cell.Disabled" />
        </CellTemplate>
    </ArkheideSystem.Flourish.Blazor.Components.Primitives.EditingGrid>
    <p id="@InfoId">@Localization.Parse(TextKey.Sample_LinkTargetLocalDraftDetails)</p>
}

@code {
    private string LocalizeText(string text) => Localization.TryParse(text, [], out var translated) ? translated : text;
    private IReadOnlyList<Primitives.GridRow> LocalizedRows => Rows.Select(row => row with
    {
        Label = Localization.Parse(TextKey.Sample_FictionalSupplyRecord, row.Cells[0].Display),
        Cells = row.Cells.Select(cell => cell with
        {
            Error = cell.Error is null ? null : LocalizeText(cell.Error),
            Display = cell.Editor == Primitives.GridEditorKind.Select ? Groups.FirstOrDefault(option => option.Value == cell.Value)?.Label ?? cell.Display
                : cell.Editor == Primitives.GridEditorKind.Link ? Localization.Parse(TextKey.Sample_ExampleDetails) : cell.Display,
            Options = cell.Editor == Primitives.GridEditorKind.Select ? Groups : cell.Options,
            LinkLabel = cell.Editor == Primitives.GridEditorKind.Link ? Localization.Parse(TextKey.Sample_SkipToExampleDetails) : cell.LinkLabel
        }).ToArray()
    }).ToArray();
    private IReadOnlyList<MultiSelectOption> LocalizedTagOptions => TagOptions.Select(option => option with
    {
        Label = option.Key switch
        {
            "stationery" => Localization.Parse(TextKey.Sample_Stationery),
            "daily" => Localization.Parse(TextKey.Sample_EverydaySupplies),
            _ => Localization.Parse(TextKey.Sample_SpareSupplies)
        }
    }).ToArray();
    [Parameter] public bool Preview { get; set; }
    private IReadOnlyList<ArkheideSystem.Flourish.Blazor.Components.Primitives.GridColumn> Columns =>
    [
        new("name", Localization.Parse(TextKey.Record_Name), Required: true, Identity: true), new("price", Localization.Parse(TextKey.Amount)), new("date", Localization.Parse(TextKey.Sample_Date)),
        new("note", Localization.Parse(TextKey.Sample_Notes)), new("group", Localization.Parse(TextKey.Sample_Category)), new("phone", Localization.Parse(TextKey.Sample_ContactPhone)), new("link", Localization.Parse(TextKey.Sample_Link))
    ];
    private IReadOnlyList<ArkheideSystem.Flourish.Blazor.Components.Primitives.GridOption> Groups => [new("stationery", Localization.Parse(TextKey.Sample_Stationery)), new("daily", Localization.Parse(TextKey.Sample_EverydaySupplies))];
    private Primitives.GridText Captions => new(Localization.Parse(TextKey.Sample_ColumnWidth), Localization.Parse(TextKey.Sample_PixelCount), Localization.Parse(TextKey.Sample_DragOrUseArrowKeysToResizeHomeRestoresAutomaticWidth));
    private readonly string InfoId = "grid-info-" + Guid.NewGuid().ToString("N");
    private IReadOnlyList<ArkheideSystem.Flourish.Blazor.Components.Primitives.GridRow> Rows = Array.Empty<ArkheideSystem.Flourish.Blazor.Components.Primitives.GridRow>();
    private readonly Stack<IReadOnlyList<ArkheideSystem.Flourish.Blazor.Components.Primitives.GridRow>> History = new(), RedoHistory = new();
    private bool ReadOnly;
    private IReadOnlyList<MultiSelectOption> TagOptions = [new("stationery", "文具", Selected: true), new("daily", "日用品"), new("spare", "备品")];
    private string[] SelectedTags => TagOptions.Where(option => option.Selected).Select(option => option.Label).ToArray();
    private IReadOnlyList<Primitives.GridColumn> TagColumns => [new("tags", Localization.Parse(TextKey.Sample_Tags))];
    private IReadOnlyList<Primitives.GridRow> TagRows => [new("tags-demo", [new(string.Join(';', SelectedTags), Localization.Parse(TextKey.Sample_ItemCount, SelectedTags.Length), Primitives.GridEditorKind.Template)])];
    private void ChangeTags(MultiSelectChange change) { if (ReadOnly) return; TagOptions = change.OrderedKeys.Select(key => TagOptions.Single(option => option.Key == key) with { Selected = change.SelectedKeys.Contains(key) }).ToArray(); }
    private long Revision;
    private string Message = "Key.Sample_FictionalDataIsRetainedOnlyInThisComponent";
    private Primitives.GridInteractions Interactions => new()
    {
        Save = SaveAsync, Cancel = ResetAsync, Undo = UndoAsync, Redo = RedoAsync,
        ReportError = message => { Message = message; StateHasChanged(); return Task.CompletedTask; }
    };
    protected override void OnInitialized() { base.OnInitialized(); Rows = CreateRows(); }
    private IReadOnlyList<ArkheideSystem.Flourish.Blazor.Components.Primitives.GridRow> CreateRows() =>
    [
        new("demo-1",
        [
            new("演示笔记本", "演示笔记本", Required: true),
            new("12.50", "12.50", Primitives.GridEditorKind.Decimal),
            new("2026-10-01", "2026-10-01", Primitives.GridEditorKind.Date),
            new("虚构会议用品", "虚构会议用品", Primitives.GridEditorKind.Multiline),
            new("stationery", "文具", Primitives.GridEditorKind.Select, Options: Groups),
            new("12345678901", "12345678901", Primitives.GridEditorKind.Masked, Mask: "000 0000 0000"),
            new("#" + InfoId, "示例说明", Primitives.GridEditorKind.Link, ReadOnly: true, LinkHref: "#" + InfoId, LinkLabel: "跳到示例说明")
        ], Label: "虚构用品：演示笔记本"),
        new("demo-2",
        [
            new("演示水杯", "演示水杯", Required: true),
            new("18.00", "18.00", Primitives.GridEditorKind.Decimal),
            new("2026-10-02", "2026-10-02", Primitives.GridEditorKind.Date),
            new("虚构茶水间用品", "虚构茶水间用品", Primitives.GridEditorKind.Multiline),
            new("daily", "日用品", Primitives.GridEditorKind.Select, Options: Groups),
            new("10987654321", "10987654321", Primitives.GridEditorKind.Masked, Mask: "000 0000 0000"),
            new("#" + InfoId, "示例说明", Primitives.GridEditorKind.Link, ReadOnly: true, LinkHref: "#" + InfoId, LinkLabel: "跳到示例说明")
        ], Label: "虚构用品：演示水杯")
    ];
    private void ChangeCell(Primitives.GridCellChange change)
    {
        if (ReadOnly || change.Row < 0 || change.Row >= Rows.Count || change.Column < 0 || change.Column >= Columns.Count) return;
        var current = Rows[change.Row].Cells[change.Column];
        if (current.ReadOnly || current.Disabled) return;
        History.Push(Rows);
        RedoHistory.Clear();
        var cells = Rows[change.Row].Cells.ToArray();
        var value = change.Value ?? "";
        string? error = change.Column == 0 && string.IsNullOrWhiteSpace(value) ? "Key.Sample_EnterAName_Record" : null;
        if (change.Column == 1 && (!decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var amount) || amount < 0))
            error = "Key.Sample_EnterAnAmountGreaterThanOrEqualTo0";
        var display = current.Editor == Primitives.GridEditorKind.Select ? Groups.FirstOrDefault(option => option.Value == value)?.Label ?? value : value;
        cells[change.Column] = current with { Value = value, Display = display, Changed = true, Error = error };
        var updated = Rows.ToArray();
        updated[change.Row] = Rows[change.Row] with { Cells = cells, Dirty = true };
        Rows = updated;
        Revision++;
        Message = error ?? "Key.Sample_FictionalCellUpdatedButNotSaved";
    }
    private Task SaveAsync()
    {
        if (Rows.Any(row => row.Cells.Any(cell => cell.Error is not null))) { Message = "Key.Sample_CorrectDemoValidationErrorsBeforeSaving"; StateHasChanged(); return Task.CompletedTask; }
        Rows = Rows.Select(row => row with { Dirty = false, Cells = row.Cells.Select(cell => cell with { Changed = false }).ToArray() }).ToArray();
        History.Clear(); RedoHistory.Clear(); Revision++;
        Message = "Key.Sample_FictionalDraftSavedToLocalState";
        StateHasChanged();
        return Task.CompletedTask;
    }
    private Task UndoAsync()
    {
        if (History.TryPop(out var previous)) { RedoHistory.Push(Rows); Rows = previous; Revision++; Message = "Key.Sample_DemoChangeUndone"; }
        StateHasChanged();
        return Task.CompletedTask;
    }
    private Task RedoAsync()
    {
        if (RedoHistory.TryPop(out var next)) { History.Push(Rows); Rows = next; Revision++; Message = "Key.Sample_DemoChangeRedone"; }
        StateHasChanged();
        return Task.CompletedTask;
    }
    private void ShowValidationError() => ChangeCell(new(0, 1, "-1"));
    private Task ResetAsync() { Reset(); return Task.CompletedTask; }
    private void Reset() { Rows = CreateRows(); History.Clear(); RedoHistory.Clear(); Revision++; ReadOnly = false; Message = "Key.Sample_FictionalDataReset"; StateHasChanged(); }
}
