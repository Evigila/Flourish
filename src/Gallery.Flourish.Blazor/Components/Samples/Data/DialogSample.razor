@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Dialog", DescriptionKey = "Key.Sample_DialogSample_Description")]

<div class="f-inline-actions">
    <Button Variant="ButtonVariant.Secondary" OnClick="() => Open(DialogPresentation.Centered)">@Localization.Parse(TextKey.Sample_OpenCenteredDialog)</Button>
    <Button Variant="ButtonVariant.Secondary" OnClick="() => Open(DialogPresentation.BottomSheet)">@Localization.Parse(TextKey.Sample_OpenBottomSheet)</Button>
</div>
@if (!Preview)
{
    <CheckBox Label="@Localization.Parse(TextKey.Sample_SimulateIncompleteInputAndPreventClosing)" @bind-Value="PreventClose" />
    <p role="status">@Localization.Parse(TextKey.Sample_ArchivedCount, CompletedCount)</p>
    <Button Variant="ButtonVariant.Underline" Href="/examples/overlays/reconnect">@Localization.Parse(TextKey.Sample_ReconnectionStateCompositionExample)</Button>
}
<Dialog @ref="Modal" Title="@(Preview ? Localization.Parse(TextKey.Sample_EmptyDialog) : Localization.Parse(TextKey.Sample_ArchiveDemoDraft))" Presentation="Presentation" Busy="Busy" CanClose="CanCloseAsync" CloseLabel="@Localization.Parse(TextKey.Sample_Off)">
    <ChildContent>
        @if (!Preview)
        {
            <p>@Localization.Parse(TextKey.Sample_ArchiveDemoDraftA)</p>
            @if (Presentation == DialogPresentation.BottomSheet)
            {
                <Field Label="@Localization.Parse(TextKey.Sample_Notes)" Id="@(Identifier + "-note")"><StandaloneTextBox Id="@(Identifier + "-note")" @bind-Value="Note" Multiline="true" Rows="3" /></Field>
            }
        }
    </ChildContent>
    <Actions>
        @if (!Preview)
        {
            <InlineActions>
                <Button Busy="Busy" BusyLabel="@Localization.Parse(TextKey.Sample_Archiving)" OnClick="CompleteAsync">@Localization.Parse(TextKey.Sample_ConfirmArchive)</Button>
                <Button Variant="ButtonVariant.Secondary" Disabled="Busy" OnClick="CancelAsync">@Localization.Parse(TextKey.Sample_Cancel)</Button>
            </InlineActions>
        }
    </Actions>
</Dialog>

@code {
    [Parameter] public bool Preview { get; set; }
    private Dialog? Modal;
    private readonly string Identifier = "dialog-sample-" + Guid.NewGuid().ToString("N");
    private string? Note = "虚构草稿备注。";
    private bool Busy, PreventClose;
    private int CompletedCount;
    private DialogPresentation Presentation;
    private async Task Open(DialogPresentation presentation)
    {
        Presentation = presentation;
        var result = await Modal!.ShowAsync();
        if (result is true) CompletedCount++;
    }
    private Task CancelAsync() => Modal!.CloseAsync();
    private Task<bool> CanCloseAsync() => Task.FromResult(!PreventClose || Preview);
    private async Task CompleteAsync()
    {
        if (Busy) return;
        Busy = true;
        try
        {
            await Task.Delay(600);
            PreventClose = false;
            Busy = false;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            await Modal!.CloseAsync(true);
        }
        finally { Busy = false; }
    }
}
