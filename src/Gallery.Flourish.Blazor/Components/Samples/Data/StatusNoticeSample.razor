@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.StatusNotice")]

@if (Preview)
{
    @foreach (var severity in Enum.GetValues<ArkheideSystem.Flourish.Blazor.Components.Primitives.NoticeSeverity>())
    {
        <ArkheideSystem.Flourish.Blazor.Components.Primitives.StatusNotice Severity="severity" Announce="false">@severity 通知</ArkheideSystem.Flourish.Blazor.Components.Primitives.StatusNotice>
    }
}
else
{
    <div class="f-inline-actions">
        @foreach (var severity in Enum.GetValues<ArkheideSystem.Flourish.Blazor.Components.Primitives.NoticeSeverity>())
        {
            <Button Variant="ButtonVariant.Secondary" OnClick="() => Severity = severity">@severity</Button>
        }
    </div>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.StatusNotice Severity="Severity">@Message</ArkheideSystem.Flourish.Blazor.Components.Primitives.StatusNotice>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private Primitives.NoticeSeverity Severity = Primitives.NoticeSeverity.Information;
    private string Message => Severity switch
    {
        Primitives.NoticeSeverity.Error => "演示字段未通过校验，请保留草稿并检查。",
        Primitives.NoticeSeverity.Warning => "演示字段有重复项，需要确认。",
        Primitives.NoticeSeverity.Success => "虚构字段已通过校验。",
        Primitives.NoticeSeverity.Subtle => "演示草稿仅在当前页面保留。",
        _ => "请检查虚构草稿中的字段。"
    };
}
