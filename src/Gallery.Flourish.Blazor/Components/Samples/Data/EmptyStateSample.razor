@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("EmptyState")]

@if (Preview)
{
    <EmptyState Title="@Localization.Parse(TextKey.Sample_NoDataYet)" />
    <EmptyState Title="@Localization.Parse(TextKey.Sample_NoDataYet)">
        <ChildContent><p>@Localization.Parse(TextKey.Sample_AShortDescriptionCanBeProvided)</p></ChildContent>
        <Actions><Button Variant="ButtonVariant.Secondary">@Localization.Parse(TextKey.Sample_Add)</Button></Actions>
    </EmptyState>
}
else
{
    @if (!HasItem)
    {
        <EmptyState Title="@Localization.Parse(TextKey.Sample_NoDemoAttachmentsAddedYet)">
            <ChildContent><p>@Localization.Parse(TextKey.Sample_AddingTheFirstItemReplacesTheEmptyStateWithTheLocalList)</p></ChildContent>
            <Actions><Button OnClick="() => HasItem = true">@Localization.Parse(TextKey.Sample_AddDemoAttachment)</Button></Actions>
        </EmptyState>
    }
    else
    {
        <ul><li>示例说明.txt（虚构）</li></ul>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => HasItem = false">@Localization.Parse(TextKey.Sample_ClearList)</Button>
    }
}

@code {
    [Parameter] public bool Preview { get; set; }
    private bool HasItem;
}
