@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("EmptyState")]

@if (Preview)
{
    <EmptyState Title="暂无数据" />
    <EmptyState Title="暂无数据">
        <ChildContent><p>可以提供简短说明。</p></ChildContent>
        <Actions><Button Variant="ButtonVariant.Secondary">添加</Button></Actions>
    </EmptyState>
}
else
{
    @if (!HasItem)
    {
        <EmptyState Title="尚未添加演示附件">
            <ChildContent><p>添加第一项后，空状态会被真实的本地列表替换。</p></ChildContent>
            <Actions><Button OnClick="() => HasItem = true">添加演示附件</Button></Actions>
        </EmptyState>
    }
    else
    {
        <ul><li>示例说明.txt（虚构）</li></ul>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => HasItem = false">清空列表</Button>
    }
}

@code {
    [Parameter] public bool Preview { get; set; }
    private bool HasItem;
}
