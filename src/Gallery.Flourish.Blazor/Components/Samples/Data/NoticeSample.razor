@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Notice")]

@if (Preview)
{
    @foreach (var severity in Enum.GetValues<NotificationSeverity>())
    {
        <Notice Severity="severity" Title="@severity.ToString()" Announce="false">@Localization.Parse(TextKey.Sample_NotificationContent)</Notice>
    }
    <Notice Subtle="true" Announce="false">@Localization.Parse(TextKey.Sample_SubtleNotice)</Notice>
}
else
{
    <div class="f-inline-actions">
        @foreach (var severity in Enum.GetValues<NotificationSeverity>())
        {
            <Button Variant="ButtonVariant.Secondary" OnClick="() => Severity = severity">@severity</Button>
        }
    </div>
    <Notice Severity="Severity" Title="@Localization.Parse(TextKey.Sample_LocalDraftStatus)">@Message</Notice>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private NotificationSeverity Severity = NotificationSeverity.Information;
    private string Message => Severity switch
    {
        NotificationSeverity.Success => Localization.Parse(TextKey.Sample_DemoDraftSavedSuccessfully),
        NotificationSeverity.Warning => Localization.Parse(TextKey.Sample_TheDemoDraftIsMissingOptionalContactDetails),
        NotificationSeverity.Error => Localization.Parse(TextKey.Sample_SimulatedSaveFailureTheDraftIsRetained),
        _ => Localization.Parse(TextKey.Sample_TheDemoDraftHasNotBeenSaved)
    };
}
