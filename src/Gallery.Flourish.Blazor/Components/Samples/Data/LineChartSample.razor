@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("LineChart", DescriptionKey = "Key.Sample_LineChartSample_Description")]

<LineChart Id="example-weekly-orders" Heading="@Localization.Parse(TextKey.Sample_WeeklyOrders)" Labels="Labels" Series="Data" Title="@Localization.Parse(TextKey.Sample_FictionalWeeklyOrderTrend)" Description="@Localization.Parse(TextKey.Sample_TheTwoDemoSeriesAreNormalizedIndependentlyTheLegendShowsEachMaximumAndTheDataTableRetainsAllRawValues)" IndependentScales="true" MaximumLabel="@Localization.Parse(TextKey.Sample_Maximum)" PointCaption="@Localization.Parse(TextKey.Sample_Date)">
    <ControlsContent>
        <Field Id="chart-example-period" Label="@Localization.Parse(TextKey.Sample_Period_Demo)">
            <StandaloneSelectBox @bind-Value="Period"><option value="current">@Localization.Parse(TextKey.Sample_CurrentWeekExample)</option><option value="previous">@Localization.Parse(TextKey.Sample_PreviousWeekExample)</option></StandaloneSelectBox>
        </Field>
    </ControlsContent>
</LineChart>

@code {
    [Parameter] public bool Preview { get; set; }
    private string Period = "current";
    private LineChart.PointLabel[] Labels => [new("mon", Localization.Parse(TextKey.Sample_MondayShort), Localization.Parse(TextKey.Sample_Monday)), new("tue", Localization.Parse(TextKey.Sample_TuesdayShort), Localization.Parse(TextKey.Sample_Tuesday)), new("wed", Localization.Parse(TextKey.Sample_WednesdayShort), Localization.Parse(TextKey.Sample_Wednesday)), new("thu", Localization.Parse(TextKey.Sample_ThursdayShort), Localization.Parse(TextKey.Sample_Thursday)), new("fri", Localization.Parse(TextKey.Sample_FridayShort), Localization.Parse(TextKey.Sample_Friday)), new("sat", Localization.Parse(TextKey.Sample_SaturdayShort), Localization.Parse(TextKey.Sample_Saturday)), new("sun", Localization.Parse(TextKey.Sample_SundayShort), Localization.Parse(TextKey.Sample_Sunday))];
    private LineChart.DataSeries[] Data => [new("count", Localization.Parse(TextKey.Sample_OrderCount), Period == "current" ? [2, 5, 3, 8, 4, 7, 6] : [4, 3, 2, 7, 6, 5, 4], value => value.ToString("N0", CultureInfo.GetCultureInfo(Localization.Culture))), new("amount", Localization.Parse(TextKey.Sample_DemoAmount), Period == "current" ? [100, 280, 240, 600, 380, 520, 410] : [200, 150, 170, 460, 390, 330, 280], value => value.ToString("C", CultureInfo.GetCultureInfo(Localization.Culture)))];
}
