@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.NoticeTrigger")]

@if (Preview)
{
    <div class="f-inline-actions">
        @foreach (var severity in Enum.GetValues<NotificationSeverity>())
        {
            <ArkheideSystem.Flourish.Blazor.Components.Primitives.NoticeTrigger Severity="severity">@Localization.Parse(TextKey.Sample_DescriptionContent)</ArkheideSystem.Flourish.Blazor.Components.Primitives.NoticeTrigger>
        }
    </div>
}
else
{
    <div class="f-inline-actions">
        <Button Variant="ButtonVariant.Secondary" OnClick="() => Severity = NotificationSeverity.Warning">@Localization.Parse(TextKey.Sample_PendingReview)</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => Severity = NotificationSeverity.Error">@Localization.Parse(TextKey.Sample_ValidationFailed)</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => Severity = NotificationSeverity.Success">@Localization.Parse(TextKey.Sample_ValidationPassed)</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => Severity = NotificationSeverity.Information">@Localization.Parse(TextKey.Sample_AdditionalInformation)</Button>
    </div>
    <p>@Localization.Parse(TextKey.Sample_NoticeRecord) <ArkheideSystem.Flourish.Blazor.Components.Primitives.NoticeTrigger Severity="Severity">@Message</ArkheideSystem.Flourish.Blazor.Components.Primitives.NoticeTrigger></p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private NotificationSeverity Severity = NotificationSeverity.Warning;
    private string Message => Severity switch
    {
        NotificationSeverity.Error => Localization.Parse(TextKey.Sample_TheFictionalRecordNeedsAName),
        NotificationSeverity.Success => Localization.Parse(TextKey.Sample_TheFictionalRecordPassedLocalChecks),
        NotificationSeverity.Information => Localization.Parse(TextKey.Sample_CheckResultsAreKeptOnlyOnThisPageAndAreNotSavedAfterLeaving),
        _ => Localization.Parse(TextKey.Sample_TheFictionalRecordNeedsContactDetailsReviewed)
    };
}
