@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("ProgressRing")]

@if (Preview)
{
    <div class="f-inline-actions">
        <ProgressRing Label="@Localization.Parse(TextKey.Sample_DeterminateProgress)" Value="0" StatusText="@Localization.Parse(TextKey.Sample_NotStarted)" />
        <ProgressRing Label="@Localization.Parse(TextKey.Sample_IndeterminateProgress)" Value="null" StatusText="@Localization.Parse(TextKey.Sample_Processing_Demo)" />
        <ProgressRing Label="@Localization.Parse(TextKey.Sample_PausedProgress)" Value="0" Stopped="true" StatusText="@Localization.Parse(TextKey.Sample_Paused)" />
        <ProgressRing Label="@Localization.Parse(TextKey.Nav_Tutorial)" Value="50" Stopped="true" Compact="true" ShowValue="false" />
    </div>
}
else
{
    <div class="f-inline-actions">
        <Button Variant="ButtonVariant.Secondary" OnClick="Advance">@Localization.Parse(TextKey.Sample_AdvanceBy10)</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => Unknown = !Unknown">@(Unknown ? Localization.Parse(TextKey.Sample_DeterminateProgress) : Localization.Parse(TextKey.Sample_IndeterminateProgress))</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => Stopped = !Stopped">@(Stopped ? Localization.Parse(TextKey.Sample_Resume) : Localization.Parse(TextKey.Sample_Pause))</Button>
    </div>
    <ProgressRing Label="@Localization.Parse(TextKey.Sample_FictionalBackgroundTask)" Value="@(Unknown ? null : (double?)Percent)" Stopped="Stopped" StatusText="@Status" />
    <p role="status">@Status</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private int Percent = 40;
    private bool Unknown, Stopped;
    private string Status => Stopped ? Localization.Parse(TextKey.Sample_TheDemoTaskIsPaused) : Unknown ? Localization.Parse(TextKey.Sample_CalculatingRemainingTime) : Localization.Parse(TextKey.Sample_TaskProgress, Percent);
    private void Advance() { if (!Stopped) { Unknown = false; Percent = Math.Min(100, Percent + 10); } }
}
