@using ArkheideSystem.Flourish.Blazor.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("SplitButton")]
@inherits LocalizedComponentBase

<SplitButton Text="@Localization.Parse(TextKey.Nav_DisplayLogin)" Href="/examples/display/login" FullWidth="FullWidth"
             SecondaryLabel="@Localization.Parse(TextKey.Access_SubmitMenu)" Disabled="MenuDisabled">
    <MenuContent>
        <Button Variant="ButtonVariant.Quiet" Href="/examples/display/accounts">@Localization.Parse(TextKey.Nav_DisplayAccounts)</Button>
        <Button Variant="ButtonVariant.Quiet" Href="/examples/display/access#display-access-title">@Localization.Parse(TextKey.Access_RecoveryDemo)</Button>
        <Button Variant="ButtonVariant.Quiet" Href="/examples/display/access#display-access-title">@Localization.Parse(TextKey.Access_RegistrationDemo)</Button>
        <Button Variant="ButtonVariant.Quiet" Href="/examples/display">@Localization.Parse(TextKey.Display_Back)</Button>
    </MenuContent>
</SplitButton>
@if (!Preview)
{
    <AccessActions Label="@Localization.Parse(TextKey.Access_SubmitMenu)">
        <StandaloneCheckBox Label="@Explain("Fill the available width", "填满可用宽度")" @bind-Value="FullWidth" />
        <StandaloneCheckBox Label="@Explain("Disable primary action and menu", "禁用主动作与菜单")" @bind-Value="MenuDisabled" />
    </AccessActions>
    <p>@Explain("MenuContent supplies native navigation links. Recovery and registration point only to the existing demonstration overview, never to an authentication workflow. Type=submit is exercised by the complete login page. The example below preserves legacy externally controlled secondary actions.",
        "MenuContent 提供原生导航链接。恢复与注册只指向现有演示总览，不执行认证流程。完整登录页演示 Type=submit。下方保留旧式由外部控制的次要动作。")</p>
}

@if (Preview)
{
    <div class="f-inline-actions">
        <SplitButton Text="操作" Icon="download" SecondaryLabel="打开选项" />
        <SplitButton Text="已选中" Icon="check" Selected="true" SecondaryLabel="打开选项" />
        <SplitButton Text="不可用" Disabled="true" SecondaryLabel="打开选项" />
    </div>
}
else
{
    <div class="f-inline-actions">
        <SplitButton Text="@($"导出 {Format}")" Icon="download" Selected="Selected" Disabled="Disabled"
                     SecondaryLabel="@(OptionsVisible ? "收起导出选项" : "展开导出选项")" Expanded="OptionsVisible"
                     SecondaryControls="split-scenario-options" OnClick="Export" OnSecondaryClick="() => OptionsVisible = !OptionsVisible" />
        <CheckBox Label="选中" @bind-Value="Selected" />
        <CheckBox Label="禁用" @bind-Value="Disabled" />
    </div>
    <div id="split-scenario-options" role="region" aria-label="导出格式" hidden="@(!OptionsVisible)">
        <div class="f-inline-actions">
            <Button Variant="ButtonVariant.Quiet" OnClick="ChooseCsv">CSV</Button>
            <Button Variant="ButtonVariant.Quiet" OnClick="ChooseJson">JSON</Button>
        </div>
    </div>
    <p role="status">导出 @ExportCount 次；上次格式：@LastFormat</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private bool Selected, Disabled, OptionsVisible;
    private bool FullWidth = true, MenuDisabled;
    private int ExportCount;
    private string Format = "CSV", LastFormat = "暂无";
    private void Export() { ExportCount++; LastFormat = Format; }
    private void ChooseCsv() => ChooseFormat("CSV");
    private void ChooseJson() => ChooseFormat("JSON");
    private void ChooseFormat(string format) { Format = format; OptionsVisible = false; }
    private string Explain(string english, string chinese) => Localization.Culture == "zh-CN" ? chinese : english;
}
