@using ArkheideSystem.Flourish.Blazor.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("SplitButton", DescriptionKey = "Key.Sample_SplitButtonSample_Description")]
@inherits LocalizedComponentBase

@if (!Preview)
{
    <div style="width:24rem;max-width:100%">
        <SplitButton Text="@Localization.Parse(TextKey.Nav_DisplayLogin)" Href="/examples/display/login" FullWidth="FullWidth"
                     SecondaryLabel="@Localization.Parse(TextKey.Access_SubmitMenu)" Disabled="MenuDisabled" PrimaryDisabled="PrimaryDisabled">
            <MenuContent>
                <Button Variant="ButtonVariant.Quiet" Href="/examples/display/accounts">@Localization.Parse(TextKey.Nav_DisplayAccounts)</Button>
                <Button Variant="ButtonVariant.Quiet" Href="/examples/display/access#display-access-title">@Localization.Parse(TextKey.Access_RecoveryDemo)</Button>
                <Button Variant="ButtonVariant.Quiet" Href="/examples/display/access#display-access-title">@Localization.Parse(TextKey.Access_RegistrationDemo)</Button>
                <Button Variant="ButtonVariant.Quiet" Href="/examples/display">@Localization.Parse(TextKey.Display_Back)</Button>
            </MenuContent>
        </SplitButton>
    </div>
    <AccessActions Label="@Localization.Parse(TextKey.Access_SubmitMenu)">
        <StandaloneCheckBox Label="@Localization.Parse(TextKey.Sample_FillAvailableWidth)" @bind-Value="FullWidth" />
        <StandaloneCheckBox Label="@Localization.Parse(TextKey.Sample_DisablePrimaryActionAndMenu)" @bind-Value="MenuDisabled" />
        <StandaloneCheckBox Label="@Localization.Parse(TextKey.Sample_DisableOnlyThePrimaryActionAndKeepTheMenu)" @bind-Value="PrimaryDisabled" />
    </AccessActions>
}

@if (Preview)
{
    <div class="f-inline-actions">
        <SplitButton Text="@Localization.Parse(TextKey.Sample_Action)" Icon="download" SecondaryLabel="@Localization.Parse(TextKey.Sample_OpenOptions)" />
        <SplitButton Text="@Localization.Parse(TextKey.Sample_Checked)" Icon="check" Selected="true" SecondaryLabel="@Localization.Parse(TextKey.Sample_OpenOptions)" />
        <SplitButton Text="@Localization.Parse(TextKey.Sample_Unavailable)" Disabled="true" SecondaryLabel="@Localization.Parse(TextKey.Sample_OpenOptions)" />
    </div>
}
else
{
    <div class="f-inline-actions">
        <SplitButton Text="@Localization.Parse(TextKey.Sample_ExportAction, Format)" Icon="download" Selected="Selected" Disabled="Disabled"
                     SecondaryLabel="@(OptionsVisible ? Localization.Parse(TextKey.Sample_CollapseExportOptions) : Localization.Parse(TextKey.Sample_ExpandExportOptions))" Expanded="OptionsVisible"
                     SecondaryControls="split-scenario-options" OnClick="Export" OnSecondaryClick="() => OptionsVisible = !OptionsVisible" />
        <CheckBox Label="@Localization.Parse(TextKey.Sample_Selected)" @bind-Value="Selected" />
        <CheckBox Label="@Localization.Parse(TextKey.Sample_Disabled)" @bind-Value="Disabled" />
    </div>
    <div id="split-scenario-options" role="region" aria-label="@Localization.Parse(TextKey.Sample_ExportFormat)" hidden="@(!OptionsVisible)">
        <div class="f-inline-actions">
            <Button Variant="ButtonVariant.Quiet" OnClick="ChooseCsv">CSV</Button>
            <Button Variant="ButtonVariant.Quiet" OnClick="ChooseJson">JSON</Button>
        </div>
    </div>
    <p role="status">@Localization.Parse(TextKey.Sample_ExportCount, ExportCount, LastFormat ?? Localization.Parse(TextKey.Sample_NoneYet))</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private bool Selected, Disabled, OptionsVisible;
    private bool FullWidth = true, MenuDisabled, PrimaryDisabled;
    private int ExportCount;
    private string Format = "CSV";
    private string? LastFormat;
    private void Export() { ExportCount++; LastFormat = Format; }
    private void ChooseCsv() => ChooseFormat("CSV");
    private void ChooseJson() => ChooseFormat("JSON");
    private void ChooseFormat(string format) { Format = format; OptionsVisible = false; }
}
