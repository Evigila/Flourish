@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System
@using System.Collections.Generic
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("ActionMenu")]

@if (Preview)
{
    <div class="f-inline-actions">
        <ActionMenu Label="空菜单" Actions="Array.Empty<MenuAction>()" />
        <ActionMenu Label="文字触发器" Actions="Array.Empty<MenuAction>()"><TriggerContent>更多 <ExpansionIndicator /></TriggerContent></ActionMenu>
        <ActionMenu Label="不可用菜单" Actions="Array.Empty<MenuAction>()" Disabled="true" />
        <ActionMenu Label="悬浮菜单" Actions="Array.Empty<MenuAction>()" OpenOnHover="true"><TriggerContent>悬浮菜单 <ExpansionIndicator /></TriggerContent></ActionMenu>
    </div>
}
else
{
    <CheckBox Label="悬浮打开、移出关闭" @bind-Value="HoverMenu" />
    <ActionMenu Label="示例草稿 A 的操作" Actions="Actions" OpenOnHover="HoverMenu"><TriggerContent>草稿操作 <ExpansionIndicator /></TriggerContent></ActionMenu>
    <ActionMenu Label="原生内容记录操作">
        <Button Variant="ButtonVariant.Quiet" role="menuitem" OnClick="EditDraft">编辑草稿</Button>
        <Button Variant="ButtonVariant.Quiet" role="menuitem" Disabled="true">发布（不可用）</Button>
        <Button Variant="ButtonVariant.Danger" role="menuitem" OnClick="DeleteDraft">删除草稿</Button>
    </ActionMenu>
    <p role="status">@Message</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private string Message = "尚未选择操作。";
    private bool HoverMenu;
    private IReadOnlyList<MenuAction> Actions =>
    [
        new("复制本地草稿", () => SetMessage("已复制虚构草稿，没有写入外部数据。")),
        new("发布（示例中不可用）", () => Task.CompletedTask, Disabled: true),
        new("删除演示草稿", () => SetMessage("已删除本地演示草稿。"), Destructive: true)
    ];
    private Task SetMessage(string message) { Message = message; return InvokeAsync(StateHasChanged); }
    private Task EditDraft() => SetMessage("已编辑本地演示草稿。");
    private Task DeleteDraft() => SetMessage("已删除本地演示草稿。");
}
