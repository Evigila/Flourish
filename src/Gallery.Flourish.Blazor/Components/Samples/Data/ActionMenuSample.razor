@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System
@using System.Collections.Generic
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("ActionMenu")]

@if (Preview)
{
    <div class="f-inline-actions">
        <ActionMenu Label="@Localization.Parse(TextKey.Sample_EmptyMenu)" Actions="Array.Empty<MenuAction>()" />
        <ActionMenu Label="@Localization.Parse(TextKey.Sample_AdvancedEditing)" Icon="stylus_fountain_pen" TriggerVariant="ButtonVariant.Secondary" Actions="Array.Empty<MenuAction>()" Disabled="true" />
        <ActionMenu Label="@Localization.Parse(TextKey.Sample_TextTrigger)" Actions="Array.Empty<MenuAction>()"><TriggerContent>@Localization.Parse(TextKey.Sample_More) <ExpansionIndicator /></TriggerContent></ActionMenu>
        <ActionMenu Label="@Localization.Parse(TextKey.Sample_UnavailableMenu)" Actions="Array.Empty<MenuAction>()" Disabled="true" />
        <ActionMenu Label="@Localization.Parse(TextKey.Sample_HoverMenu)" Actions="Array.Empty<MenuAction>()" OpenOnHover="true"><TriggerContent>@Localization.Parse(TextKey.Sample_HoverMenu) <ExpansionIndicator /></TriggerContent></ActionMenu>
    </div>
}
else
{
    <CheckBox Label="@Localization.Parse(TextKey.Sample_OpenOnHoverAndCloseOnPointerLeave)" @bind-Value="HoverMenu" />
    <ActionMenu Label="@Localization.Parse(TextKey.Sample_ActionsForDemoDraftA)" Actions="Actions" OpenOnHover="HoverMenu"><TriggerContent>@Localization.Parse(TextKey.Sample_DraftActions) <ExpansionIndicator /></TriggerContent></ActionMenu>
    <ActionMenu Label="@Localization.Parse(TextKey.Sample_NativeRecordActions)">
        <Button Variant="ButtonVariant.Quiet" role="menuitem" OnClick="EditDraft">@Localization.Parse(TextKey.Sample_EditDraft)</Button>
        <Button Variant="ButtonVariant.Quiet" role="menuitem" Disabled="true">@Localization.Parse(TextKey.Sample_PublishUnavailable)</Button>
        <Button Variant="ButtonVariant.Danger" role="menuitem" OnClick="DeleteDraft">@Localization.Parse(TextKey.Sample_DeleteDraft)</Button>
    </ActionMenu>
    <p role="status">@Localization.Parse(Message)</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private string Message = "Key.Sample_NoActionSelectedYet";
    private bool HoverMenu;
    private IReadOnlyList<MenuAction> Actions =>
    [
        new(Localization.Parse(TextKey.Sample_CopyLocalDraft), () => SetMessage("Key.Sample_FictionalDraftCopiedNoExternalDataWasWritten")),
        new(Localization.Parse(TextKey.Sample_PublishUnavailableInDemo), () => Task.CompletedTask, Disabled: true),
        new(Localization.Parse(TextKey.Sample_DeleteDemoDraft), () => SetMessage("Key.Sample_LocalDemoDraftDeleted"), Destructive: true)
    ];
    private Task SetMessage(string message) { Message = message; return InvokeAsync(StateHasChanged); }
    private Task EditDraft() => SetMessage("Key.Sample_LocalDemoDraftEdited");
    private Task DeleteDraft() => SetMessage("Key.Sample_LocalDemoDraftDeleted");
}
