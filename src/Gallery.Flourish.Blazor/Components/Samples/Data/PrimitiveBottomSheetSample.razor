@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.BottomSheet")]

<Button Variant="ButtonVariant.Secondary" OnClick="() => IsOpen = true">@(Preview ? "打开空白面板" : "编辑本地草稿")</Button>
@if (!Preview)
{
    @if (SavedMessage is not null) { <ArkheideSystem.Flourish.Blazor.Components.Primitives.StatusNotice Severity="Primitives.NoticeSeverity.Success">@SavedMessage</ArkheideSystem.Flourish.Blazor.Components.Primitives.StatusNotice> }
}
<ArkheideSystem.Flourish.Blazor.Components.Primitives.BottomSheet Id="@Identifier" Title="@(Preview ? "空白底部面板" : "虚构草稿")" IsOpen="IsOpen" IsBusy="Busy" OnClose="Close">
    <ChildContent>
    @if (!Preview)
    {
        <ArkheideSystem.Flourish.Blazor.Components.Primitives.FormFields>
            <label for="@(Identifier + "-name")">草稿名称<input id="@(Identifier + "-name")" @bind="Name" /></label>
        </ArkheideSystem.Flourish.Blazor.Components.Primitives.FormFields>
    }
    </ChildContent>
    <Actions>
        @if (!Preview)
        {
            <Button Busy="Busy" BusyLabel="正在保存" OnClick="SaveAsync">保存到本地状态</Button>
            <Button Variant="ButtonVariant.Secondary" Disabled="Busy" OnClick="Close">关闭</Button>
        }
    </Actions>
</ArkheideSystem.Flourish.Blazor.Components.Primitives.BottomSheet>

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Identifier = "primitive-sheet-" + Guid.NewGuid().ToString("N");
    private bool IsOpen, Busy;
    private string Name = "演示草稿 A";
    private string? SavedMessage;
    private void Close() { if (!Busy) IsOpen = false; }
    private async Task SaveAsync()
    {
        if (Busy) return;
        Busy = true;
        try { await Task.Delay(500); SavedMessage = $"已保存虚构草稿：{Name}"; IsOpen = false; }
        finally { Busy = false; }
    }
}
