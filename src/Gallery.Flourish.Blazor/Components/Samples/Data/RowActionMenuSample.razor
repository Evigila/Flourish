@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@using Microsoft.AspNetCore.Components
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.RowActionMenu")]

@if (Preview)
{
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.RowActionMenu Label="空白行菜单"><ChildContent></ChildContent></ArkheideSystem.Flourish.Blazor.Components.Primitives.RowActionMenu>
}
else
{
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.RowActionMenu Label="演示用品 A 的操作">
        <button type="button" role="menuitem" @onclick="() => SetMessage(false)">查看虚构记录</button>
        <button type="button" role="menuitem" disabled="true" aria-disabled="true">当前不可用</button>
        <button type="button" role="menuitem" @onclick="() => SetMessage(true)">加入本地收藏</button>
    </ArkheideSystem.Flourish.Blazor.Components.Primitives.RowActionMenu>
    <p role="status">@Message</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private string Message = "尚未选择操作。";
    private void SetMessage(bool favorite) => Message = favorite ? "已收藏虚构用品 A。" : "演示用品 A，编号 DEMO-001，全部为虚构数据。";
}
