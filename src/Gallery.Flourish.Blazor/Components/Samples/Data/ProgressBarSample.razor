@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("ProgressBar")]

@if (Preview)
{
    <ProgressBar Label="@Localization.Parse(TextKey.Sample_DeterminateProgress)" Value="0" StatusText="@Localization.Parse(TextKey.Sample_NotStarted)" />
    <ProgressBar Label="@Localization.Parse(TextKey.Sample_IndeterminateProgress)" Value="null" StatusText="@Localization.Parse(TextKey.Sample_Processing_Demo)" />
}
else
{
    <div class="f-inline-actions">
        <Button Variant="ButtonVariant.Secondary" OnClick="() => Change(-10)">@Localization.Parse(TextKey.Sample_DecreaseBy10)</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => Change(10)">@Localization.Parse(TextKey.Sample_IncreaseBy10)</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => Unknown = !Unknown">@(Unknown ? Localization.Parse(TextKey.Sample_ShowDeterminateProgress) : Localization.Parse(TextKey.Sample_SimulateIndeterminateProgress))</Button>
        <Button Variant="ButtonVariant.Quiet" OnClick="Reset">@Localization.Parse(TextKey.Sample_Reset)</Button>
    </div>
    <ProgressBar Label="@Localization.Parse(TextKey.Sample_DemoFileExport)" Value="@(Unknown ? null : (double?)Percent)" StatusText="@Status" />
}

@code {
    [Parameter] public bool Preview { get; set; }
    private int Percent = 30;
    private bool Unknown;
    private string Status => Unknown ? Localization.Parse(TextKey.Sample_EstimatingExportTask) : Percent == 100 ? Localization.Parse(TextKey.Sample_FictionalFileExportCompleted) : Localization.Parse(TextKey.Sample_ExportProgress, Percent);
    private void Change(int amount) { Unknown = false; Percent = Math.Clamp(Percent + amount, 0, 100); }
    private void Reset() { Percent = 30; Unknown = false; }
}
