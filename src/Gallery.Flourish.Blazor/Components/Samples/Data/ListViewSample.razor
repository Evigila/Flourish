@inherits LocalizedComponentBase
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using ArkheideSystem.Flourish.Blazor.Components
@using Microsoft.AspNetCore.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("ListView<TItem>", DescriptionKey = "Key.Sample_ListViewSample_Description")]

<ListView TItem="Entry" Items="@(Preview ? Items.Take(3).ToArray() : Items)" Columns="Columns"
          ItemKey="@(item => item.Id)" RowHeaderKey="name" Culture="SampleCulture" Label="@Localization.Parse(TextKey.Sample_StaticFictionalSuppliesDirectory)"
          Caption="@Localization.Parse(TextKey.Sample_ReadOnlySuppliesDirectoryWithNamesDescriptionsUnitPricesAndAvailabilityTheCompleteSceneIncludesAll25Records)">
    <CellTemplate Context="cell">
        @if (cell.Column.Key == "available")
        {
            <span aria-label="@(cell.Item.Available ? Localization.Parse(TextKey.Sample_Available) : Localization.Parse(TextKey.Sample_Unavailable))">@(cell.Item.Available ? "✔" : "✘")</span>
        }
        else
        {
            @cell.Text
        }
    </CellTemplate>
</ListView>
@if (!Preview)
{
    <ListView TItem="Entry" Items="Array.Empty<Entry>()" Columns="Columns" RowHeaderKey="name" Label="@Localization.Parse(TextKey.Sample_EmptyReadOnlyDirectory)" EmptyMessage="@Localization.Parse(TextKey.Sample_ThereAreNoSupplies)" />
}

@code {
    [Parameter] public bool Preview { get; set; }
    private sealed record Entry(int Id, string Name, string? Notes, decimal? Price, bool Available);
    private CultureInfo SampleCulture => CultureInfo.GetCultureInfo(Localization.Culture);
    private static readonly IReadOnlyList<Entry> Items = Enumerable.Range(1, 25)
        .Select(index => new Entry(index, $"虚构用品 {index:00}", index % 3 == 0 ? null
            : index == 1 ? "Key.Sample_ListViewLongNotes"
            : "Key.Sample_ListViewNotes", index % 4 == 0 ? null : 3.5m + index, index % 2 == 1)).ToArray();
    private IReadOnlyList<TableColumn<Entry>> Columns =>
    [
        new("name", Localization.Parse(TextKey.Record_Name), item => item.Name),
        new("notes", Localization.Parse(TextKey.Sample_Description), item => item.Notes, Format: item => item.Notes is null ? null : Localization.Parse(item.Notes)),
        new("price", Localization.Parse(TextKey.Sample_UnitPrice), item => item.Price, Format: item => item.Price?.ToString("C", SampleCulture)),
        new("available", Localization.Parse(TextKey.Sample_Available), item => item.Available)
    ];
}
