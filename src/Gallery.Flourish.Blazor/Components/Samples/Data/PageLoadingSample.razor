@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Data
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.PageLoading")]

@if (Preview)
{
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.PageLoading>正在加载…</ArkheideSystem.Flourish.Blazor.Components.Primitives.PageLoading>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.PageLoading><Icon Name="hourglass_empty" /> 自定义加载内容</ArkheideSystem.Flourish.Blazor.Components.Primitives.PageLoading>
}
else
{
    <div class="f-inline-actions">
        <Button Busy="Loading" BusyLabel="正在加载" OnClick="() => LoadAsync(false)">模拟成功</Button>
        <Button Variant="ButtonVariant.Secondary" Disabled="Loading" OnClick="() => LoadAsync(true)">模拟失败</Button>
    </div>
    @if (Loading) { <ArkheideSystem.Flourish.Blazor.Components.Primitives.PageLoading>正在读取虚构列表…</ArkheideSystem.Flourish.Blazor.Components.Primitives.PageLoading> }
    else if (Error) { <ArkheideSystem.Flourish.Blazor.Components.Primitives.StatusNotice Severity="Primitives.NoticeSeverity.Error">模拟加载失败，可以重新执行。</ArkheideSystem.Flourish.Blazor.Components.Primitives.StatusNotice> }
    else if (Loaded) { <ul><li>虚构记录 A</li><li>虚构记录 B</li></ul> }
    else { <EmptyState Title="尚未加载" /> }
}

@code {
    [Parameter] public bool Preview { get; set; }
    private bool Loading, Loaded, Error;
    private async Task LoadAsync(bool fail)
    {
        if (Loading) return;
        Loading = true;
        try { await Task.Delay(700); Error = fail; Loaded = !fail; }
        finally { Loading = false; }
    }
}
