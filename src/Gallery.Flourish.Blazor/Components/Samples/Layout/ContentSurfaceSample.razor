@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Patterns.ContentSurface", DescriptionKey = "Key.Sample_ContentSurfaceSample_Description")]
@using System
@using Microsoft.AspNetCore.Components
@using Controls = ArkheideSystem.Flourish.Blazor.Components
@using Patterns = ArkheideSystem.Flourish.Blazor.Components.Patterns
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives

<ArkheideSystem.Flourish.Blazor.Components.Patterns.ContentSurface Style="height:420px; min-height:0; position:relative; contain:layout paint;" ContentId="@Id" DocumentKey="Document" SkipLabel="@Localization.Parse(TextKey.Sample_SkipToExampleContent)">
    <TitleBar><header class="content-topbar"><strong>@(Preview ? Localization.Parse(TextKey.Nav_TopBar) : Localization.Parse(TextKey.Sample_HelpCenterFictional))</strong>@if (!Preview) { <ArkheideSystem.Flourish.Blazor.Components.Button OnClick="ChangeDocument">@Localization.Parse(TextKey.Sample_SwitchArticle)</ArkheideSystem.Flourish.Blazor.Components.Button> }</header></TitleBar>
    <ChildContent>
        @if (!Preview)
        {
            <div class="page-root"><ArkheideSystem.Flourish.Blazor.Components.PageHeading Title="@(Document == 0 ? Localization.Parse(TextKey.Sample_QuickStartFictional) : Localization.Parse(TextKey.Sample_FrequentlyAskedQuestionsFictional))" /><p>@Localization.Parse(TextKey.Sample_HelpCenterContent)</p>
                @for (var row = 1; row <= 6; row++) { <section class="page-module"><h2>@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_DescriptionNumber), row)</h2><p>@Localization.Parse(TextKey.Sample_ThisFictionalHelpTextDemonstratesAFixedTopBarAndScrollingContent)</p></section> }
            </div>
        }
    </ChildContent>
</ArkheideSystem.Flourish.Blazor.Components.Patterns.ContentSurface>
@if (!Preview)
{
    <InlineActions><Button Variant="ButtonVariant.Underline" Href="/examples/display/login">@Localization.Parse(TextKey.Nav_DisplayLogin)</Button><Button Variant="ButtonVariant.Underline" Href="/examples/display/accounts">@Localization.Parse(TextKey.Sample_AccountSelectionPage)</Button></InlineActions>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = $"content-sample-{Guid.NewGuid():N}";
    private int Document;
    private void ChangeDocument() => Document = 1 - Document;
}
