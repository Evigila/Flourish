@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Patterns.RecordListPage")]
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Abstract
@using Controls = ArkheideSystem.Flourish.Blazor.Components
@using Patterns = ArkheideSystem.Flourish.Blazor.Components.Patterns

<ArkheideSystem.Flourish.Blazor.Components.Patterns.RecordListPage Title="@(Preview ? "列表标题" : "阅读清单（虚构）")" SectionTitle="@(Preview ? "列表区域" : "书目")">
    <Actions>@if (!Preview) { <ArkheideSystem.Flourish.Blazor.Components.Button OnClick="AddBook">添加虚构书目</ArkheideSystem.Flourish.Blazor.Components.Button> }</Actions>
    <Status>@if (Added) { <ArkheideSystem.Flourish.Blazor.Components.Notice Severity="NotificationSeverity.Success">已添加示例书目。</ArkheideSystem.Flourish.Blazor.Components.Notice> }</Status>
    <ChildContent>
        @if (Preview) { <ArkheideSystem.Flourish.Blazor.Components.EmptyState Title="没有记录" /> }
        else { <ul>@foreach (var book in Books) { <li>@book</li> }</ul> }
    </ChildContent>
</ArkheideSystem.Flourish.Blazor.Components.Patterns.RecordListPage>

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly List<string> Books = ["森林笔记（虚构）", "城市观察（虚构）"];
    private bool Added;
    private void AddBook() { Books.Add($"新书目 {Books.Count + 1}（虚构）"); Added = true; }
}
