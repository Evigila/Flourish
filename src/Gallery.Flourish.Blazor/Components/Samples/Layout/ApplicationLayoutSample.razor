@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("ApplicationLayout", DescriptionKey = "Key.Sample_ApplicationLayoutSample_Description")]
@using System
@using Microsoft.AspNetCore.Components
@using Controls = ArkheideSystem.Flourish.Blazor.Components

<style>@((MarkupString)ScopedStyles)</style>
<div id="@Id" style="position:relative; overflow:hidden; isolation:isolate;" @onclick:preventDefault>
    <ArkheideSystem.Flourish.Blazor.Components.ApplicationLayout OwnsDocument="false">
        <Body>
            <ArkheideSystem.Flourish.Blazor.Components.PageBody>
                <ArkheideSystem.Flourish.Blazor.Components.PageHeading Title="@(Preview ? "" : Localization.Parse(TextKey.Sample_DocumentWorkspaceFictional))" />
                @if (!Preview)
                {
                    <ArkheideSystem.Flourish.Blazor.Components.Section Title="@Localization.Parse(TextKey.Sample_SharedResources)">
                        <p>@Localization.Parse(TextKey.Sample_UsesTheTopBarNavigationThemeAndContentScrollingConfiguredByTheHost)</p>
                        <ArkheideSystem.Flourish.Blazor.Components.Button OnClick="AddDocument">@Localization.Parse(TextKey.Sample_AddExampleDocument)</ArkheideSystem.Flourish.Blazor.Components.Button>
                        <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_AddedDocumentCount), Documents)</p>
                    </ArkheideSystem.Flourish.Blazor.Components.Section>
                }
            </ArkheideSystem.Flourish.Blazor.Components.PageBody>
        </Body>
    </ArkheideSystem.Flourish.Blazor.Components.ApplicationLayout>
</div>

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = $"layout-sample-{Guid.NewGuid():N}";
    private int Documents;
    private void AddDocument() => Documents++;
    // The application layout normally owns the viewport. Limit only this embedded preview.
    private string ScopedStyles => $"#{Id} > .f-shell {{ height:420px; min-height:0; }} #{Id} .f-titlebar-center, #{Id} .f-primary-navigation-fixed {{ display:none; }} #{Id} .f-skip-link {{ position:absolute; }} #{Id} .f-secondary-navigation {{ position:relative; }} #{Id} .f-navigation-backdrop {{ position:absolute; }}";
}
