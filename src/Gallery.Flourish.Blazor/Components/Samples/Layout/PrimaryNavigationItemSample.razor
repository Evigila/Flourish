@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.PrimaryNavigationItem", DescriptionKey = "Key.Sample_PrimaryNavigationItemSample_Description")]
@using System
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives

<div id="@Id" style="display:flex; flex-wrap:wrap; gap:12px;" @onclick:preventDefault>
    <div @onclick="SelectDocuments"><ArkheideSystem.Flourish.Blazor.Components.Primitives.PrimaryNavigationItem Id="@(Id + "-documents")" Label="@Localization.Parse(TextKey.Sample_Resources)" Icon="folder" Href="@($"#{Id}")" IsCurrent="@(Selected == "documents")" Match="NavLinkMatch.All" /></div>
    <div @onclick="SelectArchive"><ArkheideSystem.Flourish.Blazor.Components.Primitives.PrimaryNavigationItem Id="@(Id + "-archive")" Label="@Localization.Parse(TextKey.Sample_Archive)" Icon="archive" Href="@($"#{Id}")" IsCurrent="@(Selected == "archive")" Match="NavLinkMatch.All" /></div>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.PrimaryNavigationItem Id="@(Id + "-disabled")" Label="@Localization.Parse(TextKey.Sample_Manage)" Icon="settings" Disabled="true" DisabledMessage="@Localization.Parse(TextKey.Sample_TheDemoVisitorDoesNotHaveManagementPermission)" />
</div>
@if (!Preview)
{
    <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_CurrentModule), Selected == "documents" ? Localization.Parse(TextKey.Sample_Resources) : Localization.Parse(TextKey.Sample_Archive))</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = $"primary-nav-sample-{Guid.NewGuid():N}";
    private string Selected = "documents";
    private void SelectDocuments() => Selected = "documents";
    private void SelectArchive() => Selected = "archive";
}
