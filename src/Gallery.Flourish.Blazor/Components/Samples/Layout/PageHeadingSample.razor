@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("PageHeading")]
@using System
@using Microsoft.AspNetCore.Components
@using Controls = ArkheideSystem.Flourish.Blazor.Components

@if (Preview)
{
    <ArkheideSystem.Flourish.Blazor.Components.PageHeading Title="@Localization.Parse(TextKey.Sample_PageTitle)" />
    <ArkheideSystem.Flourish.Blazor.Components.PageHeading Title="@Localization.Parse(TextKey.Sample_CompactTitle)" Compact="true" />
    <ArkheideSystem.Flourish.Blazor.Components.PageHeading Title="@Localization.Parse(TextKey.Sample_TitleWithActions)"><Actions><ArkheideSystem.Flourish.Blazor.Components.Button>@Localization.Parse(TextKey.Sample_Action)</ArkheideSystem.Flourish.Blazor.Components.Button></Actions></ArkheideSystem.Flourish.Blazor.Components.PageHeading>
}
else
{
    <ArkheideSystem.Flourish.Blazor.Components.CheckBox Label="@Localization.Parse(TextKey.Sample_CompactTitle)" @bind-Value="Compact" />
    <div id="@Id">
        <ArkheideSystem.Flourish.Blazor.Components.PageHeading Title="@(Created ? Localization.Parse(TextKey.Sample_NewResourceFictional) : Localization.Parse(TextKey.Sample_ResourceDirectoryFictional))" Compact="Compact" ParentLabel="@Localization.Parse(TextKey.Sample_AllResources)" ParentHref="@($"#{Id}")">
            <Actions><ArkheideSystem.Flourish.Blazor.Components.Button OnClick="Create">@Localization.Parse(TextKey.Sample_NewResource)</ArkheideSystem.Flourish.Blazor.Components.Button></Actions>
        </ArkheideSystem.Flourish.Blazor.Components.PageHeading>
        <p role="status">@(Created ? Localization.Parse(TextKey.Sample_TheFictionalNewResourceSceneIsOpen) : Localization.Parse(TextKey.Sample_SelectNewResourceToTryTheHeadingAction))</p>
    </div>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = $"heading-sample-{Guid.NewGuid():N}";
    private bool Compact, Created;
    private void Create() => Created = true;
}
