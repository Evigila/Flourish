@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.NavigationGuard", DescriptionKey = "Key.Sample_NavigationGuardSample_Description")]
@using System
@using Microsoft.AspNetCore.Components
@using Controls = ArkheideSystem.Flourish.Blazor.Components
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives
@inject NavigationManager Navigation

@if (Preview)
{
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.NavigationGuard HasUnsavedChanges="false" />
}
else
{
    <ArkheideSystem.Flourish.Blazor.Components.CheckBox Label="@Localization.Parse(TextKey.Sample_EnableLeaveConfirmationForThisPage)" @bind-Value="Enabled" />
    @if (Enabled)
    {
        <ArkheideSystem.Flourish.Blazor.Components.Primitives.NavigationGuard HasUnsavedChanges="Dirty" Message="@Localization.Parse(TextKey.Sample_TheDemoDraftIsUnsavedLeaveAndDiscardIt)" />
    }
    <ArkheideSystem.Flourish.Blazor.Components.Field Label="@Localization.Parse(TextKey.Sample_DraftTitle)" Id="@Id"><ArkheideSystem.Flourish.Blazor.Components.TextBox @bind-Value="Draft" @bind-Value:after="Edit" /></ArkheideSystem.Flourish.Blazor.Components.Field>
    <ArkheideSystem.Flourish.Blazor.Components.Button OnClick="Save">@Localization.Parse(TextKey.Sample_SaveDemoDraft)</ArkheideSystem.Flourish.Blazor.Components.Button>
    <ArkheideSystem.Flourish.Blazor.Components.Button Variant="ButtonVariant.Underline" Href="@TestHref">@Localization.Parse(TextKey.Sample_TestLeaveConfirmationOnTheSameControlPage)</ArkheideSystem.Flourish.Blazor.Components.Button>
    <p role="status">@(Dirty ? Localization.Parse(TextKey.Sample_AnUnsavedFictionalDraftExists) : Localization.Parse(TextKey.Sample_NoUnsavedChanges))</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = $"navigation-guard-sample-{Guid.NewGuid():N}";
    private bool Enabled, Dirty;
    private string Draft = "虚构草稿";
    private string TestHref => new UriBuilder(Navigation.Uri) { Query = $"guardTest={Guid.NewGuid():N}" }.Uri.AbsoluteUri;
    private void Edit() => Dirty = true;
    private void Save() => Dirty = false;
}
