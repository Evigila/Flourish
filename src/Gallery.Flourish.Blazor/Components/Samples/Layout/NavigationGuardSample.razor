@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.NavigationGuard", Description = "此行为组件不生成可见内容。空白草稿不会阻止离开。\n虚构的本地草稿。明确启用后，此组件会保护当前 Gallery 页面，包括刷新和离开；保存或停用后解除。")]
@using System
@using Microsoft.AspNetCore.Components
@using Controls = ArkheideSystem.Flourish.Blazor.Components
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives
@inject NavigationManager Navigation

@if (Preview)
{
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.NavigationGuard HasUnsavedChanges="false" />
}
else
{
    <ArkheideSystem.Flourish.Blazor.Components.CheckBox Label="启用当前页面的离开确认" @bind-Value="Enabled" />
    @if (Enabled)
    {
        <ArkheideSystem.Flourish.Blazor.Components.Primitives.NavigationGuard HasUnsavedChanges="Dirty" Message="示例草稿未保存，是否离开并丢弃？" />
    }
    <ArkheideSystem.Flourish.Blazor.Components.Field Label="草稿标题" Id="@Id"><ArkheideSystem.Flourish.Blazor.Components.TextBox @bind-Value="Draft" @bind-Value:after="Edit" /></ArkheideSystem.Flourish.Blazor.Components.Field>
    <ArkheideSystem.Flourish.Blazor.Components.Button OnClick="Save">保存示例草稿</ArkheideSystem.Flourish.Blazor.Components.Button>
    <ArkheideSystem.Flourish.Blazor.Components.Button Variant="ButtonVariant.Underline" Href="@TestHref">测试离开确认（保留同一控件页面）</ArkheideSystem.Flourish.Blazor.Components.Button>
    <p role="status">@(Dirty ? "存在未保存的虚构草稿。" : "没有未保存的修改。")</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = $"navigation-guard-sample-{Guid.NewGuid():N}";
    private bool Enabled, Dirty;
    private string Draft = "虚构草稿";
    private string TestHref => new UriBuilder(Navigation.Uri) { Query = $"guardTest={Guid.NewGuid():N}" }.Uri.AbsoluteUri;
    private void Edit() => Dirty = true;
    private void Save() => Dirty = false;
}
