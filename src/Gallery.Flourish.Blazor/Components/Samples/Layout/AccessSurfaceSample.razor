@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.AccessSurface")]
@inherits LocalizedComponentBase

<p>@Localization.Parse(TextKey.Access_SurfaceGuide)</p>
<AccessActions Label="@Localization.Parse(TextKey.Nav_DisplayAccess)">
    <Button Variant="ButtonVariant.Elevated" Href="/examples/display/login">@Localization.Parse(TextKey.Nav_DisplayLogin)</Button>
    <Button Variant="ButtonVariant.Outlined" Href="/examples/display/accounts">@Localization.Parse(TextKey.Nav_DisplayAccounts)</Button>
</AccessActions>
@if (!Preview)
{
    <Notice Severity="NotificationSeverity.Information" Announce="false">@Localization.Parse(TextKey.Access_DemoOnly)</Notice>
}

@code {
    [Parameter] public bool Preview { get; set; }
}
