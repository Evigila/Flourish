@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Patterns.NavigationSurface")]
@using System
@using Microsoft.AspNetCore.Components
@using Controls = ArkheideSystem.Flourish.Blazor.Components
@using Patterns = ArkheideSystem.Flourish.Blazor.Components.Patterns
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives

@if (!Preview) {
    <ArkheideSystem.Flourish.Blazor.Components.CheckBox Label="@Localization.Parse(TextKey.Sample_ShowSecondaryNavigation)" @bind-Value="Secondary" />
    <ArkheideSystem.Flourish.Blazor.Components.StandaloneCheckBox Label="@Localization.Parse(TextKey.Sample_HalfCenteredGutters)" @bind-Value="HalfGutters" />
}
<ArkheideSystem.Flourish.Blazor.Components.Patterns.NavigationSurface CenteredContentGutterScale="@(HalfGutters ? 0.5 : 1)" Style="height:440px; min-height:0; position:relative; contain:layout paint;" ShowSecondary="Secondary" ContentId="@Id" DocumentKey="@Page" SkipLabel="@Localization.Parse(TextKey.Sample_SkipToExampleContent)" PrimaryLabel="@Localization.Parse(TextKey.Sample_ExampleModules)" SecondaryLabel="@Localization.Parse(TextKey.Sample_ExamplePages)" TopLabel="@Localization.Parse(TextKey.Sample_BackToExampleTop)">
    <TitleBar><header class="app-topbar"><strong>@(Preview ? Localization.Parse(TextKey.Nav_TopBar) : Localization.Parse(TextKey.Sample_ResourceCenterFictional))</strong></header></TitleBar>
    <PrimaryNavigation>
        <div @onclick="ShowDocuments" @onclick:preventDefault>
            <ArkheideSystem.Flourish.Blazor.Components.Primitives.PrimaryNavigationItem Id="@(Id + "-documents")" Label="@Localization.Parse(TextKey.Sample_Resources)" Icon="folder" Href="@($"#{Id}")" IsCurrent="true" />
        </div>
    </PrimaryNavigation>
    <SecondaryNavigation>
        <div @onclick="ShowDocuments" @onclick:preventDefault><ArkheideSystem.Flourish.Blazor.Components.Primitives.SecondaryNavigationItem Label="@Localization.Parse(TextKey.Sample_AllResources)" Href="@($"#{Id}-documents")" IsCurrent="@(Page == 0)" /></div>
        <div @onclick="ShowArchived" @onclick:preventDefault><ArkheideSystem.Flourish.Blazor.Components.Primitives.SecondaryNavigationItem Label="@Localization.Parse(TextKey.Sample_Archived)" Href="@($"#{Id}-archived")" IsCurrent="@(Page == 1)" /></div>
    </SecondaryNavigation>
    <ChildContent>
        @if (!Preview)
        {
            <ArkheideSystem.Flourish.Blazor.Components.PageBody Fluid="false"><ArkheideSystem.Flourish.Blazor.Components.PageHeading Title="@(Page == 0 ? Localization.Parse(TextKey.Sample_AllResourcesFictional) : Localization.Parse(TextKey.Sample_ArchivedFictional))" ParentLabel="@Localization.Parse(TextKey.Sample_Resources)" ParentHref="@($"#{Id}")" />
                @for (var row = 1; row <= (Page == 0 ? 6 : 3); row++) { <ArkheideSystem.Flourish.Blazor.Components.Section Title="@($"{(Page == 0 ? Localization.Parse(TextKey.Sample_Resources) : Localization.Parse(TextKey.Sample_ArchivedResources))} {row}")"><p>@Localization.Parse(TextKey.Sample_ThisIsAFictionalRecordChangingPagesUpdatesTheSectionIndexAndOnlyTheExampleContentAreaScrolls)</p></ArkheideSystem.Flourish.Blazor.Components.Section> }
            </ArkheideSystem.Flourish.Blazor.Components.PageBody>
        }
    </ChildContent>
</ArkheideSystem.Flourish.Blazor.Components.Patterns.NavigationSurface>

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = $"navigation-sample-{Guid.NewGuid():N}";
    private bool Secondary = true;
    private bool HalfGutters;
    private int Page;
    private void ShowDocuments() => Page = 0;
    private void ShowArchived() => Page = 1;
}
