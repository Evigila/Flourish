@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.InteractionBoundary")]
@using System
@using Microsoft.AspNetCore.Components
@using Controls = ArkheideSystem.Flourish.Blazor.Components
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives

@if (!Preview) { <ArkheideSystem.Flourish.Blazor.Components.CheckBox Label="@Localization.Parse(TextKey.Sample_PauseInteractionInThisExampleArea)" @bind-Value="Locked" /> }
<style>@((MarkupString)ScopedStyles)</style>
<div id="@Id" style="position:relative; min-height:280px; isolation:isolate;">
    @if (Preview)
    {
        <div style="position:relative; min-height:240px;">
            <ArkheideSystem.Flourish.Blazor.Components.Primitives.InteractionBoundary Locked="true" Title="@Localization.Parse(TextKey.Sample_LockedState)">
                <Message><p>@Localization.Parse(TextKey.Sample_InteractionIsPausedInThisArea)</p></Message>
                <ChildContent><ArkheideSystem.Flourish.Blazor.Components.Field Label="@Localization.Parse(TextKey.Sample_Input)" Id="@(Id + "-locked-input")"><ArkheideSystem.Flourish.Blazor.Components.TextBox @bind-Value="EmptyValue" /></ArkheideSystem.Flourish.Blazor.Components.Field></ChildContent>
            </ArkheideSystem.Flourish.Blazor.Components.Primitives.InteractionBoundary>
        </div>
    }
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.InteractionBoundary Locked="Locked" Title="@Localization.Parse(TextKey.Sample_ExampleTemporarilyNotEditable)">
        <Message><p>@Localization.Parse(TextKey.Sample_AFictionalSynchronizationIsInProgressOnlyThisExampleAreaIsPaused)</p><ArkheideSystem.Flourish.Blazor.Components.Button OnClick="Unlock">@Localization.Parse(TextKey.Sample_CompleteDemoSynchronization)</ArkheideSystem.Flourish.Blazor.Components.Button></Message>
        <ChildContent>
            <ArkheideSystem.Flourish.Blazor.Components.Field Label="@Localization.Parse(TextKey.Sample_Notes)" Id="@(Id + "-note")"><ArkheideSystem.Flourish.Blazor.Components.TextBox @bind-Value="Note" /></ArkheideSystem.Flourish.Blazor.Components.Field>
            <ArkheideSystem.Flourish.Blazor.Components.Button OnClick="Save">@Localization.Parse(TextKey.Sample_SaveNotes)</ArkheideSystem.Flourish.Blazor.Components.Button>
            @if (!Preview) { <p role="status">@(Saved ? Localization.Parse(TextKey.Sample_FictionalNotesSaved) : Localization.Parse(TextKey.Sample_ThisIsAFictionalLocalEditor))</p> }
        </ChildContent>
    </ArkheideSystem.Flourish.Blazor.Components.Primitives.InteractionBoundary>
</div>

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = $"boundary-sample-{Guid.NewGuid():N}";
    private bool Locked, Saved;
    private string EmptyValue = string.Empty;
    private string Note = string.Empty;
    private void Save() => Saved = true;
    private void Unlock() => Locked = false;
    // The library's page-level boundary normally covers the viewport. Keep this demonstration local.
    private string ScopedStyles => $"#{Id} .interaction-lock {{ position:absolute; inset:0; }}";
}
