@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.InteractionBoundary")]
@using System
@using Microsoft.AspNetCore.Components
@using Controls = ArkheideSystem.Flourish.Blazor.Components
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives

@if (!Preview) { <ArkheideSystem.Flourish.Blazor.Components.CheckBox Label="暂停此示例区域的交互" @bind-Value="Locked" /> }
<style>@((MarkupString)ScopedStyles)</style>
<div id="@Id" style="position:relative; min-height:280px; isolation:isolate;">
    @if (Preview)
    {
        <div style="position:relative; min-height:240px;">
            <ArkheideSystem.Flourish.Blazor.Components.Primitives.InteractionBoundary Locked="true" Title="锁定状态">
                <Message><p>此区域暂停交互。</p></Message>
                <ChildContent><label>输入<input value="" /></label></ChildContent>
            </ArkheideSystem.Flourish.Blazor.Components.Primitives.InteractionBoundary>
        </div>
    }
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.InteractionBoundary Locked="Locked" Title="示例暂时不可编辑">
        <Message><p>虚构的同步操作正在进行。只暂停这个示例区域。</p><ArkheideSystem.Flourish.Blazor.Components.Button OnClick="Unlock">完成示例同步</ArkheideSystem.Flourish.Blazor.Components.Button></Message>
        <ChildContent>
            <label>备注<input @bind="Note" /></label>
            <ArkheideSystem.Flourish.Blazor.Components.Button OnClick="Save">保存备注</ArkheideSystem.Flourish.Blazor.Components.Button>
            @if (!Preview) { <p role="status">@(Saved ? "已保存虚构备注。" : "这是虚构的本地编辑器。")</p> }
        </ChildContent>
    </ArkheideSystem.Flourish.Blazor.Components.Primitives.InteractionBoundary>
</div>

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = $"boundary-sample-{Guid.NewGuid():N}";
    private bool Locked, Saved;
    private string Note = string.Empty;
    private void Save() => Saved = true;
    private void Unlock() => Locked = false;
    // The library's page-level boundary normally covers the viewport. Keep this demonstration local.
    private string ScopedStyles => $"#{Id} .interaction-lock {{ position:absolute; inset:0; }}";
}
