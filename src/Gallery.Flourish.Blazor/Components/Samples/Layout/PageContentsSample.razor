@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.PageContents")]
@using System
@using Microsoft.AspNetCore.Components
@using Patterns = ArkheideSystem.Flourish.Blazor.Components.Patterns
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives

<ArkheideSystem.Flourish.Blazor.Components.Patterns.NavigationSurface Style="height:420px; min-height:0; position:relative; contain:layout paint;" ShowSecondary="false" ContentId="@(Id + "-body")">
    <TitleBar><header class="app-topbar"><strong>@(Preview ? "页内目录" : "阅读指南（虚构）")</strong></header></TitleBar>
    <PrimaryNavigation><ArkheideSystem.Flourish.Blazor.Components.Primitives.PrimaryNavigationItem Id="@(Id + "-nav")" Label="指南" Icon="description" Href="@($"#{Id}-body")" IsCurrent="true" /></PrimaryNavigation>
    <ChildContent>
        <div class="page-root page-content-frame">
            <ArkheideSystem.Flourish.Blazor.Components.Primitives.PageContents>
                <li><a href="@($"#{Id}-summary")"><span class="page-contents-label">概述</span></a></li>
                <li><a href="@($"#{Id}-steps")"><span class="page-contents-label">步骤</span></a></li>
            </ArkheideSystem.Flourish.Blazor.Components.Primitives.PageContents>
            <div class="module-group">
                <section class="page-module" id="@(Id + "-summary")"><h2>概述</h2>@if (!Preview) { <p>此虚构指南介绍如何整理阅读资料。</p> }</section>
                <section class="page-module" id="@(Id + "-steps")"><h2>步骤</h2>@if (!Preview) { <ol><li>创建资料目录。</li><li>添加分类。</li><li>记录阅读进度。</li></ol> }</section>
            </div>
        </div>
    </ChildContent>
</ArkheideSystem.Flourish.Blazor.Components.Patterns.NavigationSurface>

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = $"page-contents-sample-{Guid.NewGuid():N}";
}
