@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.ServiceMenu", Description = "虚构帮助中心。菜单提供指向实际示例段落的导航链接。")]
@using System
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@using Primitives = ArkheideSystem.Flourish.Blazor.Components.Primitives

@if (Preview)
{
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.ServiceMenu Id="@(Id + "-empty")" Label="页面" Items="EmptyLinks" />
}
else
{
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.ServiceMenu Id="@(Id + "-menu")" Label="帮助章节" Items="Links" />
    <section id="@(Id + "-start")"><h3>快速开始（虚构）</h3><p>创建工作区后，将资料加入目录。</p></section>
    <section id="@(Id + "-sharing")"><h3>共享资料（虚构）</h3><p>共享链接与访问权限由应用负责处理。</p></section>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = $"service-menu-sample-{Guid.NewGuid():N}";
    private static readonly IReadOnlyList<ArkheideSystem.Flourish.Blazor.Components.Primitives.ServiceLink> EmptyLinks = [];
    private IReadOnlyList<ArkheideSystem.Flourish.Blazor.Components.Primitives.ServiceLink> Links => [new("快速开始", $"#{Id}-start"), new("共享资料", $"#{Id}-sharing")];
}
