@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Blazor.Components
@using Microsoft.AspNetCore.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("SectionNavigator")]

<div style="width:100%;min-width:0;">
    <div id="@ContentId" class="f-page-body" style="height:340px;overflow:auto;position:relative;--f-content-gutter:32px;">
        <Section Title="@Localization.Parse(TextKey.Localization_IntroTitle)"><div style="min-height:@(Preview ? "120px" : "220px")">@if (!Preview) { <p>@Localization.Parse(TextKey.Sample_TheLocalReportIncludesThreeSectionsOfFictionalData)</p> }</div></Section>
        <Section Title="@Localization.Parse(TextKey.Sample_Data)"><div style="min-height:@(Preview ? "120px" : "220px")">@if (!Preview) { <UniformGrid><UniformGridItem Title="@Localization.Parse(TextKey.Sample_RecordCount)" Text="24" /><UniformGridItem Title="@Localization.Parse(TextKey.Sample_Period)" Text="@Localization.Parse(TextKey.Sample_ExampleMonth)" /></UniformGrid> }</div></Section>
        <Section Title="@Localization.Parse(TextKey.Sample_Summary)"><div style="min-height:160px">@if (!Preview) { <p>@Localization.Parse(TextKey.Sample_AllRecordsHaveBeenOrganized)</p> }</div></Section>
    </div>
    <SectionNavigator ContentId="@ContentId" Label="@Localization.Parse(TextKey.Sample_ReportSections)" />
</div>

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string ContentId = "section-sample-" + Guid.NewGuid().ToString("N");
}
