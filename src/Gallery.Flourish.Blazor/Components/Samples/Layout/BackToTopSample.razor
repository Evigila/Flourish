@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("BackToTop", DescriptionKey = "Key.Sample_BackToTopSample_Description")]

<div id="@ContentId" tabindex="-1" style="height:280px;overflow:auto;width:100%;">
    <Section Title="@Localization.Parse(TextKey.Sample_LocalLongReport)">
        <p>@Localization.Parse(TextKey.Sample_ScrollDownToSeeTheBackButton)</p>
        <div style="min-height:@(Preview ? "340px" : "600px")"><p>@Localization.Parse(TextKey.Sample_ReportContent)</p></div>
    </Section>
</div>
<BackToTop ContentId="@ContentId" Threshold="120" Label="@Localization.Parse(TextKey.Sample_BackToReportTop)" />

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string ContentId = "top-sample-" + Guid.NewGuid().ToString("N");
}
