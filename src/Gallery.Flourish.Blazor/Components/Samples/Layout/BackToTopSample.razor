@using ArkheideSystem.Flourish.Blazor.Components
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Layout
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("BackToTop", Description = "滚动超过 120px 后显示按钮，点击只返回这个区域的顶部。减少动态效果偏好使用直接滚动；无 JavaScript 时保留原生片段链接。")]

<div id="@ContentId" tabindex="-1" style="height:280px;overflow:auto;width:100%;">
    <Section Title="本地长报告">
        <p>向下滚动查看返回按钮。</p>
        <div style="min-height:@(Preview ? "340px" : "600px")"><p>报告正文。</p></div>
    </Section>
</div>
<BackToTop ContentId="@ContentId" Threshold="120" Label="返回报告顶部" />

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string ContentId = "top-sample-" + Guid.NewGuid().ToString("N");
}
