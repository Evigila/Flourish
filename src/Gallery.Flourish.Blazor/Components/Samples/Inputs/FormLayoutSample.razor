@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("FormLayout")]
@using System
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using ArkheideSystem.Flourish.Blazor
@using ArkheideSystem.Flourish.Blazor.Components

@if (Preview)
{
    <FormLayout Columns="1"><Field MessageFormatter="LocalizeValidation" Label="@Localization.Parse(TextKey.Sample_SingleColumn)" Id="@(Prefix + "-one")"><TextBox @bind-Value="EmptyOne" /></Field></FormLayout>
    <FormLayout Columns="2">
        <Field MessageFormatter="LocalizeValidation" Label="@Localization.Parse(TextKey.Sample_FirstItemInTwoColumns)" Id="@(Prefix + "-two-a")"><TextBox @bind-Value="EmptyTwoA" /></Field>
        <Field MessageFormatter="LocalizeValidation" Label="@Localization.Parse(TextKey.Sample_SecondItemInTwoColumns)" Id="@(Prefix + "-two-b")"><TextBox @bind-Value="EmptyTwoB" /></Field>
    </FormLayout>
}
else
{
    <ToggleSwitch Label="@Localization.Parse(TextKey.Sample_UseASingleColumn)" @bind-Value="SingleColumn" OnLabel="@Localization.Parse(TextKey.Sample_SingleColumn)" OffLabel="@Localization.Parse(TextKey.Sample_TwoColumns)" />
    <EditForm Model="Model" FormName="@Prefix" OnValidSubmit="Submit" OnInvalidSubmit="Invalid" novalidate>
        <DataAnnotationsValidator />
        <FormLayout Columns="@(SingleColumn ? 1 : 2)">
            <Field MessageFormatter="LocalizeValidation" Label="@Localization.Parse(TextKey.Sample_Registrant)" Id="@(Prefix + "-name")" Required="true" For="@(() => Model.Name)"><TextBox @bind-Value="Model.Name" /></Field>
            <Field MessageFormatter="LocalizeValidation" Label="@Localization.Parse(TextKey.Sample_Email)" Id="@(Prefix + "-email")" Required="true" For="@(() => Model.Email)"><TextBox @bind-Value="Model.Email" Type="email" /></Field>
            <Field MessageFormatter="LocalizeValidation" Label="@Localization.Parse(TextKey.Sample_Notes)" Id="@(Prefix + "-note")" FullWidth="true"><TextBox @bind-Value="Model.Note" Multiline="true" /></Field>
        </FormLayout>
        <FormActions><UniformGridButton Title="@Localization.Parse(TextKey.Sample_SubmitDemo)" Variant="UniformGridVariant.FilledElevated" Type="submit" /><UniformGridButton Title="@Localization.Parse(TextKey.Sample_ClearName)" Variant="UniformGridVariant.Elevated" OnClick="ClearName" /></FormActions>
    </EditForm>
    <p role="status">@Localization.Parse(Message)</p>
}

@code {
    private string LocalizeValidation(string message) => Localization.TryParse(message, [], out var text) ? text : message;
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-form-layout-" + Guid.NewGuid().ToString("N");
    private string? EmptyOne, EmptyTwoA, EmptyTwoB;
    private bool SingleColumn;
    private string Message = "Key.Sample_DemoSubmissionsAreKeptOnlyOnThisPage";
    private readonly Registration Model = new();
    private void ClearName() { Model.Name = ""; Message = "Key.Sample_NameClearedSubmitToCheckErrorFocus"; }
    private void Submit() => Message = "Key.Sample_DemoRegistrationPassedLocalValidation";
    private void Invalid() => Message = "Key.Sample_CorrectTheErrorsInTheForm";
    private sealed class Registration
    {
        [Required(ErrorMessage = "Key.Sample_EnterAName")] public string Name { get; set; } = "林晴（虚构）";
        [Required(ErrorMessage = "Key.Sample_EnterAnEmail"), EmailAddress(ErrorMessage = "Key.Sample_EnterAValidEmail")] public string Email { get; set; } = "demo@example.invalid";
        public string? Note { get; set; } = "虚构示例：希望参加摄影活动。";
    }
}
