@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.SearchAutocomplete<TItem>")]
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using P = ArkheideSystem.Flourish.Blazor.Components.Primitives

@if (Preview)
{
    <FormLayout Columns="1">
        <Field Id="@(Prefix + "-empty")" Label="@Localization.Parse(TextKey.Sample_EmptySuggestionList)">
        <ArkheideSystem.Flourish.Blazor.Components.Primitives.SearchAutocomplete TItem="Suggestion" Id="@(Prefix + "-empty")" Items="EmptyItems" ValueSelector="@(item => item.Name)" TextSelector="@(item => item.Name)" @bind-Value="EmptyQuery" EmptyText="@Localization.Parse(TextKey.Sample_NoSuggestions)" ResultsLabel="@Localization.Parse(TextKey.Sample_SearchSuggestions)" />
        </Field>
        <Field Id="@(Prefix + "-disabled")" Label="@Localization.Parse(TextKey.Sample_Disabled)">
        <ArkheideSystem.Flourish.Blazor.Components.Primitives.SearchAutocomplete TItem="Suggestion" Id="@(Prefix + "-disabled")" Items="EmptyItems" ValueSelector="@(item => item.Name)" TextSelector="@(item => item.Name)" @bind-Value="EmptyDisabled" Disabled="true" />
        </Field>
    </FormLayout>
}
else
{
    <ToggleSwitch Label="@Localization.Parse(TextKey.Sample_SimulateNoSuggestions)" @bind-Value="NoItems" @bind-Value:after="ResetSelection" OnLabel="@Localization.Parse(TextKey.Sample_NoData)" OffLabel="@Localization.Parse(TextKey.Sample_DemoData)" />
    <FormLayout Columns="1">
        <Field Id="@(Prefix + "-venue")" Label="@Localization.Parse(TextKey.Sample_VenueName)">
        <ArkheideSystem.Flourish.Blazor.Components.Primitives.SearchAutocomplete TItem="Suggestion" Id="@(Prefix + "-venue")" Items="@(NoItems ? EmptyItems : Suggestions)"
                              ValueSelector="@(item => item.Name)" TextSelector="@(item => item.Name)" KeySelector="@(item => item.Id)"
                              @bind-Value="Query" InputChanged="InputChanged" ItemSelected="Selected" SearchCleared="Cleared" Placeholder="@Localization.Parse(TextKey.Sample_EnterOrToChooseADemoVenue)" EmptyText="@Localization.Parse(TextKey.Sample_NoMatchingDemoVenues)" ResultsLabel="@Localization.Parse(TextKey.Sample_VenueSuggestions)" />
        </Field>
    </FormLayout>
    <p role="status">@(Chosen is null ? Localization.Parse(Message) : string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_SelectedVenue), Chosen.Name, Chosen.Id))</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-autocomplete-" + Guid.NewGuid().ToString("N");
    private string EmptyQuery = "", EmptyDisabled = "", Query = "活动";
    private bool NoItems;
    private string Message = "Key.Sample_NoDemoVenueSelectedYet";
    private static readonly Suggestion[] EmptyItems = [];
    private readonly Suggestion[] Suggestions = [new("river", "河畔活动室（虚构）"), new("park", "公园活动室（虚构）"), new("library", "公共阅读室（虚构）"), new("meeting", "晨光会议室（虚构）")];
    private sealed record Suggestion(string Id, string Name);
    private void InputChanged(string value) => ResetSelection();
    private void ResetSelection() { Chosen = null; Message = "Key.Sample_NoDemoVenueSelectedYet"; }
    private Suggestion? Chosen;
    private void Selected(Suggestion item) => Chosen = item;
    private void Cleared() { Chosen = null; Message = "Key.Sample_SearchCleared"; }
}
