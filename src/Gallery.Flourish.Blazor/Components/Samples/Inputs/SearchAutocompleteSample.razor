@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.SearchAutocomplete<TItem>")]
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using P = ArkheideSystem.Flourish.Blazor.Components.Primitives

@if (Preview)
{
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.FormFields>
        <div style="display:grid;gap:8px"><label for="@(Prefix + "-empty")">空候选集</label>
        <ArkheideSystem.Flourish.Blazor.Components.Primitives.SearchAutocomplete TItem="Suggestion" Id="@(Prefix + "-empty")" Items="EmptyItems" ValueSelector="@(item => item.Name)" TextSelector="@(item => item.Name)" @bind-Value="EmptyQuery" EmptyText="没有候选项" ResultsLabel="搜索建议" />
        </div>
        <div style="display:grid;gap:8px"><label for="@(Prefix + "-disabled")">禁用</label>
        <ArkheideSystem.Flourish.Blazor.Components.Primitives.SearchAutocomplete TItem="Suggestion" Id="@(Prefix + "-disabled")" Items="EmptyItems" ValueSelector="@(item => item.Name)" TextSelector="@(item => item.Name)" @bind-Value="EmptyDisabled" Disabled="true" />
        </div>
    </ArkheideSystem.Flourish.Blazor.Components.Primitives.FormFields>
}
else
{
    <ToggleSwitch Label="模拟无候选项" @bind-Value="NoItems" @bind-Value:after="ResetSelection" OnLabel="无数据" OffLabel="示例数据" />
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.FormFields>
        <div style="display:grid;gap:8px"><label for="@(Prefix + "-venue")">场地名称</label>
        <ArkheideSystem.Flourish.Blazor.Components.Primitives.SearchAutocomplete TItem="Suggestion" Id="@(Prefix + "-venue")" Items="@(NoItems ? EmptyItems : Suggestions)"
                              ValueSelector="@(item => item.Name)" TextSelector="@(item => item.Name)" KeySelector="@(item => item.Id)"
                              @bind-Value="Query" InputChanged="InputChanged" ItemSelected="Selected" SearchCleared="Cleared" Placeholder="输入活动、阅读或会议，选择候选场地" EmptyText="没有匹配的示例场地" ResultsLabel="场地建议" />
        </div>
    </ArkheideSystem.Flourish.Blazor.Components.Primitives.FormFields>
    <p role="status">@Message</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-autocomplete-" + Guid.NewGuid().ToString("N");
    private string EmptyQuery = "", EmptyDisabled = "", Query = "活动";
    private bool NoItems;
    private string Message = "尚未选择示例场地。";
    private static readonly Suggestion[] EmptyItems = [];
    private readonly Suggestion[] Suggestions = [new("river", "河畔活动室（虚构）"), new("park", "公园活动室（虚构）"), new("library", "公共阅读室（虚构）"), new("meeting", "晨光会议室（虚构）")];
    private sealed record Suggestion(string Id, string Name);
    private void InputChanged(string value) => ResetSelection();
    private void ResetSelection() => Message = "尚未选择示例场地。";
    private void Selected(Suggestion item) => Message = $"已选择：{item.Name}；场地 ID：{item.Id}。";
    private void Cleared() => Message = "搜索已清空。";
}
