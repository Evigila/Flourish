@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("SearchBox")]
@using System
@using System.Linq
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components

@if (Preview)
{
    <SearchBox Label="@Localization.Parse(TextKey.Sample_Search)" @bind-Value="EmptyQuery" />
    <SearchBox Label="@Localization.Parse(TextKey.Sample_DisabledSearch)" @bind-Value="EmptyDisabled" Disabled="true" />
}
else
{
    <SearchBox Label="@Localization.Parse(TextKey.Sample_SearchDemoActivities)" @bind-Value="Query" SearchChanged="ApplySearch" DebounceMilliseconds="300" />
    <ul>
        @foreach (var item in Matches) { <li>@item</li> }
    </ul>
    <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_ActivityMatches), Matches.Length, AppliedQuery.Length == 0 ? Localization.Parse(TextKey.Sample_All) : AppliedQuery)</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private string EmptyQuery = "", EmptyDisabled = "", Query = "", AppliedQuery = "";
    private readonly string[] Activities = ["阅读分享会", "插画工作坊", "户外摄影", "编程交流会"];
    private string[] Matches => Activities.Where(item => item.Contains(AppliedQuery, StringComparison.OrdinalIgnoreCase)).ToArray();
    private void ApplySearch(string query) => AppliedQuery = query;
}
