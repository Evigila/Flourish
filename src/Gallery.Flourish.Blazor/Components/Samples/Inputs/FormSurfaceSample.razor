@using ArkheideSystem.Flourish.Abstract
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.FormSurface")]
@using System
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using ArkheideSystem.Flourish.Blazor
@using ArkheideSystem.Flourish.Blazor.Components
@using P = ArkheideSystem.Flourish.Blazor.Components.Primitives

@if (Preview)
{
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.FormSurface><div style="min-height:48px"></div></ArkheideSystem.Flourish.Blazor.Components.Primitives.FormSurface>
}
else
{
    <EditForm Model="Model" FormName="Prefix" OnSubmit="Submit">
        <ArkheideSystem.Flourish.Blazor.Components.Primitives.FormSurface>
            <ArkheideSystem.Flourish.Blazor.Components.Primitives.FormFields>
                <Field Label="姓名" Id="@(Prefix + "-name")"><TextBox @bind-Value="Model.Name" /></Field>
                <Field Label="邮箱" Id="@(Prefix + "-email")"><TextBox @bind-Value="Model.Email" Type="email" /></Field>
            </ArkheideSystem.Flourish.Blazor.Components.Primitives.FormFields>
            <ArkheideSystem.Flourish.Blazor.Components.Primitives.FormActionBar><UniformGridButton Title="保存示例" Type="submit" /><UniformGridButton Title="恢复示例" OnClick="Reset" /></ArkheideSystem.Flourish.Blazor.Components.Primitives.FormActionBar>
        </ArkheideSystem.Flourish.Blazor.Components.Primitives.FormSurface>
    </EditForm>
    <p role="status">@Message</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-form-surface-" + Guid.NewGuid().ToString("N");
    private readonly Registration Model = new();
    private string Message = "尚未保存示例。";
    private void Submit() => Message = "当前示例已保存到页面内存。";
    private void Reset() { Model.Name = "林晴（虚构）"; Model.Email = "demo@example.invalid"; Message = "示例字段已恢复。"; }
    private sealed class Registration { public string? Name { get; set; } = "林晴（虚构）"; public string? Email { get; set; } = "demo@example.invalid"; }
}
