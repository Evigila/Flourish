@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("ToggleSection")]
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components

@if (Preview)
{
    <ToggleSection Label="@Localization.Parse(TextKey.Sample_ClosedOptionalSection)" @bind-Value="Off"><div style="min-height:48px"></div></ToggleSection>
    <ToggleSection Label="@Localization.Parse(TextKey.Sample_OpenOptionalSection)" @bind-Value="On"><div style="min-height:48px"></div></ToggleSection>
    <ToggleSection Label="@Localization.Parse(TextKey.Sample_DisabledSection)" @bind-Value="DisabledValue" Disabled="true"><div style="min-height:48px"></div></ToggleSection>
}
else
{
    <ToggleSection Label="@Localization.Parse(TextKey.Sample_ProvideAdditionalInformation)" @bind-Value="Enabled">
        <Field Label="@Localization.Parse(TextKey.Sample_Description)" Id="@(Prefix + "-note")"><TextBox @bind-Value="Note" Multiline="true" Rows="3" /></Field>
    </ToggleSection>
    <p role="status">@(Enabled ? Localization.Parse(TextKey.Sample_AdditionalInformationWillBeProvided) : Localization.Parse(TextKey.Sample_NoAdditionalInformationWillBeProvided))</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-toggle-section-" + Guid.NewGuid().ToString("N");
    private bool Off, On = true, DisabledValue, Enabled = true;
    private string? Note = "虚构示例：请携带一本想分享的书。";
}
