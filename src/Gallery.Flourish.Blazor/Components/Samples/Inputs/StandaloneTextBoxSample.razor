@inherits LocalizedComponentBase
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [SampleFor("StandaloneTextBox", DescriptionKey = "Key.Sample_StandaloneTextBoxSample_Description")]
<Field Label="@Localization.Parse(TextKey.Sample_ProtocolBoundaryDemoEmail)" Id="@Id"><StandaloneTextBox Id="@Id" Type="email" name="email" @bind-Value="Email" /></Field>
<p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_CurrentLocalValue), Email)</p>
@if (!Preview)
{
    <Field Label="@Localization.Parse(TextKey.Sample_ProtocolBoundaryDemoQuantity)" Id="@(Id + "-quantity")"><StandaloneTextBox Id="@(Id + "-quantity")" Type="number" name="quantity" min="0" max="100" step="1" @bind-Value="Quantity" /></Field>
    <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_QuantitySubmission), Quantity)</p>
}
@code {
    [Parameter] public bool Preview { get; set; }
    private string? Quantity = "3";
    private string? Email = "visitor@example.invalid"; private readonly string Id = "standalone-text-" + Guid.NewGuid().ToString("N");
}
