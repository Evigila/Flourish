@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.StandaloneMaskedInput")]
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using P = ArkheideSystem.Flourish.Blazor.Components.Primitives

@if (Preview)
{
    <FormLayout Columns="1">
        <Field Id="@(Prefix + "-normal")" Label="@Localization.Parse(TextKey.Sample_StandaloneMaskedInput)"><ArkheideSystem.Flourish.Blazor.Components.Primitives.StandaloneMaskedInput id="@(Prefix + "-normal")" Mask="000-000" @bind-Value="Empty" /></Field>
        <Field Id="@(Prefix + "-readonly")" Label="@Localization.Parse(TextKey.Sample_ReadOnly)"><ArkheideSystem.Flourish.Blazor.Components.Primitives.StandaloneMaskedInput id="@(Prefix + "-readonly")" Mask="000-000" @bind-Value="EmptyReadOnly" readonly /></Field>
        <Field Id="@(Prefix + "-disabled")" Label="@Localization.Parse(TextKey.Sample_Disabled)"><ArkheideSystem.Flourish.Blazor.Components.Primitives.StandaloneMaskedInput id="@(Prefix + "-disabled")" Mask="000-000" @bind-Value="EmptyDisabled" disabled /></Field>
    </FormLayout>
}
else
{
    <FormLayout Columns="1">
        <Field Id="@(Prefix + "-pickup")" Label="@Localization.Parse(TextKey.Sample_DemoPickupCode)"><ArkheideSystem.Flourish.Blazor.Components.Primitives.StandaloneMaskedInput id="@(Prefix + "-pickup")" Mask="000-000" @bind-Value="Code" /></Field>
    </FormLayout>
    <Button OnClick="Confirm">@Localization.Parse(TextKey.Sample_CheckFormat)</Button>
    <p role="status">@Localization.Parse(Message)</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-standalone-mask-" + Guid.NewGuid().ToString("N");
    private string? Empty, EmptyReadOnly, EmptyDisabled, Code = "246810";
    private string Message = "Key.Sample_TheDemoCodeDoesNotTriggerARealPickup";
    private void Confirm() => Message = Code?.Length == 6 ? "Key.Sample_TheDemoFormatIsValidTheModelKeepsSixDigits" : "Key.Sample_EnterTheFullSixDigitDemoPickupCode";
}
