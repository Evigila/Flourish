@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.ReferenceDropdown<TValue>")]
@using System
@using System.Collections.Generic
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using P = ArkheideSystem.Flourish.Blazor.Components.Primitives

@if (Preview)
{
    <label id="@(Prefix + "-empty-label")">@Localization.Parse(TextKey.Sample_EmptyOptions)</label>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.ReferenceDropdown TValue="int" Id="@(Prefix + "-empty")" LabelledBy="@(Prefix + "-empty-label")" Items="EmptyItems" @bind-Value="EmptyId" EmptySelectionText="@Localization.Parse(TextKey.Sample_NotSelected)" SearchLabel="@Localization.Parse(TextKey.Sample_SearchOptions)" />
    <label id="@(Prefix + "-disabled-label")">@Localization.Parse(TextKey.Sample_Disabled)</label>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.ReferenceDropdown TValue="int" Id="@(Prefix + "-disabled")" LabelledBy="@(Prefix + "-disabled-label")" Items="EmptyItems" Disabled="true" EmptySelectionText="@Localization.Parse(TextKey.Sample_NotSelected)" />
}
else
{
    <ToggleSwitch Label="@Localization.Parse(TextKey.Sample_PreventVenueChanges)" @bind-Value="Locked" OnLabel="@Localization.Parse(TextKey.Sample_Blocked)" OffLabel="@Localization.Parse(TextKey.Sample_Allowed)" />
    <label id="@(Prefix + "-venue-label")">@Localization.Parse(TextKey.Sample_Venue)</label>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.ReferenceDropdown TValue="int" Id="@(Prefix + "-venue")" LabelledBy="@(Prefix + "-venue-label")" Items="Venues" @bind-Value="VenueId"
                         CreateRequested="Create" Disabled="Locked" EmptySelectionText="@Localization.Parse(TextKey.Sample_NoVenueSelected)" SearchLabel="@Localization.Parse(TextKey.Sample_SearchOrCreateAVenue)" />
    <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_CurrentVenueId), VenueId?.ToString() ?? Localization.Parse(TextKey.Sample_NotSelected))</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-reference-" + Guid.NewGuid().ToString("N");
    private static readonly P.ReferenceItem<int>[] EmptyItems = [];
    private readonly List<ArkheideSystem.Flourish.Blazor.Components.Primitives.ReferenceItem<int>> Venues = [new(1, "甲"), new(2, "河畔社区阅读与交流活动室（虚构）")];
    private int? EmptyId, VenueId = 1;
    private bool Locked;
    private Task<int?> Create(string name) { var id = Venues.Count + 1; Venues.Add(new(id, name)); return Task.FromResult<int?>(id); }
}
