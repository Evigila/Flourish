@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("SelectBox<TValue>")]
@using System
@using System.Linq
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor
@using ArkheideSystem.Flourish.Blazor.Components

@if (Preview)
{
    <FormLayout>
        <Field Label="@Localization.Parse(TextKey.Sample_EmptyOptions)" Id="@(Prefix + "-empty")"><SelectBox TValue="string" @bind-Value="EmptyValue" /></Field>
        <Field Label="@Localization.Parse(TextKey.Sample_Disabled)" Id="@(Prefix + "-disabled")"><SelectBox TValue="string" @bind-Value="EmptyDisabled" Disabled="true" /></Field>
    </FormLayout>
}
else
{
    <Field Label="@Localization.Parse(TextKey.Sample_AttendanceMode)" Id="@(Prefix + "-mode")"><SelectBox TValue="AttendanceMode" @bind-Value="Mode" Options="Modes" /></Field>
    <p role="status">@Recommendation</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-select-" + Guid.NewGuid().ToString("N");
    private string EmptyValue = "", EmptyDisabled = "";
    private AttendanceMode Mode = AttendanceMode.Online;
    private enum AttendanceMode { Online, InPerson, Recorded }
    private SelectOption<AttendanceMode>[] Modes => Enum.GetValues<AttendanceMode>()
        .Select(mode => new SelectOption<AttendanceMode>(mode, mode switch { AttendanceMode.Online => Localization.Parse(TextKey.Sample_Online), AttendanceMode.InPerson => Localization.Parse(TextKey.Sample_InPerson), _ => Localization.Parse(TextKey.Sample_WatchRecording) })).ToArray();
    private string Recommendation => Mode switch { AttendanceMode.Online => Localization.Parse(TextKey.Sample_AFictionalMeetingLinkWillBeProvidedBeforeTheActivity), AttendanceMode.InPerson => Localization.Parse(TextKey.Sample_ExampleVenue), _ => Localization.Parse(TextKey.Sample_TheDemoRecordingWillBeAvailableAfterTheActivity) };
}
