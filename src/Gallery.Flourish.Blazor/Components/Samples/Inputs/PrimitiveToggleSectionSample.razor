@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.ToggleSection")]
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using P = ArkheideSystem.Flourish.Blazor.Components.Primitives

@if (Preview)
{
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.ToggleSection Label="关闭的区域" @bind-Value="Off"><div style="min-height:48px"></div></ArkheideSystem.Flourish.Blazor.Components.Primitives.ToggleSection>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.ToggleSection Label="开启的区域" @bind-Value="On"><div style="min-height:48px"></div></ArkheideSystem.Flourish.Blazor.Components.Primitives.ToggleSection>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.ToggleSection Label="禁用区域" @bind-Value="DisabledValue" Disabled="true"><div style="min-height:48px"></div></ArkheideSystem.Flourish.Blazor.Components.Primitives.ToggleSection>
}
else
{
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.ToggleSection Label="配置活动联系人" @bind-Value="Enabled">
        <Field Label="联系人" Id="@(Prefix + "-contact")"><TextBox @bind-Value="Contact" /></Field>
    </ArkheideSystem.Flourish.Blazor.Components.Primitives.ToggleSection>
    <p role="status">@(Enabled ? "示例联系人区域已启用。" : "示例联系人区域已关闭。")</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-primitive-toggle-section-" + Guid.NewGuid().ToString("N");
    private bool Off, On = true, DisabledValue, Enabled;
    private string? Contact = "许宁（虚构）";
}
