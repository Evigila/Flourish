@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("CheckBox")]
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components

@if (Preview)
{
    <div style="display:flex;gap:24px;flex-wrap:wrap">
        <CheckBox Label="@Localization.Parse(TextKey.Sample_Unchecked)" @bind-Value="Empty" />
        <CheckBox Label="@Localization.Parse(TextKey.Sample_Checked)" @bind-Value="Checked" />
        <CheckBox Label="@Localization.Parse(TextKey.Sample_Disabled)" @bind-Value="Disabled" Disabled="true" />
    </div>
}
else
{
    <CheckBox Label="@Localization.Parse(TextKey.Sample_Projector)" @bind-Value="Projector" />
    <CheckBox Label="@Localization.Parse(TextKey.Sample_Speaker)" @bind-Value="Speaker" />
    <CheckBox Label="@Localization.Parse(TextKey.Sample_Whiteboard)" @bind-Value="Whiteboard" />
    <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_SelectedEquipmentCount), (Projector ? 1 : 0) + (Speaker ? 1 : 0) + (Whiteboard ? 1 : 0))</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private bool Empty, Checked = true, Disabled;
    private bool Projector = true, Speaker, Whiteboard;
}
