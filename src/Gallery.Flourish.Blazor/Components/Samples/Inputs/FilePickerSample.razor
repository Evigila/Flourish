@inherits LocalizedComponentBase
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [SampleFor("FilePicker", DescriptionKey = "Key.Sample_FilePickerSample_Description")]
<FilePicker Label="@Localization.Parse(TextKey.Sample_ChooseDemoTextFiles)" Accept=".txt" Multiple="true" OnChange="Describe" />
<p role="status">@Message</p>
@code {
    [Parameter] public bool Preview { get; set; }
    private IReadOnlyList<IBrowserFile>? Files;
    private bool OverLimit;
    private const int MaximumDisplayedFiles = 100;
    private string Message => OverLimit
        ? string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_FileMetadataLimit), MaximumDisplayedFiles)
        : Files is null ? Localization.Parse(TextKey.Sample_NoFilesSelectedYet)
        : string.Join("; ", Files.Select(file => string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_FileMetadata), file.Name, file.Size)));
    private void Describe(InputFileChangeEventArgs args)
    {
        OverLimit = args.FileCount > MaximumDisplayedFiles;
        Files = OverLimit ? null : args.GetMultipleFiles(MaximumDisplayedFiles);
    }
}
