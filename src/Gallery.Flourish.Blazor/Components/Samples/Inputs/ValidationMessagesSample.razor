@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@using Microsoft.AspNetCore.Components.Forms
@using ArkheideSystem.Flourish.Blazor.Components
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("ValidationMessages")]

<EditForm EditContext="Context" OnSubmit="Validate" FormName="@Prefix">
    <Field Id="@(Prefix + "-name")" Label="名称" For="@(() => Draft.Name)"><TextBox @bind-Value="Draft.Name" /></Field>
    <ValidationMessages Id="@(Prefix + "-token-error")" For="@(() => Draft.Token)" />
    <Button Type="submit">验证隐藏协议字段</Button>
</EditForm>

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "validation-" + Guid.NewGuid().ToString("N");
    private readonly Model Draft = new();
    private EditContext Context = null!;
    private ValidationMessageStore Messages = null!;
    protected override void OnInitialized() { Context = new(Draft); Messages = new(Context); }
    private void Validate() { Messages.Clear(); Messages.Add(new FieldIdentifier(Draft, nameof(Model.Token)), "缺少有效令牌。"); Context.NotifyValidationStateChanged(); }
    private sealed class Model { public string? Name { get; set; } public string? Token { get; set; } }
}
