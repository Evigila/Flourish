@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Blazor.Components
@using Microsoft.AspNetCore.Components
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("MultiSelectBox", DescriptionKey = "Key.Sample_MultiSelectBoxSample_Description")]

@if (Preview)
{
    <MultiSelectBox Id="@(Prefix + "-choices")" Label="@Localization.Parse(TextKey.Sample_ActivityTags)" Items="PreviewOptions" EmptySelectionText="@Localization.Parse(TextKey.Sample_NotSelected)" MultipleSelectionText="@Localization.Parse(TextKey.Sample_TagsSelected)" />
    <MultiSelectBox Id="@(Prefix + "-icon")" Label="@Localization.Parse(TextKey.Sample_Display)" Icon="remove_red_eye" TriggerVariant="ButtonVariant.Secondary" Items="PreviewOptions" />
    <MultiSelectBox Id="@(Prefix + "-empty")" Label="@Localization.Parse(TextKey.Sample_EmptyOptions)" Items="EmptyOptions" EmptyText="@Localization.Parse(TextKey.Sample_NoOptions)" EmptySelectionText="@Localization.Parse(TextKey.Sample_NotSelected)" />
    <MultiSelectBox Id="@(Prefix + "-disabled")" Label="@Localization.Parse(TextKey.Sample_Disabled)" Items="PreviewOptions" Disabled="true" />
}
else
{
    <FormLayout>
        <ToggleSwitch Label="@Localization.Parse(TextKey.Sample_SearchAndCreate)" @bind-Value="Searchable" />
        <ToggleSwitch Label="@Localization.Parse(TextKey.Sample_AllowReordering)" @bind-Value="CanReorder" />
        <ToggleSwitch Label="@Localization.Parse(TextKey.Sample_DisableControl)" @bind-Value="Disabled" />
    </FormLayout>
    <MultiSelectBox Id="@(Prefix + "-tags")" Label="@Localization.Parse(TextKey.Sample_ActivityTags)" Items="LocalizedTags" Changed="AcceptSelection"
                    MinimumSelected="1" MaximumSelections="3" CanReorder="CanReorder" Searchable="Searchable"
                    CreateRequested="@(Searchable ? CreateTag : null)" NewItemMaximumLength="40" Disabled="Disabled"
                    EmptyText="@Localization.Parse(TextKey.Sample_NoMatchingTags)" EmptySelectionText="@Localization.Parse(TextKey.Sample_NotSelected)" MultipleSelectionText="@Localization.Parse(TextKey.Sample_TagsSelected)" />
    <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_SelectedTags), string.Join(", ", LocalizedTags.Where(option => option.Selected).Select(option => option.Label)))</p>
    <Button Variant="ButtonVariant.Secondary" OnClick="Reset" Disabled="Disabled">@Localization.Parse(TextKey.Sample_ResetTags)</Button>
    <InlineActions>
        <Button Variant="ButtonVariant.Underline" Href="/controls/data/datatablesample">@Localization.Parse(TextKey.Sample_TableExample)</Button>
        <Button Variant="ButtonVariant.Underline" Href="/controls/data/linechartsample">@Localization.Parse(TextKey.Sample_ChartExample)</Button>
    </InlineActions>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-multi-select-" + Guid.NewGuid().ToString("N");
    private static readonly IReadOnlyList<MultiSelectOption> EmptyOptions = [];
    private IReadOnlyList<MultiSelectOption> PreviewOptions => [new("reading", Localization.Parse(TextKey.Sample_Reading)), new("photography", Localization.Parse(TextKey.Sample_PhotographyAndFilmmakingDiscussionGroupFictional))];
    private IReadOnlyList<MultiSelectOption> Tags = InitialTags();
    private IReadOnlyList<MultiSelectOption> LocalizedTags => Tags.Select(option => option with { Label = LocalizeLabel(option.Label) }).ToArray();
    private string LocalizeLabel(string label) => Localization.TryParse(label, [], out var text) ? text : label;
    private bool Searchable = true;
    private bool CanReorder;
    private bool Disabled;
    private int NextTagId;

    private static IReadOnlyList<MultiSelectOption> InitialTags() =>
    [
        new("reading", "Key.Sample_Reading", Selected: true, CanDeselect: false, CanReorder: false),
        new("photography", "Key.Sample_PhotographyAndFilmmakingDiscussionGroupFictional"),
        new("discussion", "Key.Sample_Discussion"),
        new("outdoors", "Key.Sample_OutdoorExplorationFictional"),
        new("unavailable", "Key.Sample_NotAvailableYet", Disabled: true)
    ];

    private void AcceptSelection(MultiSelectChange change) => Tags = change.OrderedKeys
        .Select(key => Tags.Single(option => option.Key == key) with { Selected = change.SelectedKeys.Contains(key) }).ToArray();

    private Task<bool> CreateTag(string name)
    {
        if (Disabled || Tags.Count(option => option.Selected) >= 3 || Tags.Any(option => string.Equals(LocalizeLabel(option.Label), name, StringComparison.OrdinalIgnoreCase)))
            return Task.FromResult(false);
        Tags = [.. Tags, new("created-" + ++NextTagId, name, Selected: true)];
        StateHasChanged();
        return Task.FromResult(true);
    }

    private void Reset() => Tags = InitialTags();
}