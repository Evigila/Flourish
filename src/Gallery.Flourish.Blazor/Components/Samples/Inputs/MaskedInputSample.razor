@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.MaskedInput")]
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using P = ArkheideSystem.Flourish.Blazor.Components.Primitives

@if (Preview)
{
    <FormLayout Columns="1">
        <Field Id="@(Prefix + "-digits")" Label="@Localization.Parse(TextKey.Sample_DigitMask)"><ArkheideSystem.Flourish.Blazor.Components.Primitives.MaskedInput id="@(Prefix + "-digits")" Mask="0000-0000" @bind-Value="EmptyDigits" /></Field>
        <Field Id="@(Prefix + "-code")" Label="@Localization.Parse(TextKey.Sample_AlphanumericMask)"><ArkheideSystem.Flourish.Blazor.Components.Primitives.MaskedInput id="@(Prefix + "-code")" Mask="AA-0000" InputMode="text" @bind-Value="EmptyCode" /></Field>
        <Field Id="@(Prefix + "-disabled")" Label="@Localization.Parse(TextKey.Sample_Disabled)"><ArkheideSystem.Flourish.Blazor.Components.Primitives.MaskedInput id="@(Prefix + "-disabled")" Mask="0000-0000" @bind-Value="EmptyDisabled" disabled /></Field>
    </FormLayout>
}
else
{
    <FormLayout Columns="1">
        <Field Id="@(Prefix + "-ticket")" Label="@Localization.Parse(TextKey.Sample_DemoTicketNumber)"><ArkheideSystem.Flourish.Blazor.Components.Primitives.MaskedInput id="@(Prefix + "-ticket")" Mask="AA-0000" InputMode="text" @bind-Value="Ticket" /></Field>
    </FormLayout>
    <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_MaskedValue), Ticket, P.InputMaskFormatter.Format("AA-0000", Ticket))</p>
    <Button OnClick="Clear">@Localization.Parse(TextKey.Sample_ClearTicketNumber)</Button>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-mask-" + Guid.NewGuid().ToString("N");
    private string? EmptyDigits, EmptyCode, EmptyDisabled;
    private string? Ticket = "AB1234";
    private void Clear() => Ticket = "";
}
