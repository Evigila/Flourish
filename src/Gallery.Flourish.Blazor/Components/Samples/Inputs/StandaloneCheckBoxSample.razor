@inherits LocalizedComponentBase
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [SampleFor("StandaloneCheckBox", DescriptionKey = "Key.Sample_StandaloneCheckBoxSample_Description")]
<StandaloneCheckBox Label="@Localization.Parse(TextKey.Sample_KeepDemoSelection)" name="remember" SubmissionValue="yes" @bind-Value="Remember" />
<p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_LocalChecked), Remember ? Localization.Parse(TextKey.Sample_Checked) : Localization.Parse(TextKey.Sample_Unchecked))</p>
@code {
    [Parameter] public bool Preview { get; set; }
    private bool Remember;
}
