@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("TextBox")]
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components

@if (Preview)
{
    <FormLayout>
        <Field Label="@Localization.Parse(TextKey.Sample_SingleLineText)" Id="@(Prefix + "-single")"><TextBox @bind-Value="EmptyText" /></Field>
        <Field Label="@Localization.Parse(TextKey.Sample_MultilineText)" Id="@(Prefix + "-multi")" FullWidth="true"><TextBox @bind-Value="EmptyDescription" Multiline="true" Rows="3" /></Field>
        <Field Label="@Localization.Parse(TextKey.Access_OrganizationPassword)" Id="@(Prefix + "-password")"><TextBox @bind-Value="EmptyPassword" Type="password" /></Field>
        <Field Label="@Localization.Parse(TextKey.Sample_Disabled)" Id="@(Prefix + "-disabled")"><TextBox @bind-Value="EmptyDisabled" Disabled="true" /></Field>
    </FormLayout>
}
else
{
    <FormLayout>
        <Field Label="@Localization.Parse(TextKey.Sample_ActivityName)" Id="@(Prefix + "-name")"><TextBox @bind-Value="Name" MaxLength="80" Disabled="Locked" /></Field>
        <Field Label="@Localization.Parse(TextKey.Sample_ActivityDescription)" Id="@(Prefix + "-description")" FullWidth="true"><TextBox @bind-Value="Description" Multiline="true" Rows="3" MaxLength="300" Disabled="Locked" /></Field>
    </FormLayout>
    <ToggleSwitch Label="@Localization.Parse(TextKey.Sample_SimulateEditingBlocked)" @bind-Value="Locked" OnLabel="@Localization.Parse(TextKey.Sample_Blocked)" OffLabel="@Localization.Parse(TextKey.Sample_Editable)" />
    <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_ActivityTextStatus), Name, Description?.Length ?? 0)</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-text-" + Guid.NewGuid().ToString("N");
    private string? EmptyText, EmptyDescription, EmptyPassword, EmptyDisabled;
    private string? Name = "春日阅读会", Description = "虚构示例：周五下午分享一本近期读过的书。";
    private bool Locked;
}
