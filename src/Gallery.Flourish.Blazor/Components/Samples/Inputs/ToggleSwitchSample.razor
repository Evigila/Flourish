@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("ToggleSwitch")]
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components

@if (Preview)
{
    <ToggleSwitch Label="@Localization.Parse(TextKey.Sample_OffState)" @bind-Value="Off" OnLabel="@Localization.Parse(TextKey.Sample_On)" OffLabel="@Localization.Parse(TextKey.Sample_Off)" />
    <ToggleSwitch Label="@Localization.Parse(TextKey.Sample_OnState)" @bind-Value="On" OnLabel="@Localization.Parse(TextKey.Sample_On)" OffLabel="@Localization.Parse(TextKey.Sample_Off)" />
    <ToggleSwitch Label="@Localization.Parse(TextKey.Sample_DisabledState)" @bind-Value="DisabledValue" Disabled="true" OnLabel="@Localization.Parse(TextKey.Sample_On)" OffLabel="@Localization.Parse(TextKey.Sample_Off)" />
}
else
{
    <ToggleSwitch Label="@Localization.Parse(TextKey.Sample_ActivityReminder)" @bind-Value="Reminder" OnLabel="@Localization.Parse(TextKey.Sample_Enabled)" OffLabel="@Localization.Parse(TextKey.Sample_TurnedOff)" />
    <p role="status">@(Reminder ? Localization.Parse(TextKey.Sample_DemoSettingRemind15MinutesBeforeTheActivity) : Localization.Parse(TextKey.Sample_DemoSettingNoActivityReminderWillBeSent))</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private bool Off, On = true, DisabledValue, Reminder;
}
