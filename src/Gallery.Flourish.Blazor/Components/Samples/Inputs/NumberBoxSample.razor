@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("NumberBox<TValue>")]
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor
@using ArkheideSystem.Flourish.Blazor.Components

@if (Preview)
{
    <FormLayout>
        <Field MessageFormatter="LocalizeValidation" Label="@Localization.Parse(TextKey.Sample_Integer)" Id="@(Prefix + "-integer")"><NumberBox TValue="int?" @bind-Value="EmptyInteger" Step="1" /></Field>
        <Field MessageFormatter="LocalizeValidation" Label="@Localization.Parse(TextKey.Sample_Decimal)" Id="@(Prefix + "-decimal")"><NumberBox TValue="decimal?" @bind-Value="EmptyDecimal" Step="0.01" /></Field>
        <Field MessageFormatter="LocalizeValidation" Label="@Localization.Parse(TextKey.Sample_Disabled)" Id="@(Prefix + "-disabled")"><NumberBox TValue="decimal?" @bind-Value="EmptyDisabled" Disabled="true" /></Field>
    </FormLayout>
}
else
{
    <FormLayout>
        <Field MessageFormatter="LocalizeValidation" Label="@Localization.Parse(TextKey.Sample_Participants140)" Id="@(Prefix + "-quantity")"><NumberBox TValue="int?" @bind-Value="Quantity" Step="1" Min="1" Max="40" ParsingErrorMessage="Key.Sample_EnterAnInteger" /></Field>
        <Field MessageFormatter="LocalizeValidation" Label="@Localization.Parse(TextKey.Sample_MaterialsCostPerPerson)" Id="@(Prefix + "-price")"><NumberBox TValue="decimal?" @bind-Value="Price" Step="0.01" Min="0" ParsingErrorMessage="Key.Sample_EnterANumber" /></Field>
    </FormLayout>
    <p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_EstimatedTotal), (Quantity.GetValueOrDefault() * Price.GetValueOrDefault()).ToString("0.00", CultureInfo.GetCultureInfo(Localization.Culture)))</p>
    <Button Variant="ButtonVariant.Secondary" OnClick="Reset">@Localization.Parse(TextKey.Sample_ResetExample)</Button>
}

@code {
    private string LocalizeValidation(string message) => Localization.TryParse(message, [], out var text) ? text : message;
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-number-" + Guid.NewGuid().ToString("N");
    private int? EmptyInteger, Quantity = 8;
    private decimal? EmptyDecimal, EmptyDisabled, Price = 12.50m;
    private void Reset() { Quantity = 8; Price = 12.50m; }
}
