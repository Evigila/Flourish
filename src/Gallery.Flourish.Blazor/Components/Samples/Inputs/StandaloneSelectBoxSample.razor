@inherits LocalizedComponentBase
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [SampleFor("StandaloneSelectBox<TValue>", DescriptionKey = "Key.Sample_StandaloneSelectBoxSample_Description")]
<Field Label="@Localization.Parse(TextKey.Sample_ProtocolBoundaryDemoLanguage)" Id="@Id"><StandaloneSelectBox TValue="string" Id="@Id" name="language" Options="Languages" @bind-Value="Language" /></Field>
<p role="status">@string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_LocalSelection), Language)</p>
@code {
    [Parameter] public bool Preview { get; set; }
    private string Language = "zh-CN"; private readonly string Id = "standalone-select-" + Guid.NewGuid().ToString("N"); private static readonly IReadOnlyList<SelectOption<string>> Languages = [new("zh-CN", "中文"), new("en-US", "English"), new("pt-BR", "Português")];
}
