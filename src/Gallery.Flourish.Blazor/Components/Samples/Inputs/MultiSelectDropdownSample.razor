@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.MultiSelectDropdown<TItem, TValue>")]
@using System
@using System.Collections.Generic
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using P = ArkheideSystem.Flourish.Blazor.Components.Primitives

@if (Preview)
{
    <label id="@(Prefix + "-empty-label")">空选项</label>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.MultiSelectDropdown TItem="Tag" TValue="int" Id="@(Prefix + "-empty")" LabelledBy="@(Prefix + "-empty-label")" Items="EmptyItems" SelectedValues="EmptySelection" ValueSelector="@(item => item.Id)" TextSelector="@(item => item.Name)" SelectionChanged="Ignore" EmptyText="没有选项" EmptySelectionText="未选择" />
    <label id="@(Prefix + "-disabled-label")">禁用</label>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.MultiSelectDropdown TItem="Tag" TValue="int" Id="@(Prefix + "-disabled")" LabelledBy="@(Prefix + "-disabled-label")" Items="EmptyItems" SelectedValues="EmptySelection" ValueSelector="@(item => item.Id)" TextSelector="@(item => item.Name)" SelectionChanged="Ignore" Disabled="true" EmptySelectionText="未选择" />
}
else
{
    <label id="@(Prefix + "-tags-label")">活动标签（最多三个）</label>
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.MultiSelectDropdown TItem="Tag" TValue="int" Id="@(Prefix + "-tags")" LabelledBy="@(Prefix + "-tags-label")" Items="Tags" SelectedValues="SelectedValues"
                          ValueSelector="@(item => item.Id)" TextSelector="@(item => item.Name)" SelectionChanged="ToggleSelection" CreateRequested="Create"
                          MaximumSelections="3" EmptyText="没有示例标签" EmptySelectionText="未选择标签" MultipleSelectionText="个标签已选择" />
    <p role="status">已选 @SelectedValues.Count 个示例标签。</p>
    <Button OnClick="Clear">清空选择</Button>
    <Section Title="图表显示序列">
        <Field Id="@(Prefix + "-series")" Label="显示">
            <ArkheideSystem.Flourish.Blazor.Components.Primitives.MultiSelectDropdown TItem="SeriesOption" TValue="string" Id="@(Prefix + "-series")" LabelledBy="@(Prefix + "-series-label")"
                                  Items="SeriesOptions" SelectedValues="VisibleSeries" ValueSelector="@(item => item.Key)" TextSelector="@(item => item.Label)"
                                  SelectionChanged="ToggleSeries" EmptySelectionText="无可见序列" MultipleSelectionText="条可见序列" />
        </Field>
        <LineChart Labels="ChartLabels" Series="ChartSeries" Title="虚构订单趋势" IndependentScales="true" MaximumLabel="最大值" EmptyText="请选择至少一条序列。" />
    </Section>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-multi-select-" + Guid.NewGuid().ToString("N");
    private static readonly Tag[] EmptyItems = [];
    private readonly HashSet<int> EmptySelection = [];
    private readonly List<Tag> Tags = [new(1, "读"), new(2, "摄影与影像制作交流小组（虚构）"), new(3, "交流"), new(4, "户外探索（虚构）")];
    private readonly HashSet<int> SelectedValues = [1];
    private sealed record Tag(int Id, string Name);
    private void Ignore(int value) { }
    private void ToggleSelection(int value) { if (!SelectedValues.Remove(value) && SelectedValues.Count < 3) SelectedValues.Add(value); }
    private Task<bool> Create(string name) { var id = Tags.Count + 1; Tags.Add(new(id, name)); SelectedValues.Add(id); return Task.FromResult(true); }
    private void Clear() => SelectedValues.Clear();
    private sealed record SeriesOption(string Key, string Label);
    private static readonly SeriesOption[] SeriesOptions = [new("count", "订单数量"), new("amount", "订单金额")];
    private readonly HashSet<string> VisibleSeries = ["count", "amount"];
    private static readonly LineChart.PointLabel[] ChartLabels = [new("mon", "一"), new("tue", "二"), new("wed", "三")];
    private LineChart.DataSeries[] ChartSeries => [new("count", "订单数量", [2, 5, 3], value => value.ToString("N0"), Visible: VisibleSeries.Contains("count")), new("amount", "订单金额", [120, 250, 180], value => value.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("zh-CN")), Visible: VisibleSeries.Contains("amount"))];
    private void ToggleSeries(string key) { if (!VisibleSeries.Remove(key)) VisibleSeries.Add(key); }
}
