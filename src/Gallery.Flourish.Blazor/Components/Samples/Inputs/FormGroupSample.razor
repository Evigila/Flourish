@inherits LocalizedComponentBase
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("FormGroup")]

@if (!Preview) { <ToggleSwitch Label="@Localization.Parse(TextKey.Sample_DisableTheEntireFieldGroup)" @bind-Value="Disabled" /> }
<FormGroup Title="@Localization.Parse(TextKey.Sample_FictionalContact)" Disabled="Disabled" Columns="1">
    <Field Label="@Localization.Parse(TextKey.Record_Name)" Id="@Id"><StandaloneTextBox Id="@Id" @bind-Value="Name" /></Field>
</FormGroup>

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Id = "sample-group-" + Guid.NewGuid().ToString("N");
    private bool Disabled;
    private string? Name = "";
}
