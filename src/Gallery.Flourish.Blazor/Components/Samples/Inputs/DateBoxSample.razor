@inherits LocalizedComponentBase
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [SampleFor("DateBox<TValue>")]
<EditForm Model="Draft" FormName="@Id" OnValidSubmit="Submit">
    <Field Label="@Localization.Parse(TextKey.Sample_DemoDate)" Id="@Id"><DateBox TValue="DateTime" Id="@Id" @bind-Value="Draft.Date" /></Field>
    <Button Type="submit">@Localization.Parse(TextKey.Sample_UseDemoDate)</Button>
</EditForm>
@if (!Preview) { <p role="status">@Message</p> }
@code {
    [Parameter] public bool Preview { get; set; }
    private sealed class DemoDraft { public DateTime Date { get; set; } = new(2026, 10, 5); }
    private readonly DemoDraft Draft = new();
    private readonly string Id = "date-sample-" + Guid.NewGuid().ToString("N");
    private bool Submitted;
    private string? Message => Submitted ? string.Format(CultureInfo.GetCultureInfo(Localization.Culture), Localization.Parse(TextKey.Sample_LocalDemoDate), Draft.Date.ToString("d", CultureInfo.GetCultureInfo(Localization.Culture))) : null;
    private void Submit() => Submitted = true;
}
