@using ArkheideSystem.Flourish.Abstract
@using ArkheideSystem.Flourish.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("Primitives.SelectionDropdownSurface")]
@using System
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor.Components
@using P = ArkheideSystem.Flourish.Blazor.Components.Primitives

@if (Preview)
{
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.SelectionDropdownSurface>
        <button type="button" class="selection-trigger" aria-label="空选择触发器"><span style="min-height:1em"></span><span class="selection-chevron" aria-hidden="true"></span></button>
        <button type="button" class="selection-trigger" disabled aria-label="禁用选择触发器"><span style="min-height:1em"></span><span class="selection-chevron" aria-hidden="true"></span></button>
    </ArkheideSystem.Flourish.Blazor.Components.Primitives.SelectionDropdownSurface>
}
else
{
    <ArkheideSystem.Flourish.Blazor.Components.Primitives.SelectionDropdownSurface>
        <div style="position:relative" @onkeydown="KeyDown">
            <button type="button" class="selection-trigger" aria-expanded="@(Open ? "true" : "false")" aria-controls="@(Prefix + "-options")" @onclick="Toggle">
                <span>示例布局：@Selected</span><span class="selection-chevron" aria-hidden="true"></span>
            </button>
            @if (Open)
            {
                <div id="@(Prefix + "-options")" class="selection-panel" role="group" aria-label="选择示例布局">
                    <button type="button" class="selection-option" @onclick="SelectList">列表布局</button>
                    <button type="button" class="selection-option" @onclick="SelectCards">卡片布局</button>
                </div>
            }
        </div>
    </ArkheideSystem.Flourish.Blazor.Components.Primitives.SelectionDropdownSurface>
    <p role="status">选择结果：@Selected。可用 Escape 关闭此示例选择区域。</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private readonly string Prefix = "sample-dropdown-surface-" + Guid.NewGuid().ToString("N");
    private bool Open;
    private string Selected = "列表布局";
    private void Toggle() => Open = !Open;
    private void SelectList() { Selected = "列表布局"; Open = false; }
    private void SelectCards() { Selected = "卡片布局"; Open = false; }
    private void KeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args) { if (args.Key == "Escape") Open = false; }
}
