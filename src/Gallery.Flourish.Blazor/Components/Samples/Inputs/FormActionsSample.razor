@inherits LocalizedComponentBase
@using ArkheideSystem.Flourish.Abstract
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using System.Collections.Generic
@using System
@namespace ArkheideSystem.Gallery.Flourish.Blazor.Components.Samples.Inputs
@attribute [ArkheideSystem.Gallery.Flourish.Blazor.Models.SampleFor("FormActions")]
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using ArkheideSystem.Flourish.Blazor
@using ArkheideSystem.Flourish.Blazor.Components

@if (Preview)
{
    <FormActions Columns="2"><UniformGridButton Title="@Localization.Parse(TextKey.Sample_PrimaryAction)" Variant="UniformGridVariant.FilledElevated" /><UniformGridButton Title="@Localization.Parse(TextKey.Sample_SecondaryAction)" Variant="UniformGridVariant.Elevated" /></FormActions>
    <FormActions Columns="3"><UniformGridButton Title="@Localization.Parse(TextKey.Sample_PrimaryAction)" Variant="UniformGridVariant.FilledElevated" /><UniformGridButton Title="@Localization.Parse(TextKey.Sample_SecondaryAction)" Variant="UniformGridVariant.Elevated" /><UniformGridButton Title="@Localization.Parse(TextKey.Sample_DisabledAction)" Variant="UniformGridVariant.Elevated" Disabled="true" /></FormActions>
    <FormActions Columns="3">
        <UniformGridButton Title="FilledElevated" Variant="UniformGridVariant.FilledElevated" />
        <UniformGridButton Title="@Localization.Parse(TextKey.Sample_DefaultElevated)" />
        <UniformGridButton Title="Danger" Variant="UniformGridVariant.Danger" />
    </FormActions>
}
else
{
    <FormActions Columns="3">
        <UniformGridButton Title="@Localization.Parse(TextKey.Sample_SubmitRegistration)" Variant="UniformGridVariant.FilledElevated" Busy="Saving" BusyLabel="@Localization.Parse(TextKey.Sample_SimulatedSubmissionInProgress)" OnClick="Submit" />
        <UniformGridButton Title="@Localization.Parse(TextKey.Sample_SaveDraft)" Variant="UniformGridVariant.Elevated" Disabled="Saving" OnClick="Draft" />
        <UniformGridButton Title="@Localization.Parse(TextKey.Sample_Reset)" Variant="UniformGridVariant.Elevated" Disabled="Saving" OnClick="Reset" />
    </FormActions>
    <p role="status">@Localization.Parse(Message)</p>
}

@code {
    [Parameter] public bool Preview { get; set; }
    private bool Saving;
    private string Message = "Key.Sample_NoDemoActionHasBeenPerformed";
    private async Task Submit() { Saving = true; await Task.Delay(500); Message = "Key.Sample_FictionalRegistrationSubmittedNoNetworkRequestWasSent"; Saving = false; }
    private void Draft() => Message = "Key.Sample_TheFictionalDraftIsRetainedInThisExample";
    private void Reset() => Message = "Key.Sample_DemoStateReset";
}
