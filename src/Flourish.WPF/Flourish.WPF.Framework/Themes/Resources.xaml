<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Framework-only native system paint; Design explicitly replaces these same roles. -->
  <SolidColorBrush x:Key="Flourish.Brush.Primary" Color="{x:Static SystemColors.HighlightColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.Accent" Color="{x:Static SystemColors.HighlightColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.Canvas" Color="{x:Static SystemColors.ControlColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.SurfaceAlternate" Color="{x:Static SystemColors.ControlColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.Surface" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.SurfaceLight" Color="White" />
  <SolidColorBrush x:Key="Flourish.Brush.Text" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.Muted" Color="{x:Static SystemColors.GrayTextColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.Border" Color="{x:Static SystemColors.ActiveBorderColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.DisplayBoard" Color="{x:Static SystemColors.ControlLightColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.SurfaceHover" Color="{x:Static SystemColors.ControlLightColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.SurfacePressed" Color="{x:Static SystemColors.ControlDarkColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.PrimaryHover" Color="{x:Static SystemColors.HotTrackColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.PrimaryPressed" Color="{x:Static SystemColors.HighlightColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.Danger" Color="#9D322D" />
  <SolidColorBrush x:Key="Flourish.Brush.DangerHover" Color="#7E2824" />
  <SolidColorBrush x:Key="Flourish.Brush.DangerPressed" Color="#712420" />
  <SolidColorBrush x:Key="Flourish.Brush.Information" Color="{x:Static SystemColors.HotTrackColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.Warning" Color="#F2A33A" />
  <SolidColorBrush x:Key="Flourish.Brush.WarningInk" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.PrimaryInk" Color="{x:Static SystemColors.HighlightTextColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.AccentInk" Color="{x:Static SystemColors.HighlightTextColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.Chrome" Color="{x:Static SystemColors.HighlightColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.ChromeHover" Color="{x:Static SystemColors.HighlightColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.ChromePressed" Color="{x:Static SystemColors.HighlightColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.ChromeInk" Color="{x:Static SystemColors.HighlightTextColor}" />
  <SolidColorBrush x:Key="Flourish.Brush.Overlay" Color="#66000000" />
  <FontFamily x:Key="Flourish.FontFamily">Segoe UI</FontFamily>
  <DropShadowEffect x:Key="Flourish.Shadow.Control" BlurRadius="6" ShadowDepth="2" Opacity="0" />
  <DropShadowEffect x:Key="Flourish.Shadow.Popup" BlurRadius="48" ShadowDepth="16" Opacity="0" />
  <DropShadowEffect x:Key="Flourish.Shadow.Card" BlurRadius="52" ShadowDepth="18" Opacity="0" />
</ResourceDictionary>
