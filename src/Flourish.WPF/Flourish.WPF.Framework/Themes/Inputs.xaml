<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:ArkheideSystem.Flourish.WPF.Controls" xmlns:f="clr-namespace:ArkheideSystem.Flourish.WPF">
  <f:TextVisibilityConverter x:Key="Flourish.TextVisibility" /><BooleanToVisibilityConverter x:Key="Flourish.BooleanVisibility" />
  <ControlTemplate x:Key="Flourish.NativeTextTemplate" TargetType="TextBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Flourish.Brush.Accent}" /><Setter TargetName="Frame" Property="BorderThickness" Value="3" /></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Flourish.Brush.Danger}" /></Trigger></ControlTemplate.Triggers></ControlTemplate>
  <Style x:Key="Flourish.NativeTextBox" TargetType="TextBox"><Setter Property="MinHeight" Value="48" /><Setter Property="Padding" Value="16,10" /><Setter Property="FontFamily" Value="{DynamicResource Flourish.FontFamily}" /><Setter Property="FontSize" Value="17" /><Setter Property="Foreground" Value="{DynamicResource Flourish.Brush.Text}" /><Setter Property="Background" Value="{DynamicResource Flourish.Brush.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Flourish.Brush.Border}" /><Setter Property="Template" Value="{StaticResource Flourish.NativeTextTemplate}" /><Setter Property="Validation.ErrorTemplate"><Setter.Value><ControlTemplate><AdornedElementPlaceholder /></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type c:TextBox}" BasedOn="{StaticResource Flourish.NativeTextBox}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type c:TextBox}"><Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><Grid><TextBlock Margin="{TemplateBinding Padding}" x:Name="Hint" Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource Flourish.Brush.Muted}" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed" /><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" /></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Flourish.Brush.Accent}" /><Setter TargetName="Frame" Property="BorderThickness" Value="3" /></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Flourish.Brush.Danger}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Flourish.Brush.Muted}" /><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Flourish.Brush.Canvas}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type c:SearchBox}" BasedOn="{StaticResource {x:Type c:TextBox}}"><Setter Property="Padding" Value="0,10" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type c:SearchBox}"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><c:Icon Name="search" Size="26" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center" /><TextBlock Grid.Column="1" x:Name="Hint" Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource Flourish.Brush.Muted}" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed" /><ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" VerticalAlignment="Center" /><c:Button x:Name="PART_Clear" Grid.Column="2" Icon="close" Variant="Quiet" Width="48" ToolTip="Clear search" Visibility="{Binding Text,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource Flourish.TextVisibility}}" /></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Flourish.Brush.Accent}" /><Setter TargetName="Frame" Property="BorderThickness" Value="3" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type c:CheckBox}"><Setter Property="MinHeight" Value="48" /><Setter Property="FontFamily" Value="{DynamicResource Flourish.FontFamily}" /><Setter Property="FontSize" Value="17" /><Setter Property="Foreground" Value="{DynamicResource Flourish.Brush.Text}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type c:CheckBox}"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="48" Height="48" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Flourish.Brush.Border}" Background="{DynamicResource Flourish.Brush.Surface}"><TextBlock x:Name="Mark" Text="✓" Foreground="{DynamicResource Flourish.Brush.PrimaryInk}" FontSize="17" FontWeight="800" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" /></Border><ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" /></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Flourish.Brush.Primary}" /><Setter TargetName="Mark" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Mark" Property="Text" Value="−" /><Setter TargetName="Mark" Property="Visibility" Value="Visible" /><Setter TargetName="Box" Property="Background" Value="{DynamicResource Flourish.Brush.Primary}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Flourish.Brush.SurfacePressed}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Flourish.Brush.Accent}" /><Setter TargetName="Box" Property="BorderThickness" Value="3" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type c:ToggleSwitch}" BasedOn="{StaticResource {x:Type c:CheckBox}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type c:ToggleSwitch}"><StackPanel Orientation="Horizontal"><Border x:Name="Track" Width="52" Height="30" CornerRadius="15" Background="{DynamicResource Flourish.Brush.Muted}" Padding="3" VerticalAlignment="Center"><Ellipse x:Name="Thumb" Width="24" Height="24" Fill="{DynamicResource Flourish.Brush.Surface}" HorizontalAlignment="Left"><Ellipse.RenderTransform><TranslateTransform X="0" /></Ellipse.RenderTransform></Ellipse></Border><ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Flourish.Brush.Primary}" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Flourish.Brush.PrimaryPressed}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Flourish.SelectItem" TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,9" /><Setter Property="MinHeight" Value="46" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Frame" Padding="{TemplateBinding Padding}" CornerRadius="10" Background="Transparent"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Flourish.Brush.SurfaceHover}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Flourish.Brush.Primary}" /><Setter Property="Foreground" Value="{DynamicResource Flourish.Brush.PrimaryInk}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type c:SelectBox}"><Setter Property="MinHeight" Value="48" /><Setter Property="FontFamily" Value="{DynamicResource Flourish.FontFamily}" /><Setter Property="FontSize" Value="17" /><Setter Property="Foreground" Value="{DynamicResource Flourish.Brush.Text}" /><Setter Property="Background" Value="{DynamicResource Flourish.Brush.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Flourish.Brush.Border}" /><Setter Property="ItemContainerStyle" Value="{StaticResource Flourish.SelectItem}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type c:SelectBox}"><Grid><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" /><ToggleButton x:Name="Toggle" Foreground="{TemplateBinding Foreground}" Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><c:ExpansionIndicator Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" Expanded="{Binding IsChecked,RelativeSource={RelativeSource TemplatedParent}}" /></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="Selection" Margin="16,10,40,10" IsHitTestVisible="False" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" /><TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="16,8,40,8" VerticalAlignment="Center" FontSize="17" Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0"><TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" /></ControlTemplate></TextBox.Template></TextBox><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource Flourish.Brush.Surface}" BorderBrush="{DynamicResource Flourish.Brush.Border}" BorderThickness="1" CornerRadius="16" Padding="6" TextElement.Foreground="{DynamicResource Flourish.Brush.Text}"><ScrollViewer MaxHeight="400" Style="{DynamicResource Flourish.ScrollViewer}"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="Selection" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Flourish.Brush.Accent}" /><Setter TargetName="Frame" Property="BorderThickness" Value="3" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Flourish.Brush.Muted}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
