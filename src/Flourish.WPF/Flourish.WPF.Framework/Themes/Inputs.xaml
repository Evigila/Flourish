  <Style TargetType="{x:Type c:MultiSelectBox}"><Setter Property="FontFamily" Value="{DynamicResource Flourish.FontFamily}" /><Setter Property="FontSize" Value="17" /><Setter Property="Foreground" Value="{DynamicResource Flourish.Brush.Text}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type c:MultiSelectBox}"><Grid><ToggleButton x:Name="Trigger" Foreground="{TemplateBinding Foreground}" MinHeight="48" Padding="14,8" Content="{TemplateBinding EffectiveText}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" CornerRadius="12" Background="{DynamicResource Flourish.Brush.Surface}" BorderBrush="{DynamicResource Flourish.Brush.Border}" BorderThickness="1" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal"><ContentPresenter VerticalAlignment="Center" /><c:ExpansionIndicator Foreground="{TemplateBinding Foreground}" Margin="8,0,0,0" VerticalAlignment="Center" Expanded="{Binding IsChecked,RelativeSource={RelativeSource TemplatedParent}}" /></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Flourish.Brush.SurfaceHover}" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Flourish.Brush.SurfaceHover}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{Binding IsChecked,Mode=TwoWay,ElementName=Trigger}" PlacementTarget="{Binding ElementName=Trigger}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="{DynamicResource Flourish.Brush.Surface}" TextElement.Foreground="{DynamicResource Flourish.Brush.Text}" BorderBrush="{DynamicResource Flourish.Brush.Border}" BorderThickness="1" CornerRadius="16" Padding="12" MinWidth="280" MaxWidth="420"><StackPanel><c:SearchBox x:Name="PART_Search" Placeholder="Search choices" /><ScrollViewer MaxHeight="360" Margin="0,8,0,0" Style="{DynamicResource Flourish.ScrollViewer}"><StackPanel x:Name="PART_Items" /></ScrollViewer></StackPanel></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type c:FilePicker}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type c:FilePicker}"><c:Button x:Name="PART_Pick" Text="{TemplateBinding Text}" Variant="Secondary" Icon="upload_file" /></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
