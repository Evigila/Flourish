<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ArkheideSystem.Flourish.WPF</RootNamespace>
    <PackageId>Arkheide.Flourish.WPF.Design</PackageId>
    <Description>Optional native WPF Design resources ported from Flourish.Blazor.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Flourish.WPF.Abstract/Flourish.WPF.Abstract.csproj" />
    <ProjectReference Include="../Flourish.WPF.Framework/Flourish.WPF.Framework.csproj" />
  </ItemGroup>
</Project>
