<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:ArkheideSystem.Flourish.Controls"
>
  <ControlTemplate x:Key="CheckBoxTemplate" TargetType="{x:Type controls:CheckBox}">
    <Grid
      x:Name="InteractionRoot"
      MinWidth="{TemplateBinding MinWidth}"
      MinHeight="{TemplateBinding MinHeight}"
      ClipToBounds="True"
      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
    >
      <Border
        x:Name="SurfaceChrome"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"
        CornerRadius="{DynamicResource FlourishControlCornerRadius}"
      />
      <Border
        x:Name="HoverChrome"
        Background="{TemplateBinding controls:HoverReveal.OverrideColor}"
        BorderThickness="0"
        CornerRadius="{DynamicResource FlourishControlCornerRadius}"
        IsHitTestVisible="False"
        Opacity="0"
        RenderTransformOrigin="0.5,0.5"
      >
        <Border.RenderTransform>
          <ScaleTransform x:Name="HoverRevealScale" ScaleX="0" ScaleY="0" />
        </Border.RenderTransform>
      </Border>
      <Border
        x:Name="PressedChrome"
        Background="{DynamicResource FlourishPressedRevealBrush}"
        BorderThickness="0"
        CornerRadius="{DynamicResource FlourishControlCornerRadius}"
        IsHitTestVisible="False"
        Opacity="0"
      />
      <Grid x:Name="ContentLayout" Margin="{TemplateBinding Padding}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ContentPresenter
          x:Name="IconHost"
          Style="{DynamicResource FlourishIconContentPresenterStyle}"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Content="{TemplateBinding Icon}"
          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
          TextElement.Foreground="{DynamicResource FlourishNeutralForeground2Brush}"
          Visibility="Collapsed"
        />

        <Border
          x:Name="IndicatorChrome"
          Grid.Column="0"
          Width="20"
          Height="20"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderBrush="{DynamicResource FlourishNeutralStroke1Brush}"
          BorderThickness="{DynamicResource FlourishControlBorderThickness}"
          CornerRadius="10"
        >
          <Grid>
            <Path
              x:Name="CheckMark"
              Width="14"
              Height="11"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Data="M 0,4 L 3.25,7.25 L 10,0"
              Stretch="Fill"
              Stroke="{DynamicResource FlourishPrimaryForegroundBrush}"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              StrokeStartLineCap="Round"
              StrokeThickness="1.8"
              Visibility="Collapsed"
            />
            <Border
              x:Name="IndeterminateMark"
              Width="9"
              Height="2"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource FlourishPrimaryForegroundBrush}"
              CornerRadius="1"
              Visibility="Collapsed"
            />
          </Grid>
        </Border>

        <ContentPresenter
          x:Name="ContentHost"
          Grid.Column="1"
          Margin="10,0,0,0"
          Style="{DynamicResource FlourishControlContentPresenterStyle}"
          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
          Content="{TemplateBinding Content}"
          ContentStringFormat="{TemplateBinding ContentStringFormat}"
          ContentTemplate="{TemplateBinding ContentTemplate}"
          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
          RecognizesAccessKey="True"
          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
        />
      </Grid>
    </Grid>

    <ControlTemplate.Triggers>
      <Trigger Property="Variant" Value="Vertical">
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="Padding" Value="{DynamicResource FlourishCardPadding}" />
        <Setter Property="Background" Value="{DynamicResource FlourishCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FlourishSurfaceStrokeBrush}" />
        <Setter TargetName="SurfaceChrome" Property="CornerRadius" Value="{DynamicResource FlourishSurfaceCornerRadius}" />
        <Setter TargetName="HoverChrome" Property="CornerRadius" Value="{DynamicResource FlourishSurfaceCornerRadius}" />
        <Setter TargetName="PressedChrome" Property="CornerRadius" Value="{DynamicResource FlourishSurfaceCornerRadius}" />
        <Setter TargetName="IconHost" Property="Visibility" Value="Visible" />
        <Setter TargetName="IndicatorChrome" Property="Grid.Column" Value="1" />
        <Setter TargetName="IndicatorChrome" Property="HorizontalAlignment" Value="Right" />
        <Setter TargetName="IndicatorChrome" Property="VerticalAlignment" Value="Top" />
        <Setter TargetName="ContentHost" Property="Grid.Row" Value="1" />
        <Setter TargetName="ContentHost" Property="Grid.Column" Value="0" />
        <Setter TargetName="ContentHost" Property="Grid.ColumnSpan" Value="2" />
        <Setter TargetName="ContentHost" Property="Margin" Value="0,16,0,0" />
        <Setter TargetName="ContentHost" Property="HorizontalAlignment" Value="Left" />
        <Setter TargetName="ContentHost" Property="VerticalAlignment" Value="Top" />
      </Trigger>

      <Trigger Property="Icon" Value="{x:Null}">
        <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Icon" Value="">
        <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
      </Trigger>

      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True" />
          <Condition Property="controls:HoverReveal.IsEnabled" Value="False" />
        </MultiTrigger.Conditions>
        <Setter TargetName="HoverChrome" Property="Opacity" Value="1" />
        <Setter TargetName="HoverChrome" Property="RenderTransform">
          <Setter.Value>
            <ScaleTransform ScaleX="1" ScaleY="1" />
          </Setter.Value>
        </Setter>
      </MultiTrigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource FlourishPrimaryForegroundBrush}" />
        <Setter TargetName="SurfaceChrome" Property="BorderBrush" Value="{DynamicResource FlourishPrimaryForegroundBrush}" />
        <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{DynamicResource FlourishPrimaryForegroundBrush}" />
        <Setter TargetName="IndicatorChrome" Property="BorderBrush" Value="Transparent" />
        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsChecked" Value="{x:Null}">
        <Setter Property="Foreground" Value="{DynamicResource FlourishPrimaryForegroundBrush}" />
        <Setter TargetName="SurfaceChrome" Property="BorderBrush" Value="{DynamicResource FlourishPrimaryForegroundBrush}" />
        <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{DynamicResource FlourishPrimaryForegroundBrush}" />
        <Setter TargetName="IndicatorChrome" Property="BorderBrush" Value="{DynamicResource FlourishPrimaryForegroundBrush}" />
        <Setter TargetName="IndicatorChrome" Property="CornerRadius" Value="4" />
      </Trigger>

      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsChecked" Value="True" />
          <Condition Property="IsPressed" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="CheckMark" Property="Stroke" Value="{DynamicResource FlourishPrimaryPressedBrush}" />
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsChecked" Value="{x:Null}" />
          <Condition Property="IsPressed" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="IndicatorChrome" Property="BorderBrush" Value="{DynamicResource FlourishPrimaryPressedBrush}" />
      </MultiTrigger>

      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="HoverChrome" Property="Opacity" Value="0" />
        <Setter TargetName="PressedChrome" Property="Opacity" Value="1" />
      </Trigger>

      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource FlourishNeutralForegroundDisabledBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter TargetName="SurfaceChrome" Property="Background" Value="{DynamicResource FlourishNeutralBackgroundDisabledBrush}" />
        <Setter TargetName="SurfaceChrome" Property="BorderBrush" Value="{DynamicResource FlourishNeutralStrokeDisabledBrush}" />
        <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{DynamicResource FlourishNeutralForegroundDisabledBrush}" />
        <Setter TargetName="IndicatorChrome" Property="Background" Value="{DynamicResource FlourishNeutralBackgroundDisabledBrush}" />
        <Setter TargetName="IndicatorChrome" Property="BorderBrush" Value="{DynamicResource FlourishNeutralStrokeDisabledBrush}" />
        <Setter TargetName="CheckMark" Property="Stroke" Value="{DynamicResource FlourishNeutralForegroundDisabledBrush}" />
        <Setter TargetName="IndeterminateMark" Property="Background" Value="{DynamicResource FlourishNeutralForegroundDisabledBrush}" />
        <Setter TargetName="HoverChrome" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="PressedChrome" Property="Visibility" Value="Collapsed" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="{x:Type controls:CheckBox}">
    <Setter Property="MinHeight" Value="{DynamicResource FlourishControlHeight}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{DynamicResource FlourishControlBorderThickness}" />
    <Setter Property="Foreground" Value="{DynamicResource FlourishNeutralForeground1Brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FlourishFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FlourishFontSizeStandard}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="controls:HoverReveal.OverrideColor" Value="{DynamicResource FlourishHoverRevealBrush}" />
    <Setter Property="controls:HoverReveal.IsMotionEnabled" Value="{DynamicResource FlourishHoverRevealEnabled}" />
    <Setter Property="controls:HoverReveal.IsParticipant" Value="True" />
    <Setter Property="controls:HoverReveal.TemplateHandlesInteraction" Value="True" />
    <Setter Property="Template" Value="{StaticResource CheckBoxTemplate}" />
  </Style>
</ResourceDictionary>
