<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <!-- Neutral aliases follow Fluent roles with application-calibrated surface values. -->
  <SolidColorBrush x:Key="FlourishNeutralForeground1Brush" Color="#242424" />
  <SolidColorBrush x:Key="FlourishNeutralForeground2Brush" Color="#424242" />
  <SolidColorBrush x:Key="FlourishNeutralForegroundDisabledBrush" Color="#BDBDBD" />
  <SolidColorBrush x:Key="FlourishNeutralBackground1Brush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FlourishNeutralBackground1HoverBrush" Color="#F5F5F5" />
  <SolidColorBrush x:Key="FlourishNeutralBackground1PressedBrush" Color="#E0E0E0" />
  <SolidColorBrush x:Key="FlourishNeutralBackground2Brush" Color="#FDFDFD" />
  <SolidColorBrush x:Key="FlourishNeutralBackgroundDisabledBrush" Color="#F0F0F0" />
  <SolidColorBrush x:Key="FlourishShellBackgroundBrush" Color="#E6FDFDFD" />
  <SolidColorBrush x:Key="FlourishNeutralStroke1Brush" Color="#D1D1D1" />
  <SolidColorBrush x:Key="FlourishNeutralStroke1HoverBrush" Color="#C7C7C7" />
  <SolidColorBrush x:Key="FlourishNeutralStrokeAccessibleBrush" Color="#616161" />
  <SolidColorBrush x:Key="FlourishNeutralStrokeDisabledBrush" Color="#E0E0E0" />
  <SolidColorBrush x:Key="FlourishFocusStrokeBrush" Color="#0F6CBD" />
  <SolidColorBrush x:Key="FlourishSurfaceStrokeBrush" Color="#0D000000" />
  <SolidColorBrush x:Key="FlourishDividerBrush" Color="#E0E0E0" />

  <!-- Shared interaction aliases. -->
  <SolidColorBrush x:Key="FlourishSelectionBackgroundBrush" Color="#CFE4FA" />
  <SolidColorBrush x:Key="FlourishSelectionForegroundBrush" Color="#0C3B5E" />
  <SolidColorBrush x:Key="FlourishHoverRevealBrush" Color="#590F6CBD" />
  <SolidColorBrush x:Key="FlourishPressedRevealBrush" Color="#660E4775" />
  <SolidColorBrush x:Key="FlourishTonalButtonBackgroundBrush" Color="#EBF3FC" />
  <SolidColorBrush x:Key="FlourishTonalButtonForegroundBrush" Color="#115EA3" />
  <SolidColorBrush x:Key="FlourishTonalButtonPressedBrush" Color="#96C6FA" />
  <SolidColorBrush x:Key="FlourishTonalButtonPressedForegroundBrush" Color="#0A2E4A" />

  <!-- Primary, secondary and accent are independently overridable public roles. -->
  <Color x:Key="FlourishPrimaryColor">#0F6CBD</Color>
  <Color x:Key="FlourishSecondaryColor">#5C2E91</Color>
  <Color x:Key="FlourishAccentColor">#DA3B01</Color>
  <SolidColorBrush x:Key="FlourishPrimaryForegroundBrush" Color="#0F6CBD" />
  <SolidColorBrush x:Key="FlourishPrimaryHoverBrush" Color="#115EA3" />
  <SolidColorBrush x:Key="FlourishPrimaryPressedBrush" Color="#0E4775" />
  <SolidColorBrush x:Key="FlourishPrimarySurfaceBrush" Color="#240F6CBD" />
  <SolidColorBrush x:Key="FlourishPrimaryBackgroundBrush" Color="#0F6CBD" />
  <SolidColorBrush x:Key="FlourishPrimaryBackgroundHoverBrush" Color="#115EA3" />
  <SolidColorBrush x:Key="FlourishPrimaryBackgroundPressedBrush" Color="#0C3B5E" />
  <SolidColorBrush x:Key="FlourishForegroundOnPrimaryBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FlourishSecondaryForegroundBrush" Color="#5C2E91" />
  <SolidColorBrush x:Key="FlourishSecondarySurfaceBrush" Color="#205C2E91" />
  <SolidColorBrush x:Key="FlourishAccentForegroundBrush" Color="#C43501" />
  <SolidColorBrush x:Key="FlourishAccentSurfaceBrush" Color="#20DA3B01" />
  <LinearGradientBrush x:Key="FlourishHeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#2B0F6CBD" />
    <GradientStop Offset="0.68" Color="#245C2E91" />
    <GradientStop Offset="1" Color="#20DA3B01" />
  </LinearGradientBrush>

  <!-- Shared overlay and status aliases. -->
  <SolidColorBrush x:Key="FlourishOverlayScrimBrush" Color="#66000000" />
  <SolidColorBrush x:Key="FlourishForegroundOnOverlayBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FlourishDangerForegroundBrush" Color="#B10E1C" />
  <SolidColorBrush x:Key="FlourishDangerBackgroundBrush" Color="#FDF3F4" />
  <SolidColorBrush x:Key="FlourishDangerStrongBackgroundBrush" Color="#C50F1F" />
  <SolidColorBrush x:Key="FlourishDangerStrokeBrush" Color="#C50F1F" />
  <SolidColorBrush x:Key="FlourishDangerHoverRevealBrush" Color="#33C50F1F" />
  <SolidColorBrush x:Key="FlourishForegroundOnDangerBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FlourishWarningBackgroundBrush" Color="#FFF9F5" />
  <SolidColorBrush x:Key="FlourishWarningForegroundBrush" Color="#8A3707" />

  <!-- Specialized surfaces that cannot be represented by another alias. -->
  <SolidColorBrush x:Key="FlourishContentBackgroundBrush" Color="#F7FAFC" />
  <SolidColorBrush x:Key="FlourishScrollbarThumbBrush" Color="#7A7A7A" />
  <SolidColorBrush x:Key="FlourishScrollbarThumbPressedBrush" Color="#424242" />
  <SolidColorBrush x:Key="FlourishCardBackgroundBrush" Color="#FDFDFD" />
  <SolidColorBrush x:Key="FlourishOutputViewportBackgroundBrush" Color="#E6E6E6" />
  <SolidColorBrush x:Key="FlourishOutputViewportForegroundBrush" Color="#0E700E" />
  <DropShadowEffect x:Key="FlourishElevation1Effect" BlurRadius="10" Direction="270" Opacity="0.12" ShadowDepth="2" Color="#000000" />
  <DropShadowEffect x:Key="FlourishElevation2Effect" BlurRadius="18" Direction="270" Opacity="0.20" ShadowDepth="4" Color="#000000" />
</ResourceDictionary>
